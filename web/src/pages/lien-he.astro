---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteCtaSection from '../components/SiteCtaSection.astro';
import PageHero from '../components/PageHero.astro';
import ContactForm from '../components/ContactForm.astro';
import { pageSeo, siteContact } from '../data/site';
---

<BaseLayout title={pageSeo.lienHe.title} description={pageSeo.lienHe.description}>
  <SiteNav solid currentPath="/lien-he" />

  <PageHero
    title="Liên hệ tư vấn"
    description="Liên hệ đội ngũ tư vấn để nhận giải pháp đồng phục phù hợp với doanh nghiệp của bạn."
    breadcrumb={[
      { label: 'Trang chủ', href: '/' },
      { label: 'Liên hệ' },
    ]}
  />

  <section class="py-12 md:py-20 bg-white border-b border-border-subtle">
    <div class="max-w-container-max-width mx-auto px-6 md:px-8 grid lg:grid-cols-2 gap-8 md:gap-12 lg:gap-16">
      <div>
        <h2 class="font-headline-md text-2xl font-bold text-ink-dark mb-6">Gửi yêu cầu tư vấn</h2>
        <p class="text-text-muted mb-8 leading-relaxed">
          Điền form bên cạnh hoặc liên hệ trực tiếp qua hotline. Đội ngũ Tân Phạm Gia sẵn sàng hỗ trợ
          khảo sát, tư vấn và báo giá nhanh chóng.
        </p>
        <ContactForm />
      </div>

      <aside class="lg:pt-14">
        <h2 class="font-headline-md text-xl font-bold text-ink-dark mb-6">Thông tin liên hệ</h2>
        <ul class="space-y-5 text-sm md:text-base">
          <li class="flex gap-3">
            <span class="material-symbols-outlined text-accent-gold shrink-0">location_on</span>
            <span class="text-text-muted text-safe-wrap">
              <strong class="text-ink-dark block mb-1">Showroom</strong>
              {siteContact.address}
            </span>
          </li>
          <li class="flex gap-3">
            <span class="material-symbols-outlined text-accent-gold shrink-0">call</span>
            <span class="text-text-muted">
              <strong class="text-ink-dark block mb-1">Hotline</strong>
              <a class="text-accent-teal font-semibold hover:underline" href={siteContact.phoneHref}>
                {siteContact.phoneDisplay}
              </a>
              <span class="block text-sm mt-1">8:00–18:00, T2–T7</span>
            </span>
          </li>
          <li class="flex gap-3">
            <span class="material-symbols-outlined text-accent-gold shrink-0">mail</span>
            <span class="text-text-muted">
              <strong class="text-ink-dark block mb-1">Email</strong>
              <a class="text-accent-teal hover:underline text-safe-wrap" href={siteContact.emailHref}>
                {siteContact.email}
              </a>
            </span>
          </li>
          <li class="flex gap-3">
            <span class="material-symbols-outlined text-accent-gold shrink-0">schedule</span>
            <span class="text-text-muted">
              <strong class="text-ink-dark block mb-1">Giờ làm việc</strong>
              {siteContact.hours}
            </span>
          </li>
        </ul>

        <div class="mt-10 p-6 rounded-xl bg-surface-muted border border-border-subtle">
          <h3 class="font-bold text-ink-dark mb-2">Cam kết phản hồi</h3>
          <p class="text-text-muted text-sm leading-relaxed">{siteContact.responseCommitment}</p>
        </div>
      </aside>
    </div>
  </section>

  <SiteCtaSection />

  <SiteFooter />
</BaseLayout>
