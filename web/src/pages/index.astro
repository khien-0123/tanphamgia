---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteNav from '../components/SiteNav.astro';
import HomeFeaturedCases from '../components/HomeFeaturedCases.astro';
import HomeNewsSection from '../components/HomeNewsSection.astro';
import HomeClientLogos from '../components/HomeClientLogos.astro';
import SiteCtaSection from '../components/SiteCtaSection.astro';
import SiteFooter from '../components/SiteFooter.astro';
import {
  seo,
  navigation,
  stats,
  whyChoose,
  solutions,
  certificates,
  heroMedia,
} from '../data/site';
---

<BaseLayout title={seo.title} description={seo.description}>
  <SiteNav items={navigation} currentPath="/" ctaHref="/tai-lieu" />

  <!-- Section 2: Hero -->
  <header
    class="relative flex items-center justify-center overflow-hidden pt-24 pb-8 md:pt-28 md:pb-16 min-h-0 sm:min-h-[480px] md:min-h-[520px] lg:min-h-[560px]"
  >
    <div class="absolute inset-0 z-0">
      <div class="absolute inset-0 hero-gradient z-10"></div>
      {
        heroMedia.video ? (
          <video
            class="w-full h-full object-cover object-center"
            id="hero-video"
            autoplay
            loop
            muted
            playsinline
            poster={heroMedia.image}
          >
            <source src={heroMedia.video} type="video/mp4" />
          </video>
        ) : (
          <img
            alt="Nhà máy may đồng phục Tân Phạm Gia"
            class="w-full h-full object-cover object-center"
            id="hero-image"
            src={heroMedia.image}
          />
        )
      }
    </div>
    <div
      class="relative z-20 max-w-container-max-width mx-auto px-6 md:px-8 text-center text-white pt-2 pb-0 md:py-8"
    >
      <h1
        class="font-display-lg text-2xl sm:text-3xl md:text-4xl lg:text-[2.75rem] font-extrabold mb-5 mx-auto flex flex-col gap-2 md:gap-1 leading-[1.35] md:leading-[1.12] tracking-normal md:tracking-tight"
      >
        <span class="block md:whitespace-nowrap">Đồng Phục Chuẩn Thương Hiệu.</span>
        <span class="block text-accent-gold text-[1.125rem] sm:text-3xl md:text-4xl lg:text-[2.75rem] whitespace-nowrap">
          Chuẩn Tiến Độ. Chuẩn Từng Chiếc.
        </span>
      </h1>
      <p
        class="font-body-lg text-base md:text-lg mb-5 md:mb-8 max-w-2xl mx-auto text-white/85 leading-relaxed"
      >
        23 năm đồng hành cùng doanh nghiệp xây dựng hình ảnh chuyên nghiệp với giải pháp đồng phục
        toàn diện.
      </p>
      <div class="flex flex-row gap-2 sm:gap-3 justify-center items-stretch w-full max-w-md sm:max-w-none mx-auto">
        <a
          href="/lien-he"
          class="flex-1 min-w-0 bg-accent-gold text-ink-dark px-3 py-2.5 sm:px-8 sm:py-4 rounded-full font-bold text-xs sm:text-base leading-tight hover:shadow-gold hover:scale-105 transition-all shadow-soft text-center"
        >
          Nhận tư vấn giải pháp
        </a>
        <a
          href="/tai-lieu"
          class="flex-1 min-w-0 border border-white/50 bg-white/10 backdrop-blur-sm text-white px-3 py-2.5 sm:px-8 sm:py-4 rounded-full font-bold text-xs sm:text-base leading-tight hover:bg-white hover:text-ink-dark transition-all text-center"
        >
          Tải hồ sơ năng lực
        </a>
      </div>
    </div>
  </header>

  <!-- Section 4: Giới thiệu ngắn + Stats (Sitemap 1.3) -->
  <section class="py-10 md:py-20 bg-white border-b border-border-subtle" id="gioi-thieu">
    <div class="max-w-container-max-width mx-auto px-6 md:px-8">
      <div class="max-w-3xl mx-auto text-center mb-8 md:mb-14">
        <h2 class="gioi-thieu-title font-headline-md font-bold text-ink-dark mb-5">
          <span class="gioi-thieu-title-line md:hidden">Tân Phạm Gia – Chuyên sản xuất</span>
          <span class="gioi-thieu-title-line md:hidden">đồng{'\u00a0'}phục &amp; phát triển sản phẩm</span>
          <span class="gioi-thieu-title-line md:hidden">may{'\u00a0'}mặc dành cho{'\u00a0'}B2B</span>
          <span class="hidden md:inline">
            Tân Phạm Gia – Chuyên sản xuất đồng phục & phát triển sản phẩm may mặc dành cho B2B
          </span>
        </h2>
        <p class="gioi-thieu-text text-text-muted text-base md:text-lg leading-relaxed mb-4">
          Với hơn 23 năm kinh nghiệm trong ngành thời trang và may mặc, Tân Phạm Gia phát triển
          những giải pháp đồng phục giúp doanh nghiệp xây dựng hình ảnh chuyên nghiệp, đồng bộ và&nbsp;khác biệt.
        </p>
        <p class="gioi-thieu-text text-text-muted text-base md:text-lg leading-relaxed">
          Chúng tôi ứng dụng tiêu chuẩn tỷ lệ vàng, Rập 3D và may trên mannequin — tạo sản phẩm
          tôn dáng, thoải mái và phù hợp nhiều vóc&nbsp;dáng.
        </p>
      </div>
      <dl class="about-stats-strip about-stats-strip--4 max-w-4xl mx-auto">
        {
          stats.map((item, i) => (
            <div class:list={['about-stat text-center', i > 0 && 'about-stat--divided']}>
              <dt class="about-stat-value text-3xl md:text-4xl font-extrabold">{item.value}</dt>
              <dd class="about-stat-label">{item.label}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- Section 5: Tại sao chọn Tân Phạm Gia (Sitemap 1.4) -->
  <section class="py-10 md:py-24 bg-white border-b border-border-subtle" id="tai-sao">
    <div class="max-w-container-max-width mx-auto px-6 md:px-8">
      <div class="text-center mb-8 md:mb-14 max-w-2xl mx-auto">
        <h2 class="tai-sao-title font-headline-md font-bold text-ink-dark">
          Tiên phong "Thời trang hóa"<br class="md:hidden" />
          đồng phục doanh nghiệp
        </h2>
      </div>
      <div class="about-value-grid about-value-grid--4">
        {
          whyChoose.map((item) => (
            <div class="about-value-item">
              <span class="about-value-num">{item.num}</span>
              <div>
                <h3 class="about-value-title font-bold text-base md:text-lg text-ink-dark mb-2">{item.title}</h3>
                <p class="text-text-muted text-sm leading-relaxed">{item.desc}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Section 6: Giải pháp (Sitemap 1.5) -->
  <section
    id="giai-phap"
    class="py-10 md:py-24 bg-white border-b border-border-subtle text-ink-dark"
  >
    <div class="max-w-container-max-width mx-auto px-6 md:px-8">
      <div class="text-center mb-8 md:mb-16 max-w-3xl mx-auto">
        <h2 class="giai-phap-heading font-headline-md font-bold mb-4 text-ink-dark">
          Giải pháp đồng phục toàn&nbsp;diện
        </h2>
        <p class="giai-phap-text text-text-muted text-sm md:text-base max-w-3xl mx-auto leading-relaxed">
          Lắng nghe và thấu hiểu để đưa ra giải pháp phù hợp nhất cho từng mô hình doanh&nbsp;nghiệp.
        </p>
      </div>
      <div class="solution-box-grid solution-box-grid--compact solution-box-grid--home">
        {
          solutions.map((item, index) => (
            <article class="solution-box-item group">
              <a class="solution-box-summary no-underline" href={`/giai-phap/${item.slug}`}>
                <figure class="solution-box-media m-0">
                  <img
                    alt={item.title}
                    class="w-full h-full object-cover"
                    loading="lazy"
                    src={item.image}
                    onerror="this.onerror=null;this.src='https://lh3.googleusercontent.com/aida-public/AB6AXuD7szr7Elx-oAqCEnir2uiBqNE-4WpmIm10Kj1YsgXyu1XMFvP0qvIXYrsMpRh9sztusxsq8_7_MFPstpomb4RaDeTg9J3ldf2CSKwYUq91qGdHVM6Dm9YkfE3Rdfay_snBPthtK7WWCq_NFHZ3j3Kua1MgJAT-qQPXwlpAIQIDLIpk4Njn_msEnsXh9DyyRtwkvdNU5u10NXpGyYseM_HBo6gwnr6IFqeZ9gHXI1CrvRQnXAxx3UyIT7UIbTDEMKjd1gdxbZwWKrKl'"
                  />
                </figure>
                <span class="solution-box-number">0{index + 1}</span>
                <h3 class="solution-box-title">{item.title}</h3>
                <p class="solution-box-desc">{item.desc}</p>
                <span class="solution-box-link">Xem chi tiết</span>
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Thương hiệu đồng hành (Sitemap 1.6 — layout Aristino) -->
  <section class="pt-8 pb-10 md:py-20 bg-white border-b border-border-subtle" id="doi-tac">
    <div
      class="max-w-container-max-width mx-auto px-6 md:px-8 grid lg:grid-cols-5 gap-6 lg:gap-14 items-center"
    >
      <div class="lg:col-span-2">
        <h2 class="text-2xl md:text-3xl font-bold text-ink-dark mb-4 leading-snug">
          Thương hiệu đồng hành cùng Tân Phạm Gia
        </h2>
        <p class="text-text-muted text-sm md:text-base leading-relaxed">
          Chúng tôi tạo dựng niềm tin bằng chất lượng nhất quán, sự chỉn chu trong từng sản phẩm
          và tinh thần đồng hành lâu dài — giúp doanh nghiệp an tâm về hình ảnh và giá trị thương
          hiệu.
        </p>
      </div>
      <HomeClientLogos />
    </div>
  </section>

  <HomeFeaturedCases />

  <!-- Tải tài liệu (Sitemap 1.8) — trước chứng nhận theo sheet -->
  <section
    id="tai-lieu"
    class="py-10 md:py-24 bg-white border-b border-border-subtle text-ink-dark"
  >
    <div
      class="max-w-container-max-width mx-auto px-6 md:px-8 grid md:grid-cols-2 gap-8 md:gap-16 items-center"
    >
      <div>
        <h2
          class="font-display-lg text-[clamp(1.15rem,4.8vw,2.75rem)] md:text-5xl font-bold mb-6 leading-tight text-ink-dark"
        >
          Tải trọn bộ tài liệu mới nhất
        </h2>
        <p class="text-body-lg text-text-muted mb-8">
          Company Profile, Catalogue Đồng Phục 2026 và kiến thức hữu ích về triển khai đồng phục
          doanh nghiệp.
        </p>
        <ul class="space-y-3 text-sm md:text-base mb-8">
          <li class="flex items-center gap-2">
            <span class="material-symbols-outlined text-accent-gold text-lg">check_circle</span>
            Company Profile Tân Phạm Gia
          </li>
          <li class="flex items-center gap-2">
            <span class="material-symbols-outlined text-accent-gold text-lg">check_circle</span>
            Catalogue Đồng Phục Doanh Nghiệp 2026
          </li>
          <li class="flex items-center gap-2">
            <span class="material-symbols-outlined text-accent-gold text-lg">check_circle</span>
            Kiến thức chọn vải & triển khai đồng phục
          </li>
        </ul>
        <a
          href="/tai-lieu"
          class="inline-flex items-center gap-2 text-sm font-bold text-accent-teal hover:text-ink-dark transition-colors"
        >
          Xem toàn bộ thư viện tài liệu
          <span class="material-symbols-outlined text-base">arrow_forward</span>
        </a>
      </div>
      <div class="bg-white rounded-2xl shadow-card p-8 md:p-10">
        <p class="text-sm text-text-muted mb-6">
          Điền form để nhận link tải qua email — hoặc truy cập
          <a class="text-accent-teal font-semibold" href="/tai-lieu">trang Tài liệu</a> để chọn file cụ thể.
        </p>
        <form class="space-y-6" action="/tai-lieu#tai-lieu-form">
          <div>
            <label class="font-eyebrow text-xs text-ink-dark mb-2 block uppercase tracking-wider"
              >Họ và tên</label
            >
            <input
              class="form-input border-b px-0"
              placeholder="Nguyễn Văn A"
              type="text"
              name="name"
            />
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <div>
              <label class="font-eyebrow text-xs text-ink-dark mb-2 block uppercase tracking-wider"
                >Tên công ty</label
              >
              <input
                class="form-input border-b px-0"
                placeholder="Công ty CP ABC"
                type="text"
                name="company"
              />
            </div>
            <div>
              <label class="font-eyebrow text-xs text-ink-dark mb-2 block uppercase tracking-wider"
                >Email</label
              >
              <input
                class="form-input border-b px-0"
                placeholder="email@congty.vn"
                type="email"
                name="email"
              />
            </div>
          </div>
          <button
            type="submit"
            class="w-full bg-accent-gold text-ink-dark py-4 rounded-full font-bold text-base hover:shadow-gold transition-all active:scale-95"
            >Tải trọn bộ tài liệu mới nhất</button
          >
        </form>
      </div>
    </div>
  </section>

  <!-- Giấy khen & chứng nhận (Sitemap 1.7) -->
  <section class="py-10 md:py-20 bg-white border-b border-border-subtle" id="chung-nhan">
    <div class="max-w-container-max-width mx-auto px-6 md:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="font-headline-md text-2xl md:text-3xl font-bold text-ink-dark">
          Giấy khen & Chứng nhận
        </h2>
      </div>
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-6 md:gap-8">
        {
          certificates.map((cert) => (
            <figure class="about-cert-figure m-0">
              <img
                alt={cert.title}
                class="w-full aspect-[4/3] object-cover rounded-lg"
                loading="lazy"
                src={cert.image}
              />
              <figcaption class="mt-3 text-sm font-semibold text-ink-dark text-center md:text-left">
                {cert.title}
              </figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  <HomeNewsSection />

  <SiteCtaSection />

  <SiteFooter />
</BaseLayout>
