# Domain site Astro (canonical, OG tags) — đổi khi chuyển domain
PUBLIC_SITE_URL=https://tanphamgia.vercel.app

# Site WordPress/legacy (chính sách, media cũ)
PUBLIC_LEGACY_SITE_URL=https://dongphucvn.vn

# Link badge Bộ Công Thương
PUBLIC_MINISTRY_CERT_URL=https://online.gov.vn/

# --- Headless WordPress (WPGraphQL + ACF) ---
# Để trống = dùng data local trong src/data/*
# Khi có VPS: https://cms.ten-mien.com/graphql
WORDPRESS_GRAPHQL_URL=

# Host ảnh WP (không kèm https://). Trống = suy ra từ WORDPRESS_GRAPHQL_URL
WORDPRESS_IMAGE_HOSTNAME=
