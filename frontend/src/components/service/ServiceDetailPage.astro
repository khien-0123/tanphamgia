---
import PageHero from '../PageHero.astro';
import ServiceZigzagBlock from './ServiceZigzagBlock.astro';
import type { ServicePageContent } from '../../data/dich-vu/types';
import { sectionEyebrow } from '../../lib/section-eyebrow';
import { routes } from '../../lib/routes';

interface Props {
  content: ServicePageContent;
}

const { content } = Astro.props;
---

<PageHero
  title={content.title}
  description={content.description}
  bgImage={content.heroImage}
  breadcrumb={[
    { label: 'Trang chủ', href: routes.home },
    { label: 'Dịch vụ' },
    { label: content.shortTitle },
  ]}
/>

<section class="bg-white" aria-label={`Chi tiết dịch vụ ${content.shortTitle}`}>
  <div class="mx-auto w-full max-w-container-max-width px-6 pt-14 pb-2 md:px-8 md:pt-20 md:pb-0">
    <p class={sectionEyebrow}>Quy trình dịch vụ</p>
  </div>
  {
    content.blocks.map((block, index) => (
      <ServiceZigzagBlock block={block} index={index} reverse={index % 2 === 1} />
    ))
  }
</section>
