---
import { siteContact } from '../data/site';
import { formInputClass, formLabelClass } from '../lib/form-classes';

const quantityOptions = [
  'Dưới 100 sản phẩm',
  '100 – 500 sản phẩm',
  '500 – 2.000 sản phẩm',
  'Trên 2.000 sản phẩm',
];

const timelineOptions = [
  'Trong 2 tuần',
  'Trong 1 tháng',
  'Trong 2–3 tháng',
  'Chưa xác định',
];

const industryOptions = [
  'Sản xuất & FDI',
  'Văn phòng & Tập đoàn',
  'FMCG & Chuỗi phân phối',
  'Y tế, Spa & Dịch vụ',
  'Khác',
];

---

<form class="contact-form space-y-5" id="contact-form" method="post" action="#">
  <div class="grid sm:grid-cols-2 gap-5">
    <div>
      <label class={formLabelClass} for="contact-name">Họ tên *</label>
      <input class={formInputClass} id="contact-name" name="name" type="text" required placeholder="Nhập họ tên" />
    </div>
    <div>
      <label class={formLabelClass} for="contact-role">Chức vụ</label>
      <input class={formInputClass} id="contact-role" name="role" type="text" placeholder="Nhập chức vụ" />
    </div>
  </div>
  <div>
    <label class={formLabelClass} for="contact-company">Tên công ty *</label>
    <input class={formInputClass} id="contact-company" name="company" type="text" required placeholder="Nhập tên công ty" />
  </div>
  <div class="grid sm:grid-cols-2 gap-5">
    <div>
      <label class={formLabelClass} for="contact-phone">SĐT / Zalo *</label>
      <input class={formInputClass} id="contact-phone" name="phone" type="tel" required placeholder="Nhập SĐT/Zalo" />
    </div>
    <div>
      <label class={formLabelClass} for="contact-email">Email</label>
      <input class={formInputClass} id="contact-email" name="email" type="email" placeholder="Nhập email" />
    </div>
  </div>
  <div class="grid sm:grid-cols-2 gap-5">
    <div>
      <label class={formLabelClass} for="contact-industry">Ngành nghề</label>
      <select class={formInputClass} id="contact-industry" name="industry">
        <option value="">Chọn ngành</option>
        {industryOptions.map((opt) => <option value={opt}>{opt}</option>)}
      </select>
    </div>
    <div>
      <label class={formLabelClass} for="contact-quantity">Số lượng dự kiến</label>
      <select class={formInputClass} id="contact-quantity" name="quantity">
        <option value="">Chọn số lượng</option>
        {quantityOptions.map((opt) => <option value={opt}>{opt}</option>)}
      </select>
    </div>
  </div>
  <div>
    <label class={formLabelClass} for="contact-timeline">Thời điểm cần</label>
    <select class={formInputClass} id="contact-timeline" name="timeline">
      <option value="">Chọn thời điểm</option>
      {timelineOptions.map((opt) => <option value={opt}>{opt}</option>)}
    </select>
  </div>
  <div>
    <label class={formLabelClass} for="contact-message">Yêu cầu cụ thể</label>
    <textarea
      class:list={[formInputClass, 'resize-y min-h-16']}
      id="contact-message"
      name="message"
      rows="2"
      placeholder="Mô tả nhu cầu đồng phục, chất liệu, số lượng..."
    ></textarea>
  </div>
  <button
    class="w-full bg-accent-gold text-ink-dark py-4 rounded-full font-bold hover:shadow-gold transition-all"
    type="submit"
  >
    Gửi yêu cầu tư vấn
  </button>
  <p class="text-xs text-text-muted text-center">
    Hoặc gọi hotline <a class="text-accent-teal font-semibold" href={siteContact.phoneHref}
      >{siteContact.phoneDisplay}</a
    >
  </p>
</form>

<script>
  document.getElementById('contact-form')?.addEventListener('submit', (e) => {
    e.preventDefault();
    alert('Cảm ơn bạn! Đội ngũ Tân Phạm Gia sẽ phản hồi trong 24 giờ làm việc.');
  });
</script>
