---
import { siteContact } from '../data/site';

const quantityOptions = [
  'Dưới 100 sản phẩm',
  '100 – 500 sản phẩm',
  '500 – 2.000 sản phẩm',
  'Trên 2.000 sản phẩm',
];

const timelineOptions = [
  'Trong 2 tuần',
  'Trong 1 tháng',
  'Trong 2–3 tháng',
  'Chưa xác định',
];

const industryOptions = [
  'Sản xuất & FDI',
  'Văn phòng & Tập đoàn',
  'FMCG & Chuỗi phân phối',
  'Y tế, Spa & Dịch vụ',
  'Khác',
];
---

<form class="contact-form space-y-5" id="contact-form" method="post" action="#">
  <div class="grid sm:grid-cols-2 gap-5">
    <div>
      <label class="form-label" for="contact-name">Họ tên *</label>
      <input class="form-input" id="contact-name" name="name" type="text" required />
    </div>
    <div>
      <label class="form-label" for="contact-role">Chức vụ</label>
      <input class="form-input" id="contact-role" name="role" type="text" />
    </div>
  </div>
  <div>
    <label class="form-label" for="contact-company">Tên công ty *</label>
    <input class="form-input" id="contact-company" name="company" type="text" required />
  </div>
  <div class="grid sm:grid-cols-2 gap-5">
    <div>
      <label class="form-label" for="contact-phone">SĐT / Zalo *</label>
      <input class="form-input" id="contact-phone" name="phone" type="tel" required />
    </div>
    <div>
      <label class="form-label" for="contact-email">Email</label>
      <input class="form-input" id="contact-email" name="email" type="email" />
    </div>
  </div>
  <div class="grid sm:grid-cols-2 gap-5">
    <div>
      <label class="form-label" for="contact-industry">Ngành nghề</label>
      <select class="form-input" id="contact-industry" name="industry">
        <option value="">Chọn ngành</option>
        {industryOptions.map((opt) => <option value={opt}>{opt}</option>)}
      </select>
    </div>
    <div>
      <label class="form-label" for="contact-quantity">Số lượng dự kiến</label>
      <select class="form-input" id="contact-quantity" name="quantity">
        <option value="">Chọn số lượng</option>
        {quantityOptions.map((opt) => <option value={opt}>{opt}</option>)}
      </select>
    </div>
  </div>
  <div>
    <label class="form-label" for="contact-timeline">Thời điểm cần</label>
    <select class="form-input" id="contact-timeline" name="timeline">
      <option value="">Chọn thời điểm</option>
      {timelineOptions.map((opt) => <option value={opt}>{opt}</option>)}
    </select>
  </div>
  <div>
    <label class="form-label" for="contact-message">Yêu cầu cụ thể</label>
    <textarea class="form-input form-textarea" id="contact-message" name="message" rows="4"></textarea>
  </div>
  <button class="w-full bg-accent-gold text-ink-dark py-4 rounded-full font-bold hover:shadow-gold transition-all" type="submit">
    Gửi yêu cầu tư vấn
  </button>
  <p class="text-xs text-text-muted text-center">
    Hoặc gọi hotline <a class="text-accent-teal font-semibold" href={siteContact.phoneHref}>{siteContact.phoneDisplay}</a>
  </p>
</form>

<script>
  document.getElementById('contact-form')?.addEventListener('submit', (e) => {
    e.preventDefault();
    alert('Cảm ơn bạn! Đội ngũ Tân Phạm Gia sẽ phản hồi trong 24 giờ làm việc.');
  });
</script>
