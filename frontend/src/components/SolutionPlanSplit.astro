---
import { imageRadius } from '../lib/image-frame';

export interface PlanItem {
  title: string;
  desc: string;
}

interface Props {
  image: string;
  imageAlt: string;
  items: PlanItem[];
}

const { image, imageAlt, items } = Astro.props;

function formatNum(index: number) {
  return String(index + 1).padStart(2, '0');
}
---

<section
  class="grid grid-cols-1 gap-6 items-start lg:grid-cols-[minmax(0,0.38fr)_minmax(0,0.62fr)] lg:gap-10"
  aria-label="Giải pháp từ Tân Phạm Gia"
>
  <figure class:list={['m-0 overflow-hidden lg:sticky lg:top-[5.5rem] lg:self-start', imageRadius]}>
    <img
      src={image}
      alt={imageAlt}
      class="block w-full aspect-[4/3] object-cover"
      loading="lazy"
    />
  </figure>
  <div class="flex flex-col" role="list">
    {
      items.map((item, index) => (
        <article
          class="py-4 first:pt-0 last:pb-0"
          role="listitem"
        >
          <div class="flex flex-col lg:flex-row lg:items-center lg:gap-3 mb-2">
            <span
              class="inline-block w-fit shrink-0 text-[0.6875rem] font-bold tracking-[0.12em] text-[#111] bg-accent-gold px-2.5 py-1 rounded-full mb-3 lg:mb-0"
            >
              {formatNum(index)}
            </span>
            <h3 class="text-lg md:text-xl font-bold leading-snug text-[#111] m-0">{item.title}</h3>
          </div>
          <p class="text-sm md:text-[0.9375rem] leading-relaxed text-text-muted m-0">{item.desc}</p>
        </article>
      ))
    }
  </div>
</section>
