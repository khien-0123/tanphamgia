---
import { mainNavigation, siteCta } from '../data/site';
import SiteBrandLogo from './SiteBrandLogo.astro';

interface NavItem {
  label: string;
  href: string;
  icon?: string;
  desc?: string;
}

interface Props {
  currentPath?: string;
  items?: NavItem[];
  ctaHref?: string;
}

const {
  currentPath = '',
  items = mainNavigation,
  ctaHref = '/tai-lieu',
} = Astro.props;

const navShell = [
  'group fixed top-0 inset-x-0 z-50 w-full transition-all duration-300',
  'bg-transparent border-b border-transparent shadow-none backdrop-blur-none',
  '[&.nav-scrolled]:bg-white/80 [&.nav-scrolled]:backdrop-blur-md [&.nav-scrolled]:border-border-subtle',
  '[&.nav-scrolled]:shadow-soft',
];

const navPillLink =
  'px-3.5 py-2 rounded-full text-sm font-medium whitespace-nowrap text-white/85 transition-colors hover:text-white';

const navPillActive = '!bg-white !text-ink-dark shadow-[0_1px_4px_rgba(14,38,64,0.12)]';

const navFlatLink =
  'text-sm font-medium transition-colors text-on-surface hover:text-accent-gold';

const menuToggle =
  'lg:hidden flex items-center justify-center w-10 h-10 rounded-full border cursor-pointer transition-colors border-white/20 bg-ink-dark/70 text-white backdrop-blur-md hover:bg-ink-dark/85 group-[.nav-scrolled]:rounded-xl group-[.nav-scrolled]:border-border-subtle group-[.nav-scrolled]:bg-white group-[.nav-scrolled]:text-ink-dark group-[.nav-scrolled]:hover:bg-[#f4f7f6] group-[.nav-scrolled]:backdrop-blur-none [&_.material-symbols-outlined]:text-2xl';

const navInner = [
  'items-center gap-2 min-[400px]:gap-3 px-4 min-[400px]:px-6 md:px-8 py-3 md:py-3.5 max-w-container-max-width mx-auto min-w-0',
  'grid grid-cols-[1fr_auto] lg:grid-cols-[1fr_auto_1fr]',
  'group-[.nav-scrolled]:flex group-[.nav-scrolled]:justify-between',
];
---

<nav id="site-nav" class:list={[...navShell, 'no-transition']}>
  <div class:list={navInner}>
    <SiteBrandLogo class="shrink-0 justify-self-start group-[.nav-scrolled]:justify-self-auto" />

    <div
      class="hidden lg:flex justify-self-center items-center gap-0.5 p-1 rounded-full border border-white/10 bg-ink-dark/75 backdrop-blur-md shadow-[0_8px_32px_rgba(0,0,0,0.24)] group-[.nav-scrolled]:hidden"
    >
      {
        items.map((item) => (
          <a
            class:list={[navPillLink, currentPath === item.href && navPillActive]}
            href={item.href}
          >
            {item.label}
          </a>
        ))
      }
    </div>

    <div class="hidden lg:group-[.nav-scrolled]:flex gap-7 items-center">
      {
        items.map((item) => (
          <a
            class:list={[navFlatLink, currentPath === item.href && '!text-accent-gold']}
            href={item.href}
          >
            {item.label}
          </a>
        ))
      }
    </div>

    <div class="flex items-center gap-1.5 min-[400px]:gap-2 shrink-0 justify-self-end group-[.nav-scrolled]:justify-self-auto">
      <a
        href={ctaHref}
        class="bg-accent-gold text-ink-dark px-2.5 min-[400px]:px-4 py-2 sm:px-5 sm:py-2.5 rounded-full text-[0.6875rem] min-[400px]:text-xs sm:text-sm font-bold hover:shadow-gold hover:scale-105 transition-all active:scale-95 shadow-soft whitespace-nowrap"
      >
        Nhận Báo Giá
      </a>
      <button
        type="button"
        class={menuToggle}
        aria-expanded="false"
        aria-controls="site-nav-mobile"
        aria-label="Mở menu điều hướng"
      >
        <span class="material-symbols-outlined" aria-hidden="true">menu</span>
      </button>
    </div>
  </div>
</nav>

<script is:inline>
(function () {
  var n = document.getElementById('site-nav');
  if (!n) return;
  if (window.pageYOffset > 60) n.classList.add('nav-scrolled');
  requestAnimationFrame(function () {
    requestAnimationFrame(function () {
      n.classList.remove('no-transition');
    });
  });
})();
</script>

<div
  id="site-nav-mobile"
  class="group/mobile lg:hidden fixed inset-0 z-[60] h-dvh pointer-events-none invisible overflow-hidden [&.is-open]:pointer-events-auto [&.is-open]:visible"
  aria-hidden="true"
>
  <div
    class="absolute inset-0 bg-ink-dark/45 opacity-0 transition-opacity duration-[280ms] ease-out group-[.is-open]/mobile:opacity-100"
    data-nav-close
    tabindex="-1"
  >
  </div>
  <nav
    class="absolute top-0 bottom-0 flex h-dvh w-[min(20rem,calc(100vw-1.25rem))] flex-col pr-[env(safe-area-inset-right,0)] bg-[#f8faf9] shadow-[-12px_0_40px_rgba(14,38,64,0.16)] overflow-x-hidden transition-[right] duration-[320ms] ease-nav-panel -right-[min(20rem,calc(100vw-1.25rem))] group-[.is-open]/mobile:right-0"
    aria-label="Menu điều hướng"
  >
    <header
      class="relative z-[2] flex shrink-0 items-center justify-between gap-3 px-4 pt-[calc(0.75rem+env(safe-area-inset-top,0))] pb-4 bg-gradient-to-br from-ink-dark from-0% via-[#163a5c] via-[58%] to-[#1a4569] to-100% after:absolute after:left-0 after:right-0 after:bottom-0 after:h-[3px] after:bg-gradient-to-r after:from-accent-gold after:via-[#ffe08a] after:to-accent-gold"
    >
      <SiteBrandLogo onDark navClose />
      <button
        type="button"
        class="flex shrink-0 items-center justify-center w-9 h-9 border border-white/[0.18] rounded-[0.625rem] bg-white/[0.08] text-white cursor-pointer transition-colors hover:bg-white/[0.16]"
        aria-label="Đóng menu"
        data-nav-close
      >
        <span class="material-symbols-outlined" aria-hidden="true">close</span>
      </button>
    </header>

    <ul class="list-none m-0 flex min-h-0 flex-1 flex-col gap-[2rem] overflow-y-auto overscroll-y-contain touch-pan-y [-webkit-overflow-scrolling:touch] px-3.5 pt-[2.5rem] pb-1">
      {
        items.map((item, index) => (
          <li
            class="opacity-0 translate-x-3 group-[.is-open]/mobile:animate-navItemIn"
            style={`animation-delay: calc(0.04s * ${index} + 0.08s)`}
          >
            <a
              class:list={[
                'block px-2.5 py-3 rounded-xl no-underline text-ink-dark transition-[background,transform] hover:bg-white',
                currentPath === item.href && 'bg-white shadow-[0_2px_12px_rgba(14,38,64,0.06)]',
              ]}
              href={item.href}
            >
              <span class="flex flex-col gap-0.5 min-w-0">
                <span class="text-[0.9375rem] font-bold leading-snug">{item.label}</span>
                {item.desc && (
                  <span class="text-xs font-medium text-text-muted leading-snug max-h-[700px]:text-[0.6875rem]">
                    {item.desc}
                  </span>
                )}
              </span>
            </a>
          </li>
        ))
      }
    </ul>

    <footer
      class="shrink-0 flex flex-col gap-2.5 mt-0 px-3.5 pt-2.5 pb-[calc(0.875rem+env(safe-area-inset-bottom,0))] border-t border-[#e7eeeb] bg-[#f8faf9]"
    >
      <a
        href={siteCta.primaryHref}
        class="block w-full py-3 px-4 rounded-full text-sm font-bold text-center no-underline bg-accent-gold text-ink-dark shadow-[0_4px_14px_rgba(255,201,51,0.35)] transition-[transform,box-shadow,background] active:scale-[0.98]"
        data-nav-close
      >
        {siteCta.primaryLabel}
      </a>
      <a
        href={siteCta.secondaryHref}
        class="block w-full py-3 px-4 rounded-full text-sm font-bold text-center no-underline border border-border-subtle bg-white text-ink-dark transition-[transform,box-shadow,background] active:scale-[0.98]"
        data-nav-close
      >
        {siteCta.secondaryLabel}
      </a>
    </footer>
  </nav>
</div>
