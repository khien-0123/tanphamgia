---
import { mainNavigation, siteCta } from '../data/site';
import { routes } from '../lib/routes';
import {
  navCenterClasses,
  navControlClasses,
  navCtaClasses,
  navEndClasses,
  navInnerClasses,
  navMenuLinkActiveClasses,
  navMenuLinkBaseClasses,
  navMenuLinkInactiveClasses,
  navMenuLabelClasses,
  navMenuTrackClasses,
  navShellClasses,
  navStartClasses,
  navToggleClasses,
  navToggleIconClasses,
} from '../lib/nav-classes';
import SiteBrandLogo from './SiteBrandLogo.astro';

interface NavItem {
  label: string;
  href: string;
  icon?: string;
  desc?: string;
}

interface Props {
  currentPath?: string;
  items?: NavItem[];
  ctaHref?: string;
  /** false = trang nền sáng, dùng flat nav ngay từ đầu */
  navOverDark?: boolean;
}

const {
  currentPath = '',
  items = mainNavigation,
  ctaHref = routes.taiLieu,
  navOverDark = true,
} = Astro.props;
---

<nav
  id="site-nav"
  class:list={[...navShellClasses, 'no-transition', !navOverDark && 'nav-scrolled']}
  data-nav-over-dark={navOverDark ? 'true' : 'false'}
>
  <div class:list={navInnerClasses}>
    <div class={navStartClasses}>
      <SiteBrandLogo class="leading-none bg-white/[0.62] px-3 min-[400px]:px-5 py-1.5 rounded-[1.25rem] backdrop-blur-md shadow-sm group-[.nav-scrolled]:bg-transparent group-[.nav-scrolled]:shadow-none group-[.nav-scrolled]:p-0 group-[.nav-scrolled]:backdrop-blur-none transition-all duration-300" />
    </div>

    <div class={navCenterClasses}>
      <nav class:list={navMenuTrackClasses} aria-label="Menu chính">
        {
          items.map((item) => {
            const isActive = currentPath === item.href;
            return (
              <a
                class:list={[
                  navMenuLinkBaseClasses,
                  isActive ? navMenuLinkActiveClasses : navMenuLinkInactiveClasses,
                ]}
                href={item.href}
              >
                <span class={navMenuLabelClasses}>{item.label}</span>
              </a>
            );
          })
        }
      </nav>
    </div>

    <div class={navEndClasses}>
      <a href={ctaHref} class:list={[navControlClasses, navCtaClasses, 'max-sm:hidden']}>
        Nhận tư vấn
        <span
          class="hidden min-[400px]:flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-[#1f1b17]/15 text-[#1f1b17]"
          aria-hidden="true"
        >
          <span class="material-symbols-outlined text-base leading-none">arrow_forward</span>
        </span>
      </a>
      <button
        type="button"
        class:list={[navControlClasses, navToggleClasses]}
        aria-expanded="false"
        aria-controls="site-nav-mobile"
        aria-label="Mở menu điều hướng"
      >
        <span class={navToggleIconClasses} aria-hidden="true">menu</span>
      </button>
    </div>
  </div>
</nav>

<script is:inline>
(function () {
  var n = document.getElementById('site-nav');
  if (!n) return;
  if (window.pageYOffset > 60) n.classList.add('nav-scrolled');
  requestAnimationFrame(function () {
    requestAnimationFrame(function () {
      n.classList.remove('no-transition');
    });
  });
})();
</script>

<div
  id="site-nav-mobile"
  class="group/mobile lg:hidden fixed inset-0 z-[60] h-dvh pointer-events-none invisible overflow-hidden [&.is-open]:pointer-events-auto [&.is-open]:visible"
  aria-hidden="true"
>
  <div
    class="absolute inset-0 bg-ink-dark/45 opacity-0 transition-opacity duration-[280ms] ease-out group-[.is-open]/mobile:opacity-100"
    data-nav-close
    tabindex="-1"
  >
  </div>
  <nav
    class="absolute top-0 bottom-0 flex h-dvh w-[min(20rem,calc(100vw-1.25rem))] flex-col pr-[env(safe-area-inset-right,0)] bg-background shadow-[-12px_0_40px_rgba(14,38,64,0.16)] overflow-x-hidden transition-[right] duration-[320ms] ease-nav-panel -right-[min(20rem,calc(100vw-1.25rem))] group-[.is-open]/mobile:right-0"
    aria-label="Menu điều hướng"
  >
    <header
      class="relative z-[2] flex shrink-0 items-center justify-between gap-3 px-4 pt-[calc(0.75rem+env(safe-area-inset-top,0))] pb-4 bg-background"
    >
      <SiteBrandLogo navClose />
      <button
        type="button"
        class="flex shrink-0 items-center justify-center w-9 h-9 bg-surface-alt text-ink-dark cursor-pointer transition-colors hover:bg-surface-alt/80"
        aria-label="Đóng menu"
        data-nav-close
      >
        <span class="material-symbols-outlined" aria-hidden="true">close</span>
      </button>
    </header>

    <ul class="list-none m-0 flex min-h-0 flex-1 flex-col gap-[2rem] overflow-y-auto overscroll-y-contain touch-pan-y [-webkit-overflow-scrolling:touch] px-0 pt-[2.5rem] pb-1">
      {
        items.map((item, index) => (
          <li
            class="opacity-0 translate-x-3 group-[.is-open]/mobile:animate-navItemIn"
            style={`animation-delay: calc(0.04s * ${index} + 0.08s)`}
          >
            <a
              class:list={[
                'block w-full py-3 no-underline text-ink-dark transition-colors hover:bg-surface-alt',
                currentPath === item.href && 'bg-surface-alt font-bold',
              ]}
              href={item.href}
            >
              <span class="flex flex-col gap-0.5 min-w-0 px-4">
                <span class="text-[0.9375rem] font-bold leading-snug">{item.label}</span>
                {item.desc && (
                  <span class="text-xs font-medium text-text-muted leading-snug max-h-[700px]:text-[0.6875rem]">
                    {item.desc}
                  </span>
                )}
              </span>
            </a>
          </li>
        ))
      }
    </ul>

    <footer
      class="shrink-0 flex flex-col gap-2.5 mt-0 px-3.5 pt-2.5 pb-[calc(0.875rem+env(safe-area-inset-bottom,0))] border-t border-border-subtle bg-background"
    >
      <a
        href={siteCta.primaryHref}
        class="flex w-full items-center justify-center gap-2.5 py-2 px-4 text-sm font-bold text-center no-underline bg-accent-gold text-ink-dark shadow-[0_4px_14px_rgba(255,201,51,0.35)] transition-[transform,box-shadow,background] active:scale-[0.98]"
        data-nav-close
      >
        Nhận tư vấn
        <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-ink-dark/15 text-ink-dark" aria-hidden="true">
          <span class="material-symbols-outlined text-base leading-none">arrow_forward</span>
        </span>
      </a>
      <a
        href={siteCta.secondaryHref}
        class="block w-full py-3 px-4 text-sm font-bold text-center no-underline bg-surface-alt text-ink-dark transition-[transform,background] active:scale-[0.98]"
        data-nav-close
      >
        {siteCta.secondaryLabel}
      </a>
    </footer>
  </nav>
</div>
