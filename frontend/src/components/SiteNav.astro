---
import { mainNavigation, siteCta } from '../data/site';
import SiteBrandLogo from './SiteBrandLogo.astro';

interface NavItem {
  label: string;
  href: string;
  icon?: string;
  desc?: string;
}

interface Props {
  currentPath?: string;
  solid?: boolean;
  items?: NavItem[];
  ctaHref?: string;
}

const {
  currentPath = '',
  solid = false,
  items = mainNavigation,
  ctaHref = '/tai-lieu',
} = Astro.props;
---

<nav
  id="site-nav"
  class:list={[
    'fixed top-0 w-full z-50 border-b transition-all duration-300',
    solid
      ? 'nav-scrolled bg-white/95 backdrop-blur-lg border-border-subtle shadow-soft'
      : 'bg-white/10 backdrop-blur-lg border-white/15',
  ]}
  data-nav-solid={solid ? 'true' : undefined}
>
  <div
    class="flex justify-between items-center px-6 md:px-8 py-3.5 max-w-container-max-width mx-auto min-w-0"
  >
    <SiteBrandLogo class="shrink-0" />

    <div class="hidden lg:flex gap-7 items-center">
      {
        items.map((item) => (
          <a
            class:list={[
              'nav-link text-sm font-medium transition-colors',
              solid ? 'text-on-surface hover:text-accent-gold' : 'text-white/90 hover:text-accent-gold',
              currentPath === item.href && 'nav-link-active text-accent-gold',
            ]}
            href={item.href}
          >
            {item.label}
          </a>
        ))
      }
    </div>

    <div class="site-nav-actions flex items-center gap-2 shrink-0">
      <a
        href={ctaHref}
        class="site-nav-cta bg-accent-gold text-ink-dark px-4 py-2 sm:px-6 sm:py-2.5 rounded-full text-xs sm:text-sm font-bold hover:shadow-gold hover:scale-105 transition-all active:scale-95 shadow-soft whitespace-nowrap"
      >
        Nhận Báo Giá
      </a>
      <button
        type="button"
        class="site-nav-menu-toggle lg:hidden"
        aria-expanded="false"
        aria-controls="site-nav-mobile"
        aria-label="Mở menu điều hướng"
      >
        <span class="material-symbols-outlined" aria-hidden="true">menu</span>
      </button>
    </div>
  </div>
</nav>

<!-- Menu mobile — panel trượt từ phải -->
<div id="site-nav-mobile" class="site-nav-mobile lg:hidden" aria-hidden="true">
  <div class="site-nav-mobile-backdrop" data-nav-close tabindex="-1"></div>
  <nav class="site-nav-mobile-panel" aria-label="Menu điều hướng">
    <header class="site-nav-mobile-hero">
      <SiteBrandLogo onDark navClose />
      <button
        type="button"
        class="site-nav-menu-close"
        aria-label="Đóng menu"
        data-nav-close
      >
        <span class="material-symbols-outlined" aria-hidden="true">close</span>
      </button>
    </header>

    <ul class="site-nav-mobile-list">
      {
        items.map((item, index) => (
          <li class="site-nav-mobile-item" style={`--nav-i: ${index}`}>
            <a
              class:list={[
                'site-nav-mobile-link',
                currentPath === item.href && 'site-nav-mobile-link-active',
              ]}
              href={item.href}
            >
              <span class="site-nav-mobile-link-text">
                <span class="site-nav-mobile-link-label">{item.label}</span>
                {item.desc && <span class="site-nav-mobile-link-desc">{item.desc}</span>}
              </span>
            </a>
          </li>
        ))
      }
    </ul>

    <footer class="site-nav-mobile-footer">
      <a href={siteCta.primaryHref} class="site-nav-mobile-cta site-nav-mobile-cta--primary" data-nav-close>
        {siteCta.primaryLabel}
      </a>
      <a href={siteCta.secondaryHref} class="site-nav-mobile-cta site-nav-mobile-cta--secondary" data-nav-close>
        {siteCta.secondaryLabel}
      </a>
    </footer>
  </nav>
</div>
