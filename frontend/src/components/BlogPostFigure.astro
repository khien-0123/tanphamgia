---
/** Ảnh bài viết — khung 4:3, ưu tiên giữ phần trên khi ảnh dọc */
import SiteImage from './SiteImage.astro';
import { blogThumbFrame, blogThumbImg } from '../lib/image-frame';

interface Props {
  src: string;
  alt: string;
  class?: string;
  imgClass?: string;
  loading?: 'lazy' | 'eager';
  sizes?: string;
}

const { src, alt, class: className = '', imgClass = '', loading = 'lazy', sizes } = Astro.props;

const figureClass = [blogThumbFrame, className].filter(Boolean).join(' ');

const imageClass = [blogThumbImg, imgClass].filter(Boolean).join(' ');
---

<figure class={figureClass}>
  <SiteImage
    src={src}
    alt={alt}
    class={imageClass}
    loading={loading}
    variant="thumb"
    sizes={sizes ?? '(max-width: 767px) 100vw, (max-width: 1023px) 50vw, 33vw'}
  />
</figure>
