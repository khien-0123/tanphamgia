---
import SiteImage from './SiteImage.astro';
import { sectionEyebrow } from '../lib/section-eyebrow';
import { sectionTitleOnDark } from '../lib/section-typography';
import { RHYTHM_WHITE, sectionPy } from '../lib/section-rhythm';
import type { Testimonial } from '../data/site';
import SliderArrow from './SliderArrow.astro';

interface Props {
  items: Testimonial[];
  title?: string;
  variant?: 'light' | 'dark';
  sectionBg?: string;
}

const { items, title = 'Khách hàng nói gì về chúng tôi', variant = 'light', sectionBg } = Astro.props;

const isDark = variant === 'dark';

/** Lấy 1–2 chữ cái viết tắt làm placeholder avatar */
function getInitials(name: string): string {
  const cleaned = name.replace(/^(Ông|Bà|Anh|Chị)\s+/i, '').trim();
  const parts = cleaned.split(/\s+/).filter(Boolean);
  if (parts.length >= 2) {
    return `${parts[0]![0] ?? ''}${parts[parts.length - 1]![0] ?? ''}`.toUpperCase();
  }
  return cleaned.slice(0, 2).toUpperCase() || '?';
}

/** 3 bộ slide — vòng lặp vô hạn + autoplay */
const SLIDER_SETS = 3;
const sliderItems = Array.from({ length: SLIDER_SETS }, () => items).flat();
const itemsPerSet = items.length;

const sectionClass = isDark
  ? `${sectionPy} bg-[#0d1b3a] text-white`
  : [sectionPy, sectionBg ?? RHYTHM_WHITE];
---

<section class:list={sectionClass} aria-labelledby="testimonials-title">
  <div class="mx-auto max-w-container-max-width px-6 md:px-8">
    {
      isDark ? (
        <header>
          <p class={sectionEyebrow}>Ý kiến khách hàng</p>
          <h2 id="testimonials-title" class:list={['mt-5 max-w-[18ch]', sectionTitleOnDark]}>
            {title}
          </h2>
        </header>
      ) : (
        <h2
          id="testimonials-title"
          data-reveal
          class="font-headline-md mb-10 text-2xl font-bold text-ink-dark md:mb-14 md:text-3xl"
        >
          {title}
        </h2>
      )
    }

    <div
      class:list={[
        'group/slider relative min-w-0 [overflow-anchor:none]',
        isDark && 'mt-10 lg:mt-12',
      ]}
      data-testimonials-slider
      data-reveal={isDark ? true : undefined}
      data-reveal-motion={isDark ? 'fade' : undefined}
    >
      <div
        class:list={[
          'flex snap-x snap-mandatory items-stretch overflow-x-auto overflow-y-hidden overscroll-x-contain pb-1 [-webkit-overflow-scrolling:touch] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden',
          isDark ? 'gap-5 md:gap-6' : 'gap-0 md:gap-12',
        ]}
        data-slider-track
        aria-label={title}
        role="region"
      >
        {
          sliderItems.map((item, index) => {
            const setIndex = Math.floor(index / itemsPerSet);
            const isClone = setIndex !== 1;

            return isDark ? (
              <blockquote
                class="testimonials-dark-card m-0 box-border flex min-w-0 flex-[0_0_100%] flex-col self-stretch snap-start rounded-[1.25rem] bg-white p-6 text-[#1f1b17] shadow-[0_20px_48px_rgba(0,0,0,0.28)] sm:flex-[0_0_calc((100%-1.25rem)/2)] sm:p-7 lg:flex-[0_0_calc((100%-3rem)/3)]"
                data-slider-slide
                aria-hidden={isClone ? 'true' : undefined}
                tabindex={isClone ? -1 : undefined}
              >
                <div class="testimonials-dark-card__body">
                  <span class="block text-3xl font-extrabold leading-none text-[#c18a00]" aria-hidden="true">
                    “
                  </span>
                  <p class="mt-3 text-[0.95rem] font-medium leading-[1.55] text-[#1f1b17] sm:text-base sm:leading-[1.7]">
                    {item.quote}
                  </p>
                </div>
                <footer class="testimonials-dark-card__footer flex items-center gap-3 border-t border-[#ebe6dc]">
                  <div class="flex h-12 w-12 shrink-0 items-center justify-center overflow-hidden rounded-full bg-white p-1.5 ring-2 ring-[#ffc72c]/50">
                    {item.avatar ? (
                      <SiteImage
                        src={item.avatar}
                        alt={item.name}
                        class="h-full w-full object-contain"
                        loading="lazy"
                        variant="card"
                      />
                    ) : (
                      <span class="text-sm font-extrabold tracking-wide text-[#8a6700]" aria-hidden="true">
                        {getInitials(item.name)}
                      </span>
                    )}
                  </div>
                  <div class="min-w-0 flex-1">
                    <cite class="line-clamp-1 block text-base font-extrabold leading-snug not-italic text-[#1f1b17]">
                      {item.name}
                    </cite>
                    <span class="mt-0.5 line-clamp-1 block text-sm leading-snug text-[#6f6a60]">{item.role}</span>
                  </div>
                </footer>
              </blockquote>
            ) : (
              <blockquote
                class="testimonial-slide m-0 box-border flex min-w-0 flex-[0_0_100%] flex-col self-stretch snap-start px-1 md:flex-[0_0_calc((100%-6rem)/3)] md:px-0"
                data-slider-slide
                aria-hidden={isClone ? 'true' : undefined}
                tabindex={isClone ? -1 : undefined}
              >
                <p class="testimonial-slide__quote mb-0 italic leading-relaxed text-text-muted">
                  "{item.quote}"
                </p>
                <footer class="testimonial-slide__footer flex items-center gap-3 not-italic">
                  <div class="flex h-11 w-11 shrink-0 items-center justify-center overflow-hidden rounded-full bg-white p-1.5 ring-2 ring-[#ffc72c]/40">
                    {item.avatar ? (
                      <SiteImage
                        src={item.avatar}
                        alt={item.name}
                        class="h-full w-full object-contain"
                        loading="lazy"
                        variant="card"
                      />
                    ) : (
                      <span class="text-xs font-extrabold text-[#8a6700]" aria-hidden="true">
                        {getInitials(item.name)}
                      </span>
                    )}
                  </div>
                  <div class="min-w-0">
                    <cite class="block font-bold not-italic text-ink-dark">{item.name}</cite>
                    <span class="mt-0.5 block text-sm leading-snug text-text-muted">{item.role}</span>
                  </div>
                </footer>
              </blockquote>
            );
          })
        }
      </div>
      <SliderArrow direction="prev" solid />
      <SliderArrow direction="next" solid />
    </div>
  </div>
</section>

<script src="../scripts/about-testimonials-slider.ts"></script>

<style>
  /* Card tối: 2 hàng cố định → đường kẻ luôn thẳng hàng */
  .testimonials-dark-card {
    display: grid;
    grid-template-rows: 10.75rem 5.25rem;
    height: 100%;
    box-sizing: border-box;
  }

  .testimonials-dark-card__body {
    min-height: 0;
    overflow: hidden;
  }

  .testimonials-dark-card__body p {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 5;
    overflow: hidden;
  }

  .testimonials-dark-card__footer {
    box-sizing: border-box;
    height: 100%;
    padding-top: 1.25rem;
    min-width: 0;
  }

  @media (min-width: 640px) {
    .testimonials-dark-card {
      grid-template-rows: 11.5rem 5.25rem;
    }
  }

  .testimonial-slide {
    display: flex;
    flex-direction: column;
  }

  .testimonial-slide__quote {
    flex: 1 1 auto;
    margin-bottom: 1.5rem;
  }

  .testimonial-slide__footer {
    flex-shrink: 0;
    margin-top: auto;
  }

  @media (min-width: 768px) {
    .testimonial-slide__quote {
      flex: 1 1 0;
      min-height: 7.5rem;
    }
  }
</style>
