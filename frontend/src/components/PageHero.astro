---
import SiteImage from './SiteImage.astro';
import { siteAssets } from '../data/assets';
import { routes } from '../lib/routes';
import {
  pageHeroDescription,
  pageHeroImage,
  pageHeroInner,
  pageHeroScrim,
  pageHeroShell,
  pageHeroTitle,
} from '../lib/page-hero-shell';

interface Props {
  title: string;
  description?: string;
  /** Ngắt dòng mô tả trên mobile — tránh chữ rớt hàng lẻ */
  descriptionLines?: readonly [string, string];
  breadcrumb?: { label: string; href?: string }[];
  /** Ảnh nền hero — khớp chủ đề từng trang (xem pageHeroBg trong site.ts) */
  bgImage?: string;
}

const {
  title,
  description,
  descriptionLines,
  breadcrumb = [{ label: 'Trang chủ', href: routes.home }],
  bgImage = siteAssets.hero.fallback,
} = Astro.props;
---

<header data-page-hero class:list={[pageHeroShell, 'text-white']}>
  <SiteImage alt="" class={pageHeroImage} src={bgImage} loading="eager" decoding="async" variant="hero" />
  <div class={pageHeroScrim} aria-hidden="true"></div>

  <div class={pageHeroInner}>
    {
      breadcrumb.length > 0 && (
        <nav aria-label="Breadcrumb" class="text-sm text-white/60">
          {breadcrumb.map((item, i) => (
            <>
              {i > 0 && <span class="mx-2">/</span>}
              {item.href ? (
                <a class="hover:text-accent-gold transition-colors" href={item.href}>
                  {item.label}
                </a>
              ) : (
                <span class="text-white">{item.label}</span>
              )}
            </>
          ))}
        </nav>
      )
    }

    <div>
      <h1 class:list={[pageHeroTitle, 'mb-5 md:mb-6']}>
        {title}
      </h1>
      {
        description && (
          <p
            class:list={[
              pageHeroDescription,
              descriptionLines &&
                'max-md:text-[0.8125rem] max-md:leading-[1.45] max-md:tracking-normal',
            ]}
          >
            {
              descriptionLines ? (
                <>
                  <span class="block md:hidden">{descriptionLines[0]}</span>
                  <span class="block md:hidden">{descriptionLines[1]}</span>
                  <span class="hidden md:inline">{description}</span>
                </>
              ) : (
                description
              )
            }
          </p>
        )
      }
    </div>
  </div>
</header>
