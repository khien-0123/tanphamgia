---
import SiteImage from './SiteImage.astro';
import { siteAssets } from '../data/assets';
import { routes } from '../lib/routes';
import {
  pageHeroBreadcrumb,
  pageHeroCopy,
  pageHeroDescription,
  pageHeroImage,
  pageHeroInner,
  pageHeroScrim,
  pageHeroShell,
  pageHeroTitle,
} from '../lib/page-hero-shell';

interface HeroStat {
  value: string;
  label: string;
  suffix?: string;
}

interface Props {
  title: string;
  titleLines?: readonly [string, string];
  description?: string;
  /** Ngắt dòng mô tả trên mobile — tránh chữ rớt hàng lẻ */
  descriptionLines?: readonly [string, string];
  breadcrumb?: { label: string; href?: string }[];
  stats?: HeroStat[];
  /** Ảnh nền hero — khớp chủ đề từng trang (xem pageHeroBg trong site.ts) */
  bgImage?: string;
}

const {
  title,
  titleLines,
  description,
  descriptionLines,
  breadcrumb = [{ label: 'Trang chủ', href: routes.home }],
  stats = [],
  bgImage = siteAssets.hero.fallback,
} = Astro.props;
---

<header data-page-hero class:list={[pageHeroShell, 'text-white']}>
  <SiteImage alt="" class={pageHeroImage} src={bgImage} loading="eager" decoding="async" variant="hero" />
  <div class={pageHeroScrim} aria-hidden="true"></div>

  <div class={pageHeroInner}>
    <div class={pageHeroCopy}>
      {
        breadcrumb.length > 0 && (
          <nav aria-label="Breadcrumb" class={pageHeroBreadcrumb}>
            {breadcrumb.map((item, i) => (
              <>
                {i > 0 && <span class="mx-1.5">/</span>}
                {item.href ? (
                  <a class="inline-flex min-h-6 items-center transition-colors hover:text-[#3f2d00]" href={item.href}>
                    {item.label}
                  </a>
                ) : (
                  <span>{item.label}</span>
                )}
              </>
            ))}
          </nav>
        )
      }
      <h1 class={pageHeroTitle}>
        {titleLines ? (
          <>
            <span class="block">{titleLines[0]}</span>
            <span class="block">{titleLines[1]}</span>
          </>
        ) : (
          title
        )}
      </h1>
      {
        description && (
          <p class={pageHeroDescription}>
            {descriptionLines ? (
              <>
                <span class="block md:hidden">{descriptionLines[0]}</span>
                <span class="block md:hidden">{descriptionLines[1]}</span>
                <span class="hidden md:inline">{description}</span>
              </>
            ) : (
              description
            )}
          </p>
        )
      }
    </div>

    {
      stats.length > 0 && (
        <dl class="flex flex-wrap gap-x-10 gap-y-5 border-t border-white/15 pt-6 max-md:gap-x-7">
          {stats.map((stat) => (
            <div class="min-w-0">
              <dt class="whitespace-nowrap text-2xl font-extrabold leading-none tracking-[-0.03em] tabular-nums sm:text-[2rem]">
                {stat.value}
                {stat.suffix && <span class="text-[#ffc72c]">{stat.suffix}</span>}
              </dt>
              <dd class="m-0 mt-2 text-[0.65rem] font-bold uppercase tracking-[0.18em] text-white/65 sm:text-[0.7rem]">
                {stat.label}
              </dd>
            </div>
          ))}
        </dl>
      )
    }
  </div>
</header>
