---
import type { Testimonial } from '../data/site';

interface Props {
  items: Testimonial[];
  title?: string;
}

const { items, title = 'Khách hàng nói gì về chúng tôi' } = Astro.props;

/** 3 bộ slide để vòng lặp vô hạn */
const SLIDER_SETS = 3;
const sliderItems = Array.from({ length: SLIDER_SETS }, () => items).flat();
const itemsPerSet = items.length;
---

<section class="py-10 md:py-24 bg-ink-dark text-white">
  <div class="max-w-container-max-width mx-auto px-6 md:px-8">
    <h2 class="font-headline-md text-2xl md:text-4xl font-bold mb-12 md:mb-14">
      {title}
    </h2>
    <div class="min-w-0 [overflow-anchor:none]" data-testimonials-slider>
      <div
        class="flex items-stretch gap-0 md:gap-12 overflow-x-auto overflow-y-hidden snap-x snap-mandatory overscroll-x-contain [-webkit-overflow-scrolling:touch] [scrollbar-width:none] pb-1 [&::-webkit-scrollbar]:hidden"
        data-slider-track
        aria-label={title}
        role="region"
      >
        {
          sliderItems.map((t, index) => {
            const setIndex = Math.floor(index / itemsPerSet);
            const isClone = setIndex !== 1;

            return (
              <blockquote
                class="flex-[0_0_100%] md:flex-[0_0_calc((100%-6rem)/3)] snap-start min-w-0 box-border px-1 md:px-0 self-stretch m-0 flex flex-col h-auto md:h-full border-l-[3px] border-accent-gold pl-5 md:border-l-0 md:pl-0 [&>p]:flex-1 [&>footer]:mt-auto [&>footer]:shrink-0"
                data-slider-slide
                aria-hidden={isClone ? 'true' : undefined}
                tabindex={isClone ? -1 : undefined}
              >
                <p class="text-white/90 leading-relaxed mb-6">"{t.quote}"</p>
                <footer>
                  <cite class="not-italic font-bold text-accent-gold block">{t.name}</cite>
                  <span class="text-white/60 text-sm mt-1 block">{t.role}</span>
                </footer>
              </blockquote>
            );
          })
        }
      </div>
    </div>
  </div>
</section>

<script src="../scripts/about-testimonials-slider.ts"></script>
