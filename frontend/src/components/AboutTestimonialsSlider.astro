---
import type { Testimonial } from '../data/site';

interface Props {
  items: Testimonial[];
  title?: string;
}

const { items, title = 'Khách hàng nói gì về chúng tôi' } = Astro.props;

/** 3 bộ slide để vòng lặp vô hạn */
const SLIDER_SETS = 3;
const sliderItems = Array.from({ length: SLIDER_SETS }, () => items).flat();
const itemsPerSet = items.length;
---

<section class="about-testimonials py-10 md:py-24 bg-ink-dark text-white">
  <div class="max-w-container-max-width mx-auto px-6 md:px-8">
    <h2 class="font-headline-md text-2xl md:text-4xl font-bold mb-12 md:mb-14">
      {title}
    </h2>
    <div class="about-testimonials-slider-wrap" data-testimonials-slider>
      <div class="about-testimonials-slider" aria-label={title} role="region">
        {
          sliderItems.map((t, index) => {
            const setIndex = Math.floor(index / itemsPerSet);
            const isClone = setIndex !== 1;

            return (
              <blockquote
                class="about-testimonials-slide about-quote m-0"
                aria-hidden={isClone ? 'true' : undefined}
                tabindex={isClone ? -1 : undefined}
              >
                <p class="text-white/90 leading-relaxed mb-6">"{t.quote}"</p>
                <footer>
                  <cite class="not-italic font-bold text-accent-gold block">{t.name}</cite>
                  <span class="text-white/60 text-sm mt-1 block">{t.role}</span>
                </footer>
              </blockquote>
            );
          })
        }
      </div>
    </div>
  </div>
</section>

<script src="../scripts/about-testimonials-slider.ts"></script>
