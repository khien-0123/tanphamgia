---
interface Certificate {
  title: string;
  image: string;
}

interface Props {
  items: Certificate[];
  /** Căn giữa tiêu đề trên trang chủ */
  centeredTitle?: boolean;
}

const { items, centeredTitle = false } = Astro.props;

/** 2 cột — mỗi cột lệch thứ tự để cuộn khác nhau */
function buildColumns(certs: Certificate[]) {
  return [0, 1].map((offset) =>
    certs.map((_, index) => certs[(index + offset) % certs.length]),
  );
}

const columns = buildColumns(items);
---

<section class="py-8 md:py-10 bg-white overflow-hidden" id="chung-nhan">
  <div class="max-w-container-max-width mx-auto px-6 md:px-8">
    <header
      class:list={[
        'mb-5 md:mb-6 max-w-2xl',
        centeredTitle && 'mx-auto text-center',
      ]}
      data-reveal
    >
      <h2 class="font-headline-md text-2xl md:text-3xl font-bold text-ink-dark tracking-tight">
        Giấy khen & Chứng nhận
      </h2>
      {
        centeredTitle && (
          <p class="mt-3 text-sm md:text-base text-text-muted leading-relaxed">
            Hệ thống quản lý chất lượng và các chứng nhận uy tín đồng hành cùng Tân Phạm Gia.
          </p>
        )
      }
    </header>

    <div class="certificate-marquee">
      <div class="certificate-marquee__columns">
        {
          columns.map((column, columnIndex) => (
            <div
              class:list={[
                'certificate-marquee__column',
                columnIndex === 1 && 'certificate-marquee__column--secondary',
              ]}
            >
              <div
                class:list={[
                  'certificate-marquee__track',
                  columnIndex === 0
                    ? 'certificate-marquee__track--15'
                    : 'certificate-marquee__track--19',
                ]}
              >
                {[...column, ...column].map((cert) => (
                  <figure class="certificate-marquee__card">
                    <img
                      alt={cert.title}
                      class="certificate-marquee__image"
                      loading="lazy"
                      src={cert.image}
                    />
                    <figcaption class="certificate-marquee__caption">{cert.title}</figcaption>
                  </figure>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  /* Port từ testimonials-columns-1 (21st.dev) — cuộn dọc vô hạn */
  @keyframes certificate-column-scroll {
    from {
      transform: translate3d(0, 0, 0);
    }
    to {
      transform: translate3d(0, -50%, 0);
    }
  }

  .certificate-marquee {
    min-height: 0;
  }

  .certificate-marquee__columns {
    display: flex;
    justify-content: center;
    align-items: stretch;
    gap: 1rem;
    height: 280px;
    max-height: 42vh;
    overflow: hidden;
    mask-image: linear-gradient(to bottom, transparent, black 22%, black 78%, transparent);
    -webkit-mask-image: linear-gradient(
      to bottom,
      transparent,
      black 22%,
      black 78%,
      transparent
    );
  }

  @media (min-width: 768px) {
    .certificate-marquee__columns {
      gap: 1.5rem;
      height: 400px;
      max-height: 52vh;
    }
  }

  @media (min-width: 1024px) {
    .certificate-marquee__columns {
      height: 440px;
      max-height: 55vh;
    }
  }

  .certificate-marquee__column {
    position: relative;
    width: 100%;
    max-width: 13.5rem;
    height: 100%;
    min-height: 0;
    flex-shrink: 0;
    overflow: hidden;
  }

  @media (min-width: 768px) {
    .certificate-marquee__column {
      max-width: 15rem;
    }
  }

  @media (min-width: 1024px) {
    .certificate-marquee__column {
      max-width: 17rem;
    }
  }

  .certificate-marquee__column--secondary {
    display: none;
  }

  @media (min-width: 768px) {
    .certificate-marquee__column--secondary {
      display: block;
    }
  }

  .certificate-marquee__track {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    padding-bottom: 0.875rem;
    will-change: transform;
  }

  @media (min-width: 768px) {
    .certificate-marquee__track {
      gap: 1.25rem;
      padding-bottom: 1.25rem;
    }
  }

  @media (min-width: 1024px) {
    .certificate-marquee__track {
      gap: 1.25rem;
      padding-bottom: 1.25rem;
    }
  }

  .certificate-marquee__track--15 {
    animation: certificate-column-scroll 15s linear infinite;
  }

  .certificate-marquee__track--19 {
    animation: certificate-column-scroll 19s linear infinite;
  }

  .certificate-marquee__track:hover {
    animation-play-state: paused;
  }

  .certificate-marquee__card {
    margin: 0;
    width: 100%;
  }

  .certificate-marquee__image {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border-radius: 0.875rem;
    box-shadow: 0 4px 24px -4px rgba(14, 38, 64, 0.08);
    outline: 1px solid rgba(220, 229, 226, 0.8);
  }

  .certificate-marquee__caption {
    margin-top: 0.5rem;
    font-size: 0.8125rem;
    font-weight: 600;
    line-height: 1.3;
    color: #0e2640;
  }

  @media (prefers-reduced-motion: reduce) {
    .certificate-marquee__track {
      animation: none !important;
      transform: none !important;
    }

    .certificate-marquee__columns {
      height: auto;
      max-height: min(50vh, 400px);
      flex: none;
    }
  }
</style>
