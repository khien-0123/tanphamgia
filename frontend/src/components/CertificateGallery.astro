---
import { RHYTHM_ALT, RHYTHM_WHITE } from '../lib/section-rhythm';

interface Certificate {
  title: string;
  image: string;
}

interface Props {
  items: Certificate[];
  /** Căn giữa tiêu đề trên trang chủ */
  centeredTitle?: boolean;
  /** Nền section — xen kẽ xám/trắng */
  sectionBg?: string;
  /** @deprecated Dùng sectionBg */
  alternateSectionBg?: boolean;
}

const {
  items,
  centeredTitle = false,
  sectionBg,
  alternateSectionBg = false,
} = Astro.props;

const resolvedSectionBg = sectionBg ?? (alternateSectionBg ? RHYTHM_ALT : RHYTHM_WHITE);

/** Chia đều N chứng nhận vào N cột */
function buildColumns(certs: Certificate[], colCount: number) {
  return Array.from({ length: colCount }, (_, colIndex) => {
    const column: Certificate[] = [];
    for (let i = colIndex; i < certs.length; i += colCount) {
      column.push(certs[i]);
    }
    return column;
  });
}

const mobileColumns = [items];
const tabletColumns = buildColumns(items, 2);
const desktopColumns = buildColumns(items, 3);

const speedClasses = [
  'certificate-marquee__track--14',
  'certificate-marquee__track--18',
  'certificate-marquee__track--22',
] as const;
---

<section
  class:list={[
    'pt-16 pb-8 md:pt-20 md:pb-10 overflow-hidden w-full',
    resolvedSectionBg,
  ]}
  id="chung-nhan"
>
  <div class="max-w-container-max-width mx-auto px-6 md:px-8">
    <header
      class:list={[
        'mb-5 md:mb-6 max-w-2xl',
        centeredTitle && 'mx-auto text-center',
      ]}
      data-reveal
    >
      <h2 class="font-headline-md text-2xl md:text-3xl font-bold text-ink-dark tracking-normal">
        Giấy khen & Chứng nhận
      </h2>
      {
        centeredTitle && (
          <p class="mt-3 text-sm md:text-base text-text-muted leading-relaxed">
            Hệ thống quản lý chất lượng và các chứng nhận uy tín đồng hành cùng Tân Phạm Gia.
          </p>
        )
      }
    </header>

    <div class="certificate-marquee">
      {/* Mobile — 1 cột cuộn đủ {items.length} chứng nhận */}
      <div class="certificate-marquee__columns certificate-marquee__columns--mobile">
        {
          mobileColumns.map((column) => (
            <div class="certificate-marquee__column">
              <div class="certificate-marquee__track certificate-marquee__track--16">
                {[...column, ...column].map((cert) => (
                  <figure class="certificate-marquee__card">
                    <img
                      alt={cert.title}
                      class="certificate-marquee__image"
                      loading="lazy"
                      src={cert.image}
                    />
                    <figcaption class="certificate-marquee__caption">{cert.title}</figcaption>
                  </figure>
                ))}
              </div>
            </div>
          ))
        }
      </div>

      {/* Tablet — 2 cột, mỗi cột 3 chứng nhận */}
      <div class="certificate-marquee__columns certificate-marquee__columns--tablet">
        {
          tabletColumns.map((column, columnIndex) => (
            <div class="certificate-marquee__column">
              <div
                class:list={[
                  'certificate-marquee__track',
                  speedClasses[columnIndex % speedClasses.length],
                ]}
              >
                {[...column, ...column].map((cert) => (
                  <figure class="certificate-marquee__card">
                    <img
                      alt={cert.title}
                      class="certificate-marquee__image"
                      loading="lazy"
                      src={cert.image}
                    />
                    <figcaption class="certificate-marquee__caption">{cert.title}</figcaption>
                  </figure>
                ))}
              </div>
            </div>
          ))
        }
      </div>

      {/* Desktop — 3 cột, mỗi cột 2 chứng nhận → thấy đủ 6 cùng lúc */}
      <div class="certificate-marquee__columns certificate-marquee__columns--desktop">
        {
          desktopColumns.map((column, columnIndex) => (
            <div class="certificate-marquee__column">
              <div
                class:list={[
                  'certificate-marquee__track',
                  speedClasses[columnIndex % speedClasses.length],
                ]}
              >
                {[...column, ...column].map((cert) => (
                  <figure class="certificate-marquee__card">
                    <img
                      alt={cert.title}
                      class="certificate-marquee__image"
                      loading="lazy"
                      src={cert.image}
                    />
                    <figcaption class="certificate-marquee__caption">{cert.title}</figcaption>
                  </figure>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes certificate-column-scroll {
    from {
      transform: translate3d(0, 0, 0);
    }
    to {
      transform: translate3d(0, -50%, 0);
    }
  }

  .certificate-marquee {
    min-height: 0;
  }

  .certificate-marquee__columns {
    display: flex;
    justify-content: center;
    align-items: stretch;
    gap: 1rem;
    height: 460px;
    max-height: 58vh;
    overflow: hidden;
    mask-image: linear-gradient(to bottom, transparent, black 12%, black 88%, transparent);
    -webkit-mask-image: linear-gradient(
      to bottom,
      transparent,
      black 12%,
      black 88%,
      transparent
    );
  }

  .certificate-marquee__columns--mobile {
    display: flex;
  }

  .certificate-marquee__columns--tablet,
  .certificate-marquee__columns--desktop {
    display: none;
  }

  @media (min-width: 640px) {
    .certificate-marquee__columns--mobile {
      display: none;
    }

    .certificate-marquee__columns--tablet {
      display: flex;
    }
  }

  @media (min-width: 1024px) {
    .certificate-marquee__columns--tablet {
      display: none;
    }

    .certificate-marquee__columns--desktop {
      display: flex;
    }
  }

  @media (min-width: 768px) {
    .certificate-marquee__columns {
      gap: 1.5rem;
      height: 580px;
      max-height: 64vh;
    }
  }

  @media (min-width: 1024px) {
    .certificate-marquee__columns {
      height: 645px;
      max-height: 72vh;
    }
  }

  .certificate-marquee__column {
    position: relative;
    width: 100%;
    max-width: 16rem;
    height: 100%;
    min-height: 0;
    flex-shrink: 0;
    overflow: hidden;
  }

  @media (min-width: 768px) {
    .certificate-marquee__column {
      max-width: 18rem;
    }
  }

  @media (min-width: 1024px) {
    .certificate-marquee__column {
      max-width: 22rem;
    }
  }

  .certificate-marquee__track {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    padding-bottom: 0.875rem;
  }

  @media (min-width: 768px) {
    .certificate-marquee__track {
      gap: 1.25rem;
      padding-bottom: 1.25rem;
    }
  }

  .certificate-marquee__track--14 {
    animation: certificate-column-scroll 14s linear infinite;
  }

  .certificate-marquee__track--16 {
    animation: certificate-column-scroll 16s linear infinite;
  }

  .certificate-marquee__track--18 {
    animation: certificate-column-scroll 18s linear infinite;
  }

  .certificate-marquee__track--22 {
    animation: certificate-column-scroll 22s linear infinite;
  }

  .certificate-marquee__track:hover {
    animation-play-state: paused;
  }

  .certificate-marquee__card {
    margin: 0;
    width: 100%;
  }

  .certificate-marquee__image {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: contain;
    object-position: center;
    background: #f4f1eb;
    border-radius: 0.25rem;
    box-shadow: 0 4px 24px -4px rgba(14, 38, 64, 0.08);
    outline: 1px solid rgba(220, 229, 226, 0.8);
    image-rendering: auto;
    -webkit-backface-visibility: hidden;
    backface-visibility: hidden;
    transform: translateZ(0);
    filter: contrast(1.05) saturate(1.03);
  }

  .certificate-marquee__caption {
    margin-top: 0.5rem;
    font-size: 0.8125rem;
    font-weight: 600;
    line-height: 1.3;
    color: #0e2640;
  }

  @media (prefers-reduced-motion: reduce) {
    .certificate-marquee__track {
      animation: none !important;
      transform: none !important;
    }

    .certificate-marquee__columns {
      height: auto;
      max-height: none;
      flex: none;
      mask-image: none;
      -webkit-mask-image: none;
    }
  }
</style>
