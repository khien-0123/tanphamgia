---
interface Certificate {
  title: string;
  image: string;
}

interface Props {
  items: Certificate[];
  /** Căn giữa tiêu đề trên trang chủ */
  centeredTitle?: boolean;
}

const { items, centeredTitle = false } = Astro.props;
---

<section class="py-10 md:py-20 bg-white border-b border-border-subtle" id="chung-nhan">
  <div class="max-w-container-max-width mx-auto px-6 md:px-8">
    <div class:list={['mb-8 md:mb-12', centeredTitle && 'text-center']}>
      <h2
        data-reveal
        class="font-headline-md text-2xl md:text-3xl font-bold text-ink-dark"
      >
        Giấy khen & Chứng nhận
      </h2>
    </div>
    <div data-reveal-stagger class="grid grid-cols-2 lg:grid-cols-4 gap-6 md:gap-8">
      {
        items.map((cert) => (
          <figure
            data-reveal
            class:list={[
              'm-0 group',
              !centeredTitle && '[&_img]:transition-opacity [&_img]:duration-200 hover:[&_img]:opacity-[0.92]',
            ]}
          >
            <img
              alt={cert.title}
              class:list={[
                'w-full aspect-[4/3] object-cover rounded-lg',
                centeredTitle && 'transition-opacity duration-200 group-hover:opacity-90',
              ]}
              loading="lazy"
              src={cert.image}
            />
            <figcaption
              class:list={[
                'mt-3 text-sm font-semibold text-ink-dark',
                centeredTitle ? 'text-center md:text-left' : '',
              ]}
            >
              {cert.title}
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>
