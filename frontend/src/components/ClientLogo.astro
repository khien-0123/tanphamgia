---
interface Props {
  name: string;
  logo: string;
  scale?: number;
}

const { name, logo, scale = 1 } = Astro.props;
const imgStyle = scale !== 1 ? `transform: scale(${scale}); transform-origin: center` : undefined;
---

<div
  class="group flex h-14 w-28 sm:h-16 sm:w-32 md:h-16 md:w-36 shrink-0 items-center justify-center bg-transparent transition-opacity duration-200"
  title={name}
>
  <img
    alt={name}
    class="max-h-11 sm:max-h-12 md:max-h-14 max-w-full object-contain object-center opacity-[0.92] transition-opacity duration-200 group-hover:opacity-100"
    style={imgStyle}
    loading="lazy"
    src={logo}
    onerror="this.style.display='none';this.nextElementSibling.style.display='block'"
  />
  <span
    data-logo-fallback
    class="hidden text-[0.65rem] font-bold text-text-muted text-center leading-[1.2] tracking-[0.02em] px-1"
    >{name}</span
  >
</div>
