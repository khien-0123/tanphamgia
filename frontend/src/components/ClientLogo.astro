---
interface Props {
  name: string;
  logo: string;
}

const { name, logo } = Astro.props;
---

<div
  class="group flex h-[4.25rem] w-[6.75rem] sm:w-[7.5rem] shrink-0 items-center justify-center bg-transparent transition-opacity duration-200"
  title={name}
>
  <img
    alt={name}
    class="h-9 max-h-9 w-full max-w-[5.5rem] object-contain object-center opacity-[0.92] transition-opacity duration-200 group-hover:opacity-100"
    loading="lazy"
    src={logo}
    onerror="this.style.display='none';this.nextElementSibling.style.display='block'"
  />
  <span
    data-logo-fallback
    class="hidden text-[0.65rem] font-bold text-text-muted text-center leading-[1.2] tracking-[0.02em] px-1"
    >{name}</span
  >
</div>
