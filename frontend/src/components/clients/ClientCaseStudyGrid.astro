---
import SiteImage from '../SiteImage.astro';
import type { ClientCaseStudy } from '../../data/site';
import {
  caseStudyCarouselSlide,
  caseStudyCarouselTrack,
  caseStudyCarouselViewport,
  caseStudyCarouselShell,
  caseStudyCarouselDots,
  caseStudyDotActive,
  caseStudyDotBase,
  caseStudyDotIdleOnImage,
  caseStudyFeaturedCopy,
  caseStudyFeaturedImage,
  caseStudySecondaryGrid,
  caseStudyStack,
} from '../../lib/case-study-classes';
import ClientCaseStudySecondaryCard from './ClientCaseStudySecondaryCard.astro';
import SliderArrow from '../SliderArrow.astro';
import { RHYTHM_WHITE, sectionPy } from '../../lib/section-rhythm';

interface Props {
  items: ClientCaseStudy[];
  sectionBg?: string;
}

const { items, sectionBg = RHYTHM_WHITE } = Astro.props;

const featured = items[0];
const secondary = items.slice(1);
const useSecondaryCarousel = secondary.length >= 3;
const carouselPages = useSecondaryCarousel
  ? Math.max(1, secondary.length - 1)
  : 0;
---

<section class:list={[sectionPy, 'border-b border-border-subtle', sectionBg]}>
  <div class="max-w-container-max-width mx-auto px-6 md:px-8">
    <h2 data-reveal class="font-headline-md text-2xl md:text-3xl font-bold text-ink-dark mb-10">
      Case study tiêu biểu
    </h2>

    <div class={caseStudyStack}>
      {featured && (
        <article class="border-b border-ink-dark/10">
          <a
            href={featured.href}
            class="group grid md:grid-cols-2 gap-0 no-underline text-inherit"
          >
            <div class:list={caseStudyFeaturedCopy}>
              <p class="text-[11px] font-bold uppercase tracking-[0.14em] text-ink-dark mb-3">
                {featured.tags}
              </p>
              <h3 class="font-headline-md text-xl md:text-2xl lg:text-[1.75rem] font-bold text-ink-dark leading-snug mb-4">
                {featured.title}
              </h3>
              <p class="text-text-muted text-sm md:text-base leading-relaxed mb-6 max-w-prose">
                {featured.excerpt}
              </p>
              <span class="inline-flex items-center gap-2 text-sm font-semibold text-ink-dark group-hover:text-accent-gold transition-colors">
                Case study
                <svg
                  class="w-4 h-4 transition-transform group-hover:translate-x-1"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  aria-hidden="true"
                >
                  <path d="M5 12h14M13 6l6 6-6 6" />
                </svg>
              </span>
            </div>
            <div class:list={caseStudyFeaturedImage}>
              <SiteImage
                src={featured.image}
                alt={featured.alt}
                width={960}
                height={600}
                class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
                loading="lazy"
                decoding="async"
                variant="card"
              />
            </div>
          </a>
        </article>
      )}

      {
        secondary.length > 0 &&
          (useSecondaryCarousel ? (
            <div data-client-case-secondary-carousel>
              <div class:list={caseStudyCarouselShell}>
                <div class:list={caseStudyCarouselViewport} data-carousel-viewport>
                  <div class:list={caseStudyCarouselTrack} data-carousel-track>
                    {secondary.map((item) => (
                      <div class:list={caseStudyCarouselSlide} data-carousel-slide>
                        <ClientCaseStudySecondaryCard item={item} />
                      </div>
                    ))}
                  </div>
                </div>
                <SliderArrow direction="prev" inset solid />
                <SliderArrow direction="next" inset solid />
                <div
                  class:list={caseStudyCarouselDots}
                  role="tablist"
                  aria-label="Chọn nhóm case study phụ"
                >
                  {Array.from({ length: carouselPages }, (_, index) => (
                    <button
                      type="button"
                      role="tab"
                      data-carousel-dot={index}
                      aria-label={`Trang ${index + 1}`}
                      aria-selected={index === 0 ? 'true' : 'false'}
                      class:list={[caseStudyDotBase, index === 0 ? caseStudyDotActive : caseStudyDotIdleOnImage]}
                    />
                  ))}
                </div>
              </div>
            </div>
          ) : (
            <div class:list={caseStudySecondaryGrid}>
              {secondary.map((item, index) => (
                <div class:list={[index === 0 && 'md:border-r border-ink-dark/10']}>
                  <ClientCaseStudySecondaryCard item={item} />
                </div>
              ))}
            </div>
          ))
      }
    </div>
  </div>
</section>

<style>
  /* Căn snap theo đúng nửa viewport — tránh lệch đường kẻ giữa */
  @media (min-width: 768px) {
    [data-carousel-track] > [data-carousel-slide] {
      scroll-snap-align: start;
      scroll-snap-stop: always;
    }
  }
</style>

{useSecondaryCarousel && <script src="../../scripts/client-case-study-carousel.ts"></script>}
