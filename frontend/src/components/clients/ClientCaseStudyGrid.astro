---
/**
 * Listing case study — layout sole (ảnh | chữ xen kẽ)
 * Hàng lẻ (1, 3): nền navy · Hàng chẵn (2): nền sáng
 * Mobile: carousel ngang peek + dots (không autoplay) để rút chiều cao section
 */
import SiteImage from '../SiteImage.astro';
import type { ClientCaseStudy } from '../../data/site';
import { siteAssets } from '../../data/assets';
import { sectionEyebrow } from '../../lib/section-eyebrow';
import { getClientLogoScale } from '../../lib/client-logo-scale';
import { sectionPy } from '../../lib/section-rhythm';
import {
  sectionBody,
  sectionCardTitle,
  sectionTitleOnLight,
  textOnDarkTitle,
  textOnLightBodyMuted,
  textOnLightTitle,
} from '../../lib/section-typography';

interface Props {
  items: ClientCaseStudy[];
  sectionBg?: string;
  eyebrow?: string;
  title?: string;
}

const {
  items,
  sectionBg = 'bg-[#fbf8f1]',
  eyebrow = 'Dự án tiêu biểu',
  title = 'Case study tiêu biểu',
} = Astro.props;

/** Desktop: khung ảnh cao theo cột chữ (stretch), ảnh absolute phủ kín — không kẹp overflow bài */
const imageFrameClass =
  'relative isolate overflow-hidden bg-[#ebe4d6] max-md:aspect-[4/3] md:min-h-[26rem] lg:min-h-[30rem]';
const imageClass =
  'h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.03] max-md:static md:absolute md:inset-0 md:h-full md:w-full';
---

<section
  class:list={[sectionPy, sectionBg]}
  aria-labelledby="client-cs-title"
  data-client-cs-carousel
>
  <div class="mx-auto max-w-container-max-width px-6 md:px-8">
    <header class="mb-10 md:mb-16">
      <p class={sectionEyebrow}>{eyebrow}</p>
      <h2 id="client-cs-title" class:list={['mt-5 max-w-[18ch]', sectionTitleOnLight]}>
        {title}
      </h2>
    </header>

    <div
      class="client-cs-track flex snap-x snap-mandatory gap-0 overflow-x-auto overflow-y-hidden overscroll-x-contain pb-1 [-webkit-overflow-scrolling:touch] [scrollbar-width:none] md:snap-none md:flex-col md:overflow-visible md:pb-0 [&::-webkit-scrollbar]:hidden"
      data-client-cs-track
      role="region"
      aria-roledescription="carousel"
      aria-label={title}
    >
      {
        items.map((item, index) => {
          const imageLeft = index % 2 === 0;
          const isNavy = index % 2 === 0;
          const href = item.href ?? '#';

          return (
            <article
              class:list={[
                'group overflow-hidden last:border-b-0 md:min-w-0 md:rounded-none',
                'max-md:box-border max-md:w-full max-md:min-w-full max-md:basis-full max-md:shrink-0 max-md:grow-0 max-md:snap-start max-md:rounded-[1.25rem]',
                'md:w-full md:basis-auto md:shrink',
                isNavy
                  ? 'border-b border-white/10 bg-[#0d1b3a] max-md:border-b-0'
                  : 'border-b border-[#e8dfcf] bg-transparent max-md:border max-md:border-[#e8dfcf]',
              ]}
              data-client-cs-slide
              aria-label={`${index + 1} / ${items.length}: ${item.client}`}
            >
              <div class="grid min-w-0 grid-cols-1 md:grid-cols-2 md:items-stretch">
                {imageLeft && (
                  <div class:list={[imageFrameClass, 'max-md:order-1']}>
                    <SiteImage
                      src={item.image}
                      alt={item.alt}
                      width={960}
                      height={720}
                      class={imageClass}
                      loading="lazy"
                      decoding="async"
                      variant="card"
                      sizes="(min-width: 768px) 50vw, 85vw"
                    />
                  </div>
                )}

                <div
                  class:list={[
                    'flex min-w-0 flex-col px-5 py-6 sm:px-6 md:order-none md:p-6 lg:p-8 max-md:order-2',
                    isNavy ? 'bg-[#0d1b3a]' : 'bg-transparent',
                  ]}
                >
                  <div class="flex min-w-0 items-start justify-between gap-3">
                    <div class="flex min-w-0 flex-1 items-center overflow-hidden">
                      {item.logo?.includes('/brand/') && isNavy ? (
                        <div class="flex min-w-0 items-center gap-2.5" aria-label="Tân Phạm Gia">
                          <SiteImage
                            src={siteAssets.brand.mark}
                            alt=""
                            width={40}
                            height={40}
                            class="h-8 w-8 shrink-0 object-contain"
                            loading="lazy"
                            decoding="async"
                            variant="logo"
                          />
                          <span class="truncate text-[0.7rem] font-extrabold uppercase leading-none tracking-[0.14em] text-white sm:text-xs">
                            TAN PHAM GIA
                          </span>
                        </div>
                      ) : item.logo ? (
                        <SiteImage
                          src={item.logo}
                          alt=""
                          width={180}
                          height={48}
                          class="h-8 w-auto max-w-[min(9rem,45vw)] object-contain object-left"
                          style={`transform: scale(${getClientLogoScale(item.logo)}); transform-origin: left center;`}
                          loading="lazy"
                          decoding="async"
                          variant="logo"
                        />
                      ) : item.logoMark ? (
                        <SiteImage
                          src={item.logoMark}
                          alt=""
                          width={48}
                          height={48}
                          class="h-10 w-10 object-contain"
                          style={`transform: scale(${getClientLogoScale(item.logoMark)}); transform-origin: center;`}
                          loading="lazy"
                          decoding="async"
                          variant="logo"
                        />
                      ) : (
                        <span
                          class:list={[
                            'truncate text-sm font-extrabold',
                            isNavy ? textOnDarkTitle : textOnLightTitle,
                          ]}
                        >
                          {item.client}
                        </span>
                      )}
                    </div>
                    <span
                      class:list={[
                        'shrink-0 rounded-full px-3 py-1 text-[0.65rem] font-extrabold',
                        isNavy ? 'bg-[#ffc72c] text-[#0d1b3a]' : 'bg-[#0d1b3a] text-white',
                      ]}
                    >
                      {item.badge}
                    </span>
                  </div>

                  <h3
                    class:list={[
                      'mt-4 break-words',
                      sectionCardTitle,
                      isNavy ? textOnDarkTitle : textOnLightTitle,
                    ]}
                  >
                    {item.client}
                  </h3>

                  <div
                    class:list={[
                      'mt-4 grid grid-cols-2 gap-3 border-b pb-4 sm:gap-4',
                      isNavy ? 'border-white/15' : 'border-[#e8dfcf]',
                    ]}
                  >
                    {item.metrics.map((m) => (
                      <div class="min-w-0">
                        <p
                          class:list={[
                            'break-words text-lg font-extrabold leading-none tabular-nums text-[#ffc72c] sm:text-xl md:text-2xl',
                          ]}
                        >
                          {m.value}
                        </p>
                        <p class:list={['mt-1 break-words text-xs', isNavy ? 'text-white/55' : textOnLightBodyMuted]}>
                          {m.label}
                        </p>
                      </div>
                    ))}
                  </div>

                  <p
                    class:list={[
                      'mt-4 text-sm leading-relaxed',
                      isNavy ? textOnDarkTitle : sectionBody,
                    ]}
                  >
                    {item.intro}
                  </p>

                  <div
                    class:list={[
                      'mt-5 grid grid-cols-1 gap-5 border-t pt-5 sm:grid-cols-2 sm:gap-6',
                      isNavy ? 'border-white/15' : 'border-[#e8dfcf]',
                    ]}
                  >
                    <div class="min-w-0">
                      <p class={sectionEyebrow}>Thách thức</p>
                      <ol
                        class:list={[
                          'mt-2 list-decimal space-y-1.5 pl-4 text-sm leading-relaxed',
                          isNavy ? textOnDarkTitle : textOnLightBodyMuted,
                        ]}
                      >
                        {item.challenges.map((c) => (
                          <li class="break-words">{c}</li>
                        ))}
                      </ol>
                    </div>
                    <div class="min-w-0">
                      <p class={sectionEyebrow}>Giải pháp</p>
                      <ol
                        class:list={[
                          'mt-2 list-decimal space-y-1.5 pl-4 text-sm leading-relaxed',
                          isNavy ? textOnDarkTitle : textOnLightBodyMuted,
                        ]}
                      >
                        {item.solutions.map((s) => (
                          <li class="break-words">{s}</li>
                        ))}
                      </ol>
                    </div>
                  </div>

                  <a
                    href={href}
                    class:list={[
                      'case-cta mt-6 inline-flex items-center gap-2 text-sm font-extrabold no-underline',
                      isNavy ? textOnDarkTitle : textOnLightTitle,
                    ]}
                  >
                    <span class="case-cta__label">Tìm hiểu thêm về dự án</span>
                    <span class="case-cta__arrow material-symbols-outlined text-lg leading-none" aria-hidden="true">
                      arrow_forward
                    </span>
                  </a>
                </div>

                {!imageLeft && (
                  <div class:list={[imageFrameClass, 'max-md:order-1']}>
                    <SiteImage
                      src={item.image}
                      alt={item.alt}
                      width={960}
                      height={720}
                      class={imageClass}
                      loading="lazy"
                      decoding="async"
                      variant="card"
                      sizes="(min-width: 768px) 50vw, 85vw"
                    />
                  </div>
                )}
              </div>
            </article>
          );
        })
      }
    </div>

    {
      items.length > 1 && (
        <div
          class="mt-5 flex items-center justify-center gap-2 md:hidden"
          role="tablist"
          aria-label="Chọn case study"
        >
          {items.map((item, index) => (
            <button
              type="button"
              class="client-cs-dot h-2 w-2 rounded-full bg-[#1f1b17]/25 transition-[width,background-color] duration-200 aria-selected:w-5 aria-selected:bg-[#1f1b17]"
              data-client-cs-dot
              role="tab"
              aria-label={`Case study ${index + 1}: ${item.client}`}
              aria-selected={index === 0 ? 'true' : 'false'}
            />
          ))}
        </div>
      )
    }
  </div>
</section>

<script src="../../scripts/client-case-study-carousel.ts"></script>

<style>
  /* Mobile: mỗi slide = đúng bề ngang track (scrollport), không peek thẻ kế */
  @media (max-width: 767px) {
    .client-cs-track > [data-client-cs-slide] {
      flex: 0 0 100%;
      width: 100%;
      min-width: 100%;
      max-width: 100%;
    }
  }

  .case-cta__label {
    text-decoration-line: none;
    text-decoration-color: #ffc72c;
    text-decoration-thickness: 2px;
    text-underline-offset: 6px;
    transition: text-decoration-color 0.2s ease;
  }

  .case-cta:hover .case-cta__label,
  .group:hover .case-cta__label {
    text-decoration-line: underline;
  }

  .case-cta__arrow {
    transition: transform 0.2s ease;
  }

  .case-cta:hover .case-cta__arrow,
  .group:hover .case-cta__arrow {
    transform: translateX(4px);
  }
</style>
