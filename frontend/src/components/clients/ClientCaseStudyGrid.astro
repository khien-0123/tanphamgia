---
import type { ClientCaseStudy } from '../../data/site';
import { routes } from '../../lib/routes';
import { landscapeCardFrame, landscapeCardImg } from '../../lib/image-frame';

interface Props {
  items: ClientCaseStudy[];
}

const { items } = Astro.props;
---

<section class="py-8 md:py-12 bg-white">
  <div class="max-w-container-max-width mx-auto px-6 md:px-8">
    <h2 data-reveal class="font-headline-md text-2xl md:text-3xl font-bold text-ink-dark mb-10">
      Case study tiêu biểu
    </h2>
    <div data-reveal-stagger class="grid md:grid-cols-3 gap-8 md:gap-10">
      {
        items.map((item) => (
          <article data-reveal class="group">
            <a href={item.href ?? routes.tinTuc} class="block no-underline text-inherit">
              <figure class:list={[landscapeCardFrame, 'relative mb-5']}>
                <img
                  alt={item.alt}
                  class:list={[landscapeCardImg, 'group-hover:scale-[1.04]']}
                  src={item.image}
                  loading="lazy"
                />
              </figure>
              <span class="text-xs font-bold uppercase tracking-widest text-accent-teal mb-2 block">
                {item.client}
              </span>
              <h3 class="text-lg font-bold text-ink-dark mb-3 group-hover:text-accent-gold transition-colors leading-snug">
                {item.title}
              </h3>
              <p class="text-text-muted text-sm leading-relaxed">{item.excerpt}</p>
            </a>
          </article>
        ))
      }
    </div>
  </div>
</section>
