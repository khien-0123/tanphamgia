---
import SiteImage from '../SiteImage.astro';
import type { ClientCaseStudy } from '../../data/site';
import { getClientLogoScale } from '../../lib/client-logo-scale';
import { RHYTHM_WHITE, sectionPy } from '../../lib/section-rhythm';

interface Props {
  items: ClientCaseStudy[];
  sectionBg?: string;
}

const { items, sectionBg = RHYTHM_WHITE } = Astro.props;
---

<section class:list={[sectionPy, 'border-b border-border-subtle', sectionBg]}>
  <div class="mx-auto max-w-container-max-width px-6 md:px-8">
    <header class="mb-10 md:mb-12">
      <p class="mb-4 text-xs font-bold uppercase tracking-[0.16em] text-accent-gold">
        Dự án đã triển khai
      </p>
      <h2 class="font-headline-md text-2xl font-bold leading-tight text-ink-dark md:text-3xl">
        Case study tiêu biểu
      </h2>
    </header>

    <div class="grid gap-6 md:gap-8" data-reveal-stagger>
      {
        items.map((item, index) => (
          <article data-reveal>
            <a
              href={item.href}
              class="group grid overflow-hidden rounded-[1.75rem] bg-white shadow-soft no-underline transition-shadow duration-300 hover:shadow-card focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent-gold lg:min-h-[25rem] lg:grid-cols-2"
            >
              <figure
                class:list={[
                  'relative m-0 min-h-0 overflow-hidden bg-surface-muted max-lg:aspect-[16/10]',
                  index % 2 === 0 ? 'lg:order-2' : 'lg:order-1',
                ]}
              >
                <SiteImage
                  src={item.image}
                  alt={item.alt}
                  width={960}
                  height={640}
                  class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.04] motion-reduce:transition-none motion-reduce:group-hover:scale-100"
                  loading="lazy"
                  decoding="async"
                  variant="card"
                />
              </figure>

              <div
                class:list={[
                  'flex flex-col justify-center p-6 sm:p-8 lg:p-12',
                  index % 2 === 0 ? 'lg:order-1' : 'lg:order-2',
                ]}
              >
                <div class="mb-7 flex min-h-10 items-center gap-3">
                  {item.logoMark && item.logoWordmark ? (
                    <>
                      <SiteImage
                        src={item.logoMark}
                        alt=""
                        width={40}
                        height={40}
                        class="h-9 w-9 shrink-0 object-contain"
                        style={`transform: scale(${getClientLogoScale(item.logoMark)}); transform-origin: center;`}
                        loading="lazy"
                        decoding="async"
                        variant="logo"
                      />
                      <span class="text-base font-extrabold tracking-wide text-ink-dark">
                        {item.logoWordmark}
                      </span>
                    </>
                  ) : item.logo ? (
                    <SiteImage
                      src={item.logo}
                      alt=""
                      width={140}
                      height={48}
                      class="h-10 w-auto max-w-[9rem] object-contain object-left"
                      style={`transform: scale(${getClientLogoScale(item.logo)}); transform-origin: left center;`}
                      loading="lazy"
                      decoding="async"
                      variant="logo"
                    />
                  ) : (
                    <span class="text-base font-bold text-ink-dark">{item.client}</span>
                  )}
                </div>

                <p class="mb-4 text-[11px] font-bold uppercase tracking-[0.14em] text-[#5C4500]">
                  {item.tags}
                </p>
                <h3 class="max-w-[22ch] text-balance font-headline-md text-2xl font-extrabold leading-tight text-ink-dark sm:text-3xl">
                  {item.title}
                </h3>
                <p class="mt-5 max-w-[65ch] text-pretty text-sm leading-relaxed text-text-muted sm:text-base">
                  {item.excerpt}
                </p>

                <span class="mt-8 inline-flex items-center gap-2 text-sm font-semibold text-ink-dark transition-colors duration-300 group-hover:text-accent-gold">
                  Xem case study
                  <svg
                    class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1 motion-reduce:transition-none motion-reduce:group-hover:translate-x-0"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    aria-hidden="true"
                  >
                    <path d="M5 12h14M13 6l6 6-6 6" />
                  </svg>
                </span>
              </div>
            </a>
          </article>
        ))
      }
    </div>
  </div>
</section>
