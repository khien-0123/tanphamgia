---
import type { ClientCaseStudy } from '../../data/site';
import { getClientLogoScale } from '../../lib/client-logo-scale';
import { caseStudySecondaryCard } from '../../lib/case-study-classes';

interface Props {
  item: ClientCaseStudy;
}

const { item } = Astro.props;
---

<a href={item.href} class:list={caseStudySecondaryCard}>
  <img
    src={item.image}
    alt={item.alt}
    width={800}
    height={1000}
    class="absolute inset-0 z-0 h-full w-full object-cover object-center transition-transform duration-500 group-hover:scale-[1.04]"
    loading="lazy"
    decoding="async"
  />
  <div class="case-study-secondary-scrim pointer-events-none absolute inset-x-0 bottom-0 z-[1]" aria-hidden="true" />
  <div class="case-study-secondary-copy relative z-[2] mt-auto flex w-full flex-col gap-3 p-6 md:p-8">
    <div class="flex w-fit max-w-full items-center gap-2.5">
      {item.logoMark && item.logoWordmark ? (
        <>
          <img
            src={item.logoMark}
            alt=""
            width={32}
            height={32}
            class="case-study-brand-mark h-8 w-8 shrink-0 object-contain"
            style={`transform: scale(${getClientLogoScale(item.logoMark)}); transform-origin: center;`}
            loading="lazy"
            decoding="async"
          />
          <span class="text-sm font-bold tracking-wide text-white">{item.logoWordmark}</span>
          <span class="text-sm font-semibold text-white">{item.client}</span>
        </>
      ) : item.logo ? (
        <img
          src={item.logo}
          alt=""
          width={120}
          height={40}
          class="case-study-brand-logo h-8 w-auto object-contain object-left"
          style={`transform: scale(${getClientLogoScale(item.logo)}); transform-origin: left center;`}
          loading="lazy"
          decoding="async"
        />
      ) : (
        <span class="inline-flex h-8 w-8 items-center justify-center text-white">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 2l2.4 7.4H22l-6 4.6 2.3 7L12 16.8 5.7 21l2.3-7-6-4.6h7.6L12 2z" />
          </svg>
        </span>
      )}
      {!item.logoWordmark && (
        <span class="text-sm font-semibold text-white">{item.client}</span>
      )}
    </div>
    <p class="text-[10px] font-bold uppercase tracking-[0.12em] text-white/90">
      {item.tags}
    </p>
    <h4 class="font-headline-md text-base md:text-lg font-bold text-white leading-snug group-hover:text-accent-gold transition-colors">
      {item.title}
    </h4>
    <p class="text-sm text-white/90 leading-relaxed line-clamp-2">
      {item.excerpt}
    </p>
    <span class="inline-flex items-center gap-2 text-sm font-semibold text-white group-hover:text-accent-gold transition-colors">
      Đọc case study
      <svg
        class="w-4 h-4 transition-transform group-hover:translate-x-1"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
      >
        <path d="M5 12h14M13 6l6 6-6 6" />
      </svg>
    </span>
  </div>
</a>

<style>
  /* Đen mờ sát đáy — cùng tông section #giai-phap */
  .case-study-secondary-scrim {
    height: 62%;
    background: linear-gradient(
      to top,
      rgb(0 0 0 / 0.76) 0%,
      rgb(0 0 0 / 0.52) 36%,
      rgb(0 0 0 / 0.18) 64%,
      transparent 90%
    );
  }

  .case-study-brand-logo,
  .case-study-brand-mark {
    filter: drop-shadow(0 2px 10px rgb(0 0 0 / 0.75));
  }

  /* Nền đen PNG hòa vào scrim — chỉ giữ icon vàng */
  .case-study-brand-mark {
    mix-blend-mode: lighten;
  }

  .case-study-secondary-copy,
  .case-study-secondary-copy *:not(img) {
    text-shadow:
      0 1px 3px rgb(0 0 0 / 0.7),
      0 6px 20px rgb(0 0 0 / 0.4);
  }
</style>
