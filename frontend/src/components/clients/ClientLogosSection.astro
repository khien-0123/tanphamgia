---
/**
 * Logo khách hàng — pattern IntegrationHero (2 hàng marquee CSS).
 * Astro SSG, Zero-JS; không dùng React/shadcn.
 */
import SiteImage from '../SiteImage.astro';
import { clientLogos } from '../../data/site';
import { getClientLogoScale } from '../../lib/client-logo-scale';
import { sectionPy } from '../../lib/section-rhythm';
import { sectionEyebrow } from '../../lib/section-eyebrow';
import { sectionLead, sectionTitleOnLight } from '../../lib/section-typography';

interface Props {
  sectionBg?: string;
}

/** Mặc định trắng — fade mép track khớp nền trắng */
const { sectionBg = 'bg-white' } = Astro.props;

const mid = Math.ceil(clientLogos.length / 2);
const row1 = clientLogos.slice(0, mid);
const row2 = clientLogos.slice(mid);

/** Lặp đủ để track dài — animation translateX(-50%) liền mạch */
function repeatLogos<T>(items: T[], times = 4): T[] {
  return Array.from({ length: times }, () => items).flat();
}

const marqueeRow1 = repeatLogos(row1);
const marqueeRow2 = repeatLogos(row2);
---

<section
  class:list={['client-logos-hero relative overflow-hidden', sectionPy, sectionBg]}
  id="doi-tac"
  data-no-reveal
>
  {/* Lưới nền nhẹ */}
  <div
    class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_center,rgba(14,38,64,0.04)_1px,transparent_1px)] [background-size:24px_24px]"
    aria-hidden="true"
  >
  </div>

  <div class="relative max-w-container-max-width mx-auto px-6 md:px-8">
    <header class="mb-10 md:mb-12 text-left">
      <p class={sectionEyebrow}>Đối tác tin cậy</p>
      <h2 id="client-logos-title" class:list={['mt-5 m-0', sectionTitleOnLight]}>
        Logo khách hàng tiêu biểu
      </h2>
      <p class:list={['mt-4 max-w-3xl m-0', sectionLead]}>
        Tân Phạm Gia được tin tưởng bởi các tập đoàn, ngân hàng, chuỗi bán lẻ và doanh nghiệp sản xuất
        trên toàn quốc.
      </p>
    </header>

    <div class="client-logos-hero__carousel overflow-hidden relative pb-2">
      <div class="client-logos-hero__track client-logos-hero__track--left flex items-center gap-12 md:gap-16 lg:gap-20 w-max">
        {
          marqueeRow1.map((client, i) => (
            <div
              class="client-logos-hero__cell flex h-20 w-40 md:h-24 md:w-48 lg:h-[6.5rem] lg:w-56 shrink-0 items-center justify-center"
              title={client.name}
            >
              <SiteImage
                alt={client.name}
                class="max-h-16 md:max-h-20 lg:max-h-[5.5rem] max-w-full w-auto object-contain"
                style={`transform: scale(${getClientLogoScale(client.logo)}); transform-origin: center`}
                loading={i < row1.length ? 'eager' : 'lazy'}
                src={client.logo}
                variant="logo"
              />
            </div>
          ))
        }
      </div>

      <div class="client-logos-hero__track client-logos-hero__track--right flex items-center gap-12 md:gap-16 lg:gap-20 w-max mt-8 md:mt-10">
        {
          marqueeRow2.map((client, i) => (
            <div
              class="client-logos-hero__cell flex h-20 w-40 md:h-24 md:w-48 lg:h-[6.5rem] lg:w-56 shrink-0 items-center justify-center"
              title={client.name}
            >
              <SiteImage
                alt={client.name}
                class="max-h-16 md:max-h-20 lg:max-h-[5.5rem] max-w-full w-auto object-contain"
                style={`transform: scale(${getClientLogoScale(client.logo)}); transform-origin: center`}
                loading={i < row2.length ? 'eager' : 'lazy'}
                src={client.logo}
                variant="logo"
              />
            </div>
          ))
        }
      </div>

      <div class="client-logos-hero__fade client-logos-hero__fade--left" aria-hidden="true"></div>
      <div class="client-logos-hero__fade client-logos-hero__fade--right" aria-hidden="true"></div>
    </div>
  </div>
</section>

<style>
  @keyframes client-logos-scroll-left {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  @keyframes client-logos-scroll-right {
    0% {
      transform: translateX(-50%);
    }
    100% {
      transform: translateX(0);
    }
  }

  .client-logos-hero__track--left {
    animation: client-logos-scroll-left 80s linear infinite;
  }

  .client-logos-hero__track--right {
    animation: client-logos-scroll-right 80s linear infinite;
  }

  .client-logos-hero__fade {
    position: absolute;
    top: 0;
    height: 100%;
    width: 4rem;
    pointer-events: none;
  }

  @media (min-width: 768px) {
    .client-logos-hero__fade {
      width: 6rem;
    }
  }

  .client-logos-hero__fade--left {
    left: 0;
    background: linear-gradient(to right, #ffffff, transparent);
  }

  .client-logos-hero__fade--right {
    right: 0;
    background: linear-gradient(to left, #ffffff, transparent);
  }

  @media (prefers-reduced-motion: reduce) {
    .client-logos-hero__track--left,
    .client-logos-hero__track--right {
      animation: none;
      transform: none;
      flex-wrap: wrap;
      justify-content: center;
      width: 100%;
      max-width: 100%;
    }

    .client-logos-hero__fade {
      display: none;
    }
  }
</style>
