---
import SiteImage from '../SiteImage.astro';
import type { BlogPost } from '../../data/site';
import {
  pageHeroBreadcrumb,
  pageHeroCopy,
  pageHeroDescription,
  pageHeroEyebrow,
  pageHeroImage,
  pageHeroInner,
  pageHeroScrim,
  pageHeroShell,
  pageHeroTitle,
} from '../../lib/page-hero-shell';
import { formatBlogDate } from '../../lib/format-blog-date';
import { routes } from '../../lib/routes';
import { RHYTHM_WHITE, sectionPy } from '../../lib/section-rhythm';

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;
const publishedLabel = formatBlogDate(post.publishedAt);
---

<header data-page-hero class:list={[pageHeroShell, 'text-white']}>
  <SiteImage alt="" class={pageHeroImage} src={post.image} loading="eager" decoding="async" variant="hero" />
  <div class={pageHeroScrim} aria-hidden="true"></div>

  <div class={pageHeroInner}>
    <div class={pageHeroCopy}>
      <nav aria-label="Breadcrumb" class={pageHeroBreadcrumb}>
        <a class="inline-flex items-center transition-colors hover:text-[#3f2d00]" href={routes.home}>
          Trang chủ
        </a>
        <span class="mx-1.5">/</span>
        <a class="inline-flex items-center transition-colors hover:text-[#3f2d00]" href={routes.tinTuc}>
          Tin tức
        </a>
        <span class="mx-1.5">/</span>
        <span class="line-clamp-1" title={post.title}>{post.title}</span>
      </nav>

      <div class="mb-3 flex flex-wrap items-center gap-3">
        <span class={pageHeroEyebrow}>{post.category}</span>
        <time class="text-sm font-medium text-white/65" datetime={post.publishedAt}>
          {publishedLabel}
        </time>
      </div>
      <h1 class={pageHeroTitle}>{post.title}</h1>
      <p class={pageHeroDescription}>{post.excerpt}</p>
    </div>
  </div>
</header>

<article class:list={[sectionPy, RHYTHM_WHITE]}>
  <div class="max-w-container-max-width mx-auto px-6 md:px-8 max-w-3xl">
    <div data-reveal class="prose-blog text-text-muted leading-relaxed space-y-4">
      <p>{post.excerpt}</p>
      <p>
        Nội dung chi tiết sẽ được đồng bộ từ WordPress. Liên hệ đội ngũ tư vấn nếu bạn cần thêm
        thông tin về chủ đề này.
      </p>
    </div>
    <a
      href={routes.tinTuc}
      class="inline-block mt-10 text-sm font-bold text-accent-teal hover:text-ink-dark transition-colors"
    >
      ← Quay lại danh sách tin tức
    </a>
  </div>
</article>
