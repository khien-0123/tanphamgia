---
import type { BlogPost } from '../../data/site';
import BlogPostFigure from '../BlogPostFigure.astro';
import { routes } from '../../lib/routes';

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;
---

<article class="pt-28 md:pt-32 pb-16 bg-white">
  <div class="max-w-container-max-width mx-auto px-6 md:px-8 max-w-3xl">
    <nav aria-label="Breadcrumb" class="text-sm text-text-muted mb-8">
      <a class="hover:text-accent-gold transition-colors" href={routes.home}>Trang chủ</a>
      <span class="mx-2">/</span>
      <a class="hover:text-accent-gold transition-colors" href={routes.tinTuc}>Tin tức</a>
      <span class="mx-2">/</span>
      <span class="text-ink-dark line-clamp-2" title={post.title}>{post.title}</span>
    </nav>

    <span
      data-reveal
      class="font-bold text-xs uppercase tracking-widest mb-4 block"
      style={post.categoryColor ? `color: ${post.categoryColor}` : undefined}
    >
      {post.category}
    </span>
    <h1
      data-reveal
      class="font-display-lg text-[clamp(1.5rem,5vw,3rem)] leading-[1.2] md:text-4xl font-bold text-ink-dark mb-6 leading-tight text-balance"
    >
      {post.title}
    </h1>
    <div data-reveal>
      <BlogPostFigure
        src={post.image}
        alt={post.alt}
        class="mb-8 md:mb-10 w-full max-w-lg mx-auto"
      />
    </div>
    <div data-reveal class="prose-blog text-text-muted leading-relaxed space-y-4">
      <p>{post.excerpt}</p>
      <p>
        Nội dung chi tiết sẽ được đồng bộ từ WordPress. Liên hệ đội ngũ tư vấn nếu bạn cần thêm
        thông tin về chủ đề này.
      </p>
    </div>
    <a
      href={routes.tinTuc}
      class="inline-block mt-10 text-sm font-bold text-accent-teal hover:text-ink-dark transition-colors"
    >
      ← Quay lại danh sách tin tức
    </a>
  </div>
</article>
