---
import SiteImage from '../SiteImage.astro';
import { defaultBlogAuthor, type BlogAuthor } from '../../data/blog-engagement';

interface Props {
  /** Giữ prop để tương thích layout chi tiết bài */
  slug: string;
  author?: BlogAuthor;
}

const { author = defaultBlogAuthor } = Astro.props;
---

<section
  class="mt-14 border-t border-[#e5dfd2] pt-12"
  aria-label="Tác giả và đánh giá"
>
  {/* —— Tác giả —— */}
  <article class="rounded-[0.85rem] border border-[#ded5c5] bg-white px-5 py-5 sm:px-6 sm:py-6">
    <div class="flex flex-col gap-5 sm:flex-row sm:gap-6">
      <div class="shrink-0">
        <SiteImage
          src={author.avatar}
          alt={author.avatarAlt}
          class="h-20 w-20 rounded-full object-cover object-top sm:h-24 sm:w-24"
          width={96}
          height={96}
          loading="lazy"
          variant="thumb"
        />
      </div>
      <div class="min-w-0 flex-1">
        <p class="m-0 text-sm font-semibold text-[#625a50]">{author.role}</p>
        <h3 class="mt-1 text-lg font-extrabold uppercase tracking-[-0.02em] text-[#1f1b17] sm:text-xl">
          {author.name}
        </h3>
        <p class="mt-2 inline-flex items-center gap-1.5 text-sm font-semibold text-[#2f6b3a]">
          <span
            class="inline-flex h-4 w-4 items-center justify-center rounded-full bg-[#2f6b3a] text-white"
            aria-hidden="true"
          >
            <span class="material-symbols-outlined text-[0.7rem] leading-none">check</span>
          </span>
          {author.verifiedLabel}
        </p>
        <p class="mt-3 text-[0.9375rem] leading-relaxed text-[#3d3832]">{author.bio}</p>
      </div>
    </div>
  </article>

  {/* —— Rating cố định 5 sao (không tương tác) —— */}
  <div class="mt-8 flex flex-wrap items-center justify-end gap-3">
    <div class="flex items-center gap-0.5" role="img" aria-label="Đánh giá 5 trên 5 sao">
      {
        [1, 2, 3, 4, 5].map(() => (
          <span class="rating-star grid h-9 w-9 place-items-center" aria-hidden="true">
            <span class="material-symbols-outlined text-[1.35rem] leading-none">star</span>
          </span>
        ))
      }
    </div>
    <p class="m-0 text-sm font-semibold text-[#1f1b17]">5/5</p>
  </div>
</section>

<style>
  .rating-star {
    color: #ffc72c;
  }
  .rating-star .material-symbols-outlined {
    font-variation-settings: 'FILL' 1, 'wght' 500, 'GRAD' 0, 'opsz' 24;
  }
</style>
