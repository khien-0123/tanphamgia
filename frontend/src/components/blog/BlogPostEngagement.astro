---
import SiteImage from '../SiteImage.astro';
import { defaultBlogAuthor, type BlogAuthor } from '../../data/blog-engagement';

interface Props {
  /** Slug bài — khóa localStorage cho rating */
  slug: string;
  author?: BlogAuthor;
}

const { slug, author = defaultBlogAuthor } = Astro.props;
---

<section
  class="mt-14 border-t border-[#e5dfd2] pt-12"
  aria-label="Tác giả và đánh giá"
  data-blog-engagement
  data-post-slug={slug}
>
  {/* —— Tác giả —— */}
  <article class="flex flex-col gap-5 sm:flex-row sm:gap-6">
    <div class="shrink-0">
      <SiteImage
        src={author.avatar}
        alt={author.avatarAlt}
        class="h-20 w-20 rounded-full object-cover object-top sm:h-24 sm:w-24"
        width={96}
        height={96}
        loading="lazy"
        variant="thumb"
      />
    </div>
    <div class="min-w-0 flex-1">
      <p class="m-0 text-sm font-semibold text-[#625a50]">{author.role}</p>
      <h3 class="mt-1 text-lg font-extrabold uppercase tracking-[-0.02em] text-[#1f1b17] sm:text-xl">
        {author.name}
      </h3>
      <p class="mt-2 inline-flex items-center gap-1.5 text-sm font-semibold text-[#2f6b3a]">
        <span
          class="inline-flex h-4 w-4 items-center justify-center rounded-full bg-[#2f6b3a] text-white"
          aria-hidden="true"
        >
          <span class="material-symbols-outlined text-[0.7rem] leading-none">check</span>
        </span>
        {author.verifiedLabel}
      </p>
      <p class="mt-3 text-[0.9375rem] leading-relaxed text-[#3d3832]">{author.bio}</p>
    </div>
  </article>

  {/* —— Rating —— */}
  <div class="mt-8 flex flex-wrap items-center justify-end gap-3" data-rating-root>
    <div class="flex items-center gap-0.5" role="group" aria-label="Đánh giá bài viết">
      {
        [1, 2, 3, 4, 5].map((n) => (
          <button
            type="button"
            class="rating-star grid h-9 w-9 place-items-center rounded-full transition-colors hover:text-[#ffc72c] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#1f1b17]"
            data-rating-star={n}
            aria-label={`Chấm ${n} sao`}
          >
            <span class="material-symbols-outlined text-[1.35rem] leading-none" aria-hidden="true"
              >star</span
            >
          </button>
        ))
      }
    </div>
    <p class="m-0 text-sm font-semibold text-[#1f1b17]" data-rating-label>
      — /5 — (0 bình chọn)
    </p>
  </div>
</section>

<style>
  .rating-star {
    color: #d9d0c0;
  }
  .rating-star.is-active {
    color: #ffc72c;
  }
  .rating-star .material-symbols-outlined {
    font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
  }
  .rating-star.is-active .material-symbols-outlined {
    font-variation-settings: 'FILL' 1, 'wght' 500, 'GRAD' 0, 'opsz' 24;
  }
</style>

<script src="../../scripts/blog-post-engagement.ts"></script>
