---
import BlogPostCard from './BlogPostCard.astro';
import type { BlogPost } from '../../data/site';

interface Props {
  items: BlogPost[];
}

const { items } = Astro.props;
---

<div data-reveal-stagger class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3 md:gap-10">
  {
    items.map((post) => (
      <div data-reveal class="h-full">
        <BlogPostCard post={post} variant="default" />
      </div>
    ))
  }
</div>
