---
/**
 * Thẻ bài viết — port từ card-18 (shadcn) sang Astro.
 * featured: ảnh ngang + CTA | default: ảnh + danh mục + tiêu đề + mô tả.
 */
import BlogPostTitle from '../BlogPostTitle.astro';
import BlogPostFigure from '../BlogPostFigure.astro';
import SiteImage from '../SiteImage.astro';
import { listingZigzagFrame, listingZigzagImg } from '../../lib/image-frame';
import { formatBlogDate } from '../../lib/format-blog-date';
import type { BlogPost } from '../../data/site';
import { textOnLightTitle } from '../../lib/section-typography';

interface Props {
  post: BlogPost;
  variant?: 'default' | 'featured';
  readMoreText?: string;
  class?: string;
}

const {
  post,
  variant = 'default',
  readMoreText = 'Đọc bài viết đầy đủ',
  class: className = '',
} = Astro.props;

const href = post.href ?? '#';
const publishedLabel = formatBlogDate(post.publishedAt);

const isFeatured = variant === 'featured';
const articleBase = isFeatured
  ? `group relative flex flex-col overflow-hidden rounded-lg bg-white transition-all duration-300 ease-in-out hover:-translate-y-1 md:flex-row ${textOnLightTitle}`
  : `group relative flex h-full flex-col overflow-hidden rounded-lg bg-white ${textOnLightTitle}`;
---

<article class:list={[articleBase, className]}>
  <a href={href} class:list={['absolute inset-0 z-10', textOnLightTitle]} aria-label={`Đọc thêm: ${post.title}`}>
    <span class="sr-only">{readMoreText}</span>
  </a>

  {
    isFeatured ? (
      <>
        <figure class:list={[listingZigzagFrame, 'w-full md:w-1/2 lg:w-3/5 md:aspect-auto md:min-h-[280px]']}>
          <SiteImage
            src={post.image}
            alt={post.alt}
            class:list={[listingZigzagImg, 'group-hover:scale-105']}
            loading="eager"
            decoding="async"
            variant="card"
          />
        </figure>
        <div class="relative z-0 flex flex-1 flex-col justify-between p-6 md:p-8">
          <div>
            <div class:list={['mb-4 flex flex-wrap items-center gap-x-2 gap-y-1 text-xs font-bold uppercase tracking-widest', textOnLightTitle]}>
              <span>{post.category}</span>
              <span aria-hidden="true">·</span>
              <time class="font-semibold normal-case tracking-normal" datetime={post.publishedAt}>
                {publishedLabel}
              </time>
            </div>
            <h3 class:list={['mb-3 text-xl font-bold leading-tight lg:text-2xl', textOnLightTitle]}>
              <BlogPostTitle post={post} as="span" />
            </h3>
            <p class="text-text-muted leading-relaxed">{post.excerpt}</p>
          </div>
          <div class="mt-8 pointer-events-none">
            <span class="inline-flex items-center justify-center whitespace-nowrap rounded-md bg-ink-dark px-4 py-2.5 text-sm font-bold text-white transition-colors group-hover:bg-accent-gold group-hover:text-[#1f1b17]">
              {readMoreText}
              <svg
                class="ml-2 h-4 w-4 transition-transform duration-300 group-hover:translate-x-1"
                xmlns="http://www.w3.org/2000/svg"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M5 12h14" />
                <path d="m12 5 7 7-7 7" />
              </svg>
            </span>
          </div>
        </div>
      </>
    ) : (
      <div class="relative z-0 flex h-full flex-col">
        <BlogPostFigure
          src={post.image}
          alt={post.alt}
          class="mb-0 shrink-0"
          imgClass="transition-transform duration-500 group-hover:scale-[1.05]"
        />
        <div class="flex flex-1 flex-col bg-white px-5 pb-5 pt-4">
          <div class:list={['mb-3 flex flex-wrap items-center gap-x-2 gap-y-1 text-xs font-bold uppercase tracking-widest', textOnLightTitle]}>
            <span class="shrink-0">{post.category}</span>
            <span aria-hidden="true">·</span>
            <time class="font-semibold normal-case tracking-normal" datetime={post.publishedAt}>
              {publishedLabel}
            </time>
          </div>
          <h3 class:list={['mb-3 min-h-[3.125rem] text-lg font-bold leading-snug line-clamp-2', textOnLightTitle]}>
            <BlogPostTitle post={post} as="span" />
          </h3>
          <p class="text-sm leading-relaxed text-text-muted line-clamp-3">{post.excerpt}</p>
        </div>
      </div>
    )
  }
</article>
