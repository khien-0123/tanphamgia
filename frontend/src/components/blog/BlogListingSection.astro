---
import BlogPostCard from './BlogPostCard.astro';
import BlogPostGrid from './BlogPostGrid.astro';
import BlogPagination from './BlogPagination.astro';
import type { BlogPost } from '../../data/site';
import { RHYTHM_WHITE } from '../../lib/section-rhythm';

interface Props {
  items: BlogPost[];
  currentPage: number;
  totalPages: number;
  /** Bài nổi bật — chỉ trang 1 */
  featuredPost?: BlogPost;
  sectionBg?: string;
}

const { items, currentPage, totalPages, featuredPost, sectionBg = RHYTHM_WHITE } = Astro.props;
---

<section class:list={['py-8 md:py-12', sectionBg]}>
  <div class="max-w-container-max-width mx-auto px-6 md:px-8">
    {
      featuredPost && (
        <div data-reveal class="mb-8 md:mb-12">
          <BlogPostCard post={featuredPost} variant="featured" />
        </div>
      )
    }
    <BlogPostGrid items={items} />
    <BlogPagination currentPage={currentPage} totalPages={totalPages} />
  </div>
</section>
