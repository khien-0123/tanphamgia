---
import BlogPostCard from './BlogPostCard.astro';
import BlogPostGrid from './BlogPostGrid.astro';
import BlogPagination from './BlogPagination.astro';
import BlogCategoryFilter from './BlogCategoryFilter.astro';
import type { BlogPost } from '../../data/site';
import { RHYTHM_WHITE, sectionPy } from '../../lib/section-rhythm';

interface Props {
  items: BlogPost[];
  currentPage: number;
  totalPages: number;
  /** Bài nổi bật — chỉ trang 1 */
  featuredPost?: BlogPost;
  sectionBg?: string;
  /** Tất cả bài để lấy danh sách chuyên mục (mặc định: featured + items) */
  allPosts?: BlogPost[];
}

const { items, currentPage, totalPages, featuredPost, sectionBg = RHYTHM_WHITE, allPosts } = Astro.props;

const categorySource = allPosts ?? [...(featuredPost ? [featuredPost] : []), ...items];
const categories = [...new Set(categorySource.map((p) => p.category).filter(Boolean))];
---

<section class:list={[sectionPy, sectionBg]} data-blog-filter>
  <div class="max-w-container-max-width mx-auto px-6 md:px-8">
    {categories.length > 1 && <BlogCategoryFilter categories={categories} />}

    {
      featuredPost && (
        <div data-reveal data-blog-category={featuredPost.category} class="mb-8 md:mb-12">
          <BlogPostCard post={featuredPost} variant="featured" />
        </div>
      )
    }

    <div data-reveal-stagger class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3 md:gap-10">
      {
        items.map((post) => (
          <div data-reveal data-blog-category={post.category} class="h-full">
            <BlogPostCard post={post} variant="default" />
          </div>
        ))
      }
    </div>

    <p
      data-blog-filter-empty
      hidden
      class="hidden mt-10 text-center text-sm text-text-muted"
    >
      Chưa có bài viết trong chuyên mục này.
    </p>

    <div data-blog-filter-pagination>
      <BlogPagination currentPage={currentPage} totalPages={totalPages} />
    </div>
  </div>
</section>

<script src="../../scripts/blog-category-filter.ts"></script>
