---
import BlogPostGrid from './BlogPostGrid.astro';
import BlogPagination from './BlogPagination.astro';
import type { BlogPost } from '../../data/site';
import { RHYTHM_WHITE } from '../../lib/section-rhythm';

interface Props {
  items: BlogPost[];
  currentPage: number;
  totalPages: number;
  sectionBg?: string;
}

const { items, currentPage, totalPages, sectionBg = RHYTHM_WHITE } = Astro.props;
---

<section class:list={['py-8 md:py-12', sectionBg]}>
  <div class="max-w-container-max-width mx-auto px-6 md:px-8">
    <BlogPostGrid items={items} />
    <BlogPagination currentPage={currentPage} totalPages={totalPages} />
  </div>
</section>
