---
import { blogPageHref } from '../../lib/routes';

interface Props {
  currentPage: number;
  totalPages: number;
  /**
   * Base path cho phân trang ngoài tin tức.
   * Trang 1 = basePath; trang N = `${basePath}/trang/${N}`.
   * Không truyền → dùng blogPageHref (/tin-tuc).
   */
  basePath?: string;
  /**
   * Neo cuộn — tránh nhảy lên đầu trang khi đổi trang
   * (vd. section «Bài viết case study» dưới hero).
   */
  hash?: string;
}

const { currentPage, totalPages, basePath, hash } = Astro.props;
const pages = Math.max(1, totalPages);

function hrefFor(page: number): string {
  const path = !basePath
    ? blogPageHref(page)
    : page <= 1
      ? basePath
      : `${basePath}/trang/${page}`;
  return hash ? `${path}#${hash}` : path;
}
---

<nav aria-label="Phân trang" class="mt-12 flex justify-center gap-2">
  {
    Array.from({ length: pages }, (_, i) => i + 1).map((page) => (
      <a
        href={hrefFor(page)}
        class:list={[
          'flex h-10 w-10 items-center justify-center rounded-full text-sm font-bold no-underline transition-colors',
          page === currentPage
            ? 'bg-[#1f1b17] text-white'
            : 'bg-surface-muted text-[#1f1b17] hover:bg-accent-gold hover:text-[#1f1b17]',
        ]}
        aria-current={page === currentPage ? 'page' : undefined}
      >
        {page}
      </a>
    ))
  }
</nav>

{
  hash && (
    <script is:inline define:vars={{ hash }}>
      // Sau khi đổi trang SSR, giữ tầm nhìn ở section (không kẹt đầu trang / hero)
      const id = String(hash);
      const scrollToSection = () => {
        if (location.hash !== `#${id}`) return;
        const el = document.getElementById(id);
        if (!el) return;
        el.scrollIntoView({ behavior: 'auto', block: 'start' });
      };
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', scrollToSection);
      } else {
        scrollToSection();
      }
      window.addEventListener('load', scrollToSection, { once: true });
      document.addEventListener('astro:page-load', scrollToSection);
    </script>
  )
}
