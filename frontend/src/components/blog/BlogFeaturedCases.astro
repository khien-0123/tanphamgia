---
import { homeFeaturedCases } from '../../data/site';
import { imageRadius } from '../../lib/image-frame';

const { featured, secondary, allProjectsHref } = homeFeaturedCases;
const allCases = [featured, ...secondary];
---

<section class="py-10 md:py-16 bg-white">
  <div class="max-w-container-max-width mx-auto px-6 md:px-8">
    <header data-reveal class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-3 mb-8 md:mb-10">
      <div class="max-w-xl">
        <h2 class="font-headline-md text-2xl md:text-3xl font-bold text-ink-dark tracking-tight mb-2">
          Dự Án Tiêu Biểu
        </h2>
        <p class="text-text-muted text-sm md:text-base leading-relaxed">
          Chứng thực năng lực qua các dự án quy mô lớn cho tập đoàn đa quốc gia.
        </p>
      </div>
      <a
        href={allProjectsHref}
        class="shrink-0 self-start sm:self-auto text-sm font-bold text-ink-dark no-underline hover:text-accent-gold transition-colors"
      >
        Tất cả dự án →
      </a>
    </header>

    <div data-reveal class="grid gap-4 lg:grid-cols-[3fr_2fr] lg:grid-rows-2 lg:auto-rows-fr">
      {/* Featured — chiếm 2 hàng bên trái */}
      <a
        href={featured.href || allProjectsHref}
        class:list={['group relative block overflow-hidden lg:row-span-2 min-h-[280px] lg:min-h-0 no-underline', imageRadius]}
      >
        <img
          src={featured.image}
          alt={featured.alt}
          loading="lazy"
          class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-[1.03]"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"></div>
        <div class="absolute inset-0 flex flex-col justify-end p-6 md:p-8">
          {featured.tag && (
            <span class="inline-block w-fit px-3 py-1 mb-3 rounded-full bg-accent-gold text-ink-dark text-[0.625rem] font-bold tracking-widest uppercase">
              {featured.tag}
            </span>
          )}
          <h3 class="m-0 text-white text-xl md:text-2xl font-bold leading-tight mb-2">
            {featured.name}
          </h3>
          {featured.stats && (
            <dl class="flex flex-wrap gap-x-6 gap-y-2 m-0 mb-3">
              {featured.stats.map((stat) => (
                <div class="m-0">
                  <dt class="sr-only">{stat.label}</dt>
                  <dd class="flex items-baseline gap-1.5 m-0">
                    <span class="text-lg font-bold text-accent-gold leading-none">{stat.value}</span>
                    <span class="text-xs text-white/60">{stat.label}</span>
                  </dd>
                </div>
              ))}
            </dl>
          )}
          <span class="text-xs font-semibold text-white/50 group-hover:text-accent-gold transition-colors">
            Xem chi tiết →
          </span>
        </div>
      </a>

      {/* 2 card phụ — xếp dọc bên phải */}
      {secondary.map((project) => (
        <a
          href={project.href || allProjectsHref}
          class:list={['group relative block overflow-hidden min-h-[200px] no-underline', imageRadius]}
        >
          <img
            src={project.image}
            alt={project.alt}
            loading="lazy"
            class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-[1.03]"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/75 via-black/15 to-transparent"></div>
          <div class="absolute inset-0 flex flex-col justify-end p-5">
            <h3 class="m-0 text-white text-base md:text-lg font-bold leading-snug mb-1.5">
              {project.name}
            </h3>
            {project.statHighlight && (
              <p class="m-0 flex items-baseline gap-1.5 mb-2">
                <span class="text-base font-bold text-accent-gold leading-none">{project.statHighlight.value}</span>
                <span class="text-xs text-white/60">{project.statHighlight.suffix}</span>
              </p>
            )}
            <span class="text-xs font-semibold text-white/50 group-hover:text-accent-gold transition-colors">
              Xem chi tiết →
            </span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
