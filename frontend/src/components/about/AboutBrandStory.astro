---
import { brandStory } from '../../data/gioi-thieu';
---

<section class="bg-white py-[clamp(4.5rem,9vw,8rem)]">
  <div class="max-w-container-max-width mx-auto px-6 md:px-8">
    <div
      class="grid grid-cols-1 items-start gap-12 md:grid-cols-[1.05fr_0.95fr] md:gap-[clamp(2.5rem,5vw,5.5rem)]"
    >
      {/* Chữ — trái */}
      <div data-reveal>
        <span class="font-eyebrow text-xs uppercase tracking-[0.2em] text-accent-teal block mb-6">
          Câu chuyện thương hiệu
        </span>
        <h2
          class="text-ink-dark text-[clamp(1.75rem,3.4vw,3rem)] font-bold leading-[1.06] mb-9 text-balance"
        >
          {brandStory.title.toLowerCase()}
        </h2>
        {
          brandStory.paragraphs.map((p) => (
            <p class="max-w-[52ch] text-[1.0625rem] leading-relaxed text-text-muted [&:not(:last-child)]:mb-[1.15rem]">
              {p}
            </p>
          ))
        }
      </div>

      {/* Ảnh — phải, badge navy 2003 đè góc dưới */}
      <figure class="relative m-0 order-first md:order-none">
        <img
          src={brandStory.image}
          alt="Câu chuyện thương hiệu Tân Phạm Gia"
          loading="lazy"
          class="block w-full rounded-[4px] object-cover h-[clamp(24rem,42vw,32rem)]"
        />
        <div
          class="absolute left-4 bottom-4 max-w-[13rem] rounded-[4px] bg-ink-dark px-7 py-6 text-white md:-left-6 md:-bottom-6"
        >
          <b class="block text-[2.75rem] leading-none text-accent-gold tabular-nums">2003</b>
          <span class="mt-2 block text-[0.8125rem] leading-[1.4] text-white/70">
            Khởi nguồn hành trình may mặc
          </span>
        </div>
      </figure>
    </div>
  </div>
</section>
