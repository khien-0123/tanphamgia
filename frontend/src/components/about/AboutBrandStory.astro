---
import SiteImage from '../SiteImage.astro';
import { brandStory } from '../../data/gioi-thieu';
import { mediaTextRowClass, mediaTextCellClass } from '../../lib/about-layout';
import { imageRadius } from '../../lib/image-frame';
import { RHYTHM_WHITE, sectionPy } from '../../lib/section-rhythm';

interface Props {
  sectionBg?: string;
}

const { sectionBg = RHYTHM_WHITE } = Astro.props;

const imgClass = `block w-full ${imageRadius} object-cover h-[clamp(24rem,42vw,32rem)]`;
---

<section class:list={[sectionPy, sectionBg]}>
  <div data-reveal class="max-w-container-max-width mx-auto px-6 md:px-8">
    <div class={mediaTextRowClass}>
      <figure class={`${mediaTextCellClass} order-2 md:order-1 m-0 relative`}>
        <span
          class="absolute -left-3 top-8 hidden h-20 w-1 bg-accent-gold lg:block"
          aria-hidden="true"
        ></span>
        <SiteImage
          src={brandStory.image}
          alt="Câu chuyện thương hiệu Tân Phạm Gia"
          class={imgClass}
          loading="lazy"
          decoding="async"
          variant="card"
        />
        <div
          class="absolute left-4 bottom-4 max-w-[13rem] rounded-[4px] bg-ink-dark px-7 py-6 text-white md:-left-6 md:-bottom-6"
        >
          <b class="block text-[2.75rem] leading-none text-accent-gold tabular-nums">2003</b>
          <span class="mt-2 block text-[0.8125rem] leading-[1.4] text-white/70">
            Khởi nguồn hành trình may mặc
          </span>
        </div>
      </figure>

      <div class={`${mediaTextCellClass} order-1 md:order-2`}>
        <h2 class="text-pretty font-headline-md text-2xl md:text-3xl font-bold text-ink-dark mb-6">
          <span class="md:hidden">
            {brandStory.titleLines[0]}
            <br />
            Một Sản Phẩm May Mặc Chất{'\u00a0'}Lượng
          </span>
          <span class="hidden md:inline">{brandStory.title}</span>
        </h2>
        <div class="space-y-4 text-text-muted leading-relaxed">
          {brandStory.paragraphs.map((p) => <p>{p}</p>)}
        </div>
      </div>
    </div>
  </div>
</section>
