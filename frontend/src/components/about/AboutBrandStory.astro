---
import { brandStory } from '../../data/gioi-thieu';
import { mediaTextRowClass, mediaTextCellClass, mediaTextImgClass } from '../../lib/about-layout';
import { RHYTHM_WHITE } from '../../lib/section-rhythm';

interface Props {
  sectionBg?: string;
}

const { sectionBg = RHYTHM_WHITE } = Astro.props;
---

<section class:list={['py-8 md:py-12', sectionBg]}>
  <div data-reveal class="max-w-container-max-width mx-auto px-6 md:px-8">
    <div class={mediaTextRowClass}>
      <figure class={`${mediaTextCellClass} order-2 md:order-1 m-0 relative`}>
        <span
          class="absolute -left-3 top-8 hidden h-20 w-1 bg-accent-gold lg:block"
          aria-hidden="true"
        ></span>
        <img
          alt="chất lượng và thiết kế đồng phục — Tân Phạm Gia"x
          class={mediaTextImgClass}
          src={brandStory.image}
          alt="Câu chuyện thương hiệu Tân Phạm Gia"
          loading="lazy"
          class="block w-full rounded-[4px] object-cover h-[clamp(24rem,42vw,32rem)]"
        />
        <div
          class="absolute left-4 bottom-4 max-w-[13rem] rounded-[4px] bg-ink-dark px-7 py-6 text-white md:-left-6 md:-bottom-6"
        >
          <b class="block text-[2.75rem] leading-none text-accent-gold tabular-nums">2003</b>
          <span class="mt-2 block text-[0.8125rem] leading-[1.4] text-white/70">
            Khởi nguồn hành trình may mặc
          </span>
        </div>
      </figure>
    </div>
  </div>
</section>
