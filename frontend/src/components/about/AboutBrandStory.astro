---
import { brandStory } from '../../data/gioi-thieu';
import { mediaTextRowClass, mediaTextCellClass, mediaTextImgClass } from '../../lib/about-layout';
---

<section class="py-8 md:py-12 bg-white">
  <div data-reveal class="max-w-container-max-width mx-auto px-6 md:px-8">
    <div class={mediaTextRowClass}>
      <figure class={`${mediaTextCellClass} order-2 md:order-1 m-0 relative`}>
        <span
          class="absolute -left-3 top-8 hidden h-20 w-1 bg-accent-gold lg:block"
          aria-hidden="true"
        ></span>
        <img
          alt="Câu chuyện thương hiệu Tân Phạm Gia"
          class={mediaTextImgClass}
          src={brandStory.image}
          loading="lazy"
        />
      </figure>
      <div class={`${mediaTextCellClass} order-1 md:order-2`}>
        <h2
          class="text-pretty font-headline-md text-xl md:text-[1.75rem] lg:text-[2rem] font-bold text-ink-dark mb-6 leading-snug md:leading-tight"
        >
          <span class="md:hidden">
            {brandStory.titleLines[0]}
            <br />
            Một Sản Phẩm May Mặc Chất{' '}Lượng
          </span>
          <span class="hidden md:inline">{brandStory.title}</span>
        </h2>
        <div class="space-y-4 leading-relaxed">
          {
            brandStory.paragraphs.map((p, i) => (
              <p class:list={[i === 0 ? 'text-ink-dark/80 text-base md:text-lg' : 'text-text-muted text-base md:text-lg']}>
                {p}
              </p>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
