---
import SiteImage from '../SiteImage.astro';
import { brandStory } from '../../data/gioi-thieu';
import { sectionEyebrowWarm } from '../../lib/section-eyebrow';
import { sectionPy } from '../../lib/section-rhythm';
import { focusRingOnDark, primaryPill } from '../../lib/button-classes';
import { sectionTitleOnDark, textOnDarkLead, textOnDarkTitle } from '../../lib/section-typography';
---

<section class:list={['bg-[#0d1b3a]', textOnDarkTitle]} aria-labelledby="about-story-title">
  <div class:list={['mx-auto grid w-full max-w-container-max-width items-center gap-10 px-6 md:px-8 lg:grid-cols-[1.02fr_1fr] lg:gap-14 xl:gap-16', sectionPy]}>
    <figure data-reveal data-reveal-direction="up" class="relative m-0 overflow-hidden rounded-[1.75rem] bg-white/5 lg:self-stretch">
      <SiteImage
        src={brandStory.image}
        alt="Câu chuyện thương hiệu Tân Phạm Gia"
        class="block aspect-[1.1/1] h-full w-full object-cover sm:aspect-square lg:aspect-auto lg:h-full"
        loading="lazy"
        variant="card"
        sizes="(min-width: 1024px) 46vw, 100vw"
      />
      <figcaption class="absolute bottom-4 left-4 max-w-[13.5rem] rounded-[1.25rem] bg-accent-gold px-6 py-5 text-[#17140a] shadow-[0_16px_34px_rgba(0,0,0,0.28)] sm:bottom-6 sm:left-6 sm:px-7 sm:py-6">
        <b class="block text-[2.5rem] font-extrabold leading-none tracking-[-0.035em] text-white tabular-nums sm:text-[2.75rem]">2003</b>
        <span class="mt-2 block text-[0.8125rem] font-semibold leading-[1.4] text-white">Khởi nguồn hành trình may mặc</span>
      </figcaption>
    </figure>

    <div data-reveal data-reveal-direction="up" class="max-w-[43rem] lg:py-3">
      <p class:list={['mb-4', sectionEyebrowWarm]}>Câu chuyện thương hiệu</p>

      <h2 id="about-story-title" class:list={['max-w-[24ch]', sectionTitleOnDark]}>
        {brandStory.title}
      </h2>

      <div class:list={['mt-10 space-y-4 text-sm leading-[1.65] sm:mt-12 sm:text-base', textOnDarkLead]}>
        {brandStory.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>

      <a
        href="#nang-luc"
        class:list={[primaryPill, focusRingOnDark, 'mt-8']}
      >
        <span>Khám phá năng lực sản xuất</span>
        <span class="material-symbols-outlined text-xl leading-none sm:text-2xl" aria-hidden="true">arrow_forward</span>
      </a>
    </div>
  </div>
</section>
