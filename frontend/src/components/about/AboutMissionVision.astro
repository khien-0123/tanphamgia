---
import { missionVision, missionVisionSection, coreValues } from '../../data/gioi-thieu';

const pillars = [
  {
    label: 'Sứ mệnh',
    icon: 'flag',
    ...missionVision.mission,
  },
  {
    label: 'Tầm nhìn',
    icon: 'visibility',
    ...missionVision.vision,
  },
] as const;
---

{/* Định hướng — Sứ mệnh & Tầm nhìn: cặp thẻ navy / vàng theo ngôn ngữ thẻ quy trình trang chủ */}
<section class="bg-[#fbf8f1] text-[#1f1b17]" aria-label="Sứ mệnh và tầm nhìn">
  <div class="mx-auto w-full max-w-container-max-width px-6 py-12 md:px-8 lg:py-16">
    <header class="max-w-[44rem]">
      <p class="inline-flex rounded-full bg-[#ffedb7] px-4 py-2 text-[0.7rem] font-extrabold uppercase tracking-[0.025em] text-[#5c4500] sm:text-xs">
        {missionVisionSection.eyebrow}
      </p>
      <p class="mt-6 text-balance text-[clamp(1.35rem,2vw,1.9rem)] font-extrabold leading-[1.25] tracking-[-0.025em] text-[#26211c]">
        {missionVisionSection.intro}
      </p>
    </header>

    <div class="mt-10 grid gap-4 sm:gap-5 lg:grid-cols-2" data-reveal-stagger>
      {
        pillars.map((item, index) => (
          <article
            data-reveal
            class:list={[
              'flex flex-col rounded-[1.25rem] p-7 shadow-[0_16px_28px_rgba(38,31,21,0.14)] sm:p-9',
              index === 0 ? 'bg-[#0d1b3a] text-white' : 'bg-[#ffc72c] text-[#111827]',
            ]}
          >
            <header class="flex items-center gap-3">
              <span
                class:list={[
                  'grid h-11 w-11 shrink-0 place-items-center rounded-full',
                  index === 0 ? 'bg-white/10 text-[#ffc72c]' : 'bg-[#111827]/10 text-[#111827]',
                ]}
                aria-hidden="true"
              >
                <span class="material-symbols-outlined text-[1.375rem] leading-none">{item.icon}</span>
              </span>
              <span
                class:list={[
                  'text-xs font-extrabold uppercase tracking-[0.14em]',
                  index === 0 ? 'text-[#ffc72c]' : 'text-[#5c4500]',
                ]}
              >
                {item.label}
              </span>
            </header>

            <p class="mt-6 max-w-[30ch] text-balance text-[clamp(1.2rem,1.9vw,1.6rem)] font-extrabold leading-[1.3] tracking-[-0.02em]">
              {item.lead}
            </p>
            <p class:list={['mt-3 max-w-[46ch] text-sm leading-[1.65] sm:text-[0.95rem]', index === 0 ? 'text-white/75' : 'text-[#43370c]']}>
              {item.body}
            </p>
          </article>
        ))
      }
    </div>
  </div>
</section>

{/* 5 giá trị cốt lõi — tiêu đề dính bên trái + pill số & line vàng mờ dần (ngôn ngữ "Tại sao chọn TPG") */}
<section class="bg-[#fbf8f1] text-[#1f1b17]" aria-labelledby="about-values-title">
  <div class="mx-auto w-full max-w-container-max-width px-6 py-12 md:px-8 lg:py-16">
    <div class="grid items-start gap-12 md:grid-cols-[0.85fr_1.15fr] md:gap-16">
      <div class="md:sticky md:top-28">
        <p class="inline-flex rounded-full bg-[#ffedb7] px-4 py-2 text-[0.7rem] font-extrabold uppercase tracking-[0.025em] text-[#5c4500] sm:text-xs">
          Giá trị cốt lõi
        </p>
        <h2
          id="about-values-title"
          class="mt-6 text-balance text-[clamp(1.75rem,2.7vw,3rem)] font-extrabold leading-[1.1] tracking-[-0.03em] text-[#1f1b17]"
        >
          Năm nguyên tắc định hình cách chúng tôi làm việc
        </h2>
        <p class="mt-5 max-w-[34ch] text-sm leading-[1.7] text-[#655c51] sm:text-[0.95rem]">
          Không phải khẩu hiệu — đây là bộ nguyên tắc chi phối mọi quyết định của Tân Phạm Gia.
        </p>
      </div>

      <div class="grid gap-8" data-reveal-stagger>
        {
          coreValues.map((value) => (
            <article data-reveal class="min-w-0">
              <div class="inline-flex max-w-full items-center gap-3 rounded-full border border-[#e8dfcf] bg-[#faf5e9]/95 px-4 py-3 shadow-[0_8px_24px_rgba(65,48,13,0.05)] backdrop-blur-sm">
                <span class="shrink-0 text-lg font-extrabold tabular-nums text-[#8a6700]">{value.num}</span>
                <h3 class="text-sm font-extrabold leading-snug text-[#26211c] sm:text-[0.95rem]">{value.title}</h3>
              </div>
              <div class="relative ml-7 pl-7 pt-5 before:absolute before:bottom-0 before:left-0 before:top-0 before:w-px before:bg-gradient-to-b before:from-[#efbd35]/65 before:via-[#efbd35]/35 before:to-transparent">
                <p class="max-w-[52ch] text-sm leading-[1.7] text-[#655c51] sm:text-[0.94rem]">{value.desc}</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>
