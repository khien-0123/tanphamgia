---
import { missionVision, missionVisionSection, coreValues } from '../../data/gioi-thieu';
import { RHYTHM_WHITE, sectionPy } from '../../lib/section-rhythm';

interface Props {
  sectionBg?: string;
}

const { sectionBg = RHYTHM_WHITE } = Astro.props;

const eyebrowClass = 'font-eyebrow text-xs uppercase tracking-[0.2em] block';

const pillars = [
  {
    label: 'Sứ mệnh',
    icon: 'flag',
    accent: 'border-accent-gold',
    iconColor: 'text-accent-gold',
    labelColor: 'text-accent-gold',
    ...missionVision.mission,
  },
  {
    label: 'Tầm nhìn',
    icon: 'visibility',
    accent: 'border-accent-teal',
    iconColor: 'text-accent-teal',
    labelColor: 'text-accent-teal',
    ...missionVision.vision,
  },
] as const;
---

{/* Định hướng — Sứ mệnh & Tầm nhìn: accent dọc + icon + lead/body (không card) */}
<section class:list={[sectionPy, sectionBg]}>
  <div class="max-w-container-max-width mx-auto px-6 md:px-8">
    <header class="mb-[clamp(2.5rem,5vw,4rem)] max-w-[40rem]">
      <span class:list={[eyebrowClass, 'text-accent-teal mb-4']}>{missionVisionSection.eyebrow}</span>
      <p class="text-text-muted text-base md:text-lg leading-relaxed m-0">
        {missionVisionSection.intro}
      </p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-2 md:gap-x-[clamp(2rem,4vw,4rem)]">
      {
        pillars.map((item, i) => (
          <article
            data-reveal
            class:list={[
              'relative border-l-[3px] pl-6 md:pl-8',
              item.accent,
              i > 0 &&
                'mt-12 pt-12 border-t border-border-subtle md:mt-0 md:pt-0 md:border-t-0',
            ]}
          >
            <header class="flex items-center gap-3 mb-7">
              <span
                class:list={[
                  'inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-surface-alt',
                  item.iconColor,
                ]}
                aria-hidden="true"
              >
                <span class="material-symbols-outlined text-[1.375rem]">{item.icon}</span>
              </span>
              <span
                class:list={[
                  'text-[0.8125rem] uppercase tracking-[0.14em] font-bold',
                  item.labelColor,
                ]}
              >
                {item.label}
              </span>
            </header>

            <p class="relative text-ink-dark text-[clamp(1.25rem,2.1vw,1.75rem)] leading-[1.28] font-semibold text-balance m-0 mb-4 max-w-[34ch]">
              {item.lead}
            </p>
            <p class="relative text-text-muted text-[0.9375rem] md:text-base leading-[1.7] m-0 max-w-[42ch]">
              {item.body}
            </p>
          </article>
        ))
      }
    </div>
  </div>
</section>

{/* 5 giá trị cốt lõi — tiêu đề dính + danh sách kẻ mảnh (không lưới card) */}
<section class:list={['bg-white', sectionPy]}>
  <div class="max-w-container-max-width mx-auto px-6 md:px-8">
    <div class="grid grid-cols-1 md:grid-cols-[0.85fr_1.15fr] gap-[clamp(2.5rem,6vw,6rem)] items-start">
      <div class="md:sticky md:top-10">
        <span class:list={[eyebrowClass, 'text-accent-teal mb-6']}>Giá trị cốt lõi</span>
        <h2
          class="text-ink-dark text-[clamp(1.75rem,3.4vw,3rem)] leading-[1.05] font-bold mb-6 text-balance"
        >
          Năm nguyên tắc định hình cách chúng tôi làm việc
        </h2>
        <p class="text-text-muted max-w-[34ch] leading-relaxed">
          Không phải khẩu hiệu — đây là bộ nguyên tắc chi phối mọi quyết định của Tân Phạm Gia.
        </p>
      </div>

      <div data-reveal-stagger>
        {
          coreValues.map((value, i) => (
            <div
              data-reveal
              class:list={[
                'grid grid-cols-[auto_1fr] gap-[clamp(1.25rem,2.5vw,2.25rem)] items-baseline py-[clamp(1.5rem,2.6vw,2.1rem)]',
                i > 0 && 'border-t border-border-subtle',
              ]}
            >
              <span class="text-accent-gold font-extrabold tabular-nums text-[clamp(1.125rem,1.5vw,1.375rem)] leading-none pt-[0.15rem]">
                {value.num}
              </span>
              <div>
                <h3 class="text-ink-dark text-[clamp(1.125rem,1.7vw,1.375rem)] mb-[0.55rem]">
                  {value.title}
                </h3>
                <p class="text-text-muted text-[0.9375rem] leading-[1.65] max-w-[52ch]">
                  {value.desc}
                </p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
