---
import { missionVision, coreValues } from '../../data/gioi-thieu';
---

<section class="py-8 md:py-12 bg-white">
  <div class="max-w-container-max-width mx-auto px-6 md:px-8">
    <h2
      data-reveal
      class="text-pretty font-headline-md text-xl md:text-4xl font-bold text-ink-dark mb-8 md:mb-10 leading-snug tracking-normal"
    >
      Sứ mệnh, Tầm nhìn & Giá trị cốt{'\u00a0'}lõi
    </h2>

    <div
      data-reveal-stagger
      class="grid md:grid-cols-2 gap-8 md:gap-10 lg:gap-12 mb-8 pb-8 md:mb-10 md:pb-10"
    >
      <div data-reveal>
        <span class="material-symbols-outlined text-accent-gold text-3xl mb-4">flag</span>
        <h3 class="text-accent-gold font-bold uppercase tracking-wider text-sm mb-3">Sứ mệnh</h3>
        <p class="text-ink-dark/85 text-base md:text-lg leading-relaxed">{missionVision.mission}</p>
      </div>
      <div data-reveal class="md:pl-16">
        <span class="material-symbols-outlined text-accent-teal text-3xl mb-4">visibility</span>
        <h3 class="text-accent-teal font-bold uppercase tracking-wider text-sm mb-3">Tầm nhìn</h3>
        <p class="text-ink-dark/85 text-base md:text-lg leading-relaxed">{missionVision.vision}</p>
      </div>
    </div>

    <h3 data-reveal class="text-pretty font-headline-md text-xl md:text-4xl font-bold text-ink-dark mb-8 md:mb-10 leading-snug tracking-normal">5 giá trị cốt lõi</h3>
    <div data-reveal-stagger class="grid gap-y-8 gap-x-12 max-sm:gap-y-5 max-sm:gap-x-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        coreValues.map((value) => (
          <div data-reveal class="flex gap-4 items-start">
            <span class="shrink-0 font-extrabold text-sm text-accent-gold leading-[1.4]">
              {value.num}
            </span>
            <div>
              <h4 class="font-bold text-ink-dark mb-2">{value.title}</h4>
              <p class="text-text-muted text-sm leading-relaxed">{value.desc}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
