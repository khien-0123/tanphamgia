---
import { missionVision, missionVisionSection, coreValues } from '../../data/gioi-thieu';
import { sectionEyebrow } from '../../lib/section-eyebrow';
import { sectionPy } from '../../lib/section-rhythm';
import {
  sectionTitleOnLight,
  textOnLightLead,
  textOnLightTitle,
} from '../../lib/section-typography';

const pillars = [
  {
    label: 'Sứ mệnh',
    icon: 'flag',
    ...missionVision.mission,
  },
  {
    label: 'Tầm nhìn',
    icon: 'visibility',
    ...missionVision.vision,
  },
] as const;
---

{/* Định hướng — Sứ mệnh & Tầm nhìn: hai cột mở, chia bằng đường kẻ nhẹ */}
<section class:list={['bg-[#fbf8f1]', textOnLightTitle]} aria-label="Sứ mệnh và tầm nhìn">
  <div class:list={['mx-auto w-full max-w-container-max-width px-6 md:px-8', sectionPy]}>
    <header data-reveal class="max-w-[44rem]">
      <p class={sectionEyebrow}>{missionVisionSection.eyebrow}</p>
      <h2 class="mt-6 text-balance text-[clamp(1.35rem,2vw,1.9rem)] font-extrabold leading-[1.25] tracking-[-0.025em] text-[#1f1b17]">
        {missionVisionSection.intro}
      </h2>
    </header>

    <div class="mt-10 grid gap-4 sm:gap-5 lg:grid-cols-2" data-reveal-stagger>
      {
        pillars.map((item, index) => (
          <article
            data-reveal
            class:list={[
              'flex min-w-0 flex-col rounded-[1.25rem] p-7 sm:p-9',
              index === 0 ? 'bg-[#0d1b3a] text-white' : 'bg-[#ffc72c] text-[#1f1b17]',
            ]}
          >
            <header class="flex items-center gap-3">
              <span
                class:list={[
                  'grid h-11 w-11 shrink-0 place-items-center rounded-full',
                  index === 0 ? 'bg-white/10 text-[#ffc72c]' : 'bg-[#1f1b17]/10 text-[#1f1b17]',
                ]}
                aria-hidden="true"
              >
                <span class="material-symbols-outlined text-[1.375rem] leading-none">{item.icon}</span>
              </span>
              <span
                class:list={[
                  'text-xs font-extrabold uppercase tracking-[0.14em]',
                  index === 0 ? 'text-[#ffc72c]' : 'text-[#1f1b17]',
                ]}
              >
                {item.label}
              </span>
            </header>

            <p class="mt-6 max-w-[30ch] text-balance text-[clamp(1.2rem,1.9vw,1.6rem)] font-extrabold leading-[1.3] tracking-[-0.02em]">
              {item.lead}
            </p>
            <p class:list={['mt-3 max-w-[46ch] text-sm leading-[1.65] sm:text-[0.95rem]', index === 0 ? 'text-white/75' : 'text-[#43370c]']}>
              {item.body}
            </p>
          </article>
        ))
      }
    </div>
  </div>
</section>

{/* 5 giá trị cốt lõi — tiêu đề trái + danh sách số, không khung card */}
<section class:list={['bg-[#fbf8f1]', textOnLightTitle]} aria-labelledby="about-values-title">
  <div class:list={['mx-auto w-full max-w-container-max-width px-6 md:px-8', sectionPy]}>
    <div class="grid items-start gap-12 md:grid-cols-[0.85fr_1.15fr] md:gap-16">
      <header data-reveal class="md:sticky md:top-28">
        <p class={sectionEyebrow}>Giá trị cốt lõi</p>
        <h2
          id="about-values-title"
          class:list={[sectionTitleOnLight, 'mt-6']}
        >
          Năm nguyên tắc định hình cách chúng tôi làm việc
        </h2>
        <p class:list={['mt-5 max-w-[34ch] text-sm leading-[1.7] sm:text-[0.95rem]', textOnLightLead]}>
          Không phải khẩu hiệu — đây là bộ nguyên tắc chi phối mọi quyết định của Tân Phạm Gia.
        </p>
      </header>

      <div class="grid gap-8" data-reveal-stagger>
        {
          coreValues.map((value) => (
            <article data-reveal class="min-w-0 border-t border-[#e5dfd2] pt-6 first:border-t-0 first:pt-0">
              <div class="flex items-baseline gap-4">
                <span class="shrink-0 text-2xl font-extrabold tabular-nums leading-none text-[#1f1b17] sm:text-3xl">{value.num}</span>
                <h3 class:list={['text-base font-extrabold leading-snug sm:text-lg', textOnLightTitle]}>
                  {value.title}
                </h3>
              </div>
              <p class:list={['mt-3 max-w-[52ch] pl-12 text-sm leading-[1.7] sm:pl-14 sm:text-[0.94rem]', textOnLightLead]}>
                {value.desc}
              </p>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>
