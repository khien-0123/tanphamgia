---
import SiteImage from '../SiteImage.astro';
import { productionCapacity } from '../../data/gioi-thieu';
import { sectionEyebrowWarm } from '../../lib/section-eyebrow';
import { sectionPy } from '../../lib/section-rhythm';
import {
  sectionTitleOnLight,
  textOnDarkLead,
  textOnDarkTitle,
  textOnLightLead,
  textOnLightTitle,
} from '../../lib/section-typography';
---

{/* Năng lực sản xuất — dải navy: chữ + 6 ô số bo tròn | ảnh xưởng bo lớn */}
<section class:list={['bg-[#0d1b3a]', textOnDarkTitle]} id="nang-luc" aria-labelledby="about-capacity-title">
  <div class:list={['mx-auto grid w-full max-w-container-max-width items-stretch gap-10 px-6 md:px-8 lg:grid-cols-[1.08fr_0.92fr] lg:gap-14', sectionPy]}>
    <div data-reveal>
      <p class={sectionEyebrowWarm}>Năng lực sản xuất</p>
      <h2
        id="about-capacity-title"
        class:list={['mt-6 max-w-[16ch] text-balance text-[clamp(2rem,3.2vw,3rem)] font-extrabold leading-[1.08] tracking-[-0.04em]', textOnDarkTitle]}
      >
        Quy mô & Kiểm soát chất lượng
      </h2>
      <p class:list={['mt-5 max-w-[37rem] text-sm leading-[1.65] sm:text-[0.95rem]', textOnDarkLead]}>
        {productionCapacity.intro}
      </p>

      <dl class="mt-9 grid grid-cols-2 gap-3 sm:grid-cols-3 sm:gap-4">
        {
          productionCapacity.stats.map((stat) => (
            <div class="rounded-[1rem] border border-white/10 bg-white/[0.05] p-4 sm:p-5">
              <dt class="text-[clamp(1.2rem,1.9vw,1.7rem)] font-extrabold leading-none tracking-[-0.02em] tabular-nums">
                {stat.value}
              </dt>
              <dd class="m-0 mt-2 text-xs leading-[1.45] text-white/60 sm:text-[0.8rem]">{stat.label}</dd>
            </div>
          ))
        }
      </dl>
    </div>

    <figure data-reveal class="relative m-0 min-h-[20rem] overflow-hidden rounded-[1.75rem] bg-white/5 max-lg:order-first max-lg:min-h-[16rem]">
      <SiteImage
        src={productionCapacity.factoryImage}
        alt="Xưởng may 2.000m² Tân Phạm Gia"
        loading="lazy"
        class="absolute inset-0 h-full w-full object-cover"
        variant="card"
        sizes="(min-width: 1024px) 44vw, 100vw"
      />
      <div class="absolute inset-0 bg-[linear-gradient(to_top,rgba(13,27,58,0.92),rgba(13,27,58,0)_55%)]" aria-hidden="true"></div>
      <figcaption class="absolute bottom-6 left-6 right-6 z-[2]">
        <b class="block text-lg font-extrabold leading-[1.25] tracking-[-0.02em] sm:text-xl">
          Xưởng may 2.000m² đạt chuẩn quốc tế
        </b>
        <span class:list={['mt-2 block text-sm leading-[1.5]', textOnDarkLead]}>
          Máy móc hiện đại nhập khẩu từ Nhật Bản và Đức, đáp ứng đơn hàng khắt khe nhất về kỹ thuật lẫn mỹ thuật.
        </span>
      </figcaption>
    </figure>
  </div>
</section>

{/* Quy trình QC đa tầng — ngôn ngữ thiết kế đồng bộ với quy trình trang chủ */}
<section class:list={['qc-section relative overflow-hidden bg-[#fbf8f1]', textOnLightTitle]} aria-labelledby="about-qc-title">
  <div class="pointer-events-none absolute -right-20 -top-32 h-[28rem] w-[28rem] rounded-full bg-[#f8edc8]" aria-hidden="true"></div>

  <div class:list={['relative mx-auto w-full max-w-container-max-width px-6 md:px-8 pb-24 lg:pb-28', sectionPy]}>
    <header data-reveal class="max-w-[64rem]">
      <p class={sectionEyebrowWarm}>Kiểm soát chất lượng</p>
      <h2
        id="about-qc-title"
        class:list={['mt-6 max-w-[34ch]', sectionTitleOnLight]}
      >
        {productionCapacity.qcTitle}
      </h2>
      <p class:list={['mt-3 max-w-[58rem] text-sm leading-[1.55] sm:text-base', textOnLightLead]}>{productionCapacity.qcDesc}</p>
    </header>

    <div data-reveal class="qc-process-grid relative mt-10 lg:mt-12">
      <div class="qc-process-connector" aria-hidden="true">
        <svg viewBox="0 0 1000 90" preserveAspectRatio="none">
          <path d="M0 45 C 28 27, 48 27, 76 45 S 124 63, 152 45 S 200 27, 228 45 S 276 63, 304 45 S 352 27, 380 45 S 428 63, 456 45 S 504 27, 532 45 S 580 63, 608 45 S 656 27, 684 45 S 732 63, 760 45 S 808 27, 836 45 S 884 63, 912 45 S 960 27, 1000 45" />
        </svg>
      </div>

      <ol class="relative grid list-none grid-cols-1 gap-5 p-0 sm:grid-cols-2 lg:grid-cols-4">
        {
          productionCapacity.qcSteps.map((step, index) => (
            <li class:list={['qc-process-card relative flex min-h-[22rem] flex-col rounded-[1rem] px-5 pb-7 pt-6 text-center shadow-[0_16px_28px_rgba(38,31,21,0.14)] sm:px-6', index % 2 === 0 ? 'bg-[#0d1b3a] text-white' : ['bg-[#ffc72c]', textOnLightTitle]]}>
              <span class:list={['text-xs font-extrabold uppercase tracking-[0.14em]', index % 2 === 0 ? 'text-[#ffc72c]' : textOnLightTitle]}>
                Bước {step.number}
              </span>
              <h3 class="mt-5 flex min-h-[3.5rem] items-center justify-center text-xl font-extrabold leading-[1.18] tracking-[-0.025em]">{step.title}</h3>
              <p class:list={['mt-5 flex-1 text-sm leading-[1.65]', index % 2 === 0 ? 'text-white/75' : 'text-[#43370c]']}>
                {step.description}
              </p>
              <span class="qc-process-number absolute -bottom-[4.05rem] left-1/2 z-10 flex h-12 w-12 -translate-x-1/2 items-center justify-center rounded-full border-[3px] border-[#e1a900] bg-[#fbf8f1] text-sm font-extrabold text-[#9b6d00]">
                {step.number}
              </span>
            </li>
          ))
        }
      </ol>
    </div>

  </div>
</section>

<style>
  .qc-process-connector {
    position: absolute;
    z-index: 0;
    top: calc(100% + 1.55rem - 10px);
    left: 4%;
    width: 92%;
    height: 4rem;
    pointer-events: none;
  }

  .qc-process-connector svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .qc-process-connector path {
    fill: none;
    stroke: #e1a900;
    stroke-width: 2;
  }

  @media (max-width: 1023px) {
    .qc-process-connector {
      display: none;
    }

    .qc-process-number {
      bottom: -1.5rem;
    }

    .qc-process-card {
      margin-bottom: 1.5rem;
    }
  }
</style>
