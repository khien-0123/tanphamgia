---
import { teamDepartments } from '../../data/gioi-thieu';
---

<section class="py-10 md:py-24 bg-white border-b border-border-subtle">
  <div class="max-w-container-max-width mx-auto px-6 md:px-8">
    <h2 data-reveal class="font-headline-md text-2xl md:text-4xl font-bold text-ink-dark mb-12 md:mb-14">
      Đội ngũ nhân sự
    </h2>
    <div data-reveal-stagger class="grid gap-y-10 gap-x-12 sm:grid-cols-2 lg:grid-cols-4">
      {
        teamDepartments.map((dept) => (
          <div data-reveal>
            <span class="material-symbols-outlined text-accent-teal text-2xl mb-3 block">{dept.icon}</span>
            <h3 class="font-bold text-ink-dark mb-2">{dept.title}</h3>
            <p class="text-text-muted text-sm leading-relaxed">{dept.desc}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
