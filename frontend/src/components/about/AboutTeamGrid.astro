---
import SiteImage from '../SiteImage.astro';
import { teamDepartments } from '../../data/gioi-thieu';
import { sectionEyebrow } from '../../lib/section-eyebrow';
import { sectionPy } from '../../lib/section-rhythm';
import { cardMediaHover } from '../../lib/button-classes';
---

<section class="bg-[#fbf8f1] text-[#1f1b17]" aria-labelledby="about-team-title">
  <div class:list={['mx-auto w-full max-w-container-max-width px-6 md:px-8', sectionPy]}>
    <header class="max-w-[44rem]">
      <p class={sectionEyebrow}>Đội ngũ nhân sự</p>
      <h2
        id="about-team-title"
        class="mt-6 text-balance text-[clamp(1.75rem,2.7vw,3rem)] font-extrabold leading-[1.1] tracking-[-0.03em]"
      >
        Bốn bộ phận đồng hành cùng doanh nghiệp
      </h2>
    </header>

    <div data-reveal-stagger class="mt-10 grid gap-4 sm:grid-cols-2 lg:mt-12 lg:grid-cols-4 lg:gap-5">
      {
        teamDepartments.map((dept) => (
          <article
            data-reveal
            class="group relative flex min-h-[20rem] flex-col overflow-hidden rounded-[1rem] shadow-[0_12px_32px_rgba(38,31,21,0.12)] sm:min-h-[22rem]"
          >
            <SiteImage
              src={dept.image}
              alt={dept.alt}
              class:list={['absolute inset-0 h-full w-full object-cover', cardMediaHover]}
              loading="lazy"
              variant="card"
              sizes="(min-width: 1024px) 23vw, (min-width: 640px) 45vw, 100vw"
            />
            <div
              class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/50 to-transparent"
              aria-hidden="true"
            />
            <div class="relative mt-auto flex h-[12.5rem] flex-col px-5 pb-5 pt-4 text-left text-white sm:h-[13rem] sm:px-5">
              <span
                class="grid h-10 w-10 shrink-0 place-items-center rounded-full bg-[#ffc72c] text-[#1f1b17]"
                aria-hidden="true"
              >
                <span class="material-symbols-outlined text-[1.25rem] leading-none">{dept.icon}</span>
              </span>
              <h3 class="mt-2.5 line-clamp-2 min-h-[2.6em] shrink-0 text-[1.05rem] font-extrabold leading-[1.3] tracking-[-0.01em]">
                {dept.title}
              </h3>
              <p class="mt-2 line-clamp-3 min-h-[4.65em] text-sm leading-[1.55] text-white/80">
                {dept.desc}
              </p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
