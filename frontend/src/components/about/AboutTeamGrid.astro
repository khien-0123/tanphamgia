---
import { teamDepartments } from '../../data/gioi-thieu';
import { sectionPy } from '../../lib/section-rhythm';
---

<section class="bg-[#fbf8f1] text-[#1f1b17]" aria-labelledby="about-team-title">
  <div class:list={['mx-auto w-full max-w-container-max-width px-6 md:px-8', sectionPy]}>
    <header class="max-w-[44rem]">
      <p class="inline-flex rounded-full bg-[#ffedb7] px-4 py-2 text-[0.7rem] font-extrabold uppercase tracking-[0.025em] text-[#5c4500] sm:text-xs">
        Đội ngũ nhân sự
      </p>
      <h2
        id="about-team-title"
        class="mt-6 text-balance text-[clamp(1.75rem,2.7vw,3rem)] font-extrabold leading-[1.1] tracking-[-0.03em]"
      >
        Bốn bộ phận đồng hành cùng doanh nghiệp
      </h2>
    </header>

    <div data-reveal-stagger class="mt-10 grid gap-4 sm:grid-cols-2 lg:mt-12 lg:grid-cols-4 lg:gap-5">
      {
        teamDepartments.map((dept) => (
          <article
            data-reveal
            class="flex flex-col rounded-[1rem] border border-[#e5dfd2] bg-white p-6 shadow-[0_8px_20px_rgba(45,35,20,0.06)] transition-transform duration-300 hover:-translate-y-1"
          >
            <div class="flex items-center justify-between">
              <span class="grid h-11 w-11 place-items-center rounded-full bg-[#fff0bd] text-[#8a6700]" aria-hidden="true">
                <span class="material-symbols-outlined text-xl leading-none">{dept.icon}</span>
              </span>
              <span class="text-sm font-extrabold tabular-nums text-[#c18a00]">{dept.num}</span>
            </div>
            <h3 class="mt-5 text-[1.05rem] font-extrabold leading-[1.3] tracking-[-0.01em] text-[#26211c]">{dept.title}</h3>
            <p class="mt-2.5 text-sm leading-[1.6] text-[#6f6a60]">{dept.desc}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
