---
import SiteImage from '../SiteImage.astro';
import type { DocumentItem } from '../../data/tai-lieu';
import { documentCategories } from '../../data/tai-lieu';

interface Props {
  doc: DocumentItem;
  /** Vị trí trong lưới — quyết định tông bìa chữ xen kẽ navy / giấy */
  index: number;
  /** Ẩn khi lọc danh mục khác (SSR + client) */
  hidden?: boolean;
}

const { doc, index, hidden = false } = Astro.props;

const group = documentCategories.find((c) => c.id === doc.category);
const cardLabel = group?.cardLabel ?? 'Tài liệu';
const coverType = doc.coverType ?? cardLabel;
const coverTitle = doc.coverTitle ?? doc.title;
/* Bìa chữ đổi tông theo vị trí để lưới không thành một mảng navy liền khối */
const coverNavy = index % 2 === 0;
---

<article
  data-doc-category={doc.category}
  class:list={[
    'group flex h-full flex-col overflow-hidden rounded-[1.25rem] border border-[#e5dfd2] bg-[#fffcf7] transition-[border-color,transform] duration-300 hover:-translate-y-[3px] hover:border-[#0d1b3a]/20',
    hidden && 'hidden',
  ]}
>
  <div class="relative aspect-[16/10] overflow-hidden border-b border-[#e5dfd2] bg-[#fbf8f1]">
    {
      doc.cover ? (
        <SiteImage
          src={doc.cover}
          alt={`Bìa tài liệu ${doc.title}`}
          class="h-full w-full object-cover transition-transform duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:scale-105"
          variant="card"
        />
      ) : (
        /* Chưa có ảnh bìa thật → dựng bìa chữ, không để ô ảnh trống */
        <div
          class:list={[
            'flex h-full flex-col justify-between p-3 sm:p-4',
            coverNavy ? 'bg-[#0d1b3a] text-white' : 'bg-[#fbf8f1] text-[#1f1b17]',
          ]}
          aria-hidden="true"
        >
          <span class="pointer-events-none absolute inset-2 rounded-[0.5rem] border border-current opacity-20"></span>
          <span
            class:list={[
              'text-[0.55rem] font-bold uppercase tracking-[0.16em] sm:text-[0.6rem] sm:tracking-[0.18em]',
              coverNavy ? 'text-[#ffc933]' : 'text-[#5c4500]',
            ]}
          >
            {coverType}
          </span>
          <span class="line-clamp-3 text-[0.8rem] font-extrabold leading-[1.22] tracking-[-0.02em] sm:text-[0.95rem]">
            {coverTitle}
          </span>
          <span class="self-end text-[0.62rem] font-bold tracking-[0.2em] opacity-60">TPG</span>
        </div>
      )
    }
  </div>

  <div class="flex flex-1 flex-col p-3 pb-3.5 sm:p-4 sm:pb-[1.05rem]">
    <span class="text-[0.58rem] font-bold uppercase tracking-[0.14em] text-[#5c4500] sm:text-[0.62rem] sm:tracking-[0.16em]">
      {cardLabel}
    </span>
    <h3
      class="mt-[0.4rem] min-h-[calc(1.28em*2)] w-full text-[0.8125rem] font-extrabold leading-[1.28] tracking-[-0.015em] text-[#1f1b17] line-clamp-2 [text-wrap:initial] sm:mt-[0.55rem] sm:min-h-[calc(1.32em*2)] sm:text-[0.9375rem] sm:leading-[1.32]"
    >
      {doc.title}
    </h3>

    <div class="mt-auto flex flex-col pt-[0.4rem] sm:pt-[0.55rem]">
      <span class="min-h-[1.25rem] text-[0.65rem] tabular-nums text-[#625a50] sm:text-xs">
        {doc.meta || '\u00a0'}
      </span>
      <div class="pt-[0.7rem] sm:pt-[0.95rem]">
        <button
          type="button"
          class="flex min-h-9 w-full items-center justify-center gap-[0.35rem] rounded-full border border-[#ffc933] bg-transparent px-2 text-[0.68rem] font-extrabold text-[#5c4500] transition-colors duration-200 group-hover:bg-[#ffc933] group-hover:text-[#3f2d00] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#0d1b3a] sm:min-h-10 sm:gap-[0.45rem] sm:text-[0.78rem]"
          data-doc-download
          data-doc-id={doc.id}
        >
          Tải ngay
          <span class="material-symbols-outlined text-sm leading-none sm:text-base" aria-hidden="true">download</span>
        </button>
      </div>
    </div>
  </div>
</article>
