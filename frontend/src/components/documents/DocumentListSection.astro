---
import type { DocumentItem } from '../../data/tai-lieu';
import { docDownloadBtnClass } from '../../lib/form-classes';

interface Props {
  title: string;
  icon: string;
  documents: DocumentItem[];
}

const { title, icon, documents } = Astro.props;
---

<section data-reveal>
  <h2 class="font-headline-md text-xl md:text-2xl font-bold text-ink-dark mb-6">
    {title}
  </h2>
  <ul class="list-none m-0 p-0 flex flex-col gap-2">
    {
      documents.map((doc) => (
        <li>
          <button type="button" class={docDownloadBtnClass} data-doc-download data-doc-id={doc.id}>
            <span class="material-symbols-outlined text-accent-gold">{icon}</span>
            <span>
              <strong class="block text-ink-dark text-[0.9375rem] break-words [overflow-wrap:anywhere]">
                {doc.title}
              </strong>
              <span class="block text-sm text-text-muted">{doc.meta}</span>
            </span>
            <span class="material-symbols-outlined ml-auto text-text-muted">download</span>
          </button>
        </li>
      ))
    }
  </ul>
</section>
