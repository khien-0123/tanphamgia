---
import DocumentListSection from './DocumentListSection.astro';
import {
  brandDocuments,
  catalogueDocuments,
  guideDocuments,
} from '../../data/tai-lieu';
---

<section class="py-12 md:py-16 bg-white border-b border-border-subtle">
  <div class="max-w-container-max-width mx-auto px-6 md:px-8 space-y-10 md:space-y-14">
    <DocumentListSection title="Tài liệu thương hiệu" icon="description" documents={brandDocuments} />
    <DocumentListSection title="Catalogue sản phẩm" icon="menu_book" documents={catalogueDocuments} />
    <DocumentListSection title="Tài liệu hữu ích" icon="lightbulb" documents={guideDocuments} />
  </div>
</section>
