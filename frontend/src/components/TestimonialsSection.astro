---
import type { Testimonial } from '../data/site';

interface Props {
  items: Testimonial[];
  title?: string;
}

const { items, title = 'Khách hàng nói gì về chúng tôi' } = Astro.props;

/** 3 bộ slide để vòng lặp vô hạn */
const SLIDER_SETS = 3;
const sliderItems = Array.from({ length: SLIDER_SETS }, () => items).flat();
const itemsPerSet = items.length;
---

<section class="py-12 md:py-20 bg-white border-b border-border-subtle">
  <div class="max-w-container-max-width mx-auto px-6 md:px-8">
    <h2 class="font-headline-md text-2xl md:text-3xl font-bold text-ink-dark mb-10 md:mb-14">
      {title}
    </h2>
    <div class="clients-testimonials-slider-wrap" data-testimonials-slider>
      <div class="clients-testimonials-slider" aria-label={title} role="region">
        {
          sliderItems.map((item, index) => {
            const setIndex = Math.floor(index / itemsPerSet);
            const isClone = setIndex !== 1;

            return (
              <blockquote
                class="clients-testimonials-slide m-0"
                aria-hidden={isClone ? 'true' : undefined}
                tabindex={isClone ? -1 : undefined}
              >
                <p class="text-text-muted leading-relaxed mb-6 italic">"{item.quote}"</p>
                <footer class="not-italic">
                  <cite class="font-bold text-ink-dark not-italic block">{item.name}</cite>
                  <span class="text-sm text-text-muted">{item.role}</span>
                </footer>
              </blockquote>
            );
          })
        }
      </div>
    </div>
  </div>
</section>

<script src="../scripts/about-testimonials-slider.ts"></script>
