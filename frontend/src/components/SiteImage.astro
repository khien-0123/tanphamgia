---
import { Image } from 'astro:assets';
import type { HTMLAttributes } from 'astro/types';
import {
  SITE_IMAGE_PRESETS,
  resolveSiteImage,
  type SiteImageVariant,
} from '../lib/site-image';

type Props = HTMLAttributes<'img'> & {
  /** Path logic từ siteAssets — ví dụ `/images/hero/fallback.jpg` */
  src: string;
  alt: string;
  variant?: SiteImageVariant;
  /** Path dự phòng khi ảnh chính không có trong assets */
  fallback?: string;
  widths?: number[];
  sizes?: string;
  quality?: number;
};

const {
  src,
  alt,
  class: className,
  variant = 'card',
  loading = 'lazy',
  decoding = 'async',
  widths,
  sizes,
  quality,
  fallback,
  width,
  height,
  draggable,
  style,
  ...rest
} = Astro.props;

const preset = SITE_IMAGE_PRESETS[variant];
const resolved =
  (await resolveSiteImage(src)) ?? (fallback ? await resolveSiteImage(fallback) : undefined);

/** HTMLAttributes cho phép null — Image của Astro chỉ nhận number / undefined */
const imgWidth = width == null ? undefined : Number(width);
const imgHeight = height == null ? undefined : Number(height);
const safeWidth = imgWidth !== undefined && Number.isFinite(imgWidth) ? imgWidth : undefined;
const safeHeight = imgHeight !== undefined && Number.isFinite(imgHeight) ? imgHeight : undefined;

if (!resolved && import.meta.env.DEV) {
  console.warn(`[SiteImage] Không tìm thấy asset cho: ${src}`);
}
---

{
  resolved ? (
    <Image
      src={resolved}
      alt={alt}
      class={className}
      loading={loading}
      decoding={decoding}
      widths={widths ?? preset.widths}
      sizes={sizes ?? preset.sizes}
      quality={quality ?? preset.quality}
      width={safeWidth}
      height={safeHeight}
      draggable={draggable}
      style={style}
      {...rest}
    />
  ) : (
    <img
      src={src}
      alt={alt}
      class={className}
      loading={loading}
      decoding={decoding}
      width={safeWidth}
      height={safeHeight}
      draggable={draggable}
      style={style}
      {...rest}
    />
  )
}
