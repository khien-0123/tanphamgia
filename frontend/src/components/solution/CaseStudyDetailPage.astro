---
import SiteLayout from '../../layouts/SiteLayout.astro';
import CaseStudyStory from '../../components/CaseStudyStory.astro';
import ProjectCardsGrid from '../../components/solution/ProjectCardsGrid.astro';
import { getOtherCaseStudies } from '../../lib/case-study-pool';
import { caseStudyHref, routes, solutionAnchorHref } from '../../lib/routes';
import { getSolutionTheme } from '../../lib/solution-theme';

export interface CaseStudyProject {
  slug: string;
  name: string;
  stats: string;
  field?: string;
  image: string;
  intro: string;
  challenges: string[];
  solutions: string[];
  results: string[];
}

interface Props {
  solutionId: 1 | 2 | 3 | 4;
  solutionSlug: string;
  project: CaseStudyProject;
}

const { solutionId, solutionSlug, project } = Astro.props;

const solutionTheme = getSolutionTheme(solutionId);
const otherProjects = getOtherCaseStudies(solutionSlug, project.slug, 4).map((item) => ({
  name: item.name,
  stats: item.stats,
  field: item.field,
  image: item.image,
  href: caseStudyHref(item.solutionSlug, item.slug),
}));

const seoSuffix: Record<Props['solutionId'], string> = {
  1: 'đồng phục doanh nghiệp sản xuất & FDI',
  2: 'đồng phục văn phòng & tập đoàn',
  3: 'đồng phục FMCG & chuỗi phân phối',
  4: 'đồng phục y tế, spa & dịch vụ',
};
---

<SiteLayout
  title={`${project.name} | Dự án tiêu biểu — Giải pháp ${solutionId}`}
  description={`Case study ${project.name} — ${seoSuffix[solutionId]}.`}
  currentPath={routes.giaiPhap}
  navOverDark={false}
>
  <main class={solutionTheme.page}>
    <section class:list={[solutionTheme.section, 'pt-28 md:pt-32']}>
      <div class="max-w-container-max-width mx-auto px-6 md:px-8">
        <a
          href={solutionAnchorHref(solutionSlug, 'du-an')}
          class="text-sm font-semibold text-accent-teal hover:text-ink-dark transition-colors"
        >
          ← Quay lại Giải pháp {solutionId}
        </a>
        <div class={solutionTheme.heroGrid}>
          <div>
            <h1 class="text-3xl md:text-5xl font-bold leading-tight mb-4">{project.name}</h1>
            <p class="text-text-muted text-sm md:text-base mb-2">{project.stats}</p>
            {
              project.field && (
                <p class="text-sm text-ink-dark/75 mb-4">Lĩnh vực: {project.field}</p>
              )
            }
            <p class="text-text-muted text-base md:text-lg leading-relaxed">{project.intro}</p>
          </div>
          <figure class="m-0">
            <img src={project.image} alt={project.name} class={solutionTheme.heroImageDetail} />
          </figure>
        </div>
      </div>
    </section>

    <section data-reveal class={solutionTheme.section}>
      <div class="max-w-container-max-width mx-auto px-6 md:px-8">
        <CaseStudyStory
          challenges={project.challenges}
          solutions={project.solutions}
          results={project.results}
        />
      </div>
    </section>

    <ProjectCardsGrid
      title="Dự án khác"
      description="Khám phá thêm dự án đã triển khai trong và ngoài nhóm giải pháp này."
      items={otherProjects}
      columns={4}
    />
  </main>
</SiteLayout>
