---
import SiteLayout from '../../layouts/SiteLayout.astro';
import PostEditorialLayout from '../blog/PostEditorialLayout.astro';
import { getCaseBody } from '../../data/bai-viet';
import { getOtherCaseStudies } from '../../lib/case-study-pool';
import { caseStudyHref, routes, solutionAnchorHref, solutionHref } from '../../lib/routes';

export interface CaseStudyProject {
  slug: string;
  name: string;
  stats: string;
  field?: string;
  image: string;
  intro: string;
  challenges: string[];
  solutions: string[];
  results: string[];
}

interface Props {
  solutionId: 1 | 2 | 3 | 4;
  solutionSlug: string;
  project: CaseStudyProject;
}

const { solutionId, solutionSlug, project } = Astro.props;

/*
  Case study dùng CHUNG layout với bài blog (PostEditorialLayout) nhưng GIỮ
  đường dẫn riêng /giai-phap/<nhóm>/du-an/<dự án>. Đưa case study vào /tin-tuc
  vừa sai phân cấp nội dung, vừa tạo hai URL cùng một nội dung.
*/
const blocks = getCaseBody(solutionSlug, project.slug);


const pool = getOtherCaseStudies(solutionSlug, project.slug, 6);

const related = pool.slice(0, 3).map((item) => ({
  href: caseStudyHref(item.solutionSlug, item.slug),
  title: item.name,
  image: item.image,
  alt: `Dự án đồng phục ${item.name}`,
  category: item.field ?? 'Dự án tiêu biểu',
  meta: item.stats,
}));

/* Danh sách chữ ở cột phải đầu trang — nhiều hơn lưới thẻ dưới chân vì
   không tốn diện tích ảnh. */
const sidebarLinks = pool.map((item) => ({
  href: caseStudyHref(item.solutionSlug, item.slug),
  title: item.name,
}));

const seoSuffix: Record<Props['solutionId'], string> = {
  1: 'đồng phục doanh nghiệp sản xuất & FDI',
  2: 'đồng phục văn phòng & tập đoàn',
  3: 'đồng phục FMCG & chuỗi phân phối',
  4: 'đồng phục y tế, spa & dịch vụ',
};
---

<SiteLayout
  title={`${project.name} | Dự án tiêu biểu — Giải pháp ${solutionId}`}
  description={`Case study ${project.name} — ${seoSuffix[solutionId]}.`}
  currentPath={routes.giaiPhap}
  navOverDark={false}
>
  <PostEditorialLayout
    title={project.name}
    excerpt={project.intro}
    category="Case study"
    image={project.image}
    alt={`Đồng phục ${project.name} do Tân Phạm Gia sản xuất`}
    blocks={blocks}
    clientName={project.name}
    clientRole={project.field}
    breadcrumbLabel={`Giải pháp ${solutionId}`}
    breadcrumbHref={solutionHref(solutionSlug)}
    backLabel={`Quay lại Giải pháp ${solutionId}`}
    backHref={solutionAnchorHref(solutionSlug, 'du-an')}
    ctaLabel="Nhận tư vấn cho dự án tương tự"
    ctaHref={routes.lienHe}
    relatedTitle="Dự án khác"
    relatedAllLabel="Xem tất cả dự án"
    relatedAllHref={routes.khachHang}
    related={related}
    sidebarLinksTitle="Dự án liên quan"
    sidebarLinks={sidebarLinks}
  />
</SiteLayout>
