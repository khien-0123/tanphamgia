---
import SiteLayout from '../../layouts/SiteLayout.astro';
import CaseStudyHero from './CaseStudyHero.astro';
import CaseStudyStatsBand from './CaseStudyStatsBand.astro';
import CaseStudyNarrative from './CaseStudyNarrative.astro';
import ProjectCardsGrid from './ProjectCardsGrid.astro';
import { getOtherCaseStudies } from '../../lib/case-study-pool';
import { parseCaseStudyStats } from '../../lib/parse-case-study-stats';
import { caseStudyHref, routes, solutionAnchorHref } from '../../lib/routes';
import { getSolutionTheme } from '../../lib/solution-theme';
import { rhythmBg } from '../../lib/section-rhythm';

export interface CaseStudyProject {
  slug: string;
  name: string;
  stats: string;
  field?: string;
  image: string;
  intro: string;
  challenges: string[];
  solutions: string[];
  results: string[];
}

interface Props {
  solutionId: 1 | 2 | 3 | 4;
  solutionSlug: string;
  project: CaseStudyProject;
}

const { solutionId, solutionSlug, project } = Astro.props;

const solutionTheme = getSolutionTheme(solutionId);
const parsedStats = parseCaseStudyStats(project.stats);
const otherProjects = getOtherCaseStudies(solutionSlug, project.slug, 4).map((item) => ({
  name: item.name,
  stats: item.stats,
  field: item.field,
  image: item.image,
  href: caseStudyHref(item.solutionSlug, item.slug),
}));

const seoSuffix: Record<Props['solutionId'], string> = {
  1: 'đồng phục doanh nghiệp sản xuất & FDI',
  2: 'đồng phục văn phòng & tập đoàn',
  3: 'đồng phục FMCG & chuỗi phân phối',
  4: 'đồng phục y tế, spa & dịch vụ',
};
---

<SiteLayout
  title={`${project.name} | Dự án tiêu biểu — Giải pháp ${solutionId}`}
  description={`Case study ${project.name} — ${seoSuffix[solutionId]}.`}
  currentPath={routes.giaiPhap}
  navOverDark={true}
>
  <main class={solutionTheme.page}>
    <CaseStudyHero
      name={project.name}
      intro={project.intro}
      image={project.image}
      eyebrow={project.field}
      backHref={solutionAnchorHref(solutionSlug, 'du-an')}
      backLabel={`← Quay lại Giải pháp ${solutionId}`}
    />

    <CaseStudyStatsBand stats={parsedStats} />

    <CaseStudyNarrative
      challenges={project.challenges}
      solutions={project.solutions}
      results={project.results}
    />

    <ProjectCardsGrid
      title="Dự án khác"
      description="Khám phá thêm dự án đã triển khai trong và ngoài nhóm giải pháp này."
      items={otherProjects}
      columns={4}
      headerStyle="solution"
      sectionClass={`${rhythmBg(4)} py-16 md:py-24 border-t border-border-subtle`}
    />
  </main>
</SiteLayout>
