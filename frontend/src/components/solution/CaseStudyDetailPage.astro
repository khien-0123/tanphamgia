---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteNav from '../../components/SiteNav.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import SiteCtaSection from '../../components/SiteCtaSection.astro';
import CaseStudyStory from '../../components/CaseStudyStory.astro';
import { getSolutionTheme, solutionBoxCompact } from '../../lib/solution-theme';

export interface CaseStudyProject {
  slug: string;
  name: string;
  stats: string;
  field?: string;
  image: string;
  intro: string;
  challenges: string[];
  solutions: string[];
  results: string[];
}

interface Props {
  solutionId: 1 | 2 | 3 | 4;
  solutionSlug: string;
  project: CaseStudyProject;
  allProjects: CaseStudyProject[];
}

const { solutionId, solutionSlug, project, allProjects } = Astro.props;

const solutionTheme = getSolutionTheme(solutionId);
const otherProjects = allProjects.filter((item) => item.slug !== project.slug);

const seoSuffix: Record<Props['solutionId'], string> = {
  1: 'đồng phục doanh nghiệp sản xuất & FDI',
  2: 'đồng phục văn phòng & tập đoàn',
  3: 'đồng phục FMCG & chuỗi phân phối',
  4: 'đồng phục y tế, spa & dịch vụ',
};
---

<BaseLayout
  title={`${project.name} | Dự án tiêu biểu — Giải pháp ${solutionId}`}
  description={`Case study ${project.name} — ${seoSuffix[solutionId]}.`}
>
  <SiteNav currentPath={`/giai-phap/${solutionSlug}`} />
  <main class={solutionTheme.page}>
    <section class:list={[solutionTheme.section, 'pt-28 md:pt-32']}>
      <div class="max-w-container-max-width mx-auto px-6 md:px-8">
        <a
          href={`/giai-phap/${solutionSlug}#du-an`}
          class="text-sm font-semibold text-accent-teal hover:text-ink-dark transition-colors"
        >
          ← Quay lại Giải pháp {solutionId}
        </a>
        <div class={solutionTheme.heroGrid}>
          <div>
            <h1 class="text-3xl md:text-5xl font-bold leading-tight mb-4">{project.name}</h1>
            <p class="text-text-muted text-sm md:text-base mb-2">{project.stats}</p>
            {
              project.field && (
                <p class="text-sm text-ink-dark/75 mb-4">Lĩnh vực: {project.field}</p>
              )
            }
            <p class="text-text-muted text-base md:text-lg leading-relaxed">{project.intro}</p>
          </div>
          <figure class="m-0">
            <img src={project.image} alt={project.name} class={solutionTheme.heroImageDetail} />
          </figure>
        </div>
      </div>
    </section>

    <section data-reveal class={solutionTheme.section}>
      <div class="max-w-container-max-width mx-auto px-6 md:px-8">
        <CaseStudyStory
          challenges={project.challenges}
          solutions={project.solutions}
          results={project.results}
        />
      </div>
    </section>

    <section data-reveal class={solutionTheme.section}>
      <div class="max-w-container-max-width mx-auto px-6 md:px-8">
        <h2 class="text-2xl md:text-3xl font-bold mb-6">Dự án khác</h2>
        <div class={solutionBoxCompact.grid}>
          {
            otherProjects.map((item) => (
              <article class={solutionBoxCompact.item}>
                <a
                  class={solutionBoxCompact.summary}
                  href={`/giai-phap/${solutionSlug}/du-an/${item.slug}`}
                >
                  <figure class={solutionBoxCompact.media}>
                    <img
                      class="w-full h-full object-cover"
                      src={item.image}
                      alt={item.name}
                      loading="lazy"
                    />
                  </figure>
                  <h3 class={solutionBoxCompact.title}>{item.name}</h3>
                  <p class={solutionBoxCompact.desc}>{item.stats}</p>
                  <span class={solutionBoxCompact.link}>Xem chi tiết</span>
                </a>
              </article>
            ))
          }
        </div>
      </div>
    </section>
  </main>
  <SiteCtaSection />
  <SiteFooter />
</BaseLayout>
