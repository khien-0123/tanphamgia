---
import {
  caseStudyDetailSectionLg,
  caseStudyNarrativeBadge,
  caseStudyNarrativeHeaderGrid,
  caseStudyNarrativeLead,
  caseStudyNarrativeListItem,
  caseStudyNarrativePullResult,
  caseStudyNarrativeResultItem,
  caseStudyNarrativeTitle,
} from '../../lib/case-study-detail-classes';
import { rhythmBg } from '../../lib/section-rhythm';

interface Props {
  challenges: string[];
  solutions: string[];
  results: string[];
}

const { challenges, solutions, results } = Astro.props;

const blocks = [
  {
    num: '01',
    title: 'Thách thức',
    lead: 'Bối cảnh và áp lực vận hành khiến doanh nghiệp cần một giải pháp đồng phục đồng bộ.',
    items: challenges,
    rhythmIndex: 1,
    isResult: false,
  },
  {
    num: '02',
    title: 'Giải pháp',
    lead: 'Cách Tân Phạm Gia triển khai quy trình, chất liệu và kiểm soát chất lượng cho dự án.',
    items: solutions,
    rhythmIndex: 2,
    isResult: false,
  },
  {
    num: '03',
    title: 'Kết quả',
    lead: 'Những thay đổi đo lường được sau khi bàn giao và đưa vào sử dụng thực tế.',
    items: results,
    rhythmIndex: 3,
    isResult: true,
  },
];
---

<div aria-label="Chi tiết dự án">
  {
    blocks.map((block) => (
      <section data-reveal class:list={[caseStudyDetailSectionLg, rhythmBg(block.rhythmIndex)]}>
        <div class="max-w-container-max-width mx-auto px-6 md:px-8">
          <header class:list={caseStudyNarrativeHeaderGrid}>
            <div class="flex items-center gap-3 min-w-0">
              <span class:list={caseStudyNarrativeBadge}>{block.num}</span>
              <h2 class:list={caseStudyNarrativeTitle}>{block.title}</h2>
            </div>
            <p class:list={caseStudyNarrativeLead}>{block.lead}</p>
          </header>

          {
            block.isResult && block.items[0] && (
              <p class:list={caseStudyNarrativePullResult}>{block.items[0]}</p>
            )
          }

          <ul class="m-0 p-0 list-none grid gap-3 md:gap-4" data-reveal-stagger>
            {
              (block.isResult ? block.items.slice(1) : block.items).map((item, index) => (
                <li
                  data-reveal
                  class:list={block.isResult ? caseStudyNarrativeResultItem : caseStudyNarrativeListItem}
                  style={`--reveal-delay:${index * 60}ms`}
                >
                  {item}
                </li>
              ))
            }
          </ul>
        </div>
      </section>
    ))
  }
</div>
