---
import {
  caseStudyDetailHeroGrid,
  caseStudyDetailHeroImageWrap,
  caseStudyDetailHeroSection,
} from '../../lib/case-study-detail-classes';

interface Props {
  name: string;
  intro: string;
  image: string;
  imageClass: string;
  eyebrow?: string;
  backHref: string;
  backLabel: string;
}

const { name, intro, image, imageClass, eyebrow, backHref, backLabel } = Astro.props;
---

<section class:list={caseStudyDetailHeroSection}>
  <div class="max-w-container-max-width mx-auto px-6 md:px-8">
    <a
      href={backHref}
      class="text-sm font-semibold text-accent-teal hover:text-ink-dark transition-colors"
    >
      {backLabel}
    </a>

    <div class:list={caseStudyDetailHeroGrid}>
      <div class="min-w-0">
        {
          eyebrow && (
            <p class="font-eyebrow text-xs uppercase tracking-[0.14em] text-accent-teal mb-3">
              {eyebrow}
            </p>
          )
        }
        <h1 class="text-3xl md:text-5xl lg:text-6xl font-extrabold leading-[1.05] text-ink-dark text-balance mb-5 md:mb-6">
          {name}
        </h1>
        <p class="text-base md:text-lg text-text-muted leading-relaxed max-w-prose">{intro}</p>
      </div>

      <figure class:list={caseStudyDetailHeroImageWrap}>
        <img
          src={image}
          alt={name}
          class:list={[imageClass, 'transition-transform duration-700 hover:scale-[1.03]']}
          loading="eager"
          decoding="async"
        />
      </figure>
    </div>
  </div>
</section>
