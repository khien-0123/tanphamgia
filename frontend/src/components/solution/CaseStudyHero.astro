---
import {
  pageHeroDescription,
  pageHeroEyebrow,
  pageHeroImage,
  pageHeroInner,
  pageHeroScrim,
  pageHeroShell,
  pageHeroTitle,
} from '../../lib/page-hero-shell';

interface Props {
  name: string;
  intro: string;
  image: string;
  eyebrow?: string;
  backHref: string;
  backLabel: string;
}

const { name, intro, image, eyebrow, backHref, backLabel } = Astro.props;
---

<header data-page-hero class:list={[pageHeroShell, 'text-white']}>
  <img alt="" class={pageHeroImage} src={image} loading="eager" decoding="async" />
  <div class={pageHeroScrim} aria-hidden="true"></div>

  <div class={pageHeroInner}>
    <a
      href={backHref}
      class="text-sm font-semibold text-white/65 transition-colors hover:text-accent-gold"
    >
      {backLabel}
    </a>

    <div>
      {eyebrow && <p class:list={[pageHeroEyebrow, 'mb-3 text-accent-gold/90']}>{eyebrow}</p>}
      <h1 class:list={[pageHeroTitle, 'mb-5 md:mb-6 max-w-[24ch]']}>{name}</h1>
      <p class={pageHeroDescription}>{intro}</p>
    </div>
  </div>
</header>
