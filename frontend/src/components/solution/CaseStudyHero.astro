---
import SiteImage from '../SiteImage.astro';
import {
  pageHeroCopy,
  pageHeroDescription,
  pageHeroEyebrow,
  pageHeroImage,
  pageHeroInner,
  pageHeroScrim,
  pageHeroShell,
  pageHeroTitle,
} from '../../lib/page-hero-shell';

interface Props {
  name: string;
  intro: string;
  image: string;
  eyebrow?: string;
  backHref: string;
  backLabel: string;
}

const { name, intro, image, eyebrow, backHref, backLabel } = Astro.props;
---

<header data-page-hero class:list={[pageHeroShell, 'text-white']}>
  <SiteImage alt="" class={pageHeroImage} src={image} loading="eager" decoding="async" variant="hero" />
  <div class={pageHeroScrim} aria-hidden="true"></div>

  <div class={pageHeroInner}>
    <div class={pageHeroCopy}>
      <a
        href={backHref}
        class="mb-8 inline-flex text-sm font-semibold text-white/65 transition-colors hover:text-accent-gold sm:mb-9"
      >
        {backLabel}
      </a>

      {eyebrow && <p class:list={[pageHeroEyebrow, 'mb-3 text-accent-gold/90']}>{eyebrow}</p>}
      <h1 class={pageHeroTitle}>{name}</h1>
      <p class={pageHeroDescription}>{intro}</p>
    </div>
  </div>
</header>
