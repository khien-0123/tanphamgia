---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteNav from '../../components/SiteNav.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import SiteCtaSection from '../../components/SiteCtaSection.astro';
import PageHero from '../../components/PageHero.astro';
import { solutions } from '../../data/site';
import type { SolutionPageContent } from '../../data/solution-page';
import { duAnGiaiPhap1 } from '../../data/giai-phap-1-du-an';
import { duAnGiaiPhap2 } from '../../data/giai-phap-2-du-an';
import { duAnGiaiPhap3 } from '../../data/giai-phap-3-du-an';
import { duAnGiaiPhap4 } from '../../data/giai-phap-4-du-an';

interface Props {
  content: SolutionPageContent;
}

const { content } = Astro.props;

const solution = solutions.find((item) => item.slug === content.slug);
const relatedSolutions = solutions.filter((item) => item.slug !== content.slug);

const projectsBySolution = {
  1: duAnGiaiPhap1,
  2: duAnGiaiPhap2,
  3: duAnGiaiPhap3,
  4: duAnGiaiPhap4,
} as const;

const projects = projectsBySolution[content.solutionId];

/** Bỏ tiền tố "0N. " trong tiêu đề đến từ data */
const heading = (raw: string) => raw.replace(/^\d{2}\.\s*/, '');
---

<BaseLayout title={content.seo.title} description={content.seo.description}>
  <SiteNav solid currentPath="/giai-phap" />

  {/* Banner đồng bộ toàn site */}
  <PageHero
    title={content.hero.title}
    description={content.hero.description}
    bgImage={solution?.image}
    breadcrumb={[
      { label: 'Trang chủ', href: '/' },
      { label: 'Giải pháp', href: '/giai-phap' },
      { label: content.hero.title },
    ]}
  />

  <main class="bg-white text-ink-dark">
    {/* Ngành phù hợp — thanh mảnh, không phải card */}
    <section class="border-b border-border-subtle bg-white">
      <div class="mx-auto max-w-container-max-width px-6 py-5 md:px-8">
        <p class="flex flex-wrap items-center gap-x-5 gap-y-2 text-sm">
          <span class="font-bold text-ink-dark">Phù hợp cho</span>
          {
            content.hero.industries.map((item) => (
              <span class="inline-flex items-center gap-2 text-text-muted">
                <span class="h-1 w-1 rounded-full bg-accent-gold" />
                {item}
              </span>
            ))
          }
        </p>
      </div>
    </section>

    {/* 01. Vấn đề — danh sách phẳng */}
    <section data-reveal class="bg-white py-16 md:py-24">
      <div class="mx-auto max-w-container-max-width px-6 md:px-8">
        <header class="mb-10 max-w-2xl md:mb-12">
          <div class="mb-4 h-1 w-10 rounded-full bg-accent-gold"></div>
          <h2 class="text-balance text-2xl font-bold leading-tight text-ink-dark md:text-4xl">
            {heading(content.sections.issuesTitle)}
          </h2>
        </header>

        <ul class="grid list-none gap-x-12 gap-y-1 p-0 md:grid-cols-2">
          {
            content.issues.map((issue) => (
              <li class="flex items-start gap-3 border-b border-border-subtle py-5">
                <span class="material-symbols-outlined mt-0.5 shrink-0 text-xl text-accent-gold">
                  error
                </span>
                <p class="text-[0.95rem] leading-relaxed text-ink-mid">{issue}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    {/* 02. Giải pháp — ảnh sticky + danh sách phẳng */}
    <section data-reveal class="bg-surface-fresh py-16 md:py-24">
      <div class="mx-auto max-w-container-max-width px-6 md:px-8">
        <header class="mb-10 max-w-2xl md:mb-12">
          <div class="mb-4 h-1 w-10 rounded-full bg-accent-gold"></div>
          <h2 class="text-balance text-2xl font-bold leading-tight text-ink-dark md:text-4xl">
            Giải pháp từ Tân Phạm Gia
          </h2>
        </header>

        <div class="grid gap-8 lg:grid-cols-[0.85fr_1.15fr] lg:gap-14">
          <figure class="m-0 self-start overflow-hidden rounded-2xl lg:sticky lg:top-24">
            <img
              src={solution?.image}
              alt={content.hero.imageAlt}
              loading="lazy"
              class="block aspect-[4/3] w-full object-cover lg:aspect-[4/5]"
            />
          </figure>

          <ul class="m-0 list-none p-0">
            {
              content.plans.map((plan) => (
                <li class="flex gap-4 border-b border-border-subtle/70 py-6 first:pt-0 last:border-0 last:pb-0">
                  <span class="material-symbols-outlined mt-0.5 shrink-0 text-xl text-accent-gold">
                    check_circle
                  </span>
                  <div class="min-w-0">
                    <h3 class="mb-1.5 text-lg font-bold text-ink-dark md:text-xl">{plan.title}</h3>
                    <p class="text-sm leading-relaxed text-text-muted md:text-[0.9375rem]">
                      {plan.desc}
                    </p>
                  </div>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>

    {/* 03. Sản phẩm & chất liệu */}
    <section data-reveal class="bg-white py-16 md:py-24">
      <div class="mx-auto max-w-container-max-width px-6 md:px-8">
        <header class="mb-10 max-w-2xl md:mb-12">
          <div class="mb-4 h-1 w-10 rounded-full bg-accent-gold"></div>
          <h2 class="text-balance text-2xl font-bold leading-tight text-ink-dark md:text-4xl">
            {heading(content.sections.productsTitle)}
          </h2>
        </header>

        <ul class="mb-10 flex list-none flex-wrap gap-2.5 p-0">
          {
            content.products.map((product) => (
              <li class="inline-flex items-center gap-2 rounded-full border border-border-subtle bg-surface-fresh px-4 py-2 text-sm font-medium text-ink-dark">
                <span class="material-symbols-outlined text-base text-accent-teal">apparel</span>
                {product}
              </li>
            ))
          }
        </ul>

        {/* Mobile: danh sách; Desktop: bảng */}
        <div class="grid gap-3 md:hidden">
          {
            content.fabricTable.map((row) => (
              <div class="rounded-xl border border-border-subtle bg-white p-4">
                <div class="mb-3 flex items-baseline justify-between gap-3 border-b border-border-subtle pb-3">
                  <span class="font-bold text-ink-dark">{row.material}</span>
                  <span class="shrink-0 text-xs font-medium text-text-muted">{row.composition}</span>
                </div>
                <dl class="space-y-1.5 text-sm">
                  <div class="flex gap-2">
                    <dt class="shrink-0 text-text-muted">Đặc tính:</dt>
                    <dd class="text-ink-mid">{row.features}</dd>
                  </div>
                  <div class="flex gap-2">
                    <dt class="shrink-0 text-text-muted">Môi trường:</dt>
                    <dd class="text-ink-mid">{row.environment}</dd>
                  </div>
                </dl>
              </div>
            ))
          }
        </div>

        <div class="hidden overflow-hidden rounded-2xl border border-border-subtle md:block">
          <table class="w-full text-left text-sm">
            <thead>
              <tr class="bg-ink-dark text-xs uppercase tracking-wider text-white/90">
                <th class="px-6 py-4 font-semibold">Chất liệu</th>
                <th class="px-6 py-4 font-semibold">Thành phần</th>
                <th class="px-6 py-4 font-semibold">Đặc tính nổi bật</th>
                <th class="px-6 py-4 font-semibold">Môi trường phù hợp</th>
              </tr>
            </thead>
            <tbody>
              {
                content.fabricTable.map((row) => (
                  <tr class="border-t border-border-subtle transition-colors odd:bg-surface-fresh/40 hover:bg-accent-gold-light/50">
                    <td class="px-6 py-4 font-semibold text-ink-dark">{row.material}</td>
                    <td class="px-6 py-4 text-text-muted">{row.composition}</td>
                    <td class="px-6 py-4 text-text-muted">{row.features}</td>
                    <td class="px-6 py-4 text-text-muted">{row.environment}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </div>
    </section>

    {/* 04. Quy trình — timeline phẳng (số bước là chức năng) */}
    <section data-reveal class="bg-surface-fresh py-16 md:py-24">
      <div class="mx-auto max-w-container-max-width px-6 md:px-8">
        <header class="mb-10 max-w-2xl md:mb-12">
          <div class="mb-4 h-1 w-10 rounded-full bg-accent-gold"></div>
          <h2 class="text-balance text-2xl font-bold leading-tight text-ink-dark md:text-4xl">
            Quy trình làm việc — giảm rủi ro cho doanh nghiệp
          </h2>
        </header>

        <ol class="grid list-none gap-x-10 gap-y-7 p-0 sm:grid-cols-2 lg:grid-cols-3">
          {
            content.processSteps.map((step, i) => (
              <li class="flex items-start gap-4">
                <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-accent-gold text-sm font-bold tabular-nums text-ink-dark">
                  {i + 1}
                </span>
                <h3 class="pt-1.5 text-[0.95rem] font-bold leading-snug text-ink-dark">{step}</h3>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    {/* 05. Dự án tiêu biểu — card điều hướng */}
    <section data-reveal id="du-an" class="scroll-mt-24 bg-white py-16 md:py-24">
      <div class="mx-auto max-w-container-max-width px-6 md:px-8">
        <header class="mb-10 max-w-2xl md:mb-12">
          <div class="mb-4 h-1 w-10 rounded-full bg-accent-gold"></div>
          <h2 class="text-balance text-2xl font-bold leading-tight text-ink-dark md:text-4xl">
            Dự án tiêu biểu
          </h2>
        </header>

        <div class="grid gap-6 md:grid-cols-3">
          {
            projects.map((project) => (
              <a
                href={`/giai-phap/${content.slug}/du-an/${project.slug}`}
                class="group flex flex-col overflow-hidden rounded-2xl border border-border-subtle bg-white text-inherit no-underline transition hover:-translate-y-1 hover:border-accent-gold/50 hover:shadow-card"
              >
                <figure class="m-0 aspect-[4/3] overflow-hidden">
                  <img
                    src={project.image}
                    alt={project.name}
                    loading="lazy"
                    class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                  />
                </figure>
                <div class="flex flex-1 flex-col p-6">
                  {project.field && (
                    <span class="mb-1.5 text-xs font-bold uppercase tracking-wider text-accent-teal">
                      {project.field}
                    </span>
                  )}
                  <h3 class="text-lg font-bold text-ink-dark transition-colors group-hover:text-accent-gold">
                    {project.name}
                  </h3>
                  <p class="mt-2 text-xs font-medium text-text-muted">{project.stats}</p>
                  <p class="mt-4 line-clamp-3 text-sm leading-relaxed text-text-muted">
                    {project.intro}
                  </p>
                  <span class="mt-auto inline-flex items-center gap-1.5 pt-5 text-sm font-bold text-accent-teal">
                    Xem chi tiết dự án
                    <span class="material-symbols-outlined text-base transition-transform duration-300 group-hover:translate-x-1">
                      arrow_forward
                    </span>
                  </span>
                </div>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    {/* Giải pháp khác */}
    <section data-reveal class="bg-surface-fresh py-16 md:py-24">
      <div class="mx-auto max-w-container-max-width px-6 md:px-8">
        <header class="mb-10 max-w-2xl md:mb-12">
          <div class="mb-4 h-1 w-10 rounded-full bg-accent-gold"></div>
          <h2 class="text-balance text-2xl font-bold leading-tight text-ink-dark md:text-4xl">
            Các giải pháp đồng phục khác
          </h2>
        </header>

        <div class="grid gap-6 sm:grid-cols-3">
          {
            relatedSolutions.map((item) => (
              <a
                href={`/giai-phap/${item.slug}`}
                class="group flex flex-col overflow-hidden rounded-2xl border border-border-subtle bg-white text-inherit no-underline transition hover:-translate-y-1 hover:border-accent-gold/50 hover:shadow-card"
              >
                <figure class="m-0 aspect-video overflow-hidden">
                  <img
                    src={item.image}
                    alt={item.title}
                    loading="lazy"
                    class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                  />
                </figure>
                <div class="flex flex-1 flex-col p-5">
                  <h3 class="mb-2 text-base font-bold leading-snug text-ink-dark transition-colors group-hover:text-accent-gold">
                    {item.title}
                  </h3>
                  <p class="mb-4 line-clamp-2 text-sm leading-relaxed text-text-muted">{item.desc}</p>
                  <span class="mt-auto inline-flex items-center gap-1.5 text-sm font-bold text-accent-teal">
                    Xem chi tiết
                    <span class="material-symbols-outlined text-base transition-transform duration-300 group-hover:translate-x-1">
                      arrow_forward
                    </span>
                  </span>
                </div>
              </a>
            ))
          }
        </div>
      </div>
    </section>
  </main>

  <SiteCtaSection />
  <SiteFooter />
</BaseLayout>
