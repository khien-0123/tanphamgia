---
import SiteImage from '../SiteImage.astro';
import PageHero from '../PageHero.astro';
import SolutionProcessSection from './SolutionProcessSection.astro';
import ClientCaseStudyGrid from '../clients/ClientCaseStudyGrid.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { RHYTHM_WHITE, SURFACE_PAPER, sectionPy } from '../../lib/section-rhythm';
import { sectionEyebrow } from '../../lib/section-eyebrow';
import { sectionTitle } from '../../lib/section-typography';
import {
  cardMediaHover,
  focusRingOnDark,
  ghostCta,
  ghostCtaArrow,
  ghostCtaLabel,
} from '../../lib/button-classes';
import { solutions, clientCaseStudies } from '../../data/site';
import { siteAssets } from '../../data/assets';
import { listingKeywords } from '../../data/giai-phap-listing';
import type { SolutionPageContent } from '../../data/solution-page';
import { routes } from '../../lib/routes';
import { imageRadius } from '../../lib/image-frame';

interface Props {
  content: SolutionPageContent;
}

const { content } = Astro.props;

const solution = solutions.find((item) => item.slug === content.slug);
const relatedSolutions = solutions.filter((item) => item.slug !== content.slug);

type SolutionLike = { slug: string; bullets: string[]; homeBullets?: string[] };

const keywordsFor = (item: SolutionLike): string[] =>
  listingKeywords[item.slug] ?? item.homeBullets ?? item.bullets.slice(0, 3);

/** Data mang sẵn tiền tố "0N. " — số đó chuyển lên eyebrow, tiêu đề để sạch. */
const heading = (raw: string) => raw.replace(/^\d{2}\.\s*/, '');

const heroId = String(content.solutionId).padStart(2, '0');

/**
 * Mỗi ngành một icon riêng — icon phải PHÂN BIỆT được các mục; lặp cùng một hình
 * thì nó chỉ là chấm tròn tốn chỗ. Khoá theo đúng chuỗi trong data (19 ngành / 4 trang).
 */
const INDUSTRY_ICON: Record<string, string> = {
  'Nhà máy sản xuất': 'factory',
  'Khu công nghiệp': 'location_city',
  'FDI / Tập đoàn nước ngoài': 'public',
  'Logistics & Kho vận': 'local_shipping',
  'Kỹ thuật & Công trình': 'engineering',
  'Tập đoàn & Tổng công ty': 'corporate_fare',
  'Doanh nghiệp dịch vụ': 'support_agent',
  'Ngân hàng & Tài chính': 'account_balance',
  'Bất động sản': 'apartment',
  'Logistics & Chuỗi văn phòng': 'local_shipping',
  'FMCG & Hàng tiêu dùng nhanh': 'shopping_basket',
  'Hệ thống phân phối': 'hub',
  'Đội ngũ Sales thị trường': 'storefront',
  'PG/PB & Activation': 'campaign',
  'Phòng khám & Trung tâm y tế': 'local_hospital',
  'Nha khoa': 'dentistry',
  'Thẩm mỹ viện & Spa': 'spa',
  'Chuỗi chăm sóc sức khỏe': 'health_and_safety',
  'Trung tâm đào tạo': 'school',
};

/**
 * Khung "Phù hợp cho" ở cột phải hero.
 * Trước đây là một dải riêng dưới banner, xếp 5 ngành thành một hàng ngang —
 * 5 tên cộng lại ~96 ký tự nên luôn chiếm gần trọn chiều ngang. Xếp dọc thì
 * tên dài chỉ nở xuống, không đẩy ngang.
 */
const heroAside = {
  label: 'Phù hợp cho',
  countLabel: `${String(content.hero.industries.length).padStart(2, '0')} ngành`,
  items: content.hero.industries.map((name) => ({
    name,
    icon: INDUSTRY_ICON[name] ?? 'business_center',
  })),
};

/** Bộ ảnh macro dùng chung cho bảng so sánh; thứ tự bám đúng nhịp 4 cột của mockup. */
const fabricImages = [
  siteAssets.materials.piquePolyester,
  siteAssets.materials.piqueTiciCvc,
  siteAssets.materials.oxfordTechnical,
  siteAssets.materials.kakiStretch,
] as const;

/**
 * Một cỡ H2 duy nhất cho cả trang — đúng token sectionTitle dùng ở home, about,
 * dịch vụ. Trước đây trang này có ba cỡ khác nhau: 3.25rem cho khối 01/02,
 * 4.75rem cho khối Chất liệu, 3rem cho khối cuối.
 */
const h2Macro = `${sectionTitle} text-ink-dark`;
---

<SiteLayout
  title={content.seo.title}
  description={content.seo.description}
  currentPath={routes.giaiPhap}
>
  <PageHero
    title={content.hero.title}
    bgImage={solution?.image}
    description={content.hero.description}
    breadcrumb={[
      { label: 'Trang chủ', href: routes.home },
      { label: 'Giải pháp', href: routes.giaiPhap },
      { label: `Giải pháp ${heroId}` },
    ]}
    aside={heroAside}
  />

  {/* Nền chung là giấy ấm #FBF8F1 (DESIGN.md §2 luật 3). Trước đây để #FFFCF7 —
      màu đó chỉ dành cho mặt thẻ nổi, không phải nền section. */}
  <main class:list={[SURFACE_PAPER, 'text-ink-dark']}>
    {/* ══ 01 · VẤN ĐỀ — hai cột đều, tiêu đề dính trái ══ */}
    <section class:list={[RHYTHM_WHITE, sectionPy]}>
      <div class="mx-auto max-w-container-max-width px-6 md:px-8">
        <div class="grid items-start gap-x-[clamp(2rem,4vw,4.5rem)] gap-y-10 md:grid-cols-2">
          <div class="md:sticky md:top-28">
            <span class={sectionEyebrow}>01 — Vấn đề</span>
            <h2 class:list={[h2Macro, 'mt-[1.15rem]']}>
              {heading(content.sections.issuesTitle)}
            </h2>
          </div>

          {/* Nét ngăn vẽ bằng border thật trên từng hàng. Trước đây dùng gap-px + nền của <ul>
              lộ qua khe, nhưng mỗi <li> là [data-reveal] nên bị đẩy thành lớp compositing riêng,
              khe 1px giữa hai lớp bị làm tròn mất — nét lúc có lúc không. */}
          <ul class="grid list-none p-0" data-reveal-stagger>
            {
              content.issues.map((issue, i) => (
                <li
                  data-reveal
                  class:list={[
                    'grid grid-cols-[2.25rem_1fr] items-baseline gap-4 border-t border-border-subtle py-4 first:border-t-0',
                    RHYTHM_WHITE,
                  ]}
                >
                  {/* Số dẫn đầu — 1.5rem cố định mọi khổ màn, nên cột chỉ cần đủ ôm 2 chữ số */}
                  <span class="text-[1.5rem] font-extrabold leading-none tabular-nums text-[#5c4500]">
                    {String(i + 1).padStart(2, '0')}
                  </span>
                  <p class="text-[1.0625rem] leading-relaxed text-ink-mid">{issue}</p>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>

    {/* ══ 02 · GIẢI PHÁP — ảnh sticky + cột hairline ══ */}
    <section class:list={[RHYTHM_WHITE, sectionPy]}>
      <div class="mx-auto max-w-container-max-width px-6 md:px-8">
        <div class="grid gap-10 lg:grid-cols-[0.85fr_1.15fr] lg:gap-16">
          <figure
            class:list={['m-0 self-start overflow-hidden lg:sticky lg:top-28', imageRadius]}
          >
            <SiteImage
              src={solution?.image}
              alt={content.hero.imageAlt}
              loading="lazy"
              class="block aspect-[4/5] w-full object-cover object-top"
              variant="card"
            />
          </figure>

          <div>
            <span class={sectionEyebrow}>02 — Giải pháp</span>
            <h2 class:list={[h2Macro, 'mb-10 mt-[1.15rem]']}>Giải pháp từ Tân Phạm Gia</h2>

            <ul class="list-none p-0" data-reveal-stagger>
              {
                content.plans.map((plan) => (
                  <li
                    data-reveal
                    class:list={[
                      'flex gap-3 border-t border-border-subtle py-4 first:border-t-0',
                      RHYTHM_WHITE,
                    ]}
                  >
                    <span class="material-symbols-outlined mt-0.5 shrink-0 text-xl text-accent-teal">
                      check_circle
                    </span>
                    <div class="min-w-0">
                      <h3 class="mb-1.5 text-lg font-bold text-ink-dark md:text-xl">
                        {plan.title}
                      </h3>
                      <p class="text-sm leading-relaxed text-text-muted md:text-[0.9375rem]">
                        {plan.desc}
                      </p>
                    </div>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </div>
    </section>

    {/* ══ 03 · CHẤT LIỆU — bảng mẫu vải so sánh, không sticky-scroll ══ */}
    <section
      class:list={[RHYTHM_WHITE, sectionPy]}
      aria-labelledby="material-comparison-title"
    >
      <div class="mx-auto max-w-container-max-width px-6 md:px-8">
        <header class="grid items-start gap-8 lg:grid-cols-[minmax(0,1.45fr)_minmax(18rem,0.75fr)] lg:gap-16">
          <div data-reveal>
            <span class={sectionEyebrow}>03 — Chất liệu</span>
            <h2
              id="material-comparison-title"
              class:list={[h2Macro, 'mt-[1.15rem]']}
            >
              So sánh nhanh {content.fabricTable.length} nhóm chất liệu
            </h2>
          </div>

          <div data-reveal class="lg:pt-10">
            <p class="max-w-[34rem] text-base leading-[1.65] text-[#4F4942] md:text-lg">
              Nhìn cùng lúc thành phần, đặc tính và môi trường phù hợp để lựa chọn nhanh hơn.
            </p>
          </div>
        </header>

        <div
          data-reveal
          class="mt-10 overflow-hidden rounded-[1.5rem] border border-[#D8CFBF] bg-[#D8CFBF] shadow-[0_24px_70px_rgba(66,50,22,0.08)] md:mt-12"
        >
          <ol
            class="grid list-none grid-cols-1 gap-px p-0 min-[560px]:grid-cols-2 lg:grid-cols-4"
            aria-label="So sánh các chất liệu kỹ thuật"
          >
            {
              content.fabricTable.map((row, index) => (
                <li class="group flex min-w-0 flex-col bg-[#FFFDF8]">
                  <figure class="relative m-0 aspect-[16/10] overflow-hidden min-[560px]:aspect-[4/3] lg:aspect-[7/8]">
                    <SiteImage
                      src={fabricImages[index % fabricImages.length]}
                      alt={`Cận cảnh bề mặt ${row.material}`}
                      loading="lazy"
                      class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.025] motion-reduce:transition-none"
                      variant="card"
                      widths={[320, 480, 640, 800]}
                      sizes="(max-width: 559px) 100vw, (max-width: 1023px) 50vw, 25vw"
                    />
                    {/* #FFC72C là bản trôi của token; chuẩn là accent-gold #FFC933 (DESIGN.md §11) */}
                    <span class="absolute left-4 top-4 inline-flex h-11 min-w-11 items-center justify-center rounded-[0.65rem] bg-accent-gold px-2.5 text-lg font-extrabold leading-none tabular-nums text-[#171717] shadow-[0_8px_20px_rgba(83,58,0,0.18)] sm:left-5 sm:top-5 sm:h-12 sm:min-w-12 sm:text-xl">
                      {String(index + 1).padStart(2, '0')}
                    </span>
                  </figure>

                  <div class="px-4 py-4 sm:px-5 sm:py-5">
                    <h3 class="min-h-[2.75rem] text-[clamp(1.25rem,1.55vw,1.5rem)] font-extrabold leading-[1.08] tracking-[-0.03em] text-ink-dark">
                      {row.material}
                    </h3>

                    <dl class="mt-2.5 grid">
                      <div class="grid min-h-[3.75rem] grid-cols-[5rem_minmax(0,1fr)] items-start gap-2.5 border-t border-[#DDD4C6] py-2.5 xl:grid-cols-[5.5rem_minmax(0,1fr)]">
                        <dt class="pt-0.5 text-[0.625rem] font-extrabold uppercase tracking-[0.09em] text-[#A46F00]">
                          Thành phần
                        </dt>
                        <dd class="m-0 text-[0.8125rem] leading-[1.45] tabular-nums text-[#3D3832]">
                          {row.composition}
                        </dd>
                      </div>
                      <div class="grid min-h-[3.75rem] grid-cols-[5rem_minmax(0,1fr)] items-start gap-2.5 border-t border-[#DDD4C6] py-2.5 xl:grid-cols-[5.5rem_minmax(0,1fr)]">
                        <dt class="pt-0.5 text-[0.625rem] font-extrabold uppercase tracking-[0.09em] text-[#A46F00]">
                          Đặc tính
                        </dt>
                        <dd class="m-0 text-[0.8125rem] leading-[1.45] text-[#3D3832]">
                          {row.features}
                        </dd>
                      </div>
                      <div class="grid min-h-[3.75rem] grid-cols-[5rem_minmax(0,1fr)] items-start gap-2.5 border-t border-[#DDD4C6] py-2.5 xl:grid-cols-[5.5rem_minmax(0,1fr)]">
                        <dt class="pt-0.5 text-[0.625rem] font-extrabold uppercase tracking-[0.09em] text-[#A46F00]">
                          Phù hợp
                        </dt>
                        <dd class="m-0 text-[0.8125rem] leading-[1.45] text-[#3D3832]">
                          {row.environment}
                        </dd>
                      </div>
                    </dl>
                  </div>
                </li>
              ))
            }
          </ol>
          <div class="h-[3px] bg-[#E1A900]" aria-hidden="true"></div>
        </div>
      </div>
    </section>

    {/* ══ CASE STUDY — layout sole giống /khach-hang ══ */}
    <ClientCaseStudyGrid
      items={clientCaseStudies}
      sectionBg="bg-[#fbf8f1]"
      eyebrow="Dự án tiêu biểu"
      title="Case study tiêu biểu"
    />

    {/* ══ 04 · QUY TRÌNH ══ */}
    <SolutionProcessSection
      steps={content.processSteps}
      sectionBg={RHYTHM_WHITE}
      eyebrow="04 — Quy trình"
    />

    {/* ══ GIẢI PHÁP KHÁC — mosaic 1 lớn / 2 nhỏ ══ */}
    <section class:list={[RHYTHM_WHITE, sectionPy]}>
      <div class="mx-auto max-w-container-max-width px-6 md:px-8">
        <header class="mb-10 flex flex-col gap-6 md:mb-12 md:flex-row md:items-end md:justify-between">
          <div>
            <span class={sectionEyebrow}>Tìm hiểu thêm</span>
            <h2 class:list={[h2Macro, 'mt-[1.15rem]']}>Khám phá giải pháp phù hợp</h2>
          </div>

          <a href={routes.giaiPhap} class:list={[ghostCta, 'w-fit']}>
            <span class={ghostCtaLabel}>Xem tất cả giải pháp</span>
            <span aria-hidden="true" class={ghostCtaArrow}>arrow_forward</span>
          </a>
        </header>

        <div class="grid gap-3 sm:gap-5 md:grid-cols-2 lg:grid-rows-2" data-reveal-stagger>
          {
            relatedSolutions.map((item, index) => (
              <a
                data-reveal
                href={item.href}
                class:list={[
                  /* Thẻ nằm trên ảnh tối → viền focus màu trắng (DESIGN.md §Focus).
                     Vàng trên ảnh navy không đủ tương phản để làm dấu focus. */
                  'group relative isolate flex min-h-[300px] flex-col justify-end overflow-hidden rounded-[20px] bg-ink-dark p-5 no-underline sm:p-6',
                  focusRingOnDark,
                  index === 0
                    ? 'md:col-span-2 md:min-h-[420px] lg:col-span-1 lg:row-span-2 lg:min-h-[620px]'
                    : 'lg:min-h-[300px]',
                ]}
              >
                <SiteImage
                  src={item.image}
                  alt={`Đồng phục cho ${item.title}`}
                  loading="lazy"
                  class:list={[
                    'absolute inset-0 -z-20 h-full w-full object-cover',
                    cardMediaHover,
                    item.homeImagePosition ?? 'object-top',
                  ]}
                  variant="card"
                />
                <span aria-hidden="true" class="related-scrim absolute inset-0 -z-10"></span>

                <span
                  aria-hidden="true"
                  class="absolute left-4 top-4 grid h-10 w-10 place-items-center rounded-[11px] border border-white/30 bg-white/15 backdrop-blur-[6px] sm:left-5 sm:top-5"
                >
                  <span class="material-symbols-outlined text-lg leading-none text-white">
                    {item.icon}
                  </span>
                </span>

                <h3 class="pr-14 text-balance text-lg font-extrabold leading-snug text-white sm:text-xl">
                  {item.title}
                </h3>
                <ul class="mt-3 list-none space-y-1 p-0 pr-14 text-xs leading-snug text-white/90 sm:text-[0.8125rem]">
                  {keywordsFor(item).map((keyword) => <li>{keyword}</li>)}
                </ul>

                {/* Mũi tên trần — không vòng tròn, không nền. Trước đây nằm trong
                    huy hiệu tròn màu vàng. */}
                <span
                  aria-hidden="true"
                  class="material-symbols-outlined absolute bottom-4 right-4 text-[1.6rem] leading-none text-accent-gold transition-transform duration-300 group-hover:translate-x-1 motion-reduce:transition-none sm:bottom-5 sm:right-5"
                >
                  arrow_forward
                </span>
              </a>
            ))
          }
        </div>
      </div>
    </section>
  </main>
</SiteLayout>

<style>
  /* ── Giải pháp khác: cùng scrim card với trang /giai-phap ── */
  .related-scrim {
    background: linear-gradient(
      to top,
      rgba(13, 27, 58, 0.94) 0%,
      rgba(13, 27, 58, 0.72) 32%,
      rgba(13, 27, 58, 0.2) 62%,
      rgba(13, 27, 58, 0.06) 100%
    );
  }

</style>
