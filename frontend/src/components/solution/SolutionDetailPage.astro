---
import SiteImage from '../SiteImage.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { sectionPy } from '../../lib/section-rhythm';
import { solutions } from '../../data/site';
import type { SolutionPageContent } from '../../data/solution-page';
import { duAnGiaiPhap1 } from '../../data/giai-phap-1-du-an';
import { duAnGiaiPhap2 } from '../../data/giai-phap-2-du-an';
import { duAnGiaiPhap3 } from '../../data/giai-phap-3-du-an';
import { duAnGiaiPhap4 } from '../../data/giai-phap-4-du-an';
import { caseStudyHref, routes } from '../../lib/routes';
import { imageRadius } from '../../lib/image-frame';
import {
  pageHeroEyebrow,
  pageHeroImage,
  pageHeroInner,
  pageHeroScrim,
  pageHeroShell,
  pageHeroStats,
  pageHeroTitle,
} from '../../lib/page-hero-shell';

interface Props {
  content: SolutionPageContent;
}

const { content } = Astro.props;

const solution = solutions.find((item) => item.slug === content.slug);
const relatedSolutions = solutions.filter((item) => item.slug !== content.slug);

const projectsBySolution = {
  1: duAnGiaiPhap1,
  2: duAnGiaiPhap2,
  3: duAnGiaiPhap3,
  4: duAnGiaiPhap4,
} as const;

const projects = projectsBySolution[content.solutionId];

/** Data mang sẵn tiền tố "0N. " — số đó chuyển lên eyebrow, tiêu đề để sạch. */
const heading = (raw: string) => raw.replace(/^\d{2}\.\s*/, '');

const heroId = String(content.solutionId).padStart(2, '0');

/**
 * Số quy mô ở hero. Rút dải "từ X đến Y" trong mô tả nếu có — đây là con số
 * mạnh nhất; không có thì bỏ qua, ba số còn lại suy từ data nên luôn đúng.
 */
const scaleMatch = content.hero.description.match(/từ\s*([\d.]+)\s*đến\s*([\d.+]+)/i);
const heroStats = [
  scaleMatch && { value: `${scaleMatch[1]}–${scaleMatch[2]}`, label: 'Nhân sự / đội ngũ' },
  { value: String(projects.length).padStart(2, '0'), label: 'Dự án tiêu biểu' },
  { value: String(content.fabricTable.length).padStart(2, '0'), label: 'Chất liệu kỹ thuật' },
].filter(Boolean) as { value: string; label: string }[];

/**
 * Mỗi ngành một icon riêng — icon phải PHÂN BIỆT được các mục; lặp cùng một hình
 * thì nó chỉ là chấm tròn tốn chỗ. Khoá theo đúng chuỗi trong data (19 ngành / 4 trang).
 */
const INDUSTRY_ICON: Record<string, string> = {
  'Nhà máy sản xuất': 'factory',
  'Khu công nghiệp': 'location_city',
  'FDI / Tập đoàn nước ngoài': 'public',
  'Logistics & Kho vận': 'local_shipping',
  'Kỹ thuật & Công trình': 'engineering',
  'Tập đoàn & Tổng công ty': 'corporate_fare',
  'Doanh nghiệp dịch vụ': 'support_agent',
  'Ngân hàng & Tài chính': 'account_balance',
  'Bất động sản': 'apartment',
  'Logistics & Chuỗi văn phòng': 'local_shipping',
  'FMCG & Hàng tiêu dùng nhanh': 'shopping_basket',
  'Hệ thống phân phối': 'hub',
  'Đội ngũ Sales thị trường': 'storefront',
  'PG/PB & Activation': 'campaign',
  'Phòng khám & Trung tâm y tế': 'local_hospital',
  'Nha khoa': 'dentistry',
  'Thẩm mỹ viện & Spa': 'spa',
  'Chuỗi chăm sóc sức khỏe': 'health_and_safety',
  'Trung tâm đào tạo': 'school',
};

/**
 * Ảnh nền cho từng vật liệu trong trình khám phá.
 * Tạm dùng ảnh giải pháp + 3 ảnh dự án (đủ 4, khác nhau, có sẵn) để crossfade
 * hoạt động thật. NÂNG CẤP: thay bằng 4 ảnh macro chụp vải + thêm field ảnh vào
 * fabricTable — lúc đó chỉ cần đổi mảng này.
 */
const fabricImages = [solution?.image, ...projects.map((p) => p.image)].filter(Boolean) as string[];

/** Tách chuỗi stats tự do "1.086 sản phẩm | 45 ngày | Đối tác 5 năm" thành số lớn + đơn vị + phụ chú. */
const parseStat = (raw: string) => {
  const parts = raw.split('|').map((s) => s.trim()).filter(Boolean);
  const m = parts[0]?.match(/^([\d.,+]+)\s*(.*)$/);
  return {
    big: m ? m[1] : parts[0] ?? '',
    unit: m ? m[2] : '',
    meta: parts.slice(1),
  };
};

const proofItems = projects.map((p) => ({
  name: p.name,
  image: p.image,
  href: caseStudyHref(content.slug, p.slug),
  ...parseStat(p.stats),
}));

const chapterEyebrow = 'font-eyebrow text-xs uppercase tracking-[0.2em]';
const h2Macro =
  'text-balance text-[clamp(1.75rem,3.6vw,3.25rem)] font-bold leading-[1.03] text-ink-dark';
---

<SiteLayout
  title={content.seo.title}
  description={content.seo.description}
  currentPath={routes.giaiPhap}
>
  {/* ══ 00 · HERO — 504px, ảnh nền, chữ đè ══ */}
  <header data-page-hero class:list={[pageHeroShell, 'overflow-hidden']}>
    <SiteImage
      src={solution?.image}
      alt={content.hero.imageAlt}
      class={pageHeroImage}
      loading="eager"
      decoding="async"
      variant="hero"
    />
    <div class={pageHeroScrim} aria-hidden="true"></div>
    <div class={pageHeroInner}>
      <p class:list={[pageHeroEyebrow]}>Giải pháp {heroId}</p>
      <div>
        <h1 class:list={[pageHeroTitle, 'max-w-[15ch] md:max-w-[18ch]']}>
          {content.hero.title}
        </h1>
        <div class:list={[pageHeroStats, 'mt-4 md:mt-7']}>
          {
            heroStats.map((s) => (
              <div class="flex items-baseline gap-3">
                <b class="text-lg font-extrabold leading-none tabular-nums text-white md:text-2xl">
                  {s.value}
                </b>
                <span class:list={[pageHeroEyebrow, 'text-white/55']}>{s.label}</span>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </header>

  <main class="bg-white text-ink-dark">
    {/* ══ 01b · NGÀNH — dải mảnh, mỗi ngành một icon ══ */}
    <section class="bg-surface-alt">
      <div class="mx-auto max-w-container-max-width px-6 py-5 md:px-8">
        <p class="flex flex-wrap items-center gap-x-6 gap-y-3 text-sm">
          <span class="font-bold text-ink-dark">Phù hợp cho</span>
          {
            content.hero.industries.map((item) => (
              <span class="inline-flex items-center gap-2 text-ink-mid">
                <span
                  class="material-symbols-outlined text-[1.125rem] leading-none text-accent-teal"
                  aria-hidden="true"
                >
                  {INDUSTRY_ICON[item] ?? 'business_center'}
                </span>
                {item}
              </span>
            ))
          }
        </p>
      </div>
    </section>

    {/* ══ 01 · VẤN ĐỀ — hai cột đều, tiêu đề dính trái ══ */}
    <section class:list={['bg-white', sectionPy]}>
      <div class="mx-auto max-w-container-max-width px-6 md:px-8">
        <div class="grid items-start gap-x-[clamp(2rem,4vw,4.5rem)] gap-y-10 md:grid-cols-2">
          <div class="md:sticky md:top-28">
            <span class:list={[chapterEyebrow, 'mb-5 block text-accent-teal']}>01 — Vấn đề</span>
            <h2 class={h2Macro}>{heading(content.sections.issuesTitle)}</h2>
          </div>

          <ul class="grid list-none gap-px bg-border-subtle p-0" data-reveal-stagger>
            {
              content.issues.map((issue, i) => (
                <li
                  data-reveal
                  class="grid grid-cols-[2.5rem_1fr] items-start gap-4 bg-white py-6"
                >
                  <span class="font-eyebrow text-xs tabular-nums text-text-muted">
                    {String(i + 1).padStart(2, '0')}
                  </span>
                  <p class="text-[1.0625rem] leading-relaxed text-ink-mid">{issue}</p>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>

    {/* ══ 02 · GIẢI PHÁP — ảnh sticky + cột hairline ══ */}
    <section class:list={['bg-surface-alt', sectionPy]}>
      <div class="mx-auto max-w-container-max-width px-6 md:px-8">
        <div class="grid gap-10 lg:grid-cols-[0.85fr_1.15fr] lg:gap-16">
          <figure
            class:list={['m-0 self-start overflow-hidden lg:sticky lg:top-28', imageRadius]}
          >
            <SiteImage
              src={solution?.image}
              alt={content.hero.imageAlt}
              loading="lazy"
              class="block aspect-[4/5] w-full object-cover object-top"
              variant="card"
            />
          </figure>

          <div>
            <span class:list={[chapterEyebrow, 'mb-5 block text-accent-teal']}>02 — Giải pháp</span>
            <h2 class:list={[h2Macro, 'mb-10']}>Giải pháp từ Tân Phạm Gia</h2>

            <ul class="grid list-none gap-px bg-border-subtle p-0" data-reveal-stagger>
              {
                content.plans.map((plan) => (
                  <li data-reveal class="flex gap-4 bg-surface-alt py-6">
                    <span class="material-symbols-outlined mt-0.5 shrink-0 text-xl text-accent-teal">
                      check_circle
                    </span>
                    <div class="min-w-0">
                      <h3 class="mb-1.5 text-lg font-bold text-ink-dark md:text-xl">
                        {plan.title}
                      </h3>
                      <p class="text-sm leading-relaxed text-text-muted md:text-[0.9375rem]">
                        {plan.desc}
                      </p>
                    </div>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </div>
    </section>

    {/* ══ 03 · CHẤT LIỆU — dải navy duy nhất, trình khám phá ghim màn ══ */}
    <section class="exp bg-ink-dark text-white" aria-label="Chất liệu kỹ thuật">
      <div class="exp__stage">
        <div class="exp__left">
          <span class:list={[chapterEyebrow, 'mb-6 block text-accent-gold']}>03 — Chất liệu</span>
          <h2 class="exp__h2">
            {heading(content.sections.productsTitle)}
          </h2>

          <ul class="exp__tags">
            {content.products.map((product) => <li>{product}</li>)}
          </ul>

          <div class="exp__list">
            <span class="exp__bar" data-bar></span>
            {
              content.fabricTable.map((row, i) => (
                <button
                  type="button"
                  class:list={['exp__m', i === 0 && 'on']}
                  data-m={i}
                  aria-label={`Xem ${row.material}`}
                >
                  <span class="font-eyebrow text-xs tabular-nums">
                    {String(i + 1).padStart(2, '0')}
                  </span>
                  <span class="exp__mname">{row.material}</span>
                </button>
              ))
            }
          </div>
        </div>

        <div class="exp__media">
          {
            content.fabricTable.map((row, i) => (
              <div class:list={['exp__shot', i === 0 && 'on']} data-s={i}>
                <SiteImage
                  src={fabricImages[i] ?? solution?.image}
                  alt={row.material}
                  loading="lazy"
                  class="exp__img"
                  variant="card"
                />
                <dl class="exp__spec">
                  <div>
                    <dt>Thành phần</dt>
                    <dd class="tabular-nums">{row.composition}</dd>
                  </div>
                  <div>
                    <dt>Đặc tính</dt>
                    <dd>{row.features}</dd>
                  </div>
                  <div>
                    <dt>Môi trường</dt>
                    <dd>{row.environment}</dd>
                  </div>
                </dl>
              </div>
            ))
          }
        </div>
      </div>

      {/* mốc cuộn — vô hình, đổi vật liệu khi đi qua tâm màn */}
      <div class="exp__steps" aria-hidden="true">
        {content.fabricTable.map((_, i) => <div data-step={i}></div>)}
      </div>

      {/* Mobile: carousel ngang — desktop giữ trình khám phá ghim màn */}
      <div class="exp__mobile mx-auto max-w-container-max-width px-6 md:px-8">
        <span class:list={[chapterEyebrow, 'mb-6 block text-accent-gold']}>03 — Chất liệu</span>
        <h2 class="exp__h2">{heading(content.sections.productsTitle)}</h2>

        <div class="exp__slider" data-fabric-mobile-slider>
          <div class="exp__track" data-fabric-track role="list" aria-label="Danh sách vật liệu">
            {
              content.fabricTable.map((row, i) => (
                <article class="exp__mrow" data-fabric-slide role="listitem">
                  <figure class="m-0 mb-5 aspect-[4/3] overflow-hidden rounded-[4px]">
                    <SiteImage
                      src={fabricImages[i] ?? solution?.image}
                      alt={row.material}
                      loading="lazy"
                      class="h-full w-full object-cover"
                      variant="card"
                    />
                  </figure>
                  <h3 class="mb-4 text-2xl font-bold">{row.material}</h3>
                  <dl class="grid gap-2">
                    <dt>Thành phần</dt>
                    <dd class="tabular-nums">{row.composition}</dd>
                    <dt>Đặc tính</dt>
                    <dd>{row.features}</dd>
                    <dt>Môi trường</dt>
                    <dd>{row.environment}</dd>
                  </dl>
                </article>
              ))
            }
          </div>

          {
            content.fabricTable.length > 1 && (
              <div class="exp__dots" role="tablist" aria-label="Chọn vật liệu">
                {content.fabricTable.map((row, i) => (
                  <button
                    type="button"
                    class="exp__dot"
                    data-fabric-dot={i}
                    role="tab"
                    aria-label={row.material}
                    aria-selected={i === 0 ? 'true' : 'false'}
                  />
                ))}
              </div>
            )
          }
        </div>
      </div>
    </section>

    {/* ══ BẰNG CHỨNG — một dải ba cột, số lớn đè ảnh ══ */}
    <section class:list={['bg-white', sectionPy]}>
      <div class="mx-auto max-w-container-max-width px-6 md:px-8">
        <header class="mb-10 md:mb-12">
          <span class:list={[chapterEyebrow, 'mb-5 block text-accent-teal']}>Bằng chứng</span>
          <h2 class:list={[h2Macro, 'md:whitespace-nowrap']}>
            Đã giao cho những đội ngũ ở quy mô này
          </h2>
        </header>

        <div class="grid list-none gap-px bg-border-subtle sm:grid-cols-3" data-reveal-stagger>
          {
            proofItems.map((item) => (
              <a href={item.href} class="proof-case group" data-reveal>
                <SiteImage src={item.image} alt="" loading="lazy" class="proof-case__img" variant="card" />
                <div class="proof-case__in">
                  <span class:list={[chapterEyebrow, 'mb-4 block text-accent-gold']}>
                    {item.name}
                  </span>
                  <p class="text-[clamp(2.75rem,5vw,4.25rem)] font-extrabold leading-[0.85] tracking-tight tabular-nums text-white">
                    {item.big}
                  </p>
                  {item.unit && <p class="mt-1 text-sm text-white/65">{item.unit}</p>}
                  {
                    item.meta.length > 0 && (
                      <p class="mt-5 flex flex-wrap gap-x-4 gap-y-1 text-xs text-white/55">
                        {item.meta.map((m) => (
                          <span>{m}</span>
                        ))}
                      </p>
                    )
                  }
                </div>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    {/* ══ 04 · QUY TRÌNH — số thứ tự khổng lồ dẫn dắt ══ */}
    <section class:list={['bg-white', sectionPy]}>
      <div class="mx-auto max-w-container-max-width px-6 md:px-8">
        <span class:list={[chapterEyebrow, 'mb-5 block text-accent-teal']}>04 — Quy trình</span>
        <h2 class:list={[h2Macro, 'mb-12 max-w-[22ch] md:mb-16']}>
          Sáu bước, minh bạch từ yêu cầu đến hậu mãi
        </h2>

        <ol class="flow-rail bg-border-subtle" data-reveal-stagger>
          {
            content.processSteps.map((step, i) => (
              <li class="flow-step" data-reveal>
                <span class="flow-no tabular-nums" aria-hidden="true">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <h3>{step}</h3>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    {/* ══ GIẢI PHÁP KHÁC — dải điều hướng mảnh ══ */}
    <section class:list={['bg-surface-alt', sectionPy]}>
      <div class="mx-auto max-w-container-max-width px-6 md:px-8">
        <span class:list={[chapterEyebrow, 'mb-8 block text-accent-teal']}>Chuyển hướng</span>
        <div class="grid list-none gap-px bg-border-subtle">
          {
            relatedSolutions.map((item) => (
              <a href={item.href} class="more-row group bg-surface-alt">
                <span class="font-eyebrow text-xs tabular-nums text-text-muted">
                  {String(item.slug.replace(/\D/g, '')).padStart(2, '0')}
                </span>
                <h3 class="text-[clamp(1.25rem,2.4vw,1.875rem)] font-bold text-ink-dark transition-colors group-hover:text-accent-teal">
                  {item.title}
                </h3>
                <span
                  class="material-symbols-outlined text-accent-teal transition-transform duration-300 group-hover:translate-x-1.5"
                  aria-hidden="true"
                >
                  arrow_forward
                </span>
              </a>
            ))
          }
        </div>
      </div>
    </section>
  </main>
</SiteLayout>

<style>
  /* ── Trình khám phá vật liệu (03) ── */
  .exp {
    position: relative;
    height: 380vh;
  }
  .exp__stage {
    position: sticky;
    top: 0;
    display: grid;
    height: 100svh;
    grid-template-columns: 1fr 1.1fr;
    overflow: hidden;
  }
  .exp__left {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 4rem clamp(1.5rem, 5vw, 6rem);
  }
  .exp__h2 {
    font-size: clamp(1.5rem, 2.4vw, 2.25rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.02em;
    text-wrap: balance;
    max-width: 20ch;
    margin: 0 0 2.5rem;
  }
  .exp__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin: 0 0 3rem;
    padding: 0;
    list-style: none;
  }
  .exp__tags li {
    background: rgb(255 255 255 / 0.07);
    padding: 0.55rem 1.1rem;
    border-radius: 999px;
    font-size: 0.8125rem;
    color: rgb(255 255 255 / 0.9);
  }
  .exp__list {
    position: relative;
    padding-left: 2.25rem;
  }
  .exp__list::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.35rem;
    bottom: 0.35rem;
    width: 1px;
    background: rgb(255 255 255 / 0.14);
  }
  .exp__bar {
    position: absolute;
    left: 0;
    top: 0.35rem;
    width: 2px;
    height: calc((100% - 0.7rem) / 4);
    background: #ffc933;
    transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .exp__m {
    display: flex;
    align-items: baseline;
    gap: 1.5rem;
    width: 100%;
    padding: 0.7rem 0;
    background: none;
    border: 0;
    text-align: left;
    cursor: pointer;
    color: rgb(255 255 255 / 0.25);
    transition: color 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .exp__mname {
    font-size: clamp(1.375rem, 2.8vw, 2.5rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.15;
  }
  .exp__m.on {
    color: #fff;
  }
  .exp__media {
    position: relative;
    overflow: hidden;
  }
  .exp__shot {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 1s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .exp__shot.on {
    opacity: 1;
  }
  .exp__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.08);
    transition: transform 1.6s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .exp__shot.on .exp__img {
    transform: scale(1);
  }
  .exp__spec {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    margin: 0;
    padding: 2.5rem clamp(1.5rem, 3vw, 3rem);
    background: linear-gradient(to top, rgb(11 31 53 / 0.94), rgb(11 31 53 / 0));
  }
  .exp__spec div {
    padding-right: 1.25rem;
  }
  .exp__spec dt {
    margin-bottom: 0.55rem;
    font-family: var(--font-body);
    font-size: 0.625rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #FFC933;
  }
  .exp__spec dd {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.5;
    color: #fff;
  }
  .exp__steps {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .exp__steps > div {
    height: 95vh;
  }
  .exp__mobile {
    display: none;
  }
  @media (max-width: 900px) {
    .exp {
      height: auto;
    }
    .exp__stage,
    .exp__steps {
      display: none;
    }
    .exp__mobile {
      display: block;
      padding-block: 4.5rem;
    }
    .exp__slider {
      margin-top: 2rem;
    }
    .exp__track {
      display: flex;
      gap: 1rem;
      overflow-x: auto;
      overscroll-x: contain;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }
    .exp__track::-webkit-scrollbar {
      display: none;
    }
    .exp__mrow {
      flex: 0 0 100%;
      scroll-snap-align: start;
      min-width: 0;
    }
    .exp__dots {
      display: flex;
      justify-content: center;
      gap: 0.5rem;
      margin-top: 1.75rem;
    }
    .exp__dot {
      width: 0.5rem;
      height: 0.5rem;
      padding: 0;
      border: 0;
      border-radius: 999px;
      background: rgb(255 255 255 / 0.35);
      cursor: pointer;
      transition:
        width 0.25s ease,
        background-color 0.25s ease;
    }
    .exp__dot[aria-selected='true'] {
      width: 1.5rem;
      background: #ffc933;
    }
    .exp__mobile dt {
      font-family: var(--font-body);
      font-size: 0.625rem;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: #FFC933;
    }
    .exp__mobile dd {
      margin: 0 0 0.5rem;
      font-size: 0.9375rem;
      color: rgb(255 255 255 / 0.8);
    }
  }

  /* ── Bằng chứng: ảnh nền + số đè ── */
  .proof-case {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: 20rem;
    overflow: hidden;
    background: #0E2640;
    text-decoration: none;
    isolation: isolate;
  }
  .proof-case__img {
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.2s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .proof-case::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      to top,
      rgb(11 31 53 / 0.88) 0%,
      rgb(11 31 53 / 0.42) 52%,
      transparent 90%
    );
  }
  .proof-case:hover .proof-case__img {
    transform: scale(1.06);
  }
  .proof-case__in {
    width: 100%;
    padding: 2rem;
  }
  @media (max-width: 640px) {
    .proof-case {
      min-height: 16rem;
    }
  }

  /* ── Quy trình: số thứ tự khổng lồ ── */
  .flow-rail {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 1px;
    margin: 0;
    padding: 0;
    list-style: none;
    overflow: hidden;
  }
  .flow-step {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 0.75rem;
    overflow: hidden;
    background: #fff;
    padding: 1.5rem 1rem 1.75rem;
    min-height: 9.5rem;
  }
  .flow-no {
    display: block;
    flex-shrink: 0;
    margin: 0;
    font-size: clamp(2.25rem, 4.2vw, 3.75rem);
    font-weight: 800;
    letter-spacing: -0.05em;
    line-height: 1;
    color: rgb(14 38 64 / 0.07);
    pointer-events: none;
    user-select: none;
    transition: color 0.4s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .flow-step h3 {
    position: relative;
    margin: 0;
    flex: 1;
    min-width: 0;
    font-size: 0.9375rem;
    font-weight: 700;
    line-height: 1.45;
    color: #0e2640;
  }
  .flow-step h3::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -0.55rem;
    width: 1.6rem;
    height: 3px;
    background: #FFC933;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .flow-step:hover .flow-no {
    color: rgb(14 38 64 / 0.1);
  }
  .flow-step:hover h3::after {
    transform: scaleX(1);
  }
  @media (max-width: 1000px) {
    .flow-rail {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .flow-step {
      padding: 1.75rem 1.25rem;
      min-height: 8rem;
    }
    .flow-step h3 {
      font-size: 1rem;
    }
  }
  @media (max-width: 560px) {
    .flow-rail {
      grid-template-columns: 1fr;
    }
  }

  /* ── Giải pháp khác: dòng điều hướng ── */
  .more-row {
    display: grid;
    grid-template-columns: 3.5rem 1fr auto;
    gap: 1.5rem;
    align-items: center;
    padding: 2rem 0;
    text-decoration: none;
    transition: padding-left 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .more-row:hover {
    padding-left: 1.25rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .exp {
      height: auto;
    }
    .exp__stage {
      position: static;
      height: auto;
    }
  }
</style>

<script>
  /* Trình khám phá vật liệu — zero thư viện, một IntersectionObserver.
     Cuộn qua mốc → đổi vật liệu; bấm tên vải cũng đổi được. */
  const root = document.querySelector<HTMLElement>('.exp');
  if (root) {
    const names = Array.from(root.querySelectorAll<HTMLElement>('.exp__m'));
    const shots = Array.from(root.querySelectorAll<HTMLElement>('.exp__shot'));
    const bar = root.querySelector<HTMLElement>('[data-bar]');

    const activate = (i: number) => {
      names.forEach((n, k) => n.classList.toggle('on', k === i));
      shots.forEach((s, k) => s.classList.toggle('on', k === i));
      if (bar) bar.style.transform = `translateY(${i * 100}%)`;
    };

    names.forEach((n, i) => n.addEventListener('click', () => activate(i)));

    const steps = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            const i = Number((e.target as HTMLElement).dataset.step);
            if (!Number.isNaN(i)) activate(i);
          }
        });
      },
      { rootMargin: '-50% 0px -50% 0px' },
    );
    root.querySelectorAll<HTMLElement>('[data-step]').forEach((el) => steps.observe(el));
  }

  /* Carousel vật liệu — chỉ hiển thị mobile (<900px) */
  const fabricSlider = document.querySelector<HTMLElement>('[data-fabric-mobile-slider]');
  if (fabricSlider) {
    const track = fabricSlider.querySelector<HTMLElement>('[data-fabric-track]');
    const slides = track
      ? [...track.querySelectorAll<HTMLElement>('[data-fabric-slide]')]
      : [];
    const dots = [...fabricSlider.querySelectorAll<HTMLButtonElement>('[data-fabric-dot]')];

    if (track && slides.length > 1) {
      const getStep = () => {
        const first = slides[0];
        const second = slides[1];
        if (!first) return 0;
        if (second) return second.offsetLeft - first.offsetLeft;
        const gap = parseFloat(getComputedStyle(track).columnGap || getComputedStyle(track).gap) || 0;
        return first.offsetWidth + gap;
      };

      const getActiveIndex = () => {
        const step = getStep();
        if (step <= 0) return 0;
        return Math.min(slides.length - 1, Math.round(track.scrollLeft / step));
      };

      const syncDots = () => {
        const active = getActiveIndex();
        dots.forEach((dot, index) => {
          dot.setAttribute('aria-selected', index === active ? 'true' : 'false');
        });
      };

      const scrollToIndex = (index: number) => {
        const step = getStep();
        if (step <= 0) return;
        track.scrollTo({ left: Math.round(step * index), behavior: 'smooth' });
      };

      let scrollTimer: ReturnType<typeof setTimeout> | undefined;

      track.addEventListener(
        'scroll',
        () => {
          clearTimeout(scrollTimer);
          scrollTimer = setTimeout(syncDots, 80);
        },
        { passive: true },
      );
      track.addEventListener('scrollend', syncDots);

      dots.forEach((dot, index) => {
        dot.addEventListener('click', () => scrollToIndex(index));
      });

      window.addEventListener('resize', syncDots);
      syncDots();
    }
  }
</script>
