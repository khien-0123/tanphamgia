---
import { sectionPy } from '../../lib/section-rhythm';
import { sectionEyebrow } from '../../lib/section-eyebrow';
import { textOnLightLead, textOnLightTitle } from '../../lib/section-typography';

interface Props {
  steps: string[];
  sectionBg?: string;
  eyebrow?: string;
}

const { steps, sectionBg, eyebrow } = Astro.props;

const processDetails = [
  {
    description: 'Tiếp nhận nhu cầu, số lượng, ngân sách và tư vấn chất liệu, form dáng phù hợp.',
    colors: ['#FFC933', '#FFC933'],
    icon: '<path d="M5 13v-2a7 7 0 0 1 14 0v2M5 13H3v5h4v-5H5Zm14 0h2v5h-4v-5h2Zm0 5c0 2-2 3-5 3" />',
  },
  {
    description: 'Phát triển thiết kế theo nhận diện thương hiệu, cân chỉnh và gửi báo giá chi tiết.',
    colors: ['#0D1B3A', '#0D1B3A'],
    icon: '<path d="m12 4 3 3 3-2 3 4-4 3v8H7v-8L3 9l3-4 3 2 3-3Z" />',
  },
  {
    description: 'May mẫu thử để kiểm tra form dáng, màu sắc và chất liệu trước khi sản xuất hàng loạt.',
    colors: ['#FFC933', '#FFC933'],
    icon: '<path d="M7 3h10v18H7zM10 7h4m-4 4h4m-4 4h4" />',
  },
  {
    description: 'Thống nhất đơn giá, số lượng, bảng size, tiến độ, đổi trả và lịch thanh toán.',
    colors: ['#0D1B3A', '#0D1B3A'],
    icon: '<path d="M8 3h8v4H8zM6 5H4v16h16V5h-2M8 12l3 3 5-6" />',
  },
  {
    description: 'Sản xuất theo mẫu duyệt, kiểm soát nhiều lớp từ chất liệu, đường may đến đóng gói.',
    colors: ['#FFC933', '#FFC933'],
    icon: '<path d="M5 8h14v12H5zM8 8V4h8v4M8 13h8m-8 3h5" />',
  },
  {
    description: 'Bàn giao đúng số lượng, tiến độ và hỗ trợ các nhu cầu phát sinh sau đơn hàng.',
    colors: ['#0D1B3A', '#0D1B3A'],
    icon: '<path d="m4 8 8-4 8 4-8 4-8-4Zm0 0v9l8 4 8-4V8m-8 4v9" />',
  },
];
---

<section class:list={[sectionPy, sectionBg]}>
  <div class="mx-auto max-w-container-max-width px-4 sm:px-6 md:px-8">
    <div class="process-panel relative overflow-hidden">
      <div class="process-glow process-glow-left" aria-hidden="true"></div>
      <div class="process-glow process-glow-right" aria-hidden="true"></div>

      <header data-reveal class="relative z-10">
        {
          eyebrow && (
            <div class="mb-[1.15rem] text-left">
              <span class={sectionEyebrow}>{eyebrow}</span>
            </div>
          )
        }
        <div class="mx-auto text-center">
          <h2 class:list={['text-balance text-[clamp(1.75rem,2.7vw,3rem)] font-extrabold uppercase leading-[1.1] tracking-[-0.03em]', textOnLightTitle]}>
            Quy trình <span class="process-gradient-text">làm việc</span>
          </h2>
          <p class:list={['mt-4 text-base font-medium leading-relaxed', textOnLightLead]}>
            Quy trình làm việc - giảm rủi ro cho doanh nghiệp
          </p>
          <span class="process-heading-line mt-5 inline-block h-1 w-24 rounded-full"></span>
        </div>
      </header>

      <ol class="process-grid relative z-10 mt-12 list-none p-0 md:mt-16">
        {steps.map((step, i) => {
          const detail = processDetails[i];
          if (!detail) return null;
          return (
            <li data-reveal class="process-step" style={`--reveal-delay:${i * 60}ms;--from:${detail.colors[0]};--to:${detail.colors[1]}`}>
              <div class="process-node" aria-hidden="true">
                <svg viewBox="0 0 24 24" set:html={detail.icon}></svg>
              </div>
              <article class="process-card">
                <span class="process-no tabular-nums" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                <h3>{step}</h3>
                <span class="process-accent" aria-hidden="true"></span>
                <p>{detail.description}</p>
              </article>
            </li>
          );
        })}
      </ol>
    </div>
  </div>
</section>

<style>
  .process-glow { position: absolute; width: 26rem; height: 26rem; top: 50%; transform: translateY(-50%); border-radius: 999px; background: radial-gradient(circle, rgb(255 190 39 / 0.55), rgb(255 235 183 / 0.1) 62%, transparent 72%); }
  .process-glow-left { left: -10rem; }
  .process-glow-right { right: -10rem; }
  .process-gradient-text { color: #1f1b17; }
  .process-heading-line { background: #FFC933; }
  .process-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2rem 0.75rem; }
  .process-step { position: relative; min-width: 0; padding-top: 2.5rem; }
  .process-node { position: absolute; z-index: 3; top: 0; left: 50%; display: grid; width: 5rem; height: 5rem; translate: -50% 0; place-items: center; border: 0; border-radius: 999px; color: white; background: linear-gradient(145deg, var(--from), var(--to)); box-shadow: 0 10px 22px color-mix(in srgb, var(--to) 30%, transparent); }
  .process-node svg { width: 2rem; height: 2rem; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .process-card { display: flex; min-height: 15rem; height: 100%; padding: 4rem 1rem 1.5rem; flex-direction: column; border: 1px solid #ebeaf0; border-radius: 1.35rem; background: linear-gradient(155deg, #fff 48%, color-mix(in srgb, var(--from) 13%, white)); box-shadow: 0 14px 30px rgb(30 36 60 / 0.09); }
  .process-no { display: block; color: #e7e8ee; font-size: 2.65rem; font-weight: 800; line-height: 1; letter-spacing: -0.06em; }
  .process-card h3 { min-height: 2.8em; margin-top: 1rem; color: #1f1b17; font-size: 0.875rem; font-weight: 800; line-height: 1.4; }
  .process-accent { display: block; width: 2rem; height: 0.18rem; margin-top: 0.9rem; border-radius: 999px; background: linear-gradient(90deg, var(--from), var(--to)); }
  .process-card p { margin-top: 1rem; color: #625a50; font-size: 0.75rem; line-height: 1.65; }
  @media (min-width: 768px) { .process-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 2.5rem 1rem; } }
  @media (min-width: 1280px) {
    .process-grid { grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 0; }
    .process-step { padding-inline: 0.35rem; }
    .process-step:not(:last-child)::before { content: ''; position: absolute; z-index: 1; top: 2.45rem; left: calc(50% + 2.5rem); width: calc(50% - 2rem); height: 0.22rem; background: #0D1B3A; }
    .process-step:nth-child(1)::before,
    .process-step:nth-child(3)::before,
    .process-step:nth-child(5)::before { background: #FFC933; }
    .process-step:not(:last-child)::after { content: ''; position: absolute; z-index: 4; top: 2.56rem; right: -0.5rem; width: 0.7rem; height: 0.7rem; border-top: 0.22rem solid var(--to); border-right: 0.22rem solid var(--to); transform: translateY(-50%) rotate(45deg); transform-origin: center; }
    .process-card { min-height: 17.5rem; padding-inline: 1.6rem 2.75rem; border: 0; border-radius: 1rem 0 0 0; clip-path: polygon(0 0, calc(100% - 2.25rem) 0, 100% 50%, calc(100% - 2.25rem) 100%, 0 100%); filter: drop-shadow(0 14px 22px rgb(30 36 60 / 0.1)); }
    .process-card h3 { min-height: 4.2em; }
    .process-accent { flex: 0 0 auto; }
    .process-card p { margin-top: 1rem; }
  }
</style>
