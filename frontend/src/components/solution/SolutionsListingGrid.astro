---
import SiteImage from '../SiteImage.astro';
import { solutions } from '../../data/site';
import { imageRadius } from '../../lib/image-frame';
import { RHYTHM_WHITE, sectionPy } from '../../lib/section-rhythm';

interface Props {
  sectionBg?: string;
}

const { sectionBg = RHYTHM_WHITE } = Astro.props;
---

<section class:list={[sectionPy, sectionBg]}>
  <div class="max-w-container-max-width mx-auto px-6 md:px-8">
    <header data-reveal class="max-w-3xl mb-14 md:mb-20">
      <p class="font-eyebrow text-xs uppercase tracking-widest text-accent-teal mb-4">
        Tuyển tập · 04 phân khúc
      </p>
      <h2 class="font-headline-md text-4xl md:text-5xl font-extrabold text-ink-dark mb-5 text-balance">
        Chọn ngành của bạn
      </h2>
      <p class="text-text-muted text-base md:text-lg leading-relaxed max-w-[58ch] text-pretty">
        Mỗi phân khúc xây trên pain points thực tế và một quy trình triển khai 6 bước nhất quán. Mở
        từng ngành để xem chi tiết.
      </p>
    </header>

    <div class="grid gap-10 lg:grid-cols-[1fr_minmax(0,30rem)] lg:items-start lg:gap-16 xl:gap-20">
      <!-- SÂN KHẤU ẢNH (desktop) — đổi theo ngành đang mở -->
      <div
        class={`relative order-2 hidden aspect-[4/5] overflow-hidden bg-surface-alt ring-1 ring-border-subtle lg:sticky lg:top-28 lg:block ${imageRadius}`}
      >
        {
          solutions.map((item, i) => (
            <SiteImage
              data-stage={i}
              data-active={i === 0 ? 'true' : 'false'}
              src={item.image}
              alt={item.title}
              loading="lazy"
              class="absolute inset-0 h-full w-full object-cover object-top opacity-0 transition-opacity duration-500 data-[active=true]:opacity-100"
              variant="card"
            />
          ))
        }
      </div>

      <!-- DANH SÁCH NGÀNH — chữ khổ lớn, mở/đóng -->
      <div class="order-1">
        {
          solutions.map((item, i) => (
            <div
              data-acc
              data-active={i === 0 ? 'true' : 'false'}
              class="group/acc border-t border-border-subtle last:border-b"
            >
              <h3 class="m-0">
                <button
                  type="button"
                  data-acc-btn={i}
                  aria-expanded={i === 0 ? 'true' : 'false'}
                  class="flex w-full items-center gap-5 py-6 text-left md:py-8"
                >
                  <span class="font-mono text-xs tabular-nums text-text-muted">
                    {String(i + 1).padStart(2, '0')}
                  </span>
                  <span class="flex-1 text-2xl md:text-4xl font-extrabold leading-tight text-ink-dark text-balance transition-colors group-data-[active=true]/acc:text-accent-gold">
                    {item.title}
                  </span>
                  <span
                    aria-hidden="true"
                    class="relative h-4 w-4 shrink-0 text-accent-gold transition-transform duration-300 group-data-[active=true]/acc:rotate-45"
                  >
                    <span class="absolute left-0 top-1/2 h-px w-full -translate-y-1/2 bg-current" />
                    <span class="absolute left-1/2 top-0 h-full w-px -translate-x-1/2 bg-current" />
                  </span>
                </button>
              </h3>

              <div class="grid grid-rows-[0fr] transition-[grid-template-rows] duration-500 ease-out group-data-[active=true]/acc:grid-rows-[1fr]">
                <div class="overflow-hidden">
                  <div class="max-w-[54ch] pb-8">
                    <SiteImage
                      src={item.image}
                      alt={item.title}
                      loading="lazy"
                      class:list={[
                        imageRadius,
                        'mb-6 aspect-[4/3] w-full object-cover object-top ring-1 ring-border-subtle lg:hidden',
                      ]}
                      variant="card"
                    />
                    <p class="text-text-muted text-base leading-relaxed text-pretty">{item.desc}</p>
                    <ul class="mt-5 grid gap-x-8 gap-y-3 sm:grid-cols-2">
                      {item.bullets.map((bullet) => (
                        <li class="flex items-start gap-3 text-sm text-ink-mid leading-snug">
                          <span aria-hidden="true" class="mt-2 h-px w-4 shrink-0 bg-accent-gold" />
                          <span class="min-w-0">{bullet}</span>
                        </li>
                      ))}
                    </ul>
                    <a
                      href={item.href}
                      class="group/cta mt-7 inline-flex items-center gap-2 text-sm font-bold text-accent-teal no-underline"
                    >
                      <span class="relative">
                        Xem chi tiết giải pháp
                        <span
                          aria-hidden="true"
                          class="absolute -bottom-0.5 left-0 h-px w-full origin-left scale-x-0 bg-accent-gold transition-transform duration-300 group-hover/cta:scale-x-100"
                        />
                      </span>
                      <span
                        aria-hidden="true"
                        class="transition-transform duration-300 group-hover/cta:translate-x-1"
                      >
                        →
                      </span>
                    </a>
                  </div>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  // Accordion + sân khấu ảnh đồng bộ: mở một ngành, đóng các ngành khác, đổi ảnh.
  const accs = Array.from(document.querySelectorAll<HTMLElement>('[data-acc]'));
  const btns = document.querySelectorAll<HTMLButtonElement>('[data-acc-btn]');
  const stages = document.querySelectorAll<HTMLElement>('[data-stage]');

  btns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const idx = btn.dataset.accBtn ?? '0';
      accs.forEach((a) => {
        const on = a.contains(btn);
        a.setAttribute('data-active', on ? 'true' : 'false');
        a.querySelector('[data-acc-btn]')?.setAttribute('aria-expanded', on ? 'true' : 'false');
      });
      stages.forEach((s) => s.setAttribute('data-active', s.dataset.stage === idx ? 'true' : 'false'));
    });
  });
</script>
