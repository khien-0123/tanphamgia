---
import SiteImage from '../SiteImage.astro';
import { solutions } from '../../data/site';
import { listingKeywords } from '../../data/giai-phap-listing';
import { RHYTHM_WHITE, sectionPy } from '../../lib/section-rhythm';
import { routes } from '../../lib/routes';

interface Props {
  sectionBg?: string;
}

const { sectionBg = RHYTHM_WHITE } = Astro.props;

type SolutionLike = { slug: string; bullets: string[]; homeBullets?: string[] };

/** Thẻ hẹp 411px chỉ chứa được keyword ngắn — xem `data/giai-phap-listing.ts` */
const keywordsFor = (item: SolutionLike): string[] =>
  listingKeywords[item.slug] ?? item.homeBullets ?? item.bullets.slice(0, 3);
---

<section class:list={[sectionPy, sectionBg]}>
  <div class="max-w-container-max-width mx-auto px-6 md:px-8">
    <div class="grid gap-3 sm:gap-5 md:grid-cols-2 lg:grid-cols-[0.86fr_1fr_1fr]">
      <!-- Ô ĐẦU — tiêu đề section nằm trong lưới, không phải thẻ ảnh.
           Không nền, không viền: khoảng trống giữa mô tả và CTA là khoảng thở, không phải hộp rỗng.
           Ở lg cột này cao bằng 2 hàng thẻ nên `flex-col` + `lg:mt-auto` ghim khối CTA xuống đáy,
           thẳng hàng với mép dưới thẻ hàng 2. -->
      <div
        data-reveal
        class="flex flex-col md:col-span-2 lg:col-span-1 lg:row-span-2 lg:pr-3"
      >
        <span
          class="inline-flex self-start rounded-full bg-[#FFF0BD] px-4 py-2 text-xs font-extrabold uppercase tracking-[0.025em] text-[#5c4500] sm:text-sm"
        >
          Tuyển tập · 04 phân khúc
        </span>
        <h2
          class="font-headline-md mt-6 text-[clamp(1.75rem,2.7vw,3rem)] font-extrabold leading-[1.1] tracking-[-0.03em] text-balance text-[#1f1b17]"
        >
          Chọn ngành của bạn
        </h2>
        <p class="mt-4 text-sm leading-[1.55] text-pretty text-[#625a50] sm:text-base">
          Hiểu sâu đặc thù từng ngành để mang đến giải pháp phù hợp nhất — từ an toàn lao động ở nhà
          máy đến thẩm mỹ ở phòng khám.
        </p>

        <!-- Đường kẻ hổ phách tách CTA khỏi mô tả. Ở lg khối này bị đẩy xuống đáy cột. -->
        <div class="mt-6 border-t-2 border-accent-gold pt-4 lg:mt-auto">
          <strong class="block text-sm font-extrabold text-[#1f1b17] sm:text-base">
            Không thấy ngành của bạn?
          </strong>
          <a
            href={routes.lienHe}
            class="group/cta relative mt-2 inline-flex items-center gap-2 text-sm font-bold text-[#5c4500] transition-colors after:absolute after:bottom-[-5px] after:left-0 after:h-[2px] after:w-full after:origin-left after:scale-x-0 after:bg-current after:transition-transform after:duration-300 after:ease-out hover:text-[#1f1b17] hover:after:scale-x-100 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#E1A900] focus-visible:after:scale-x-100 motion-reduce:after:transition-none"
          >
            <span>Đặt lịch tư vấn riêng</span>
            <span
              aria-hidden="true"
              class="material-symbols-outlined text-lg leading-none"
            >
              arrow_forward
            </span>
          </a>
        </div>
      </div>

      <!-- 4 THẺ NGÀNH — không đánh số 01–04: bốn phân khúc không phải một chuỗi có trình tự -->
      {
        solutions.map((item) => (
          <a
            data-reveal
            href={item.href}
            class="group relative isolate flex min-h-[300px] flex-col justify-end overflow-hidden rounded-[20px] bg-ink-dark p-5 no-underline sm:p-6 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent-gold"
          >
            <SiteImage
              src={item.image}
              alt={`Đồng phục cho ${item.title}`}
              loading="lazy"
              class="absolute inset-0 -z-20 h-full w-full object-cover object-top transition-transform duration-500 group-hover:scale-105 motion-reduce:transition-none motion-reduce:group-hover:scale-100"
              variant="card"
            />
            <span aria-hidden="true" class="ind-scrim absolute inset-0 -z-10" />

            <span
              aria-hidden="true"
              class="absolute left-4 top-4 grid h-10 w-10 place-items-center rounded-[11px] border border-white/30 bg-white/15 backdrop-blur-[6px] sm:left-5 sm:top-5"
            >
              <span class="material-symbols-outlined text-lg leading-none text-white">
                {item.icon}
              </span>
            </span>

            <h3 class="pr-14 text-lg font-extrabold leading-snug text-balance text-white sm:text-xl">
              {item.title}
            </h3>
            <ul class="mt-3 list-none space-y-1 p-0 pr-14 text-xs leading-snug text-white/90 sm:text-[0.8125rem]">
              {keywordsFor(item).map((keyword) => (
                <li>{keyword}</li>
              ))}
            </ul>

            <span
              aria-hidden="true"
              class="absolute bottom-4 right-4 grid h-10 w-10 place-items-center rounded-full bg-accent-gold text-[#171717] transition-transform duration-300 group-hover:translate-x-1 motion-reduce:transition-none sm:bottom-[18px] sm:right-[18px]"
            >
              <span class="material-symbols-outlined text-lg leading-none">arrow_forward</span>
            </span>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* Scrim navy đáy → đỉnh: điều kiện để chữ trắng đọc được trên ảnh sáng (DESIGN.md §2),
     không phải hiệu ứng làm ảnh tối cho sang.
     Viết ở đây chứ không dùng class Tailwind arbitrary: Tailwind 3 không dịch được
     `rgba()` lồng trong `linear-gradient()` — class sinh ra nhưng CSS thì không. */
  .ind-scrim {
    background: linear-gradient(
      to top,
      rgba(13, 27, 58, 0.94) 0%,
      rgba(13, 27, 58, 0.72) 32%,
      rgba(13, 27, 58, 0.2) 62%,
      rgba(13, 27, 58, 0.06) 100%
    );
  }
</style>
