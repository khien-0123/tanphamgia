---
import type { CaseStudyStat } from '../../lib/parse-case-study-stats';
import { rhythmBg, sectionPy } from '../../lib/section-rhythm';
import {
  caseStudyDetailStatCell,
  caseStudyDetailStatCellBordered,
  caseStudyDetailStatLabel,
  caseStudyDetailStatsGrid,
  caseStudyDetailStatsGridTwo,
  caseStudyDetailStatValue,
  caseStudyDetailStatValueText,
  caseStudyDetailStatValuePair,
} from '../../lib/case-study-detail-classes';

interface Props {
  stats: CaseStudyStat[];
}

const { stats } = Astro.props;

const statsSectionClass = `${rhythmBg(0)} ${sectionPy}`;
const isTwoStats = stats.length === 2;
const isNumericStatValue = (value: string) => /^[\d.,+]/.test(value.trim());
---

{
  stats.length > 0 && (
    <section class:list={statsSectionClass} aria-label="Số liệu dự án">
      <div class="max-w-container-max-width mx-auto px-6 md:px-8">
        <div
          class:list={[isTwoStats ? caseStudyDetailStatsGridTwo : caseStudyDetailStatsGrid]}
          data-reveal-stagger
        >
          {
            isTwoStats ? (
              <>
                <div
                  data-reveal
                  class:list={[
                    caseStudyDetailStatCellBordered,
                    'case-study-stats-band-item row-start-1 col-start-1',
                  ]}
                  style="--reveal-delay:0ms"
                >
                  <p
                    class:list={[
                      caseStudyDetailStatValuePair,
                      isNumericStatValue(stats[0].value) && 'tabular-nums',
                    ]}
                  >
                    {stats[0].value}
                  </p>
                </div>
                <div
                  data-reveal
                  class:list={[
                    'case-study-stats-band-item row-start-1 col-start-2 text-left',
                  ]}
                  style="--reveal-delay:80ms"
                >
                  <p class:list={caseStudyDetailStatValuePair}>
                    {stats[1].value}
                  </p>
                </div>
                {
                  stats[0].label && (
                    <p
                      class:list={[
                        caseStudyDetailStatLabel,
                        caseStudyDetailStatCellBordered,
                        'row-start-2 col-start-1 m-0 mt-1 text-center',
                      ]}
                    >
                      {stats[0].label}
                    </p>
                  )
                }
              </>
            ) : (
              stats.map((stat, index) => (
                <div
                  data-reveal
                  class:list={[caseStudyDetailStatCell, 'case-study-stats-band-item']}
                  style={`--reveal-delay:${index * 80}ms`}
                >
                  <p
                    class:list={[
                      isNumericStatValue(stat.value)
                        ? caseStudyDetailStatValue
                        : caseStudyDetailStatValueText,
                    ]}
                  >
                    {stat.value}
                  </p>
                  {stat.label && <p class:list={caseStudyDetailStatLabel}>{stat.label}</p>}
                </div>
              ))
            )
          }
        </div>
      </div>
    </section>
  )
}

<style>
  /* Scroll-driven reveal — fallback qua data-reveal + scroll-reveal.ts */
  @supports (animation-timeline: view()) {
    .case-study-stats-band-item {
      animation: case-study-stat-rise linear both;
      animation-timeline: view();
      animation-range: entry 10% cover 35%;
    }
  }

  @keyframes case-study-stat-rise {
    from {
      opacity: 0;
      transform: translateY(1rem);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .case-study-stats-band-item {
      animation: none;
    }
  }
</style>
