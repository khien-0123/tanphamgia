---
import SiteImage from '../SiteImage.astro';
import {
  projectCardBodyClasses,
  projectCardCtaClasses,
  projectCardCtaIconClasses,
  projectCardFieldClasses,
  projectCardGrid3Classes,
  projectCardGrid4Classes,
  projectCardImageClasses,
  projectCardLinkClasses,
  projectCardScrimClasses,
  projectCardSectionClasses,
  projectCardStatsClasses,
  projectCardTitleClasses,
} from '../../lib/project-card-classes';

export interface ProjectCardItem {
  name: string;
  stats: string;
  field?: string;
  image: string;
  href: string;
}

interface Props {
  items: ProjectCardItem[];
  title: string;
  description?: string;
  /** 3 cột (trang giải pháp) hoặc 4 cột (dự án khác) */
  columns?: 3 | 4;
  sectionClass?: string;
  id?: string;
  /** default: tiêu đề đơn giản | solution: macro-typography clamp() như trang giải pháp */
  headerStyle?: 'default' | 'solution';
  ctaLabel?: string;
}

const {
  items,
  title,
  description,
  columns = 4,
  sectionClass = projectCardSectionClasses,
  id,
  headerStyle = 'default',
  ctaLabel = 'Xem chi tiết',
} = Astro.props;

const gridClass = columns === 3 ? projectCardGrid3Classes : projectCardGrid4Classes;
---

{
  items.length > 0 && (
    <section data-reveal class:list={sectionClass} {...(id ? { id } : {})}>
      <div class="max-w-container-max-width mx-auto px-6 md:px-8">
        {
          headerStyle === 'solution' ? (
            <header class="mb-10 max-w-2xl md:mb-14">
              <h2 class="text-balance text-[clamp(1.75rem,4.2vw,3.25rem)] font-bold leading-[1.02] text-ink-dark">
                {title}
              </h2>
              {
                description && (
                  <p class="m-0 mt-3 text-sm leading-relaxed text-text-muted md:text-base">
                    {description}
                  </p>
                )
              }
            </header>
          ) : (
            <header class="mb-8 md:mb-10 max-w-2xl">
              <h2 class="font-headline-md text-2xl font-bold text-ink-dark md:text-3xl">
                {title}
              </h2>
              {
                description && (
                  <p class="m-0 mt-2 text-sm leading-relaxed text-text-muted md:text-base">
                    {description}
                  </p>
                )
              }
            </header>
          )
        }

        <div class={gridClass}>
          {
            items.map((item) => (
              <a
                href={item.href}
                class:list={projectCardLinkClasses}
                aria-label={`${ctaLabel} dự án ${item.name}`}
              >
                <SiteImage
                  src={item.image}
                  alt=""
                  class:list={projectCardImageClasses}
                  loading="lazy"
                  variant="card"
                />
                <div class:list={projectCardScrimClasses} aria-hidden="true" />
                <div class:list={projectCardBodyClasses}>
                  <div>
                    <h3 class={projectCardTitleClasses}>{item.name}</h3>
                    {item.field && <p class={projectCardFieldClasses}>{item.field}</p>}
                  </div>
                  <p class={projectCardStatsClasses}>{item.stats}</p>
                  <span class:list={projectCardCtaClasses}>
                    <span>{ctaLabel}</span>
                    <svg
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      class={projectCardCtaIconClasses}
                      aria-hidden="true"
                    >
                      <path d="M5 12h14" />
                      <path d="m13 5 7 7-7 7" />
                    </svg>
                  </span>
                </div>
              </a>
            ))
          }
        </div>
      </div>
    </section>
  )
}

<style>
  .project-card-scrim {
    height: 62%;
    background: linear-gradient(
      to top,
      rgb(14 38 64 / 0.96) 0%,
      rgb(14 38 64 / 0.82) 22%,
      rgb(14 38 64 / 0.48) 48%,
      transparent 88%
    );
  }
</style>
