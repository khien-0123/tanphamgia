---
import ContactForm from '../ContactForm.astro';
import ContactInfoAside from './ContactInfoAside.astro';
import { SURFACE_PAPER, sectionPy } from '../../lib/section-rhythm';

interface Props {
  sectionBg?: string;
}

const { sectionBg = SURFACE_PAPER } = Astro.props;
---

{/*
  Cột trái 5 phần giữ kênh liên hệ, cột phải 7 phần giữ form — form cần bề ngang hơn.
  Cả hai căn đỉnh bằng `items-start`; bản cũ phải chèn `lg:pt-14` vào cột phải để
  hai đầu trông ngang nhau, mà con số đó chỉ đúng với đúng một cỡ chữ tiêu đề.
*/}
<section class:list={[sectionPy, sectionBg]}>
  <div
    class="mx-auto grid max-w-container-max-width items-start gap-10 px-6 md:px-8 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-16"
  >
    <ContactInfoAside />

    <div data-reveal class="rounded-[1.25rem] border border-[#e5dfd2] bg-white p-6 sm:p-8 lg:p-9">
      <h3 class="text-xl font-extrabold leading-tight tracking-[-0.02em] text-ink-dark sm:text-2xl">
        Gửi yêu cầu tư vấn
      </h3>
      <p class="mt-2 text-sm leading-relaxed text-[#625a50]">
        Đội ngũ Tân Phạm Gia sẵn sàng hỗ trợ khảo sát, tư vấn và báo giá nhanh chóng.
      </p>

      <div class="mt-7">
        <ContactForm />
      </div>
    </div>
  </div>
</section>
