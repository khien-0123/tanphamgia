---
import { siteCta } from '../data/site';
import needleBg from '../assets/images/why-choose/kim_chi.svg';
---

<section class="bg-[#fbf8f1] px-6 py-7 md:px-8 lg:py-8" aria-labelledby="site-cta-title">
  <div class="relative mx-auto flex max-w-container-max-width items-center justify-center overflow-hidden rounded-[1.8rem] bg-[#ffc72c] px-6 py-[80px] text-center sm:px-10">
    <img src={needleBg.src} alt="" class="pointer-events-none absolute inset-0 h-full w-full object-contain opacity-70" aria-hidden="true" />

    <div class="relative z-10 flex max-w-3xl flex-col items-center">
      <h2 id="site-cta-title" class="text-balance text-[clamp(1.8rem,4vw,2.7rem)] font-extrabold leading-[1.1] tracking-[-0.035em] text-white">
        {siteCta.title}
      </h2>
      <p class="mt-3 text-sm leading-relaxed text-white/90 sm:text-base">{siteCta.description}</p>
      <div class="mt-7 flex w-full flex-col items-stretch justify-center gap-3 sm:w-auto sm:flex-row">
        <a href={siteCta.primaryHref} class="inline-flex min-h-12 items-center justify-center gap-5 rounded-full bg-[#171717] px-7 py-3 text-xs font-extrabold text-white transition-transform hover:-translate-y-0.5 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#171717] sm:min-w-[13.2rem]">
          <span>{siteCta.primaryLabel}</span><span aria-hidden="true">→</span>
        </a>
        <a href={siteCta.secondaryHref} class="inline-flex min-h-12 items-center justify-center rounded-full border border-[#171717] px-7 py-3 text-xs font-extrabold text-[#171717] transition-colors hover:bg-white/30 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#171717] sm:min-w-[10rem]">
          {siteCta.secondaryLabel}
        </a>
      </div>
    </div>
  </div>
</section>
