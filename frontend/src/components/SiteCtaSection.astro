---
import SiteImage from './SiteImage.astro';
import { siteCta } from '../data/site';
import { sectionPy } from '../lib/section-rhythm';
---

<section class:list={['relative overflow-hidden text-white bg-ink-dark', sectionPy]}>
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
    <SiteImage
      alt=""
      class="cta-section__photo absolute inset-0 h-full w-full object-cover object-center"
      src={siteCta.backgroundImage}
      loading="lazy"
      variant="hero"
    />
    <div class="cta-section__overlay absolute inset-0"></div>
  </div>
  <div class="relative z-10 max-w-container-max-width mx-auto px-6 md:px-8 text-center">
    <div data-reveal class="inline-flex flex-col items-stretch mx-auto max-w-full gap-4 md:gap-6">
      <h2
        class="font-display-lg text-[clamp(1.5rem,5vw,3rem)] leading-tight md:text-5xl font-bold m-0 text-white text-balance [text-shadow:0_2px_20px_rgba(14,38,64,0.35)]"
      >
        {siteCta.title}
      </h2>
      <p class="text-white/85 m-0 text-base md:text-lg leading-relaxed">
        {siteCta.description}
      </p>
      <div class="flex flex-row gap-2 sm:gap-3 items-stretch">
        <a
          href={siteCta.primaryHref}
          class="flex-1 min-w-0 inline-flex items-center justify-center bg-accent-gold text-ink-dark px-4 py-2.5 md:px-5 md:py-3 rounded-full font-bold text-xs md:text-sm leading-tight hover:shadow-gold hover:scale-105 transition-all shadow-soft text-center"
        >
          {siteCta.primaryLabel}
        </a>
        <a
          href={siteCta.secondaryHref}
          class="flex-1 min-w-0 inline-flex items-center justify-center border border-white/45 bg-white/12 text-white px-4 py-2.5 md:px-5 md:py-3 rounded-full font-bold text-xs md:text-sm leading-tight hover:bg-white hover:text-ink-dark transition-all text-center backdrop-blur-sm"
        >
          {siteCta.secondaryLabel}
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  /* Ảnh mờ + lớp ink-dark (#0E2640) — cùng tone header, nhạt hơn footer */
  .cta-section__photo {
    opacity: 0.34;
  }

  .cta-section__overlay {
    background: linear-gradient(
      135deg,
      rgba(14, 38, 64, 0.44) 0%,
      rgba(14, 38, 64, 0.34) 50%,
      rgba(14, 38, 64, 0.4) 100%
    );
  }
</style>
