---
import { homeCtaMedia, siteCta } from '../data/site';
---

<section class="relative overflow-hidden py-12 md:py-20 text-white min-h-64 md:min-h-80">
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
    <img
      alt=""
      class="w-full h-full object-cover object-center"
      src={homeCtaMedia.image}
      loading="lazy"
    />
    <div
      class="absolute inset-0 z-[1] bg-gradient-to-br from-ink-dark/62 via-ink-dark/38 to-ink-dark/52"
    >
    </div>
  </div>
  <div class="relative z-10 max-w-container-max-width mx-auto px-6 md:px-8 text-center">
    <div data-reveal class="inline-flex flex-col items-stretch mx-auto max-w-full gap-4 md:gap-6">
      <h2
        class="font-display-lg text-[clamp(1.5rem,5vw,3rem)] leading-tight md:text-5xl font-bold m-0 [text-shadow:0_2px_24px_rgba(14,38,64,0.45)] text-balance"
      >
        {siteCta.title}
      </h2>
      <p class="text-white/85 m-0 text-base md:text-lg leading-relaxed">
        {siteCta.description}
      </p>
      <div class="flex flex-row gap-2 sm:gap-3 items-stretch">
        <a
          href={siteCta.primaryHref}
          class="flex-1 min-w-0 inline-flex items-center justify-center bg-accent-gold text-ink-dark px-4 py-2.5 md:px-5 md:py-3 rounded-full font-bold text-xs md:text-sm leading-tight hover:shadow-gold hover:scale-105 transition-all shadow-soft text-center"
        >
          {siteCta.primaryLabel}
        </a>
        <a
          href={siteCta.secondaryHref}
          class="flex-1 min-w-0 inline-flex items-center justify-center border border-white/50 bg-white/10 backdrop-blur-sm text-white px-4 py-2.5 md:px-5 md:py-3 rounded-full font-bold text-xs md:text-sm leading-tight hover:bg-white hover:text-ink-dark transition-all text-center"
        >
          {siteCta.secondaryLabel}
        </a>
      </div>
    </div>
  </div>
</section>
