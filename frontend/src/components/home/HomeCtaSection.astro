---
import { siteCta } from '../../data/site';

---

<section class="bg-[#fbf8f1] px-6 py-7 md:px-8 lg:py-8" aria-labelledby="mockup-cta-title">
  <div class="relative mx-auto flex min-h-[15rem] max-w-container-max-width items-center justify-center overflow-hidden rounded-[1.8rem] bg-[#ffc72c] px-6 py-10 text-center sm:px-10 lg:min-h-[15rem]">
    <svg class="pointer-events-none absolute inset-0 h-full w-full" viewBox="0 0 1000 280" preserveAspectRatio="none" aria-hidden="true">
      <path d="M18 255 C105 112 184 38 284 40 C390 42 426 172 528 126 C618 86 649 45 741 52 C814 58 870 102 972 38" fill="none" stroke="#b88a20" stroke-width="1.2" stroke-dasharray="8 9" opacity="0.72" />
    </svg>

    <div class="relative z-10 flex max-w-3xl flex-col items-center">
      <h2 id="mockup-cta-title" class="text-balance text-[clamp(1.8rem,4vw,2.7rem)] font-extrabold leading-[1.1] tracking-[-0.035em] text-white">
        {siteCta.title}
      </h2>
      <p class="mt-3 text-sm leading-relaxed text-white/90 sm:text-base">{siteCta.description}</p>
      <div class="mt-7 flex w-full flex-col items-stretch justify-center gap-3 sm:w-auto sm:flex-row">
        <a href={siteCta.primaryHref} class="inline-flex min-h-12 items-center justify-center gap-5 rounded-full bg-[#171717] px-7 py-3 text-xs font-extrabold text-white transition-transform hover:-translate-y-0.5 sm:min-w-[13.2rem]">
          <span>{siteCta.primaryLabel}</span><span aria-hidden="true">→</span>
        </a>
        <a href={siteCta.secondaryHref} class="inline-flex min-h-12 items-center justify-center rounded-full border border-[#171717] px-7 py-3 text-xs font-extrabold text-[#171717] transition-colors hover:bg-white/30 sm:min-w-[10rem]">
          {siteCta.secondaryLabel}
        </a>
      </div>
    </div>
  </div>
</section>
