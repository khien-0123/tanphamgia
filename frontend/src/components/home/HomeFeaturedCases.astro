---
import SiteImage from '../SiteImage.astro';
import { homeRecentProjects } from '../../data/home';
import { sectionPy } from '../../lib/section-rhythm';
import {
  sectionTitleOnLight,
  textOnLightBodyMuted,
  textOnLightLead,
  textOnLightTitle,
} from '../../lib/section-typography';

const projects = homeRecentProjects.items;
const loopProjects = [...projects, ...projects, ...projects];
---

<section
  class:list={['relative overflow-hidden bg-[#fbf8f1]', textOnLightTitle]}
  aria-labelledby="mockup-recent-projects-title"
  data-mockup-projects-slider
>
  <div
    class="pointer-events-none absolute -left-36 top-0 h-[27rem] w-[30rem] rounded-[42%_58%_54%_46%/46%_44%_56%_54%] bg-[#f8edc8] sm:-left-28 lg:-left-20"
    aria-hidden="true"
  ></div>

  <div class:list={['relative mx-auto w-full max-w-container-max-width px-6', sectionPy]}>
    <header data-reveal data-reveal-direction="up" class="max-w-[64rem]">
      <h2 id="mockup-recent-projects-title" class:list={['max-w-[34ch]', sectionTitleOnLight]}>
        {homeRecentProjects.title}
      </h2>
      <p class:list={['mt-4 max-w-[54rem] text-sm leading-[1.55] sm:text-base', textOnLightLead]}>
        {homeRecentProjects.description}
      </p>
      <a
        href={homeRecentProjects.cta.href}
        target="_blank"
        rel="noreferrer"
        class="mt-6 inline-flex items-center gap-2 rounded-full border border-[#dca900] bg-[#fffaf0]/75 px-5 py-2.5 text-xs font-extrabold text-[#332b1c] no-underline transition-colors hover:bg-[#ffedb7] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#b88900] sm:text-sm"
      >
        {homeRecentProjects.cta.label}
      </a>
    </header>

    <div data-reveal data-reveal-motion="fade" class="mockup-projects-slider relative mt-8 lg:mt-9">
      <div
        class="mockup-projects-viewport"
        data-mockup-projects-viewport
        aria-label="Các dự án gần đây"
        tabindex="0"
      >
        <div class="mockup-projects-track" data-mockup-projects-track>
          {loopProjects.map((item, index) => {
            const logicalIndex = index % projects.length;
            const setIndex = Math.floor(index / projects.length);
            const isCanonical = setIndex === 1;

            return (
              <article
                class="mockup-project-card group shrink-0 rounded-[1.25rem] bg-white shadow-[0_18px_48px_rgba(38,31,21,0.10)]"
                data-mockup-projects-slide
                data-logical-index={logicalIndex}
                data-slide-set={setIndex}
                data-canonical={isCanonical ? 'true' : 'false'}
                aria-label={isCanonical ? `${logicalIndex + 1} / ${projects.length}: ${item.title}` : undefined}
                aria-current={isCanonical ? 'false' : undefined}
                aria-hidden={isCanonical ? undefined : 'true'}
                inert={isCanonical ? undefined : true}
              >
                <div class="mockup-project-card-inner">
                  <div class="mockup-project-media">
                    <SiteImage
                      src={item.image}
                      alt={item.alt}
                      class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.02]"
                      loading="lazy"
                      variant="card"
                    />
                    <div class="absolute inset-0 bg-black/45" aria-hidden="true"></div>
                    {'youtubeVideoId' in item && item.youtubeVideoId && (
                      <button
                        type="button"
                        data-video-id={item.youtubeVideoId}
                        tabindex={isCanonical ? undefined : '-1'}
                        class="absolute left-1/2 top-1/2 inline-flex h-14 w-14 -translate-x-1/2 -translate-y-1/2 items-center justify-center text-white drop-shadow-[0_4px_12px_rgba(0,0,0,0.55)] transition-transform duration-300 hover:scale-110 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white"
                        aria-label={`Phát video ${item.title}`}
                      >
                        <svg class="h-12 w-12" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                          <path d="M8 5v14l11-7z"></path>
                        </svg>
                      </button>
                    )}
                    {'youtubeVideoId' in item && item.youtubeVideoId && (
                      <div class="absolute inset-0 hidden overflow-hidden bg-black" data-video-player>
                        <iframe class="mockup-project-video-frame" title={`Video ${item.title}`} allow="autoplay; encrypted-media; picture-in-picture" allowfullscreen></iframe>
                        <button type="button" data-video-close class="absolute right-3 top-3 z-10 rounded-full bg-black/70 px-3 py-1.5 text-xs font-bold text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-white" aria-label={`Đóng video ${item.title}`}>Đóng</button>
                      </div>
                    )}
                  </div>

                  <div class="mockup-project-content">
                    <div>
                      <p class:list={['text-sm leading-snug sm:text-base', textOnLightTitle]}>
                        {item.eyebrow}
                      </p>
                      <h3 class="mt-1.5 text-[clamp(1.2rem,1.8vw,1.75rem)] font-extrabold leading-[0.98] tracking-[-0.04em] text-[#d99500]">
                        {item.title}
                      </h3>
                    </div>

                    <p class:list={['mt-4 text-sm leading-[1.5]', textOnLightBodyMuted]}>
                      {item.caption}
                    </p>
                  </div>
                </div>
              </article>
            );
          })}
        </div>
      </div>
    </div>

    <div
      class="mt-7 flex min-h-4 items-center justify-center gap-3 lg:mt-8"
      role="tablist"
      aria-label="Chọn dự án đang hiển thị"
      data-no-reveal
    >
      {projects.map((item, index) => (
        <button
          type="button"
          role="tab"
          data-mockup-projects-dot={index}
          class="mockup-projects-dot group inline-flex h-6 w-8 shrink-0 items-center justify-center rounded-full focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#9c7200]"
          aria-label={`Hiển thị dự án ${index + 1}: ${item.title}`}
          aria-selected={index === 0 ? 'true' : 'false'}
        >
          <span class="h-2.5 w-2.5 rounded-full bg-[#d4c8b2] transition-all duration-300 group-hover:bg-[#bfae91] group-aria-selected:w-8 group-aria-selected:bg-[#d99500]"></span>
        </button>
      ))}
    </div>
  </div>
</section>

<style>


  .mockup-projects-slider {
    --slide-width: min(48rem, calc(100% - 7rem));
    --slider-gap: 1.5rem;
    --stage-width: calc(var(--slide-width) * 1.8 + var(--slider-gap) * 2);
  }

  .mockup-projects-viewport {
    width: 100%;
    overflow-x: auto;
    overscroll-behavior-inline: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    padding-inline: calc((100% - var(--slide-width)) / 2);
  }

  .mockup-projects-viewport::-webkit-scrollbar {
    display: none;
  }

  .mockup-projects-track {
    display: flex;
    width: max-content;
    gap: var(--slider-gap);
  }

  .mockup-project-card {
    width: var(--slide-width);
    scroll-snap-align: center;
    scroll-snap-stop: always;
    overflow: hidden;
  }

  .mockup-project-card-inner {
    display: grid;
    min-height: 36rem;
    grid-template-columns: 1fr;
    grid-template-rows: minmax(26rem, 1fr) auto;
  }

  .mockup-project-media {
    position: relative;
    min-width: 0;
    min-height: 26rem;
    overflow: hidden;
    background: #161b22;
  }

  /* YouTube phủ kín khung (object-fit: cover) — cắt vệt đen letterbox/pillarbox */
  .mockup-project-media [data-video-player] {
    container-type: size;
  }

  .mockup-project-video-frame {
    position: absolute;
    top: 50%;
    left: 50%;
    width: max(100cqw, calc(100cqh * 16 / 9));
    height: max(100cqh, calc(100cqw * 9 / 16));
    max-width: none;
    border: 0;
    transform: translate(-50%, -50%);
  }

  .mockup-project-content {
    display: flex;
    min-width: 0;
    flex-direction: column;
    justify-content: flex-start;
    padding: 1.25rem 1.5rem 1.25rem;
    background: #fff;
  }

  @media (max-width: 639px) {
    .mockup-projects-slider {
      --slide-width: calc(100vw - 3rem);
      --slider-gap: 1rem;
    }

    .mockup-projects-viewport {
      padding-inline: 1.5rem;
    }

    .mockup-project-card {
      overflow: visible;
      border-radius: 1.25rem;
    }

    .mockup-project-card-inner {
      display: block;
      min-height: 0;
      overflow: hidden;
      border-radius: 1.25rem;
    }

    .mockup-project-media {
      display: block;
      height: auto;
      min-height: 0;
      aspect-ratio: 16 / 9;
    }

    .mockup-project-content {
      display: flex;
      min-height: 0;
      padding: 1.25rem 1.5rem;
      background: #fff;
      color: #3d3832;
    }
  }

  @media (min-width: 640px) and (max-width: 1023px) {
    .mockup-projects-slider {
      --slide-width: 42rem;
    }
  }

  @media (min-width: 1024px) {
    .mockup-project-content {
      padding: 2.25rem 1.5rem 1.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mockup-projects-viewport {
      scroll-behavior: auto;
    }

    .mockup-project-card :global(*) {
      transition-duration: 0.01ms !important;
    }
  }
</style>

<script src="../../scripts/home-recent-projects-slider.ts"></script>
