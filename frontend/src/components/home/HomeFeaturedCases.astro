---
import { homeFeaturedCases } from '../../data/site';
import { imageRadius } from '../../lib/image-frame';
import { sectionPy } from '../../lib/section-rhythm';

const { featured, secondary, quote, allProjectsHref } = homeFeaturedCases;

const featuredCard =
  `relative block overflow-hidden ${imageRadius} bg-ink-mid min-h-[280px] lg:min-h-[380px] order-1 lg:order-none`;
const featuredImg =
  'absolute inset-0 w-full h-full object-cover opacity-75 transition-[transform,opacity] duration-700 group-hover:scale-[1.04] group-hover:opacity-[0.88]';
const featuredOverlay =
  'featured-case-copy absolute inset-0 z-[2] flex flex-col justify-end gap-3.5 p-6';
const secondaryCard =
  `relative shrink-0 snap-start overflow-hidden ${imageRadius} bg-ink-mid min-h-[220px] basis-[85vw] sm:basis-[calc(50%-0.425rem)] transition-transform duration-250 hover:-translate-y-0.5 lg:shrink lg:min-h-[220px] lg:h-full`;
---

<section class:list={[sectionPy, 'text-white bg-ink-dark overflow-hidden']} id="du-an">
  <header
    data-reveal
    class="max-w-container-max-width w-full mx-auto px-6 md:px-8 pb-4 md:pb-6 flex flex-col md:flex-row justify-between items-start md:items-end gap-4 md:gap-6"
  >
    <div class="max-w-2xl">
      <h2 class="text-[clamp(1.5rem,5vw,3rem)] leading-tight md:text-5xl font-bold tracking-normal mb-3 text-balance">
        Dự Án Tiêu Biểu
      </h2>
      <p class="text-white/60 text-base md:text-lg">
        Chứng thực năng lực qua các dự án quy mô lớn cho tập đoàn đa quốc gia.
      </p>
    </div>
  </header>

  <div
    data-reveal
    class="grid gap-4 max-w-container-max-width mx-auto px-6 md:px-8 lg:grid-cols-[5fr_7fr] lg:[grid-template-areas:'featured_aside'] lg:items-stretch"
  >
    {
      featured.href ? (
        <a
          href={featured.href}
          class:list={[featuredCard, 'group no-underline text-white lg:[grid-area:featured]']}
        >
          <img src={featured.image} alt={featured.alt} class={featuredImg} loading="lazy" />
          <div class="featured-case-scrim pointer-events-none absolute inset-x-0 bottom-0 z-[1]" aria-hidden="true" />
          <div class={featuredOverlay}>
            {featured.tag && (
              <span class="inline-block w-fit px-3 py-1 rounded-full bg-accent-gold text-ink-dark text-[0.625rem] font-bold tracking-widest uppercase">
                {featured.tag}
              </span>
            )}
            <div class="flex items-center gap-2.5 md:gap-3">
              {featured.logoMark && (
                <img
                  src={featured.logoMark}
                  alt=""
                  width={40}
                  height={40}
                  class="featured-case-logo-mark h-9 w-9 md:h-10 md:w-10 shrink-0 object-contain"
                  loading="lazy"
                  decoding="async"
                />
              )}
              <h3 class="m-0 text-[clamp(1.5rem,3vw,1.875rem)] font-bold leading-tight">
                {featured.name}
              </h3>
            </div>
            {featured.stats && (
              <dl class="flex flex-wrap gap-x-8 gap-y-5 m-0">
                {featured.stats.map((stat) => (
                  <div class="m-0">
                    <dt class="sr-only">{stat.label}</dt>
                    <dd class="flex flex-col gap-0.5 m-0">
                      <span class="text-[clamp(1.35rem,2.5vw,1.75rem)] font-bold text-accent-gold leading-none">
                        {stat.value}
                      </span>
                      <span class="text-[0.8125rem] text-white/65">{stat.label}</span>
                    </dd>
                  </div>
                ))}
              </dl>
            )}
          </div>
        </a>
      ) : (
        <article class:list={[featuredCard, 'group lg:[grid-area:featured]']}>
          <img src={featured.image} alt={featured.alt} class={featuredImg} loading="lazy" />
          <div class="featured-case-scrim pointer-events-none absolute inset-x-0 bottom-0 z-[1]" aria-hidden="true" />
          <div class={featuredOverlay}>
            {featured.tag && (
              <span class="inline-block w-fit px-3 py-1 rounded-full bg-accent-gold text-ink-dark text-[0.625rem] font-bold tracking-widest uppercase">
                {featured.tag}
              </span>
            )}
            <div class="flex items-center gap-2.5 md:gap-3">
              {featured.logoMark && (
                <img
                  src={featured.logoMark}
                  alt=""
                  width={40}
                  height={40}
                  class="featured-case-logo-mark h-9 w-9 md:h-10 md:w-10 shrink-0 object-contain"
                  loading="lazy"
                  decoding="async"
                />
              )}
              <h3 class="m-0 text-[clamp(1.5rem,3vw,1.875rem)] font-bold leading-tight">
                {featured.name}
              </h3>
            </div>
            {featured.stats && (
              <dl class="flex flex-wrap gap-x-8 gap-y-5 m-0">
                {featured.stats.map((stat) => (
                  <div class="m-0">
                    <dt class="sr-only">{stat.label}</dt>
                    <dd class="flex flex-col gap-0.5 m-0">
                      <span class="text-[clamp(1.35rem,2.5vw,1.75rem)] font-bold text-accent-gold leading-none">
                        {stat.value}
                      </span>
                      <span class="text-[0.8125rem] text-white/65">{stat.label}</span>
                    </dd>
                  </div>
                ))}
              </dl>
            )}
          </div>
        </article>
      )
    }

    <div class="contents lg:flex lg:flex-col lg:gap-4 lg:[grid-area:aside] lg:min-h-[380px]">
      <blockquote class="m-0 pl-5 border-l-4 border-accent-gold order-3 lg:order-none lg:shrink-0 lg:pt-1">
        <p class="m-0 text-[clamp(1rem,2vw,1.125rem)] leading-relaxed text-white/92">
          "{quote.text}"
        </p>
        <footer class="mt-3.5 text-sm font-semibold text-accent-gold">— {quote.author}</footer>
      </blockquote>

      <div
        class="flex gap-3.5 overflow-x-auto snap-x snap-proximity overscroll-x-contain [-webkit-overflow-scrolling:touch] [scrollbar-width:none] pb-1 order-2 min-w-0 lg:order-none lg:flex-1 lg:grid lg:grid-cols-2 lg:auto-rows-fr lg:overflow-visible lg:min-h-[220px] [&::-webkit-scrollbar]:hidden"
        role="list"
      >
        {
          secondary.map((project) => (
            <a
              href={project.href}
              class:list={[secondaryCard, 'group no-underline text-white']}
              role="listitem"
              aria-label={`Xem chi tiết dự án ${project.name}`}
            >
              <img
                src={project.image}
                alt=""
                loading="lazy"
                class="absolute inset-0 w-full h-full object-cover opacity-70 transition-opacity duration-350 group-hover:opacity-[0.82]"
              />
              <div class="absolute inset-0 z-[1] flex flex-col justify-end p-5 bg-gradient-to-t from-black/90 via-black/40 from-0% via-45% to-transparent">
                <h3 class="m-0 mb-1.5 text-[1.0625rem] font-bold leading-snug line-clamp-2">{project.name}</h3>
                {project.statHighlight && (
                  <p class="m-0 text-[1.35rem] font-bold leading-normal">
                    <span
                      class:list={[
                        'text-white',
                        project.statHighlight.valueClass === 'gold' && 'text-accent-gold',
                      ]}
                    >
                      {project.statHighlight.value}
                    </span>
                    <span class="ml-1.5 text-[0.8125rem] font-medium text-white/70">
                      {project.statHighlight.suffix}
                    </span>
                  </p>
                )}
                <span class="mt-2.5 pl-1 text-xs font-semibold leading-normal text-white/55 transition-colors group-hover:text-accent-gold">
                  Xem chi tiết →
                </span>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  /* Màn đen mờ sát đáy */
  .featured-case-scrim {
    height: 55%;
    background: linear-gradient(
      to top,
      rgb(0 0 0 / 0.88) 0%,
      rgb(0 0 0 / 0.72) 28%,
      rgb(0 0 0 / 0.4) 55%,
      transparent 100%
    );
  }

  .featured-case-copy,
  .featured-case-copy *:not(img) {
    text-shadow:
      0 1px 2px rgb(0 0 0 / 0.9),
      0 2px 14px rgb(0 0 0 / 0.7);
  }

  .featured-case-logo-mark {
    filter: drop-shadow(0 2px 10px rgb(0 0 0 / 0.75));
    mix-blend-mode: lighten;
  }
</style>
