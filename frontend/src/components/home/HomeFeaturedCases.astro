---
import SiteImage from '../SiteImage.astro';
import { homeRecentProjects } from '../../data/home';

const projects = homeRecentProjects.items;
const loopProjects = [...projects, ...projects, ...projects];
---

<section
  class="relative overflow-hidden bg-[#fbf8f1] text-[#1f1b17]"
  aria-labelledby="mockup-recent-projects-title"
  data-mockup-projects-slider
>
  <div
    class="pointer-events-none absolute -left-36 top-0 h-[27rem] w-[30rem] rounded-[42%_58%_54%_46%/46%_44%_56%_54%] bg-[#f8edc8] sm:-left-28 lg:-left-20"
    aria-hidden="true"
  ></div>

  <div class="relative mx-auto w-full max-w-container-max-width px-6 py-12">
    <header data-reveal data-reveal-direction="up" class="max-w-[64rem]">
      <h2
        id="mockup-recent-projects-title"
        class="max-w-[34ch] text-balance text-[clamp(1.75rem,2.7vw,3rem)] font-extrabold leading-[1.1] tracking-[-0.03em] text-[#1f1b17]"
      >
        {homeRecentProjects.title}
      </h2>
      <p class="mt-4 max-w-[54rem] text-sm leading-[1.55] text-[#625a50] sm:text-base">
        {homeRecentProjects.description}
      </p>
      <a
        href={homeRecentProjects.cta.href}
        target="_blank"
        rel="noreferrer"
        class="mt-6 inline-flex items-center gap-2 rounded-full border border-[#dca900] bg-[#fffaf0]/75 px-5 py-2.5 text-xs font-extrabold text-[#332b1c] no-underline transition-colors hover:bg-[#ffedb7] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#b88900] sm:text-sm"
      >
        {homeRecentProjects.cta.label}
      </a>
    </header>

    <div data-reveal data-reveal-motion="fade" class="mockup-projects-slider relative mt-8 lg:mt-9">
      <div
        class="mockup-projects-viewport"
        data-mockup-projects-viewport
        aria-label="Các dự án gần đây"
        tabindex="0"
      >
        <div class="mockup-projects-track" data-mockup-projects-track>
          {loopProjects.map((item, index) => {
            const logicalIndex = index % projects.length;
            const setIndex = Math.floor(index / projects.length);
            const isCanonical = setIndex === 1;

            return (
              <article
                class="mockup-project-card group shrink-0 overflow-hidden rounded-[1.25rem] bg-white shadow-[0_18px_48px_rgba(38,31,21,0.10)]"
                data-mockup-projects-slide
                data-logical-index={logicalIndex}
                data-slide-set={setIndex}
                data-canonical={isCanonical ? 'true' : 'false'}
                aria-label={isCanonical ? `${logicalIndex + 1} / ${projects.length}: ${item.title}` : undefined}
                aria-current={isCanonical ? 'false' : undefined}
                aria-hidden={isCanonical ? undefined : 'true'}
                inert={isCanonical ? undefined : true}
              >
                <div class="mockup-project-card-inner">
                  <div class="mockup-project-content">
                    <div>
                      <p class="text-sm leading-snug text-[#3d3832] sm:text-base">
                        {item.eyebrow}
                      </p>
                      <h3 class="mt-1.5 text-[clamp(1.2rem,1.8vw,1.75rem)] font-extrabold leading-[0.98] tracking-[-0.04em] text-[#d99500]">
                        {item.title}
                      </h3>
                    </div>

                    <p class="mt-4 text-sm leading-[1.5] text-[#71685d]">
                      {item.caption}
                    </p>
                  </div>

                  <div class="mockup-project-media">
                    <SiteImage
                      src={item.image}
                      alt={item.alt}
                      class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.02]"
                      loading="lazy"
                      variant="card"
                    />
                    <div class="absolute inset-0 bg-gradient-to-r from-black/5 to-transparent" aria-hidden="true"></div>
                    <a
                      href={homeRecentProjects.cta.href}
                      target="_blank"
                      rel="noreferrer"
                      tabindex={isCanonical ? undefined : '-1'}
                      class="absolute left-1/2 top-1/2 inline-flex h-12 w-[4.25rem] -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-2xl bg-[#ff1f18] text-white opacity-0 shadow-[0_14px_35px_rgba(0,0,0,0.3)] transition-[opacity,transform] group-hover:scale-105 group-hover:opacity-100 group-focus-within:opacity-100 focus-visible:opacity-100 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white"
                      aria-label={`Xem video ${item.title} trên YouTube`}
                    >
                      <svg class="ml-1 h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                        <path d="M8 5v14l11-7z"></path>
                      </svg>
                    </a>
                  </div>
                </div>
              </article>
            );
          })}
        </div>
      </div>
    </div>

    <div
      class="mt-7 flex justify-center gap-3 lg:mt-8"
      role="tablist"
      aria-label="Chọn dự án đang hiển thị"
    >
      {projects.map((item, index) => (
        <button
          type="button"
          role="tab"
          data-mockup-projects-dot={index}
          class:list={[
            'mockup-projects-dot block rounded-full transition-[width,background-color] duration-300 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#9c7200]',
            index === 0
              ? 'h-4 w-4 border border-[#9c7200] bg-[#ffc72c]'
              : 'h-2 w-2 self-center border border-transparent bg-[#eadfbf]',
          ]}
          aria-label={`Hiển thị dự án ${index + 1}: ${item.title}`}
          aria-selected={index === 0 ? 'true' : 'false'}
        />
      ))}
    </div>
  </div>
</section>

<style>
  .mockup-projects-slider {
    --slide-width: min(48rem, calc(100vw - 7rem));
    --slider-gap: 1.5rem;
    --stage-width: calc(var(--slide-width) * 1.8 + var(--slider-gap) * 2);
  }

  .mockup-projects-viewport {
    width: 100vw;
    margin-left: calc(50% - 50vw);
    overflow-x: auto;
    overscroll-behavior-inline: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    padding-inline: calc((100vw - var(--slide-width)) / 2);
  }

  .mockup-projects-viewport::-webkit-scrollbar {
    display: none;
  }

  .mockup-projects-track {
    display: flex;
    width: max-content;
    gap: var(--slider-gap);
  }

  .mockup-project-card {
    width: var(--slide-width);
    scroll-snap-align: center;
    scroll-snap-stop: always;
  }

  .mockup-project-card-inner {
    display: grid;
    min-height: 29rem;
    grid-template-columns: 1fr;
    grid-template-rows: minmax(19rem, 1fr) auto;
  }

  .mockup-project-content {
    display: flex;
    min-width: 0;
    flex-direction: column;
    justify-content: flex-start;
    order: 2;
    padding: 1.25rem 1.5rem 1.25rem;
    background: #fff;
  }

  .mockup-project-media {
    position: relative;
    min-width: 0;
    min-height: 19rem;
    order: 1;
    overflow: hidden;
    background: #161b22;
  }

  @media (max-width: 639px) {
    .mockup-projects-slider {
      --slide-width: calc(100vw - 3rem);
      --slider-gap: 1rem;
    }

    .mockup-projects-viewport {
      padding-inline: 1.5rem;
    }

    .mockup-project-card-inner {
      min-height: 28rem;
      grid-template-columns: 1fr;
    }

    .mockup-project-content {
      min-height: 13rem;
      padding: 1.5rem;
    }

    .mockup-project-media {
      min-height: 15rem;
    }
  }

  @media (min-width: 640px) and (max-width: 1023px) {
    .mockup-projects-slider {
      --slide-width: 42rem;
    }
  }

  @media (min-width: 1024px) {
    .mockup-project-content {
      padding: 2.25rem 1.5rem 1.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mockup-projects-viewport {
      scroll-behavior: auto;
    }

    .mockup-project-card :global(*) {
      transition-duration: 0.01ms !important;
    }
  }
</style>

<script src="../../scripts/home-recent-projects-slider.ts"></script>
