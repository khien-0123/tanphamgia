---
import { whyChoose } from '../../data/site';
---

<section class="pt-8 pb-8 md:pt-10 md:pb-10 bg-white" id="tai-sao">
  <div class="max-w-container-max-width mx-auto px-6 md:px-8">
    <div data-reveal class="text-center mb-5 md:mb-8 max-w-2xl mx-auto">
      <h2
        class="font-headline-md font-bold text-ink-dark text-xl leading-snug md:text-4xl md:leading-tight"
      >
        Tiên phong "Thời trang hóa"<br class="md:hidden" />
        đồng phục doanh nghiệp
      </h2>
    </div>
    <div data-reveal-stagger class="grid gap-5 sm:grid-cols-2 sm:gap-x-12 sm:gap-y-8 lg:grid-cols-4 lg:gap-x-4">
      {
        whyChoose.map((item) => (
          <div data-reveal class="flex gap-4 items-start lg:flex-col lg:gap-3 lg:min-w-0">
            <span class="shrink-0 font-extrabold text-3xl sm:text-4xl text-accent-gold leading-none tabular-nums">
              {item.num}
            </span>
            <div>
              <h3 class="font-bold text-base md:text-lg text-ink-dark mb-2 lg:text-sm lg:whitespace-nowrap">
                {item.title}
              </h3>
              <p class="text-text-muted text-sm leading-relaxed">{item.desc}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
