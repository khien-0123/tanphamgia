---
import { homeWhyChoose } from '../../data/home';
import waveBgImage from '../../assets/images/about/dai-chi-tpg 1.png';

const cardPositions = [
  'lg:mt-10',
  'lg:mt-32',
  'lg:mt-0',
  'lg:mt-28',
] as const;
---

<section class="overflow-hidden bg-[#fbf8f1] text-[#1f1b17]" aria-labelledby="mockup-why-choose-title">
  <div class="mx-auto w-full max-w-container-max-width px-6 py-12">
    <header class="max-w-[62rem]">
      <p class="mb-6 inline-flex rounded-full bg-[#ffedb7] px-4 py-2 text-xs font-extrabold uppercase tracking-[0.025em] text-[#5c4500] sm:text-sm">
        {homeWhyChoose.eyebrow}
      </p>
      <h2
        id="mockup-why-choose-title"
        class="max-w-[34ch] text-balance text-[clamp(1.75rem,2.7vw,3rem)] font-extrabold leading-[1.1] tracking-[-0.03em] text-[#1f1b17]"
      >
        {homeWhyChoose.title}
      </h2>
    </header>

    <div class="relative mt-10 lg:min-h-80 lg:mt-12">
      <img
        src={waveBgImage.src}
        alt=""
        class="pointer-events-none absolute inset-x-[-5%] top-0 hidden w-[110%] object-contain lg:block mix-blend-multiply"
        aria-hidden="true"
      />

      <div class="relative z-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4 lg:gap-5">
        {
          homeWhyChoose.items.map((item, index) => (
            <article class:list={['min-w-0', cardPositions[index]]}>
              <div class="inline-flex max-w-full items-center gap-3 rounded-full border border-[#e8dfcf] bg-[#faf5e9]/95 px-4 py-3 shadow-[0_8px_24px_rgba(65,48,13,0.05)] backdrop-blur-sm">
                <span class="shrink-0 text-lg font-extrabold tabular-nums text-[#8a6700]">{item.number}</span>
                <h3 class="text-sm font-extrabold leading-snug text-[#26211c] sm:text-[0.95rem]">
                  {item.title}
                </h3>
              </div>

              <div class="ml-7 border-l border-[#efbd35]/65 pl-7 pt-6">
                <p class="max-w-[19rem] text-sm leading-[1.75] text-[#655c51] lg:text-[0.94rem]">
                  {item.description}
                </p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>
