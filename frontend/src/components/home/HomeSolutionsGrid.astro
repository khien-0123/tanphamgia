---
import { solutions } from '../../data/site';
import { siteAssets } from '../../data/assets';
import { solutionHomeCarousel } from '../../lib/solution-theme';

const imageFallback = siteAssets.hero.fallback;
const t = solutionHomeCarousel;
---

<section id="giai-phap" class={t.section}>
  <div class="max-w-container-max-width mx-auto px-6 md:px-8">
    <header data-reveal class={t.headerRow}>
      <div class={t.headerText}>
        <h2 class={t.title}>Giải pháp đồng phục toàn&nbsp;diện</h2>
        <p class={t.lead}>
          Lắng nghe và thấu hiểu để đưa ra giải pháp phù hợp nhất cho từng mô hình doanh&nbsp;nghiệp.
        </p>
      </div>
    </header>

    <div data-reveal-stagger class={t.grid}>
      {
        solutions.map((item, index) => (
          <article id={`giai-phap-${item.slug}`} data-reveal class="min-h-0">
            <a href={item.href} class={t.card}>
              <img
                alt={item.title}
                class={t.media}
                loading={index < 2 ? 'eager' : 'lazy'}
                src={item.image}
                onerror={`this.onerror=null;this.src='${imageFallback}'`}
              />
              <div class={t.scrim} aria-hidden="true"></div>
              <div class={t.body}>
                <h3 class={t.heading}>{item.title}</h3>
                <p class={t.desc}>{item.desc}</p>
                <span class={t.cta}>Xem chi tiết</span>
              </div>
            </a>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  @media (prefers-reduced-motion: reduce) {
    .group:hover img {
      transform: none;
    }
  }
</style>
