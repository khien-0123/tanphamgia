---
import { solutions } from '../../data/site';
import { siteAssets } from '../../data/assets';
import { solutionBoxHome } from '../../lib/solution-theme';
import { portraitCardImg } from '../../lib/image-frame';

const imageFallback = siteAssets.hero.fallback;
---

<section
  id="giai-phap"
  class="py-8 md:py-12 bg-white text-ink-dark"
>
  <div class="max-w-container-max-width mx-auto px-6 md:px-8">
    <div data-reveal class="text-center mb-6 md:mb-10 max-w-3xl mx-auto">
      <h2
        class="font-headline-md font-bold mb-4 text-ink-dark text-xl leading-snug tracking-tight min-[390px]:text-[1.3125rem] text-balance md:text-4xl md:leading-tight md:tracking-normal"
      >
        Giải pháp đồng phục toàn&nbsp;diện
      </h2>
      <p class="text-pretty text-text-muted text-sm md:text-base max-w-3xl mx-auto leading-relaxed">
        Lắng nghe và thấu hiểu để đưa ra giải pháp phù hợp nhất cho từng mô hình doanh&nbsp;nghiệp.
      </p>
    </div>
    <div data-reveal-stagger class={solutionBoxHome.grid}>
      {
        solutions.map((item) => (
          <article data-reveal class:list={[solutionBoxHome.item, 'group']}>
            <a class={solutionBoxHome.summary} href={item.href}>
              <figure class={solutionBoxHome.media}>
                <img
                  alt={item.title}
                  class={portraitCardImg}
                  loading="lazy"
                  src={item.image}
                  onerror={`this.onerror=null;this.src='${imageFallback}'`}
                />
              </figure>
              <h3 class={solutionBoxHome.title}>{item.title}</h3>
              <p class={solutionBoxHome.desc}>{item.desc}</p>
              <span class={solutionBoxHome.link}>Xem chi tiết</span>
            </a>
          </article>
        ))
      }
    </div>
  </div>
</section>
