---
import { solutions } from '../../data/site';
import { siteAssets } from '../../data/assets';
import { solutionHomeMosaic } from '../../lib/solution-theme';
import { RHYTHM_WHITE, sectionPy } from '../../lib/section-rhythm';

interface Props {
  sectionBg?: string;
}

const { sectionBg = RHYTHM_WHITE } = Astro.props;

const imageFallback = siteAssets.hero.fallback;
const t = solutionHomeMosaic;
---

<section
  id="giai-phap"
  class:list={['relative z-[2]', sectionPy, 'text-ink-dark', sectionBg]}
>
  <div class="max-w-container-max-width mx-auto px-6 md:px-8">
    <div data-reveal class={t.headerWrap}>
      <h2 class={t.title}>
        Giải pháp đồng phục toàn&nbsp;diện
      </h2>
      <p class={t.lead}>
        Lắng nghe và thấu hiểu để đưa ra giải pháp phù hợp nhất cho từng mô hình doanh&nbsp;nghiệp.
      </p>
    </div>
    <div data-reveal-stagger class={t.grid}>
      {
        solutions.map((item, index) => {
          const layoutClass =
            index === 0
              ? t.spanLarge
              : index === 1
                ? t.spanTall
                : index === 2
                  ? t.spanTall
                : index === 3
                  ? t.spanWide
                  : '';

          // Ô FMCG hẹp — hover gọn hơn; các ô khác giữ đủ bullet
          const isCompactHover = item.slug === 'giai-phap-3';

          return (
            <article
              data-reveal
              class:list={[
                t.cardWrap,
                layoutClass,
                isCompactHover && 'solutions-mosaic__card--compact',
              ]}
            >
              <a
                class={t.cardLink}
                href={item.href}
                data-solutions-mosaic-link
                aria-expanded="false"
              >
                <img
                  alt={item.title}
                  class:list={[t.media, item.homeImagePosition ?? 'object-top']}
                  loading="lazy"
                  src={item.image}
                  onerror={`this.onerror=null;this.src='${imageFallback}'`}
                />
                <div class={t.scrim} aria-hidden="true"></div>
                <div class={isCompactHover ? t.bodyCompact : t.body}>
                  <h3 class={isCompactHover ? t.titleInCardCompact : t.titleInCard}>
                    {item.title}
                  </h3>
                  <div class={t.revealWrap}>
                    <div class={isCompactHover ? t.revealInnerCompact : t.revealInner}>
                      {
                        isCompactHover ? (
                          <>
                            <p class={t.descCompact}>{item.desc}</p>
                            {
                              item.homeBullets && item.homeBullets.length > 0 && (
                                <ul class={t.bulletsCompact}>
                                  {item.homeBullets.map((bullet) => (
                                    <li class={t.bulletItemCompact}>{bullet}</li>
                                  ))}
                                </ul>
                              )
                            }
                          </>
                        ) : (
                          <>
                            <p class={t.desc}>{item.desc}</p>
                            {
                              item.bullets && item.bullets.length > 0 && (
                                <ul class={t.bullets}>
                                  {item.bullets.slice(0, 3).map((bullet) => (
                                    <li class={t.bulletItem}>{bullet}</li>
                                  ))}
                                </ul>
                              )
                            }
                          </>
                        )
                      }
                      <span class={isCompactHover ? t.ctaCompact : t.cta}>
                        Xem chi tiết
                      </span>
                    </div>
                  </div>
                </div>
              </a>
            </article>
          );
        })
      }
    </div>
  </div>
</section>

<script src="../../scripts/solutions-mosaic-mobile.ts"></script>

<style>
  /* Lưới mosaic: hàng trên cao hơn để khung ngang/nhỏ không cắt mất đầu người */
  .solutions-mosaic__grid {
    grid-auto-rows: minmax(260px, auto);
  }

  @media (min-width: 768px) {
    .solutions-mosaic__grid {
      grid-template-rows: minmax(300px, auto) minmax(280px, auto);
    }
  }

  /* Đen mờ sát đáy — đủ contrast chữ, không che kín ảnh */
  .solutions-mosaic-scrim {
    height: 38%;
    background: linear-gradient(
      to top,
      rgb(0 0 0 / 0.76) 0%,
      rgb(0 0 0 / 0.52) 30%,
      rgb(0 0 0 / 0.18) 58%,
      transparent 82%
    );
    transition:
      height 0.4s cubic-bezier(0.22, 1, 0.36, 1),
      background 0.4s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .solutions-mosaic-body,
  .solutions-mosaic-body * {
    text-shadow:
      0 1px 3px rgb(0 0 0 / 0.7),
      0 6px 20px rgb(0 0 0 / 0.4);
  }

  /* Mặc định chỉ tiêu đề; hover/focus bung nội dung */
  .solutions-mosaic-reveal {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    transform: translateY(0.35rem);
    transition:
      grid-template-rows 0.42s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.32s ease,
      transform 0.42s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .solutions-mosaic-reveal__inner {
    overflow: hidden;
  }

  /* Desktop: hover/focus sổ nội dung */
  @media (min-width: 768px) {
    .solutions-mosaic__grid a:is(:hover, :focus-visible) .solutions-mosaic-body,
    .solutions-mosaic__grid a:is(:hover, :focus-visible) .solutions-mosaic-body * {
      text-shadow:
        0 1px 4px rgb(0 0 0 / 0.8),
        0 8px 22px rgb(0 0 0 / 0.48);
    }

    .solutions-mosaic__grid a:is(:hover, :focus-visible) .solutions-mosaic-scrim {
      height: 86%;
      background: linear-gradient(
        to top,
        rgb(0 0 0 / 0.8) 0%,
        rgb(0 0 0 / 0.68) 34%,
        rgb(0 0 0 / 0.46) 60%,
        rgb(0 0 0 / 0.18) 80%,
        transparent 96%
      );
    }

    .solutions-mosaic__grid .solutions-mosaic__card--compact a:is(:hover, :focus-visible) .solutions-mosaic-scrim {
      height: 80%;
      background: linear-gradient(
        to top,
        rgb(0 0 0 / 0.78) 0%,
        rgb(0 0 0 / 0.64) 32%,
        rgb(0 0 0 / 0.42) 58%,
        rgb(0 0 0 / 0.16) 78%,
        transparent 94%
      );
    }

    .solutions-mosaic__grid a:is(:hover, :focus-visible) .solutions-mosaic-reveal {
      grid-template-rows: 1fr;
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Mobile: tap mở — class .is-expanded (JS) */
  @media (max-width: 767px) {
    .solutions-mosaic__grid a.is-expanded .solutions-mosaic-body,
    .solutions-mosaic__grid a.is-expanded .solutions-mosaic-body * {
      text-shadow:
        0 1px 4px rgb(0 0 0 / 0.8),
        0 8px 22px rgb(0 0 0 / 0.48);
    }

    .solutions-mosaic__grid a.is-expanded .solutions-mosaic-scrim {
      height: 86%;
      background: linear-gradient(
        to top,
        rgb(0 0 0 / 0.8) 0%,
        rgb(0 0 0 / 0.68) 34%,
        rgb(0 0 0 / 0.46) 60%,
        rgb(0 0 0 / 0.18) 80%,
        transparent 96%
      );
    }

    .solutions-mosaic__grid .solutions-mosaic__card--compact a.is-expanded .solutions-mosaic-scrim {
      height: 80%;
      background: linear-gradient(
        to top,
        rgb(0 0 0 / 0.78) 0%,
        rgb(0 0 0 / 0.64) 32%,
        rgb(0 0 0 / 0.42) 58%,
        rgb(0 0 0 / 0.16) 78%,
        transparent 94%
      );
    }

    .solutions-mosaic__grid a.is-expanded .solutions-mosaic-reveal {
      grid-template-rows: 1fr;
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .solutions-mosaic-scrim,
    .solutions-mosaic-reveal {
      transition: none;
    }

    @media (min-width: 768px) {
      .solutions-mosaic__grid a:is(:hover, :focus-visible) .solutions-mosaic-scrim {
        height: 86%;
        background: linear-gradient(
          to top,
          rgb(0 0 0 / 0.8) 0%,
          rgb(0 0 0 / 0.68) 34%,
          rgb(0 0 0 / 0.46) 60%,
          rgb(0 0 0 / 0.18) 80%,
          transparent 96%
        );
      }

      .solutions-mosaic__grid .solutions-mosaic__card--compact a:is(:hover, :focus-visible) .solutions-mosaic-scrim {
        height: 80%;
        background: linear-gradient(
          to top,
          rgb(0 0 0 / 0.78) 0%,
          rgb(0 0 0 / 0.64) 32%,
          rgb(0 0 0 / 0.42) 58%,
          rgb(0 0 0 / 0.16) 78%,
          transparent 94%
        );
      }

      .solutions-mosaic__grid a:is(:hover, :focus-visible) .solutions-mosaic-reveal {
        grid-template-rows: 1fr;
        opacity: 1;
        transform: none;
      }
    }

    @media (max-width: 767px) {
      .solutions-mosaic__grid a.is-expanded .solutions-mosaic-scrim {
        height: 86%;
        background: linear-gradient(
          to top,
          rgb(0 0 0 / 0.8) 0%,
          rgb(0 0 0 / 0.68) 34%,
          rgb(0 0 0 / 0.46) 60%,
          rgb(0 0 0 / 0.18) 80%,
          transparent 96%
        );
      }

      .solutions-mosaic__grid .solutions-mosaic__card--compact a.is-expanded .solutions-mosaic-scrim {
        height: 80%;
        background: linear-gradient(
          to top,
          rgb(0 0 0 / 0.78) 0%,
          rgb(0 0 0 / 0.64) 32%,
          rgb(0 0 0 / 0.42) 58%,
          rgb(0 0 0 / 0.16) 78%,
          transparent 94%
        );
      }

      .solutions-mosaic__grid a.is-expanded .solutions-mosaic-reveal {
        grid-template-rows: 1fr;
        opacity: 1;
        transform: none;
      }
    }
  }
</style>
