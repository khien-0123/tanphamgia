---
import SiteImage from '../SiteImage.astro';
import { homeSolutions } from '../../data/home';
---

<section class="overflow-hidden bg-[#fbf8f1] text-[#1f1b17]" aria-labelledby="mockup-solutions-title">
  <div class="mx-auto w-full max-w-container-max-width px-6 py-12">
    <header data-reveal data-reveal-direction="up" class="max-w-[64rem]">
      <p class="mb-6 inline-flex rounded-full bg-[#ffedb7] px-4 py-2 text-xs font-extrabold uppercase tracking-[0.025em] text-[#806000] sm:text-sm">
        {homeSolutions.eyebrow}
      </p>
      <h2
        id="mockup-solutions-title"
        class="max-w-[34ch] text-balance text-[clamp(1.75rem,2.7vw,3rem)] font-extrabold leading-[1.1] tracking-[-0.03em] text-[#1f1b17]"
      >
        {homeSolutions.title}
      </h2>
      <p class="mt-6 max-w-[62rem] text-sm leading-[1.55] text-[#625a50] sm:text-base">
        {homeSolutions.description}
      </p>
    </header>

    <div data-reveal data-reveal-direction="up" class="mt-10 grid gap-5 sm:grid-cols-2 lg:mt-12 lg:grid-cols-4">
      {
        homeSolutions.items.map((item) => (
          <a
            href={item.href}
            class="group relative min-h-[24rem] overflow-hidden rounded-3xl border border-[#ded5c5] bg-[#e8e1d5] text-[#1f1b17] no-underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#b88900] lg:min-h-[24rem]"
          >
            <SiteImage
              src={item.image}
              alt={item.imageAlt}
              loading="lazy"
              class:list={[
                'absolute inset-0 h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-105 group-focus-visible:scale-105',
                item.imagePosition,
              ]}
              variant="card"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-[#f8f4eb] via-[#f8f4eb]/55 to-[#f8f4eb]/10 transition-colors duration-300 group-hover:bg-[#f8f4eb]/95 group-focus-visible:bg-[#f8f4eb]/95" aria-hidden="true"></div>

            <div class="absolute inset-x-0 bottom-0 p-5 transition-opacity duration-200 group-hover:opacity-0 group-focus-visible:opacity-0">
              <span class="inline-flex rounded-full bg-[#ffedb7] px-3 py-2 text-lg font-extrabold tabular-nums text-[#806000]">
                {item.number}
              </span>
              <h3 class="mt-2 text-sm font-extrabold leading-snug tracking-[-0.025em] text-[#26211c] sm:text-[0.95rem]">
                {item.title}
              </h3>
            </div>

            <div class="absolute inset-0 flex translate-y-4 flex-col justify-center bg-[#f8f0df]/95 p-5 opacity-0 transition-all duration-300 group-hover:translate-y-0 group-hover:opacity-100 group-focus-visible:translate-y-0 group-focus-visible:opacity-100">
              <div class="flex items-start gap-3">
                <span class="inline-flex shrink-0 rounded-full bg-[#ffedb7] px-3 py-2 text-sm font-extrabold tabular-nums text-[#806000]">
                  {item.number}
                </span>
                <h3 class="text-sm font-extrabold leading-snug text-[#26211c] sm:text-[0.95rem]">{item.title}</h3>
              </div>
              <ul class="mt-4 space-y-2 text-xs leading-[1.55] text-[#2b2722] sm:text-sm">
                {item.bullets.map((bullet) => <li><span aria-hidden="true">&gt;</span> {bullet}</li>)}
              </ul>
              <span class="mt-4 inline-flex items-center text-sm font-extrabold">
                Xem chi tiết
              </span>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>
