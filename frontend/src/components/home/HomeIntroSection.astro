---
import { homeIntro } from '../../data/site';
import { imageRadius } from '../../lib/image-frame';
import {
  introJourneyIconClasses,
  introJourneySlideClasses,
  introJourneyStepClasses,
  introJourneyTrackClasses,
} from '../../lib/intro-journey-classes';

const stepsMiddle = homeIntro.steps.slice(0, 3);
const stepsRight = homeIntro.steps.slice(3);
const stepCount = homeIntro.steps.length;
const trackSlideCount = stepCount + 2;
const trackStepHeight = 100 / trackSlideCount;
const firstStep = homeIntro.steps[0];
const lastStep = homeIntro.steps[stepCount - 1];
---

<section class="py-12 md:py-16 lg:py-20 bg-white" id="gioi-thieu" data-intro-journey>
  <div class="max-w-container-max-width mx-auto px-6 md:px-8">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,1.05fr)_minmax(0,0.95fr)] lg:gap-x-16 xl:gap-x-20 lg:items-start">
      <div data-reveal class="min-w-0 flex flex-col">
        <h2
          class="text-pretty font-headline-md font-bold text-ink-dark m-0 text-[1.25rem] leading-snug md:text-[1.75rem] md:leading-tight lg:text-[2rem]"
        >
          {homeIntro.title}
        </h2>

        <p class="text-pretty text-ink-dark/85 text-sm sm:text-base leading-snug m-0 mt-4 md:mt-5 max-w-prose">
          {homeIntro.leadLines[0]}
          <br />
          <span class="text-text-muted">{homeIntro.leadLines[1]}</span>
        </p>

        <div
          data-reveal-stagger
          class="mt-8 md:mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2 sm:gap-8 md:gap-10 sm:items-start"
        >
          <ul data-reveal class="m-0 p-0 list-none flex flex-col gap-3">
            {
              stepsMiddle.map((step, i) => (
                <li
                  data-journey-step
                  data-step-index={i}
                  class:list={['group/journey m-0', i === 0 && 'is-journey-active']}
                >
                  <button
                    type="button"
                    class:list={introJourneyStepClasses}
                    aria-current={i === 0 ? 'step' : undefined}
                  >
                    <span data-journey-icon class:list={introJourneyIconClasses}
                      aria-hidden="true"
                    >
                      ✓
                    </span>
                    <span data-journey-label>{step.label}</span>
                  </button>
                </li>
              ))
            }
          </ul>
          <ul data-reveal class="m-0 p-0 list-none flex flex-col gap-3">
            {
              stepsRight.map((step, i) => {
                const stepIndex = i + 3;
                return (
                  <li data-journey-step data-step-index={stepIndex} class="group/journey m-0">
                    <button type="button" class:list={introJourneyStepClasses}>
                      <span data-journey-icon class:list={introJourneyIconClasses}
                        aria-hidden="true"
                      >
                        ✓
                      </span>
                      <span data-journey-label>{step.label}</span>
                    </button>
                  </li>
                );
              })
            }
          </ul>
        </div>

        <a
          data-reveal
          href={homeIntro.cta.href}
          class="inline-flex items-center gap-2 mt-8 md:mt-10 text-sm font-bold text-ink-dark no-underline transition-colors hover:text-accent-gold group w-fit"
        >
          {homeIntro.cta.label}
          <span
            class="material-symbols-outlined text-lg transition-transform group-hover:translate-x-0.5"
            aria-hidden="true"
          >
            arrow_forward
          </span>
        </a>
      </div>

      <figure data-reveal class="relative m-0 lg:self-center">
        <span
          class="absolute -left-3 top-8 hidden h-20 w-1 bg-accent-gold lg:block"
          aria-hidden="true"
        >
        </span>
        <div
          data-journey-media
          data-step-count={stepCount}
          class:list={['relative w-full aspect-[4/3] overflow-hidden isolate [contain:layout_paint]', imageRadius]}
          style={`--journey-steps: ${trackSlideCount}; --journey-step-height: ${trackStepHeight}%`}
        >
          <div data-journey-track class:list={introJourneyTrackClasses}>
            <div
              class:list={introJourneySlideClasses}
              data-journey-slide
              data-journey-clone="head"
              aria-hidden="true"
            >
              <img
                src={lastStep.image}
                alt=""
                loading="eager"
                decoding="async"
                class="block h-full w-full object-cover"
                draggable="false"
              />
            </div>
            {
              homeIntro.steps.map((step) => (
                <div class:list={introJourneySlideClasses} data-journey-slide>
                  <img
                    src={step.image}
                    alt={step.imageAlt}
                    loading="eager"
                    decoding="async"
                    class="block h-full w-full object-cover"
                    draggable="false"
                  />
                </div>
              ))
            }
            <div
              class:list={introJourneySlideClasses}
              data-journey-slide
              data-journey-clone="tail"
              aria-hidden="true"
            >
              <img
                src={firstStep.image}
                alt=""
                loading="eager"
                decoding="async"
                class="block h-full w-full object-cover"
                draggable="false"
              />
            </div>
          </div>
        </div>
      </figure>
    </div>
  </div>
</section>

<script src="../../scripts/home-intro-journey.ts"></script>
