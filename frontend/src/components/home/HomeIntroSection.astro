---
import { homeHero } from '../../data/home';
import SiteImage from '../SiteImage.astro';
import { sectionPy } from '../../lib/section-rhythm';

const { about } = homeHero;
---

<section class="flex bg-[#0D1B3A] text-white lg:min-h-[max(42rem,100svh)]" aria-labelledby="mockup-about-title">
  <div class:list={['mx-auto grid w-full max-w-container-max-width items-center gap-10 px-6 lg:min-h-[max(42rem,100svh)] lg:grid-cols-[1.02fr_1fr] lg:gap-8 xl:gap-10', sectionPy]}>
    <figure data-reveal data-reveal-direction="up" class="m-0 overflow-hidden rounded-[1.75rem] bg-white/5 lg:self-stretch">
      <SiteImage
        src={about.image}
        alt={about.imageAlt}
        class="block aspect-[1.1/1] sm:aspect-square h-full w-full object-cover lg:aspect-auto lg:h-full"
        loading="lazy"
        variant="card"
        sizes="(min-width: 1024px) 46vw, 100vw"
      />
    </figure>

    <div data-reveal data-reveal-direction="up" class="max-w-[43rem] lg:py-3">
      <p class="mb-4 inline-flex rounded-full bg-[#fff0bd] px-5 py-2 text-xs font-extrabold uppercase tracking-[0.025em] text-[#7a5900]">
        {about.eyebrow}
      </p>

      <h2
        id="mockup-about-title"
        class="max-w-[21ch] text-balance text-[clamp(1.75rem,2.7vw,3rem)] font-extrabold leading-[1.1] tracking-[-0.03em] text-white"
      >
        {about.title}
      </h2>

      <div class="mt-6 space-y-2 text-sm leading-[1.55] text-white/78 sm:text-base">
        {about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>

      <ul class="mt-7 grid list-none gap-1 p-0 text-sm font-medium leading-snug text-white/90 sm:text-[0.95rem]">
        {
          about.highlights.map((highlight) => (
            <li class="flex items-start gap-2">
              <span class="mt-[0.05rem] font-extrabold text-[#FFBE1B]" aria-hidden="true">✓</span>
              <span>{highlight}</span>
            </li>
          ))
        }
      </ul>

      <a
        href={about.cta.href}
        class="mt-8 inline-flex min-h-14 items-center justify-center gap-2.5 rounded-full bg-accent-gold px-9 py-4 text-center text-base font-extrabold leading-snug text-ink-dark shadow-[0_12px_30px_rgba(255,201,51,0.2)] transition-all hover:-translate-y-0.5 hover:shadow-[0_16px_34px_rgba(255,201,51,0.32)] sm:px-10 sm:text-lg"
      >
        <span>{about.cta.label}</span>
        <span class="material-symbols-outlined text-xl leading-none sm:text-2xl" aria-hidden="true">arrow_forward</span>
      </a>
    </div>
  </div>
</section>
