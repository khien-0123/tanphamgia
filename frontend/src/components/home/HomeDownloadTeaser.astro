---
import { homeCatalogCovers } from '../../data/assets';
import { routes } from '../../lib/routes';
import { imageRadius } from '../../lib/image-frame';
import { RHYTHM_WHITE, sectionPy } from '../../lib/section-rhythm';

interface Props {
  sectionBg?: string;
}

const { sectionBg = RHYTHM_WHITE } = Astro.props;
---
<section
  id="tai-lieu"
  class:list={[sectionPy, 'text-ink-dark overflow-visible', sectionBg]}
>
  <div
    class="max-w-container-max-width mx-auto px-6 md:px-8 grid md:grid-cols-2 gap-8 md:gap-16 items-center overflow-visible"
  >
    <div data-reveal>
      <h2
        class="font-display-lg text-[clamp(1.15rem,4.8vw,2.75rem)] md:text-5xl font-bold mb-6 leading-tight text-ink-dark"
      >
        Tải trọn bộ tài liệu mới nhất
      </h2>
      <p class="text-body-lg text-text-muted mb-8">
        Company Profile, Catalogue Đồng Phục 2026 và kiến thức hữu ích về triển khai đồng phục
        doanh nghiệp.
      </p>
      <ul class="space-y-3 text-sm md:text-base mb-8">
        <li class="flex items-center gap-2">
          <span class="material-symbols-outlined text-accent-gold text-lg">check_circle</span>
          Company Profile Tân Phạm Gia
        </li>
        <li class="flex items-center gap-2">
          <span class="material-symbols-outlined text-accent-gold text-lg">check_circle</span>
          Catalogue Đồng Phục Doanh Nghiệp 2026
        </li>
        <li class="flex items-center gap-2">
          <span class="material-symbols-outlined text-accent-gold text-lg">check_circle</span>
          Kiến thức chọn vải & triển khai đồng phục
        </li>
      </ul>
      <a
        href={routes.taiLieu}
        class="inline-flex items-center gap-2 text-sm font-bold text-accent-teal hover:text-ink-dark transition-colors"
      >
        Xem toàn bộ thư viện tài liệu
        <span class="material-symbols-outlined text-base">arrow_forward</span>
      </a>
    </div>

    <a
      href={routes.taiLieu}
      class="group block mx-auto w-full max-w-[min(100%,26rem)] sm:max-w-md md:max-w-lg md:mx-0 md:ml-auto md:justify-self-end pb-10 md:pb-12 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent-teal"
      data-reveal
      aria-label="Xem và tải catalogue, hồ sơ năng lực Tân Phạm Gia"
    >
      <figure
        class="relative mx-auto aspect-[5/4] sm:aspect-[4/3] w-full overflow-visible transition-transform duration-500 group-hover:scale-[1.02]"
      >
        {
          homeCatalogCovers.map((cover) => (
            <img
              src={cover.src}
              alt={cover.alt}
              class:list={['absolute object-cover', imageRadius, cover.class]}
              loading="lazy"
            />
          ))
        }
      </figure>
    </a>
  </div>
</section>
