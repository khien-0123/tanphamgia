---
/** Bìa catalogue Tân Phạm Gia — nguồn dongphucvn.vn */
const catalogCovers = [
  {
    src: '/images/documents/catalog-y-te.webp',
    alt: 'Catalogue đồng phục y tế Tân Phạm Gia',
    class: 'left-[4%] top-[10%] w-[58%] -rotate-6 shadow-[0_18px_40px_-20px_rgba(16,44,77,0.45)]',
  },
  {
    src: '/images/documents/catalog-the-thao.webp',
    alt: 'Catalogue đồng phục thể thao Tân Phạm Gia',
    class: 'left-[22%] top-[6%] w-[58%] rotate-2 shadow-[0_22px_48px_-18px_rgba(16,44,77,0.5)]',
  },
  {
    src: '/images/documents/catalog-teaser.webp',
    alt: 'Catalogue polo doanh nghiệp Tân Phạm Gia',
    class: 'left-[38%] top-[2%] w-[58%] rotate-[9deg] shadow-[0_28px_56px_-16px_rgba(16,44,77,0.55)] z-10',
  },
];
---
<section
  id="tai-lieu"
  class="py-8 md:py-12 bg-white text-ink-dark"
>
  <div
    class="max-w-container-max-width mx-auto px-6 md:px-8 grid md:grid-cols-2 gap-8 md:gap-16 items-center"
  >
    <div data-reveal>
      <h2
        class="font-display-lg text-[clamp(1.15rem,4.8vw,2.75rem)] md:text-5xl font-bold mb-6 leading-tight text-ink-dark"
      >
        Tải trọn bộ tài liệu mới nhất
      </h2>
      <p class="text-body-lg text-text-muted mb-8">
        Company Profile, Catalogue Đồng Phục 2026 và kiến thức hữu ích về triển khai đồng phục
        doanh nghiệp.
      </p>
      <ul class="space-y-3 text-sm md:text-base mb-8">
        <li class="flex items-center gap-2">
          <span class="material-symbols-outlined text-accent-gold text-lg">check_circle</span>
          Company Profile Tân Phạm Gia
        </li>
        <li class="flex items-center gap-2">
          <span class="material-symbols-outlined text-accent-gold text-lg">check_circle</span>
          Catalogue Đồng Phục Doanh Nghiệp 2026
        </li>
        <li class="flex items-center gap-2">
          <span class="material-symbols-outlined text-accent-gold text-lg">check_circle</span>
          Kiến thức chọn vải & triển khai đồng phục
        </li>
      </ul>
      <a
        href="/tai-lieu"
        class="inline-flex items-center gap-2 text-sm font-bold text-accent-teal hover:text-ink-dark transition-colors"
      >
        Xem toàn bộ thư viện tài liệu
        <span class="material-symbols-outlined text-base">arrow_forward</span>
      </a>
    </div>

    <a
      href="/tai-lieu"
      class="group block w-full max-w-md md:max-w-lg md:justify-self-end focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent-teal"
      data-reveal
      aria-label="Xem và tải catalogue, hồ sơ năng lực Tân Phạm Gia"
    >
      <figure
        class="relative mx-auto aspect-[4/3] w-full transition-transform duration-500 group-hover:scale-[1.02]"
      >
        {
          catalogCovers.map((cover) => (
            <img
              src={cover.src}
              alt={cover.alt}
              class:list={['absolute rounded-lg object-cover', cover.class]}
              loading="lazy"
            />
          ))
        }
      </figure>
    </a>
  </div>
</section>
