---
import HomeClientLogos from '../HomeClientLogos.astro';
import { RHYTHM_WHITE } from '../../lib/section-rhythm';

interface Props {
  sectionBg?: string;
}

const { sectionBg = RHYTHM_WHITE } = Astro.props;
---

<section class:list={['py-8 md:py-12', sectionBg]} id="doi-tac">
  <div
    class="max-w-container-max-width mx-auto px-6 md:px-8 grid lg:grid-cols-5 gap-8 lg:gap-10 items-center"
  >
    <div data-reveal class="lg:col-span-2">
      <h2 class="text-2xl md:text-3xl font-bold text-ink-dark mb-4 leading-snug">
        Tân Phạm Gia được tin tưởng lựa chọn bởi:
      </h2>
      <p class="text-text-muted text-sm md:text-base leading-relaxed">
        23 năm đồng hành cùng doanh nghiệp trong hành trình xây dựng hình ảnh chuyên nghiệp thông
        qua các giải pháp đồng phục được phát triển bài bản và bền vững.
      </p>
    </div>
    <HomeClientLogos />
  </div>
</section>
