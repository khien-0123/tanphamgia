---
import SiteImage from '../SiteImage.astro';
import { homeClients } from '../../data/home';
import { getClientLogoScale } from '../../lib/client-logo-scale';

const midpoint = Math.ceil(homeClients.items.length / 2);
const rows = [
  homeClients.items.slice(0, midpoint),
  homeClients.items.slice(midpoint),
] as const;

function repeatLogos<T>(items: readonly T[], times = 4): T[] {
  return Array.from({ length: times }, () => [...items]).flat();
}

const mockupLogoScale: Record<string, number> = {
  '/images/logos/van-hanh-mall.webp': 1.55,
  '/images/logos/vfm.webp': 1.85,
  '/images/logos/vietbank.jpg': 1.55,
  '/images/logos/bv-rang-ham-mat-sg.webp': 1.55,
  '/images/logos/hanwha-life.webp': 1.5,
  '/images/logos/zero-waste.png': 1.5,
};

function getMockupLogoScale(logo: string): number {
  return mockupLogoScale[logo] ?? getClientLogoScale(logo);
}
---

<section class="overflow-hidden bg-[#0d1b3a] text-white" aria-labelledby="mockup-clients-title">
  <div class="mx-auto w-full max-w-container-max-width px-6 py-10 lg:py-12">
    <header data-reveal data-reveal-direction="up" class="max-w-[64rem]">
      <p class="mb-5 inline-flex rounded-full bg-[#ffedb7] px-4 py-2 text-xs font-extrabold uppercase tracking-[0.025em] text-[#806000] sm:text-sm">
        {homeClients.eyebrow}
      </p>
      <h2
        id="mockup-clients-title"
        class="max-w-[34ch] text-balance text-[clamp(1.75rem,2.7vw,3rem)] font-extrabold leading-[1.1] tracking-[-0.03em] text-white"
      >
        {homeClients.title}
      </h2>
      <p class="mt-4 max-w-[51rem] text-sm leading-[1.55] text-white/78 sm:text-base">
        {homeClients.description}
      </p>
    </header>

    <h3 class="mt-6 text-base font-extrabold uppercase tracking-[-0.015em] text-white sm:text-lg">
      {homeClients.logosLabel}
    </h3>

    <div data-reveal data-reveal-motion="fade" class="mockup-clients-marquee mt-5 space-y-3 overflow-hidden sm:space-y-4">
      {
        rows.map((row, rowIndex) => (
          <div
            class:list={[
              'mockup-clients-track flex w-max gap-4 sm:gap-5',
              rowIndex === 0 ? 'mockup-clients-track--left' : 'mockup-clients-track--right',
            ]}
          >
            {repeatLogos(row).map((client, index) => (
              <article
                class="group flex min-h-[7.75rem] w-[13rem] shrink-0 items-center justify-center overflow-hidden rounded-[1.15rem] border border-white/70 bg-[#fbfaf7] px-5 py-6 shadow-[0_16px_36px_rgba(2,8,23,0.16)] transition-colors duration-300 hover:border-[#ffcf4d] sm:min-h-[8.75rem] sm:w-[15rem] lg:min-h-[8.25rem] lg:w-[15.5rem]"
                title={client.name}
                aria-hidden={index >= row.length ? 'true' : undefined}
              >
                <SiteImage
                  src={client.logo}
                  alt={index < row.length ? client.name : ''}
                  loading="lazy"
                  class="max-h-14 w-auto max-w-full object-contain object-center opacity-[0.92] grayscale-[0.12] transition-all duration-300 group-hover:opacity-100 group-hover:grayscale-0 sm:max-h-16"
                  style={`transform: scale(${getMockupLogoScale(client.logo)}); transform-origin: center`}
                  variant="logo"
                />
                <span
                  data-logo-fallback
                  class="hidden px-1 text-center text-xs font-extrabold leading-tight text-[#33415c]"
                >
                  {client.name}
                </span>
              </article>
            ))}
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .mockup-clients-marquee {
    width: 100vw;
    margin-left: calc(50% - 50vw);
    padding-inline: 1.5rem;
  }

  @media (min-width: 640px) {
    .mockup-clients-marquee {
      padding-inline: 2rem;
    }
  }

  @media (min-width: 1024px) {
    .mockup-clients-marquee {
      padding-inline: 3rem;
    }
  }

  @keyframes mockup-clients-scroll-left {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  @keyframes mockup-clients-scroll-right {
    from {
      transform: translateX(-50%);
    }
    to {
      transform: translateX(0);
    }
  }

  .mockup-clients-track--left {
    animation: mockup-clients-scroll-left 75s linear infinite;
  }

  .mockup-clients-track--right {
    animation: mockup-clients-scroll-right 75s linear infinite;
  }

  .mockup-clients-marquee:hover .mockup-clients-track {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .mockup-clients-track {
      animation: none;
      transform: none;
    }
  }
</style>
