---
import { blogPosts, blogSectionMeta } from '../../data/site';
import SliderArrow from '../SliderArrow.astro';
import BlogPostFigure from '../BlogPostFigure.astro';
import BlogPostTitle from '../BlogPostTitle.astro';

const featured = blogPosts[0];
const gridPosts = blogPosts.slice(1);
const { allPostsHref } = blogSectionMeta;

/** Mobile: 3 bộ slide để vòng lặp vô hạn */
const SLIDER_SETS = 3;
const sliderPosts = Array.from({ length: SLIDER_SETS }, () => blogPosts).flat();
const postsPerSet = blogPosts.length;
---

<section class="py-8 md:py-12 bg-white" id="tin-tuc">
  <div class="max-w-container-max-width mx-auto px-6 md:px-8">
    <header
      data-reveal
      class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-3 md:gap-4 mb-6 md:mb-8"
    >
      <div class="max-w-2xl">
        <h2
          class="font-display-lg font-bold tracking-tight text-ink-dark mb-2 md:mb-4 text-[clamp(1.375rem,5.5vw,1.5rem)] leading-snug md:text-5xl md:leading-tight md:tracking-tighter text-pretty"
        >
          Tin Tức & Kiến Thức Ngành
        </h2>
        <p class="text-text-muted text-sm md:text-base max-w-lg leading-relaxed">
          Những chia sẻ từ hành trình sản xuất đồng phục và các dự án gần đây của chúng tôi.
        </p>
      </div>
      <a
        href={allPostsHref}
        class="bg-ink-dark text-white px-5 py-2.5 md:px-6 md:py-3 rounded-full text-xs md:text-sm font-bold hover:bg-accent-gold hover:text-ink-dark transition-all shadow-soft shrink-0 self-start sm:self-auto no-underline"
      >
        Xem tất cả bài viết
      </a>
    </header>

    <!-- Mobile: slider scroll vòng lặp + tự chạy -->
    <div class="min-w-0 overflow-anchor-none md:hidden relative group/slider" data-news-slider>
      <div
        class="flex overflow-x-auto overflow-y-hidden snap-x snap-proximity overscroll-x-contain [-webkit-overflow-scrolling:touch] [scrollbar-width:none] pb-1 [&::-webkit-scrollbar]:hidden"
        data-slider-track
        aria-label="Tin tức nổi bật"
      >
        {
          sliderPosts.map((post, postIndex) => {
            const setIndex = Math.floor(postIndex / postsPerSet);
            const isClone = setIndex !== 1;

            return (
              <a
                href={post.href ?? allPostsHref}
                class="group shrink-0 snap-start basis-full min-w-0 px-1 box-border no-underline text-ink-dark"
                data-slider-slide
                aria-hidden={isClone ? 'true' : undefined}
                tabindex={isClone ? -1 : undefined}
              >
                <BlogPostFigure
                  src={post.image}
                  alt={post.alt}
                  class="mb-3.5"
                  imgClass="transition-transform duration-400 group-active:scale-[1.02]"
                />
                <div class="min-h-[7.5rem]">
                  <BlogPostTitle
                    post={post}
                    as="h3"
                    class="m-0 mb-2 text-[clamp(1.0625rem,4.2vw,1.125rem)] font-bold leading-snug tracking-tight text-pretty line-clamp-3"
                  />
                  <p class="m-0 mb-2.5 text-sm leading-relaxed text-pretty text-[#111]/65 line-clamp-3">
                    {post.excerpt}
                  </p>
                  <span
                    class="text-[0.8125rem] font-bold text-accent-teal"
                    style={post.categoryColor ? `color: ${post.categoryColor}` : undefined}
                  >
                    {post.category}
                  </span>
                </div>
              </a>
            );
          })
        }
      </div>
      <SliderArrow direction="prev" />
      <SliderArrow direction="next" />
    </div>

    <!-- Desktop: featured + grid -->
    <div class="hidden md:block">
      {
        featured && (
          <article data-reveal class="grid md:grid-cols-2 gap-6 md:gap-10 items-start mb-6 md:mb-10 pb-6 md:pb-10 group">
            <a href={featured.href ?? allPostsHref} class="contents no-underline text-inherit">
              <BlogPostFigure
                src={featured.image}
                alt={featured.alt}
                imgClass="transition-transform duration-500 group-hover:scale-[1.03]"
              />
              <div class="flex flex-col justify-center min-w-0">
                <h3 class="font-display-lg text-2xl md:text-4xl leading-tight text-ink-dark mb-5">
                  {featured.title}
                </h3>
                <p class="text-body-lg text-text-muted mb-6">{featured.excerpt}</p>
                <div class="mt-auto pt-4">
                  <span class="font-bold text-accent-teal">{featured.category}</span>
                </div>
              </div>
            </a>
          </article>
        )
      }
      <div data-reveal-stagger class="grid md:grid-cols-3 gap-6 md:gap-8">
        {
          gridPosts.map((post) => (
            <a
              data-reveal
              href={post.href ?? allPostsHref}
              class="group cursor-pointer no-underline text-inherit"
            >
              <BlogPostFigure
                src={post.image}
                alt={post.alt}
                class="mb-6"
                imgClass="transition-transform duration-500 group-hover:scale-[1.05]"
              />
              <span
                class="font-bold text-xs uppercase tracking-widest mb-4 block"
                style={post.categoryColor ? `color: ${post.categoryColor}` : undefined}
              >
                {post.category}
              </span>
              <BlogPostTitle
                post={post}
                as="h4"
                class="text-xl font-bold text-ink-dark mb-4 group-hover:text-accent-gold transition-colors"
              />
            </a>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script src="../../scripts/home-news-slider.ts"></script>
