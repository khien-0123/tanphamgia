---
import { homeHero } from '../../data/home';
import { routes } from '../../lib/routes';
---

<main class="relative overflow-visible bg-[#f5f0e7] p-0 sm:p-2 lg:p-0">
  <section class="relative flex flex-col pb-12 sm:min-h-[100svh] sm:pb-0 overflow-visible bg-ink-dark text-white">
    <div class="absolute inset-0" aria-hidden="true">
      <video class="h-full w-full object-cover object-center" autoplay loop muted playsinline preload="metadata" poster={homeHero.poster}>
        <source src={homeHero.media} type="video/mp4" />
        Trình duyệt của bạn không hỗ trợ video nền.
      </video>
      <div class="absolute inset-0 bg-black/45"></div>
      <div class="absolute inset-0 bg-[linear-gradient(90deg,rgba(0,0,0,.44),rgba(0,0,0,.12)_62%,rgba(6,22,35,.46))]"></div>
      <div class="absolute inset-x-0 bottom-0 h-52 bg-gradient-to-t from-black/45 to-transparent"></div>
    </div>


    <div class="relative z-10 mx-auto flex w-full max-w-[96rem] flex-1 flex-col px-5 pb-5 pt-[clamp(6.5rem,12svh,7.5rem)] sm:pt-[clamp(5.5rem,13svh,9rem)] sm:px-8 lg:px-12 xl:px-16">

      <div class="flex flex-1 flex-col pt-[clamp(1.5rem,4svh,3rem)] sm:pb-[clamp(3rem,7svh,5rem)] lg:pt-0">
        <div aria-hidden="true" class="grow sm:grow-[4]"></div>
        <div data-reveal-stagger class="mx-auto w-full max-w-[84rem]">
          <p data-reveal class="mb-5 text-center text-[0.65rem] font-bold uppercase tracking-[0.26em] text-accent-gold lg:hidden">{homeHero.eyebrow}</p>
          <h1 data-reveal class="mx-auto max-w-[84rem] text-center text-[clamp(2.25rem,min(1.1rem+4.2vw,8.5svh),5.75rem)] font-extrabold leading-[1.05] tracking-[-0.045em] text-white">
            {homeHero.title}
          </h1>

          <p data-reveal class="mx-auto mt-[clamp(1.25rem,3svh,1.75rem)] max-w-[75rem] text-center text-sm leading-relaxed text-white/80 sm:text-lg lg:text-xl">
            {homeHero.description}
          </p>

          <div data-reveal class="mx-auto mt-[clamp(1.5rem,3.5svh,2rem)] flex w-full max-w-full flex-row items-stretch gap-2 sm:max-w-[92%] sm:gap-2.5 md:max-w-xl">
            <a
              href={routes.lienHe}
              class="flex min-w-0 flex-1 items-center justify-center gap-2 rounded-full bg-accent-gold py-1.5 pl-4 pr-1.5 text-center text-sm font-bold leading-snug text-ink-dark shadow-soft transition-all hover:scale-105 hover:shadow-gold sm:gap-2.5 sm:pl-5 sm:pr-2 sm:text-base md:text-[0.9rem]"
            >
              Nhận tư vấn giải pháp
              <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-ink-dark/15 text-ink-dark sm:h-9 sm:w-9" aria-hidden="true">
                <span class="material-symbols-outlined text-base leading-none sm:text-lg">arrow_forward</span>
              </span>
            </a>
            <a
              href={routes.taiLieu}
              class="flex min-w-0 flex-1 items-center justify-center rounded-full border border-white/60 bg-white/10 px-3.5 py-3 text-center text-sm font-bold leading-snug text-white backdrop-blur-md transition-all hover:scale-105 hover:bg-white/20 sm:px-4 sm:py-3.5 sm:text-base md:px-[1.575rem] md:py-[0.7875rem] md:text-[0.9rem]"
            >
              Tải hồ sơ năng lực
            </a>
          </div>
        </div>
        <div aria-hidden="true" class="grow"></div>

        <div data-reveal class="hidden sm:flex items-end justify-between gap-5 pt-[clamp(1.5rem,4svh,3.5rem)]">
          {/* Stat card — ẩn trên mobile, hiện từ sm trở lên */}
          <div class="hidden sm:block w-[15.5rem] rounded-[2rem] border border-white/35 bg-white/10 px-6 py-6 shadow-[0_18px_45px_rgba(0,0,0,.2)] backdrop-blur-md sm:w-[18rem] sm:px-7">
            <p
              class="text-4xl font-extrabold tracking-[-0.045em] text-white sm:text-5xl"
              data-hero-stat-counter
              data-hero-stat-target={homeHero.stat.value}
            >
              {homeHero.stat.value}
            </p>
            <p class="mt-2 text-xs text-white/75 sm:text-sm">{homeHero.stat.label}</p>
          </div>

        </div>
      </div>
    </div>

    {/* Dossier card — Đặt ở level section để neo sát màn hình, không bị giới hạn bởi container max-width */}
    <a
      href={homeHero.dossier.href}
      class="hidden sm:flex absolute right-0 bottom-0 z-30 min-h-[7rem] w-[17.5rem] sm:w-[18.5rem] items-center rounded-tl-[3rem] bg-[#faf8f2] px-8 py-4 text-ink-dark shadow-[-6px_-4px_16px_rgba(0,0,0,.1)]"
    >
      <span aria-hidden="true" class="mr-9 text-[1.75rem] font-bold leading-none">↗</span>
      <span class="text-left">
        <strong class="block text-xl font-extrabold leading-tight tracking-[-0.025em]">{homeHero.dossier.title}</strong>
        <span class="mt-1 block text-base leading-tight text-ink-dark/80">{homeHero.dossier.subtitle}</span>
      </span>
    </a>
  </section>
</main>

<script src="../../scripts/hero-stats-counter.ts"></script>
