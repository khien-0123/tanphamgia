---
import { homeHero } from '../../data/home';
import SiteNav from '../SiteNav.astro';
import { routes } from '../../lib/routes';
---

<main class="relative overflow-visible bg-[#f5f0e7] p-0 sm:p-2 lg:p-0">
  <section class="relative min-h-[46rem] overflow-visible bg-ink-dark text-white sm:min-h-[48rem] lg:h-[min(50rem,100svh)] lg:min-h-[42rem]">
    <div class="absolute inset-0" aria-hidden="true">
      <video class="h-full w-full object-cover object-center" autoplay loop muted playsinline preload="metadata" poster={homeHero.poster}>
        <source src={homeHero.media} type="video/mp4" />
        Trình duyệt của bạn không hỗ trợ video nền.
      </video>
      <div class="absolute inset-0 bg-black/45"></div>
      <div class="absolute inset-0 bg-[linear-gradient(90deg,rgba(0,0,0,.44),rgba(0,0,0,.12)_62%,rgba(6,22,35,.46))]"></div>
      <div class="absolute inset-x-0 bottom-0 h-52 bg-gradient-to-t from-black/45 to-transparent"></div>
    </div>

    <SiteNav currentPath={routes.home} navOverDark />

    <div class="relative z-10 mx-auto h-full w-full max-w-[96rem] px-5 pb-5 pt-24 sm:px-8 sm:pt-28 lg:px-12 lg:pb-5 xl:px-16">

      <div class="flex h-[calc(100%-5rem)] flex-col pt-10 sm:pt-12 lg:h-[calc(100%-5rem)] lg:pt-0">
        <div data-reveal-stagger class="mx-auto w-full max-w-[84rem]">
          <p data-reveal class="mb-5 text-center text-[0.65rem] font-bold uppercase tracking-[0.26em] text-accent-gold lg:hidden">{homeHero.eyebrow}</p>
          <h1 data-reveal class="mx-auto max-w-[84rem] text-center text-[clamp(2.6rem,5vw,5.75rem)] font-extrabold leading-[1.03] tracking-[-0.045em] text-white">
            {homeHero.title}
          </h1>

          <p data-reveal class="mx-auto mt-7 max-w-[75rem] text-center text-sm leading-relaxed text-white/80 sm:text-lg lg:text-xl">
            {homeHero.description}
          </p>

          <div data-reveal class="mx-auto mt-8 flex w-full max-w-full flex-row items-stretch gap-2 sm:max-w-[92%] sm:gap-2.5 md:max-w-xl">
            <a
              href={routes.lienHe}
              class="min-w-0 flex-1 rounded-full bg-accent-gold px-3.5 py-3 text-center text-sm font-bold leading-snug text-ink-dark shadow-soft transition-all hover:scale-105 hover:shadow-gold sm:px-4 sm:py-3.5 sm:text-base md:px-[1.575rem] md:py-[0.7875rem] md:text-[0.9rem]"
            >
              Nhận tư vấn giải pháp
            </a>
            <a
              href={routes.taiLieu}
              class="min-w-0 flex-1 rounded-full border border-white bg-white px-3.5 py-3 text-center text-sm font-bold leading-snug text-ink-dark transition-all hover:scale-105 hover:shadow-soft sm:px-4 sm:py-3.5 sm:text-base md:px-[1.575rem] md:py-[0.7875rem] md:text-[0.9rem]"
            >
              Tải hồ sơ năng lực
            </a>
          </div>
        </div>

        <div data-reveal class="mt-auto flex items-end justify-between gap-5 pt-14">
          <div class="w-[15.5rem] rounded-[2rem] border border-white/35 bg-white/10 px-6 py-6 shadow-[0_18px_45px_rgba(0,0,0,.2)] backdrop-blur-md sm:w-[18rem] sm:px-7">
            <p
              class="text-4xl font-extrabold tracking-[-0.045em] text-white sm:text-5xl"
              data-hero-stat-counter
              data-hero-stat-target={homeHero.stat.value}
            >
              {homeHero.stat.value}
            </p>
            <p class="mt-2 text-xs text-white/75 sm:text-sm">{homeHero.stat.label}</p>
          </div>

          <a
            href={homeHero.dossier.href}
            class="relative z-30 -mb-7 -mr-5 flex h-28 w-[17.5rem] translate-y-[15px] shrink-0 items-center rounded-tl-[3rem] rounded-br-[2rem] bg-[#faf8f2] px-8 text-ink-dark shadow-[-6px_-4px_16px_rgba(0,0,0,.1)] sm:-mr-8 sm:w-[18.5rem] lg:-mb-5 lg:-mr-12 lg:translate-y-0 xl:-mr-16"
          >
            <span aria-hidden="true" class="mr-9 text-[1.75rem] font-bold leading-none">↗</span>
            <span class="text-left">
              <strong class="block text-xl font-extrabold leading-tight tracking-[-0.025em]">{homeHero.dossier.title}</strong>
              <span class="mt-1 block text-base leading-tight text-ink-dark/80">{homeHero.dossier.subtitle}</span>
            </span>
          </a>
        </div>
      </div>
    </div>
  </section>
</main>

<script src="../../scripts/hero-stats-counter.ts"></script>
