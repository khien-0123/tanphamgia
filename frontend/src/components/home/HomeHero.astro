---
import { stats, heroMedia } from '../../data/site';
import { routes } from '../../lib/routes';

/** Lớp phủ hero — mờ nhẹ để video vẫn thấy chuyển động nhưng không lấn chữ */
const heroOverlay = heroMedia.video
  ? 'absolute inset-0 z-10 bg-black/30'
  : 'absolute inset-0 z-10 bg-black/40';
---

<header
  data-page-hero
  class="relative flex flex-col overflow-hidden pt-24 min-h-0 sm:min-h-[480px] md:min-h-[520px] lg:min-h-screen"
>
  <div class="absolute inset-0 z-0">
    <div class={heroOverlay}></div>
    {
      heroMedia.video ? (
        <video
          class="w-full h-full object-cover object-center opacity-90"
          id="hero-video"
          autoplay
          loop
          muted
          playsinline
        >
          <source src={heroMedia.video} type="video/mp4" />
        </video>
      ) : (
        <div class="w-full h-full bg-ink-dark" id="hero-image" aria-hidden="true"></div>
      )
    }
  </div>

  <div
    class="relative z-20 flex flex-1 flex-col max-w-container-max-width mx-auto px-6 md:px-8 w-full text-center text-white py-8 md:py-12"
  >
    <div class="flex flex-1 flex-col items-center justify-center w-full">
      <div class="w-full flex flex-col items-center md:inline-grid md:w-max md:max-w-full md:mx-auto md:[grid-template-columns:minmax(0,max-content)] md:justify-items-stretch">
        <h1
          class="font-display-lg font-extrabold mb-5 flex flex-col gap-2 md:gap-1 leading-[1.35] md:leading-[1.12] tracking-normal md:tracking-normal md:[grid-row:1]"
        >
          <span class="block text-[clamp(1.75rem,7.5vw,2.25rem)] md:text-[3.5rem] md:whitespace-nowrap">Đồng Phục Chuẩn Thương Hiệu.</span>
          <span class="block text-[clamp(1.75rem,7.5vw,2.25rem)] text-accent-gold md:text-[3.5rem] md:whitespace-nowrap">
            Chuẩn Tiến Độ. Chuẩn Từng Chiếc.
          </span>
        </h1>
        <p
          class="font-body-lg text-base md:text-lg mb-5 md:mb-8 max-w-2xl mx-auto md:mx-0 md:w-full md:max-w-none text-white/85 leading-relaxed text-center md:[grid-row:2]"
        >
          23 năm đồng hành cùng doanh nghiệp xây dựng hình ảnh chuyên nghiệp với giải pháp đồng phục
          toàn diện.
        </p>
        <div class="flex flex-row gap-2 sm:gap-2.5 items-stretch w-full max-w-full sm:max-w-[92%] md:max-w-xl mx-auto md:[grid-row:3]">
          <a
            href={routes.lienHe}
            class="flex-1 min-w-0 bg-accent-gold text-ink-dark px-3.5 py-3 sm:px-4 sm:py-3.5 md:px-[1.575rem] md:py-[0.7875rem] rounded-full font-bold text-sm sm:text-base md:text-[0.9rem] leading-snug hover:shadow-gold hover:scale-105 transition-all shadow-soft text-center"
          >
            Nhận tư vấn giải pháp
          </a>
          <a
            href={routes.taiLieu}
            class="flex-1 min-w-0 bg-white text-ink-dark border border-white px-3.5 py-3 sm:px-4 sm:py-3.5 md:px-[1.575rem] md:py-[0.7875rem] rounded-full font-bold text-sm sm:text-base md:text-[0.9rem] leading-snug hover:shadow-soft hover:scale-105 transition-all text-center"
          >
            Tải hồ sơ năng lực
          </a>
        </div>
      </div>
    </div>

    <dl
      class="mt-10 md:mt-14 lg:mt-auto lg:pt-10 w-full max-w-4xl mx-auto grid grid-cols-4 gap-x-2 md:gap-x-8 pb-2 md:pb-4"
    >
      {
        stats.map((item, i) => (
          <div
            class:list={[
              'text-center m-0 min-w-0',
              i > 0 && 'border-l border-white/20 pl-2 md:pl-5',
            ]}
          >
            <dt
              class="text-xl sm:text-2xl md:text-4xl font-extrabold text-white mb-0.5 md:mb-1 leading-none tabular-nums"
              data-hero-stat-counter
              data-hero-stat-target={item.value}
            >
              {item.value}
            </dt>
            <dd class="text-[0.625rem] sm:text-[0.6875rem] md:text-xs text-white/70 leading-snug m-0">{item.label}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</header>

<script src="../../scripts/hero-stats-counter.ts"></script>
