---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import PageHero from '../../../components/PageHero.astro';
import DocumentLibrary from '../../../components/documents/DocumentLibrary.astro';
import DocumentDownloadForm from '../../../components/documents/DocumentDownloadForm.astro';
import { pageSeo, pageHeroBg } from '../../../data/site';
import { allDocuments, DOCUMENTS_PER_PAGE } from '../../../data/tai-lieu';
import { routes } from '../../../lib/routes';
import { SURFACE_NAVY, SURFACE_PAPER } from '../../../lib/section-rhythm';

/**
 * Chỉ sinh trang 2 trở đi — trang 1 đã là /tai-lieu.
 * Thư viện chưa vượt DOCUMENTS_PER_PAGE thì mảng này rỗng, không route nào được dựng.
 */
export function getStaticPaths() {
  const totalPages = Math.ceil(allDocuments.length / DOCUMENTS_PER_PAGE);
  return Array.from({ length: Math.max(0, totalPages - 1) }, (_, i) => ({
    params: { page: String(i + 2) },
  }));
}

const currentPage = Number(Astro.params.page);
const totalPages = Math.ceil(allDocuments.length / DOCUMENTS_PER_PAGE);
---

<SiteLayout
  title={`${pageSeo.taiLieu.title} — Trang ${currentPage}`}
  description={pageSeo.taiLieu.description}
  currentPath={routes.taiLieu}
>
  <PageHero
    title="Thư viện tài liệu"
    bgImage={pageHeroBg.taiLieu}
    description={`Trang ${currentPage} / ${totalPages}`}
    breadcrumb={[
      { label: 'Trang chủ', href: routes.home },
      { label: 'Tài liệu', href: routes.taiLieu },
      { label: `Trang ${currentPage}` },
    ]}
  />

  <DocumentLibrary
    documents={allDocuments}
    category="all"
    currentPage={currentPage}
    sectionBg={SURFACE_PAPER}
  />
  <DocumentDownloadForm allDocuments={allDocuments} sectionBg={SURFACE_NAVY} />
</SiteLayout>
