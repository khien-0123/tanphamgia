---
import SiteLayout from '../../../../../layouts/SiteLayout.astro';
import PageHero from '../../../../../components/PageHero.astro';
import DocumentLibrary from '../../../../../components/documents/DocumentLibrary.astro';
import DocumentDownloadForm from '../../../../../components/documents/DocumentDownloadForm.astro';
import { pageSeo, pageHeroBg } from '../../../../../data/site';
import {
  allDocuments,
  documentCategories,
  documentsByCategory,
  DOCUMENTS_PER_PAGE,
} from '../../../../../data/tai-lieu';
import { routes } from '../../../../../lib/routes';
import { SURFACE_NAVY, SURFACE_PAPER } from '../../../../../lib/section-rhythm';

/**
 * Trang 2 trở đi của từng nhóm. Nhóm nào chưa vượt DOCUMENTS_PER_PAGE thì
 * không đóng góp route nào — hôm nay cả 4 nhóm đều vậy nên mảng này rỗng.
 */
export function getStaticPaths() {
  return documentCategories
    .filter((cat) => cat.id !== 'all')
    .flatMap((cat) => {
      const total = Math.ceil(documentsByCategory(cat.id).length / DOCUMENTS_PER_PAGE);
      return Array.from({ length: Math.max(0, total - 1) }, (_, i) => ({
        params: { category: cat.id, page: String(i + 2) },
      }));
    });
}

const category = Astro.params.category as string;
const group = documentCategories.find((c) => c.id === category);
const currentPage = Number(Astro.params.page);
const totalPages = Math.ceil(documentsByCategory(category as 'all').length / DOCUMENTS_PER_PAGE);
const label = group?.label ?? 'Tài liệu';
---

<SiteLayout
  title={`${label} — Trang ${currentPage} — ${pageSeo.taiLieu.title}`}
  description={pageSeo.taiLieu.description}
  currentPath={routes.taiLieu}
>
  <PageHero
    title={label}
    bgImage={pageHeroBg.taiLieu}
    vAlign="center"
    description={`Trang ${currentPage} / ${totalPages}`}
    breadcrumb={[
      { label: 'Trang chủ', href: routes.home },
      { label: 'Tài liệu', href: routes.taiLieu },
      { label, href: `${routes.taiLieu}/danh-muc/${category}` },
      { label: `Trang ${currentPage}` },
    ]}
  />

  <DocumentLibrary
    documents={allDocuments}
    category={category}
    currentPage={currentPage}
    sectionBg={SURFACE_PAPER}
  />
  <DocumentDownloadForm allDocuments={allDocuments} sectionBg={SURFACE_NAVY} />
</SiteLayout>
