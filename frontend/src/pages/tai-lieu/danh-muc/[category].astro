---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import PageHero from '../../../components/PageHero.astro';
import DocumentLibrary from '../../../components/documents/DocumentLibrary.astro';
import DocumentDownloadForm from '../../../components/documents/DocumentDownloadForm.astro';
import { pageSeo, pageHeroBg } from '../../../data/site';
import {
  allDocuments,
  documentCategories,
  documentsByCategory,
  DOCUMENTS_PER_PAGE,
} from '../../../data/tai-lieu';
import { paginate } from '../../../utils/pagination';
import { routes } from '../../../lib/routes';
import { SURFACE_NAVY, SURFACE_PAPER } from '../../../lib/section-rhythm';

/** Một route cho mỗi nhóm có tài liệu — nhóm rỗng không sinh trang */
export function getStaticPaths() {
  return documentCategories
    .filter((cat) => cat.id !== 'all' && documentsByCategory(cat.id).length > 0)
    .map((cat) => ({ params: { category: cat.id } }));
}

const category = Astro.params.category as string;
const group = documentCategories.find((c) => c.id === category);
const docs = documentsByCategory(category as 'all');
const { items, currentPage, totalPages, totalItems } = paginate(docs, 1, DOCUMENTS_PER_PAGE);
const label = group?.label ?? 'Tài liệu';
---

<SiteLayout
  title={`${label} — ${pageSeo.taiLieu.title}`}
  description={pageSeo.taiLieu.description}
  currentPath={routes.taiLieu}
>
  <PageHero
    title={label}
    bgImage={pageHeroBg.taiLieu}
    description="Tải miễn phí catalogue, hồ sơ năng lực và tài liệu hướng dẫn triển khai đồng phục doanh nghiệp."
    breadcrumb={[
      { label: 'Trang chủ', href: routes.home },
      { label: 'Tài liệu', href: routes.taiLieu },
      { label },
    ]}
  />

  <DocumentLibrary
    documents={items}
    category={category}
    currentPage={currentPage}
    totalPages={totalPages}
    totalItems={totalItems}
    sectionBg={SURFACE_PAPER}
  />
  <DocumentDownloadForm allDocuments={allDocuments} sectionBg={SURFACE_NAVY} />
</SiteLayout>
