---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import PageHero from '../../../components/PageHero.astro';
import BlogListingSection from '../../../components/blog/BlogListingSection.astro';
import { pageSeo, blogPosts, BLOG_POSTS_PER_PAGE, pageHeroBg } from '../../../data/site';
import { paginate } from '../../../utils/pagination';
import { routes } from '../../../lib/routes';
import { rhythmBg } from '../../../lib/section-rhythm';

export function getStaticPaths() {
  const listingPosts = blogPosts.slice(1);
  const totalPages = Math.ceil(listingPosts.length / BLOG_POSTS_PER_PAGE);
  return Array.from({ length: Math.max(0, totalPages - 1) }, (_, i) => ({
    params: { page: String(i + 2) },
  }));
}

const pageNum = Number(Astro.params.page);
const listingPosts = blogPosts.slice(1);
const { items, currentPage, totalPages } = paginate(listingPosts, pageNum, BLOG_POSTS_PER_PAGE);
const seoTitle = `${pageSeo.tinTuc.title} — Trang ${currentPage}`;
---

<SiteLayout
  title={seoTitle}
  description={pageSeo.tinTuc.description}
  currentPath={routes.tinTuc}
>
  <PageHero
    title="Tin tức & Kiến thức chuyên ngành"
    eyebrow="Tin tức · Est. 2003"
    bgImage={pageHeroBg.tinTuc}
    description={`Trang ${currentPage} / ${totalPages}`}
    breadcrumb={[
      { label: 'Trang chủ', href: routes.home },
      { label: 'Tin tức', href: routes.tinTuc },
      { label: `Trang ${currentPage}` },
    ]}
  />

  <BlogListingSection items={items} currentPage={currentPage} totalPages={totalPages} sectionBg={rhythmBg(0)} />
</SiteLayout>
