---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SiteNav from '../../../components/SiteNav.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import SiteCtaSection from '../../../components/SiteCtaSection.astro';
import PageHero from '../../../components/PageHero.astro';
import BlogListingSection from '../../../components/blog/BlogListingSection.astro';
import { pageSeo, blogPosts, BLOG_POSTS_PER_PAGE, pageHeroBg } from '../../../data/site';
import { paginate } from '../../../utils/pagination';
import { routes } from '../../../lib/routes';

export function getStaticPaths() {
  const totalPages = Math.ceil(blogPosts.length / BLOG_POSTS_PER_PAGE);
  return Array.from({ length: Math.max(0, totalPages - 1) }, (_, i) => ({
    params: { page: String(i + 2) },
  }));
}

const pageNum = Number(Astro.params.page);
const { items, currentPage, totalPages } = paginate(blogPosts, pageNum, BLOG_POSTS_PER_PAGE);
const seoTitle = `${pageSeo.tinTuc.title} — Trang ${currentPage}`;
---

<BaseLayout title={seoTitle} description={pageSeo.tinTuc.description}>
  <SiteNav currentPath={routes.tinTuc} />

  <PageHero
    title="Tin tức & Kiến thức chuyên ngành"
    bgImage={pageHeroBg.tinTuc}
    description={`Trang ${currentPage} / ${totalPages}`}
    breadcrumb={[
      { label: 'Trang chủ', href: routes.home },
      { label: 'Tin tức', href: routes.tinTuc },
      { label: `Trang ${currentPage}` },
    ]}
  />

  <BlogListingSection items={items} currentPage={currentPage} totalPages={totalPages} />

  <SiteCtaSection />

  <SiteFooter />
</BaseLayout>
