---
/**
 * Deep-link trang N của «Tất cả». Click phân trang chỉ pushState — không reload.
 */
import SiteLayout from '../../../layouts/SiteLayout.astro';
import PageHero from '../../../components/PageHero.astro';
import BlogListingSection from '../../../components/blog/BlogListingSection.astro';
import { pageSeo, BLOG_POSTS_PER_PAGE, pageHeroBg } from '../../../data/site';
import { getAllBlogPosts } from '../../../lib/cms';
import { routes } from '../../../lib/routes';

export async function getStaticPaths() {
  const blogPosts = await getAllBlogPosts();
  const featured = blogPosts[0];
  const listing = featured ? blogPosts.slice(1) : blogPosts;
  const totalPages = Math.max(1, Math.ceil(listing.length / BLOG_POSTS_PER_PAGE));
  return Array.from({ length: Math.max(0, totalPages - 1) }, (_, i) => ({
    params: { page: String(i + 2) },
  }));
}

const blogPosts = await getAllBlogPosts();
const pageNum = Number(Astro.params.page);
const featuredPost = blogPosts[0];
const seoTitle = `${pageSeo.tinTuc.title} — Trang ${pageNum}`;
---

<SiteLayout
  title={seoTitle}
  description={pageSeo.tinTuc.description}
  currentPath={routes.tinTuc}
>
  <PageHero
    title="Tin tức & Kiến thức chuyên ngành"
    bgImage={pageHeroBg.tinTuc}
    imageClass="object-[center_40%]"
    vAlign="center"
    description="Chia sẻ kinh nghiệm quản lý đồng phục, lựa chọn chất liệu và xu hướng mới trong ngành."
    breadcrumb={[
      { label: 'Trang chủ', href: routes.home },
      { label: 'Tin tức', href: routes.tinTuc },
      { label: `Trang ${pageNum}` },
    ]}
  />

  <BlogListingSection
    posts={blogPosts}
    featuredPost={featuredPost}
    category="all"
    currentPage={pageNum}
    sectionBg="bg-[#fbf8f1]"
  />
</SiteLayout>
