---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteNav from '../../components/SiteNav.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import SiteCtaSection from '../../components/SiteCtaSection.astro';
import BlogPostArticle from '../../components/blog/BlogPostArticle.astro';
import { blogPosts } from '../../data/site';

export function getStaticPaths() {
  return blogPosts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const title = `${post.title} | Tân Phạm Gia`;
---

<BaseLayout title={title} description={post.excerpt}>
  <SiteNav currentPath="/tin-tuc" />
  <BlogPostArticle post={post} />
  <SiteCtaSection />
  <SiteFooter />
</BaseLayout>
