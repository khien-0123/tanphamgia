---
import SiteLayout from '../../layouts/SiteLayout.astro';
import PostEditorialLayout from '../../components/blog/PostEditorialLayout.astro';
import { getAllBlogPosts, getBlogPostBySlug } from '../../lib/cms';
import { formatBlogDate } from '../../lib/format-blog-date';
import { routes } from '../../lib/routes';
import { allDocuments } from '../../data/tai-lieu';

export async function getStaticPaths() {
  const posts = await getAllBlogPosts();
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { slug: post.slug },
  }));
}

const slug = Astro.props.slug as string;
const detail = await getBlogPostBySlug(slug);
if (!detail) {
  return Astro.redirect(routes.tinTuc);
}

const { post, blocks, contentHtml } = detail;
const allPosts = await getAllBlogPosts();
const title = `${post.title} | Tân Phạm Gia`;

const others = allPosts.filter((item) => item.slug !== post.slug);
const ranked = [
  ...others.filter((item) => item.category === post.category),
  ...others.filter((item) => item.category !== post.category),
];

const related = ranked.slice(0, 3).map((item) => ({
  href: item.href!,
  title: item.title,
  image: item.image,
  alt: item.alt,
  category: item.category,
  meta: formatBlogDate(item.publishedAt),
}));

/** Sidebar trỏ về tài liệu thật trên trang /tai-lieu — không dùng bài viết khác */
const sidebarLinks = allDocuments.slice(0, 6).map((doc) => ({
  href: `${routes.taiLieu}#${doc.id}`,
  title: doc.title,
}));
---

<SiteLayout title={title} description={post.excerpt} currentPath={routes.tinTuc} navOverDark={false}>
  <PostEditorialLayout
    title={post.title}
    excerpt={post.excerpt}
    category={post.category}
    image={post.image}
    alt={post.alt}
    publishedAt={post.publishedAt}
    blocks={blocks}
    contentHtml={contentHtml}
    breadcrumbLabel="Tin tức"
    breadcrumbHref={routes.tinTuc}
    backLabel="Quay lại Tin tức"
    backHref={routes.tinTuc}
    ctaLabel="Nhận tư vấn miễn phí"
    ctaHref={routes.lienHe}
    relatedTitle="Bài viết cùng danh mục"
    relatedAllLabel="Xem tất cả"
    relatedAllHref={routes.tinTuc}
    related={related}
    sidebarLinksTitle="Tài liệu liên quan"
    sidebarLinks={sidebarLinks}
    engagementSlug={post.slug}
  />
</SiteLayout>
