---
import SiteLayout from '../../layouts/SiteLayout.astro';
import PostEditorialLayout from '../../components/blog/PostEditorialLayout.astro';
import { blogPosts } from '../../data/site';
import { getPostBody } from '../../data/bai-viet';
import { formatBlogDate } from '../../lib/format-blog-date';
import { routes } from '../../lib/routes';

export function getStaticPaths() {
  return blogPosts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const title = `${post.title} | Tân Phạm Gia`;

/* Bài liên quan ưu tiên cùng danh mục, thiếu thì bù bằng bài khác để lưới
   3 thẻ không bị hụt. */
const others = blogPosts.filter((item) => item.slug !== post.slug);
const ranked = [
  ...others.filter((item) => item.category === post.category),
  ...others.filter((item) => item.category !== post.category),
];

const related = ranked.slice(0, 3).map((item) => ({
  href: item.href!,
  title: item.title,
  image: item.image,
  alt: item.alt,
  category: item.category,
  meta: formatBlogDate(item.publishedAt),
}));

/* Danh sách chữ ở cột phải đầu trang — nhiều hơn lưới thẻ dưới chân vì
   không tốn diện tích ảnh. */
const sidebarLinks = ranked.slice(0, 6).map((item) => ({
  href: item.href!,
  title: item.title,
}));
---

<SiteLayout title={title} description={post.excerpt} currentPath={routes.tinTuc} navOverDark={false}>
  <PostEditorialLayout
    title={post.title}
    excerpt={post.excerpt}
    category={post.category}
    image={post.image}
    alt={post.alt}
    publishedAt={post.publishedAt}
    blocks={getPostBody(post.slug)}
    breadcrumbLabel="Tin tức"
    breadcrumbHref={routes.tinTuc}
    backLabel="Quay lại Tin tức"
    backHref={routes.tinTuc}
    ctaLabel="Nhận tư vấn miễn phí"
    ctaHref={routes.lienHe}
    relatedTitle="Bài viết cùng danh mục"
    relatedAllLabel="Xem tất cả"
    relatedAllHref={routes.tinTuc}
    related={related}
    sidebarLinksTitle="Tài liệu liên quan"
    sidebarLinks={sidebarLinks}
    engagementSlug={post.slug}
  />
</SiteLayout>
