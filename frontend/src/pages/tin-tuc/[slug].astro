---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteNav from '../../components/SiteNav.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import SiteCtaSection from '../../components/SiteCtaSection.astro';
import { blogPosts } from '../../data/site';

export function getStaticPaths() {
  return blogPosts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const title = `${post.title} | Tân Phạm Gia`;
---

<BaseLayout title={title} description={post.excerpt}>
  <SiteNav solid currentPath="/tin-tuc" />

  <article class="pt-28 md:pt-32 pb-16 bg-white">
    <div class="max-w-container-max-width mx-auto px-6 md:px-8 max-w-3xl">
      <nav aria-label="Breadcrumb" class="text-sm text-text-muted mb-8">
        <a class="hover:text-accent-gold transition-colors" href="/">Trang chủ</a>
        <span class="mx-2">/</span>
        <a class="hover:text-accent-gold transition-colors" href="/tin-tuc">Tin tức</a>
        <span class="mx-2">/</span>
        <span class="text-ink-dark line-clamp-2" title={post.title}>{post.title}</span>
      </nav>

      <span
        class="font-bold text-xs uppercase tracking-widest mb-4 block"
        style={post.categoryColor ? `color: ${post.categoryColor}` : undefined}
      >
        {post.category}
      </span>
      <h1 class="font-display-lg text-[clamp(1.5rem,5vw,3rem)] leading-[1.2] md:text-4xl font-bold text-ink-dark mb-6 leading-tight text-balance">
        {post.title}
      </h1>
      <figure class="m-0 mb-10 rounded-lg overflow-hidden">
        <img alt={post.alt} class="w-full h-auto" src={post.image} />
      </figure>
      <div class="prose-blog text-text-muted leading-relaxed space-y-4">
        <p>{post.excerpt}</p>
        <p>
          Nội dung chi tiết sẽ được đồng bộ từ WordPress. Liên hệ đội ngũ tư vấn nếu bạn cần thêm
          thông tin về chủ đề này.
        </p>
      </div>
      <a
        href="/tin-tuc"
        class="inline-block mt-10 text-sm font-bold text-accent-teal hover:text-ink-dark transition-colors"
      >
        ← Quay lại danh sách tin tức
      </a>
    </div>
  </article>

  <SiteCtaSection />

  <SiteFooter />
</BaseLayout>
