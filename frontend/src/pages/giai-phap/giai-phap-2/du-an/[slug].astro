---
import CaseStudyDetailPage from '../../../../components/solution/CaseStudyDetailPage.astro';
import { duAnGiaiPhap2 } from '../../../../data/giai-phap-2-du-an';

export function getStaticPaths() {
  return duAnGiaiPhap2.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
---

<CaseStudyDetailPage
  solutionId={2}
  solutionSlug="giai-phap-2"
  project={project}
/>
