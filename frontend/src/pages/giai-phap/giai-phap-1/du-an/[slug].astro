---
/**
 * Redirect legacy URL → /khach-hang/du-an/:slug
 * Giữ route cũ để bookmark / link ngoài không gãy.
 */
import { caseStudyHref } from '../../../../lib/routes';
import { duAnGiaiPhap1 } from '../../../../data/giai-phap-1-du-an';

export function getStaticPaths() {
  return duAnGiaiPhap1.map((project) => ({
    params: { slug: project.slug },
  }));
}

const { slug } = Astro.params;
return Astro.redirect(caseStudyHref(slug!), 301);
---
