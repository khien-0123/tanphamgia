---
import CaseStudyDetailPage from '../../../../components/solution/CaseStudyDetailPage.astro';
import { duAnGiaiPhap1 } from '../../../../data/giai-phap-1-du-an';

export function getStaticPaths() {
  return duAnGiaiPhap1.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
---

<CaseStudyDetailPage
  solutionId={1}
  solutionSlug="giai-phap-1"
  project={project}
  allProjects={duAnGiaiPhap1}
/>
