---
import CaseStudyDetailPage from '../../../../components/solution/CaseStudyDetailPage.astro';
import { duAnGiaiPhap3 } from '../../../../data/giai-phap-3-du-an';

export function getStaticPaths() {
  return duAnGiaiPhap3.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
---

<CaseStudyDetailPage
  solutionId={3}
  solutionSlug="giai-phap-3"
  project={project}
  allProjects={duAnGiaiPhap3}
/>
