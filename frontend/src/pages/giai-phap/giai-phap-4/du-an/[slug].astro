---
import CaseStudyDetailPage from '../../../../components/solution/CaseStudyDetailPage.astro';
import { duAnGiaiPhap4 } from '../../../../data/giai-phap-4-du-an';

export function getStaticPaths() {
  return duAnGiaiPhap4.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
---

<CaseStudyDetailPage
  solutionId={4}
  solutionSlug="giai-phap-4"
  project={project}
/>
