---
import SiteLayout from '../../layouts/SiteLayout.astro';
import PageHero from '../../components/PageHero.astro';
import ServiceDetailBlocks from '../../components/services/ServiceDetailBlocks.astro';
import ServiceProofBand from '../../components/services/ServiceProofBand.astro';
import ServiceMosaic from '../../components/services/ServiceMosaic.astro';
import { services, getOtherServices } from '../../data/dich-vu';
import { siteAssets } from '../../data/assets';
import { routes } from '../../lib/routes';
import { sectionEyebrow } from '../../lib/section-eyebrow';
import { SURFACE_PAPER, sectionPy } from '../../lib/section-rhythm';

export function getStaticPaths() {
  return services.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

const { service } = Astro.props;
const others = getOtherServices(service.slug);
const blocks = service.blocks ?? [];
---

<SiteLayout
  title={service.seo.title}
  description={service.seo.description}
  currentPath={routes.dichVu}
>
  <PageHero
    title={service.title}
    bgImage={service.heroImage ?? service.image ?? siteAssets.hero.gioiThieu}
    description={service.heroDescription ?? service.seo.description}
    breadcrumb={[
      { label: 'Trang chủ', href: routes.home },
      { label: 'Dịch vụ', href: routes.dichVu },
      { label: service.title },
    ]}
  />

  {/*
    Dịch vụ nào khách chưa gửi nội dung chi tiết thì `blocks` rỗng — trang đi
    thẳng từ hero xuống Dịch vụ khác, không dựng khung rỗng để chờ chữ.
  */}
  {blocks.length > 0 && <ServiceDetailBlocks blocks={blocks} />}

  <ServiceProofBand />

  <section
    class:list={[
      SURFACE_PAPER,
      sectionPy,
    ]}
  >
    <div class="mx-auto max-w-container-max-width px-6 md:px-8">
      <header data-reveal class="flex flex-col items-center text-center">
        <span class={sectionEyebrow}>Dịch vụ khác</span>
        <h2
          class="mt-[1.15rem] text-balance text-[clamp(1.75rem,2.7vw,3rem)] font-extrabold leading-[1.1] tracking-[-0.03em] text-ink-dark"
        >
          Các mảng dịch vụ còn lại
        </h2>
      </header>

      <ServiceMosaic services={others} />
    </div>
  </section>
</SiteLayout>
