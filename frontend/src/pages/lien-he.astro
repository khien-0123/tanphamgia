---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteCtaSection from '../components/SiteCtaSection.astro';
import PageHero from '../components/PageHero.astro';
import ContactPageSection from '../components/contact/ContactPageSection.astro';
import { pageSeo, pageHeroBg } from '../data/site';
---

<BaseLayout title={pageSeo.lienHe.title} description={pageSeo.lienHe.description}>
  <SiteNav solid currentPath="/lien-he" />

  <PageHero
    title="Liên hệ tư vấn"
    bgImage={pageHeroBg.lienHe}
    description="Liên hệ đội ngũ tư vấn để nhận giải pháp đồng phục phù hợp với doanh nghiệp của bạn."
    breadcrumb={[
      { label: 'Trang chủ', href: '/' },
      { label: 'Liên hệ' },
    ]}
  />

  <ContactPageSection />

  <SiteCtaSection />
  <SiteFooter />
</BaseLayout>
