---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteCtaSection from '../components/SiteCtaSection.astro';
import PageHero from '../components/PageHero.astro';
import ClientLogosSection from '../components/clients/ClientLogosSection.astro';
import ClientCaseStudyGrid from '../components/clients/ClientCaseStudyGrid.astro';
import TestimonialsSlider from '../components/TestimonialsSlider.astro';
import { pageSeo, clientCaseStudies, testimonialsClients, pageHeroBg } from '../data/site';
import { routes } from '../lib/routes';
---

<BaseLayout title={pageSeo.khachHang.title} description={pageSeo.khachHang.description}>
  <SiteNav currentPath={routes.khachHang} />

  <PageHero
    title="Dự án & Khách hàng tiêu biểu"
    bgImage={pageHeroBg.khachHang}
    description="Khám phá các dự án đồng phục thực tế và thương hiệu đã đồng hành cùng Tân Phạm Gia trong hơn 23 năm."
    breadcrumb={[
      { label: 'Trang chủ', href: routes.home },
      { label: 'Khách hàng' },
    ]}
  />

  <ClientLogosSection />
  <ClientCaseStudyGrid items={clientCaseStudies} />
  <TestimonialsSlider items={testimonialsClients} variant="light" />

  <SiteCtaSection />
  <SiteFooter />
</BaseLayout>
