---
import SiteLayout from '../layouts/SiteLayout.astro';
import PageHero from '../components/PageHero.astro';
import ClientLogosSection from '../components/clients/ClientLogosSection.astro';
import ClientCaseStudyGrid from '../components/clients/ClientCaseStudyGrid.astro';
import TestimonialsSlider from '../components/TestimonialsSlider.astro';
import { pageSeo, clientCaseStudies, testimonialsClients, pageHeroBg } from '../data/site';
import { routes } from '../lib/routes';
import { rhythmBgWhiteFirst } from '../lib/section-rhythm';
---

<SiteLayout
  title={pageSeo.khachHang.title}
  description={pageSeo.khachHang.description}
  currentPath={routes.khachHang}
>
  <PageHero
    title="Dự án & Khách hàng tiêu biểu"
    bgImage={pageHeroBg.khachHang}
    description="Khám phá các dự án đồng phục thực tế và thương hiệu đã đồng hành cùng Tân Phạm Gia trong hơn 23 năm."
    breadcrumb={[
      { label: 'Trang chủ', href: routes.home },
      { label: 'Khách hàng' },
    ]}
  />

  <ClientLogosSection sectionBg={rhythmBgWhiteFirst(0)} />
  <ClientCaseStudyGrid items={clientCaseStudies} sectionBg={rhythmBgWhiteFirst(1)} />
  <TestimonialsSlider items={testimonialsClients} variant="light" sectionBg={rhythmBgWhiteFirst(2)} />
</SiteLayout>
