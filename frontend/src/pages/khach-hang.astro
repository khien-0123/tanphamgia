---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteCtaSection from '../components/SiteCtaSection.astro';
import PageHero from '../components/PageHero.astro';
import HomeClientLogos from '../components/HomeClientLogos.astro';
import TestimonialsSection from '../components/TestimonialsSection.astro';
import { pageSeo, clientCaseStudies, testimonialsClients } from '../data/site';
---

<BaseLayout title={pageSeo.khachHang.title} description={pageSeo.khachHang.description}>
  <SiteNav solid currentPath="/khach-hang" />

  <PageHero
    title="Dự án & Khách hàng tiêu biểu"
    description="Khám phá các dự án đồng phục thực tế và thương hiệu đã đồng hành cùng Tân Phạm Gia trong hơn 23 năm."
    breadcrumb={[
      { label: 'Trang chủ', href: '/' },
      { label: 'Khách hàng' },
    ]}
  />

  <section class="py-12 md:py-16 bg-white border-b border-border-subtle" id="doi-tac">
    <div class="max-w-container-max-width mx-auto px-6 md:px-8 mb-8">
      <h2 class="font-headline-md text-2xl md:text-3xl font-bold text-ink-dark mb-3">
        Logo khách hàng tiêu biểu
      </h2>
      <p class="text-text-muted max-w-2xl">
        Tân Phạm Gia được tin tưởng bởi các tập đoàn, ngân hàng, chuỗi bán lẻ và doanh nghiệp sản xuất
        trên toàn quốc.
      </p>
    </div>
    <HomeClientLogos />
  </section>

  <section class="py-12 md:py-20 bg-white border-b border-border-subtle">
    <div class="max-w-container-max-width mx-auto px-6 md:px-8">
      <h2 class="font-headline-md text-2xl md:text-3xl font-bold text-ink-dark mb-10">
        Case study tiêu biểu
      </h2>
      <div class="grid md:grid-cols-3 gap-8 md:gap-10">
        {
          clientCaseStudies.map((item) => (
            <article class="group">
              <a href={item.href ?? '/tin-tuc'} class="block no-underline text-inherit">
                <figure class="relative aspect-video overflow-hidden rounded-lg mb-5 m-0">
                  <img
                    alt={item.alt}
                    class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-[1.04]"
                    src={item.image}
                    loading="lazy"
                  />
                </figure>
                <span class="text-xs font-bold uppercase tracking-widest text-accent-teal mb-2 block">
                  {item.client}
                </span>
                <h3 class="text-lg font-bold text-ink-dark mb-3 group-hover:text-accent-gold transition-colors leading-snug">
                  {item.title}
                </h3>
                <p class="text-text-muted text-sm leading-relaxed">{item.excerpt}</p>
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <TestimonialsSection items={testimonialsClients} />

  <SiteCtaSection />

  <SiteFooter />
</BaseLayout>
