---
import SiteLayout from '../layouts/SiteLayout.astro';
import PageHero from '../components/PageHero.astro';
import DocumentLibrary from '../components/documents/DocumentLibrary.astro';
import DocumentDownloadForm from '../components/documents/DocumentDownloadForm.astro';
import { pageSeo, pageHeroBg } from '../data/site';
import { allDocuments, DOCUMENTS_PER_PAGE } from '../data/tai-lieu';
import { paginate } from '../utils/pagination';
import { routes } from '../lib/routes';
import { SURFACE_NAVY, SURFACE_PAPER } from '../lib/section-rhythm';

const { items, currentPage, totalPages, totalItems } = paginate(
  allDocuments,
  1,
  DOCUMENTS_PER_PAGE,
);
---

<SiteLayout
  title={pageSeo.taiLieu.title}
  description={pageSeo.taiLieu.description}
  currentPath={routes.taiLieu}
>
  <PageHero
    title="Thư viện tài liệu"
    bgImage={pageHeroBg.taiLieu}
    description="Tải miễn phí catalogue, hồ sơ năng lực và tài liệu hướng dẫn triển khai đồng phục doanh nghiệp."
    descriptionLines={[
      'Tải miễn phí catalogue, hồ sơ năng lực và tài liệu',
      'hướng dẫn triển khai đồng phục doanh nghiệp.',
    ]}
    breadcrumb={[
      { label: 'Trang chủ', href: routes.home },
      { label: 'Tài liệu' },
    ]}
  />

  <DocumentLibrary
    documents={items}
    category="all"
    currentPage={currentPage}
    totalPages={totalPages}
    totalItems={totalItems}
    sectionBg={SURFACE_PAPER}
  />
  <DocumentDownloadForm allDocuments={allDocuments} sectionBg={SURFACE_NAVY} />
</SiteLayout>
