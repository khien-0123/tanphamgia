---
import SiteLayout from '../layouts/SiteLayout.astro';
import PageHero from '../components/PageHero.astro';
import SolutionsListingGrid from '../components/solution/SolutionsListingGrid.astro';
import SolutionProcessSection from '../components/solution/SolutionProcessSection.astro';
import TestimonialsSlider from '../components/TestimonialsSlider.astro';
import { pageSeo, pageHeroBg, testimonialsClients } from '../data/site';
import { routes } from '../lib/routes';
import { giaiPhap1Content } from '../data/giai-phap-1';
import { SURFACE_PAPER } from '../lib/section-rhythm';

const processSteps = giaiPhap1Content.processSteps;
---

<SiteLayout
  title={pageSeo.giaiPhap.title}
  description={pageSeo.giaiPhap.description}
  currentPath={routes.giaiPhap}
>
  <PageHero
    title="Giải pháp đồng phục doanh nghiệp"
    bgImage={pageHeroBg.giaiPhap}
    description="Tư vấn chiến lược, thiết kế riêng và sản xuất quy mô lớn cho 4 phân khúc ngành B2B."
    breadcrumb={[
      { label: 'Trang chủ', href: routes.home },
      { label: 'Giải pháp' },
    ]}
  />

  <SolutionsListingGrid sectionBg={SURFACE_PAPER} />
  <SolutionProcessSection steps={processSteps} sectionBg={SURFACE_PAPER} />
  <TestimonialsSlider items={testimonialsClients} variant="dark" />
</SiteLayout>
