---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteCtaSection from '../components/SiteCtaSection.astro';
import PageHero from '../components/PageHero.astro';
import { pageSeo, solutions } from '../data/site';
---

<BaseLayout title={pageSeo.giaiPhap.title} description={pageSeo.giaiPhap.description}>
  <SiteNav solid currentPath="/giai-phap" />

  <PageHero
    title="Giải pháp đồng phục doanh nghiệp"
    description="Tư vấn chiến lược, thiết kế riêng và sản xuất quy mô lớn cho 4 phân khúc ngành B2B."
    breadcrumb={[
      { label: 'Trang chủ', href: '/' },
      { label: 'Giải pháp' },
    ]}
  />

  <section class="py-8 md:py-20 bg-white border-b border-border-subtle">
    <div class="max-w-container-max-width mx-auto px-6 md:px-8">
      <header class="max-w-3xl mb-6 md:mb-16">
        <p class="text-xs font-bold uppercase tracking-widest text-accent-teal mb-2 md:mb-3">4 nhóm giải pháp</p>
        <h2 class="font-headline-md text-2xl md:text-4xl font-bold text-ink-dark mb-3 md:mb-4">
          Lựa chọn giải pháp phù hợp ngành của bạn
        </h2>
        <p class="text-text-muted text-sm md:text-base leading-relaxed">
          Mỗi phân khúc được xây dựng theo pain points thực tế, case study có số liệu và quy trình
          triển khai 6 bước nhất quán.
        </p>
      </header>

      <div class="grid md:grid-cols-2 gap-5 md:gap-12">
        {
          solutions.map((item, index) => (
            <a
              href={`/giai-phap/${item.slug}`}
              class="group grid grid-cols-1 sm:grid-cols-[1fr_140px] gap-3 sm:gap-6 items-center no-underline text-inherit py-4 sm:py-6 border-b border-border-subtle last:border-0 md:border-0"
            >
              <figure class="order-first sm:order-2 m-0 overflow-hidden rounded-lg aspect-[4/3] w-full min-w-0">
                <img
                  alt={item.title}
                  class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                  src={item.image}
                  loading="lazy"
                />
              </figure>
              <div class="order-last sm:order-1 min-w-0">
                <span class="text-xs font-bold text-accent-gold mb-2 block">
                  0{index + 1}
                </span>
                <h3 class="text-lg sm:text-xl md:text-2xl font-bold text-ink-dark mb-2 sm:mb-3 group-hover:text-accent-gold transition-colors">
                  {item.title}
                </h3>
                <p class="text-text-muted text-sm leading-relaxed mb-3 sm:mb-4">{item.desc}</p>
                <span class="text-sm font-bold text-accent-teal group-hover:underline">
                  Xem chi tiết giải pháp
                </span>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <SiteCtaSection />

  <SiteFooter />
</BaseLayout>
