---
import SiteLayout from '../layouts/SiteLayout.astro';
import PageHero from '../components/PageHero.astro';
import SolutionsListingGrid from '../components/solution/SolutionsListingGrid.astro';
import { pageSeo, pageHeroBg } from '../data/site';
import { routes } from '../lib/routes';
import { giaiPhap1Content } from '../data/giai-phap-1';
import { rhythmBg } from '../lib/section-rhythm';

/** Quy trình 6 bước — nhất quán cho cả 4 nhóm (nguồn: data giải pháp). */
const processSteps = giaiPhap1Content.processSteps;
---

<SiteLayout
  title={pageSeo.giaiPhap.title}
  description={pageSeo.giaiPhap.description}
  currentPath={routes.giaiPhap}
>
  <PageHero
    title="Giải pháp đồng phục doanh nghiệp"
    bgImage={pageHeroBg.giaiPhap}
    description="Tư vấn chiến lược, thiết kế riêng và sản xuất quy mô lớn cho 4 phân khúc ngành B2B."
    breadcrumb={[
      { label: 'Trang chủ', href: routes.home },
      { label: 'Giải pháp' },
    ]}
  />

  <SolutionsListingGrid sectionBg={rhythmBg(0)} />

  <!-- S4 · Dải sáng — một quy trình cho bốn ngành -->
  <section class:list={['py-20 md:py-32', rhythmBg(1)]}>
    <div class="max-w-container-max-width mx-auto px-6 md:px-8">
      <header data-reveal class="max-w-3xl mb-12 md:mb-16">
        <p class="font-eyebrow text-xs uppercase tracking-widest text-accent-teal mb-3">
          Một quy trình · bốn ngành
        </p>
        <h2 class="text-3xl md:text-5xl font-extrabold text-ink-dark text-balance">
          Cùng một quy trình 6 bước cho mọi giải pháp
        </h2>
        <p class="mt-4 text-text-muted text-base leading-relaxed max-w-[60ch] text-pretty">
          Dù thuộc ngành nào, mỗi đơn hàng đều đi qua đúng sáu bước kiểm soát — minh bạch tiến độ và
          đồng bộ chất lượng giữa các đợt sản xuất.
        </p>
      </header>

      <ol class="process-grid">
        {
          processSteps.map((step, i) => (
            <li
              data-reveal
              class:list={['process-step', rhythmBg(1)]}
              style={`--reveal-delay:${i * 60}ms`}
            >
              <span class="process-no tabular-nums" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <p class="process-title">{step}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>
</SiteLayout>

<style>
  .process-grid {
    display: grid;
    gap: 1px;
    overflow: hidden;
    border-radius: 4px;
    background: #dce5e2;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  @media (min-width: 640px) {
    .process-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .process-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .process-step {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 1rem;
    overflow: hidden;
    min-height: 9rem;
    padding: 1.5rem 1.5rem 1.75rem;
  }

  @media (min-width: 768px) {
    .process-step {
      padding: 1.75rem 2rem 2rem;
    }
  }

  .process-no {
    display: block;
    flex-shrink: 0;
    margin: 0;
    font-size: clamp(2.75rem, 5vw, 4.25rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.05em;
    color: rgb(14 38 64 / 0.07);
    pointer-events: none;
    user-select: none;
  }

  .process-title {
    margin: 0;
    flex: 1;
    min-width: 0;
    max-width: 20ch;
    font-weight: 700;
    line-height: 1.45;
    color: #0e2640;
  }
</style>
