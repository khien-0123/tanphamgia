---
import SiteLayout from '../layouts/SiteLayout.astro';
import AboutBrandStory from '../components/about/AboutBrandStory.astro';
import AboutTimeline from '../components/about/AboutTimeline.astro';
import AboutMissionVision from '../components/about/AboutMissionVision.astro';
import AboutProductionCapacity from '../components/about/AboutProductionCapacity.astro';
import AboutTeamGrid from '../components/about/AboutTeamGrid.astro';
import CertificateGallery from '../components/CertificateGallery.astro';
import TestimonialsSlider from '../components/TestimonialsSlider.astro';
import { gioiThieuSeo } from '../data/gioi-thieu';
import { siteAssets } from '../data/assets';
import { testimonialsAbout, certificates } from '../data/site';
import { routes } from '../lib/routes';
import { rhythmBg } from '../lib/section-rhythm';
import {
  pageHeroImage,
  pageHeroInner,
  pageHeroScrim,
  pageHeroShell,
  pageHeroStats,
  pageHeroTitle,
} from '../lib/page-hero-shell';

const eyebrowClass =
  'font-eyebrow text-xs uppercase tracking-[0.2em] font-medium text-white';
---

<SiteLayout
  title={gioiThieuSeo.title}
  description={gioiThieuSeo.description}
  currentPath={routes.gioiThieu}
>
  {/* Banner — ảnh xưởng may, scrim giữ độ đọc chữ */}
  <header data-page-hero class:list={[pageHeroShell, 'text-white']}>
    <img
      alt=""
      class={pageHeroImage}
      src={siteAssets.hero.gioiThieu}
      loading="eager"
      decoding="async"
    />
    <div class={pageHeroScrim} aria-hidden="true"></div>

    <div class={pageHeroInner}>
      <p class={eyebrowClass}>Giới thiệu&nbsp;·&nbsp;Est. 2003</p>

      <div>
        <h1 class:list={[pageHeroTitle, 'mb-4 md:mb-7']}>
          23 năm theo đuổi giá trị của một sản phẩm may mặc chất lượng
        </h1>

        <div class:list={[pageHeroStats, 'max-md:gap-x-3']}>
          <div class="flex items-baseline gap-3.5">
            <b class="text-white text-lg font-extrabold tabular-nums md:text-[clamp(1.25rem,2vw,1.75rem)]">23</b>
            <span class={eyebrowClass}>Năm kinh nghiệm</span>
          </div>
          <div class="flex items-baseline gap-3.5">
            <b class="text-white text-lg font-extrabold tabular-nums md:text-[clamp(1.25rem,2vw,1.75rem)]">
              2.000m²
            </b>
            <span class={eyebrowClass}>Nhà xưởng</span>
          </div>
          <div class="flex items-baseline gap-3.5">
            <b class="text-white text-lg font-extrabold tabular-nums md:text-[clamp(1.25rem,2vw,1.75rem)]">
              30.000<span class="text-accent-gold">+</span>
            </b>
            <span class={eyebrowClass}>Sản phẩm / tháng</span>
          </div>
        </div>
      </div>
    </div>
  </header>

  <AboutBrandStory sectionBg={rhythmBg(0)} />
  <AboutTimeline sectionBg={rhythmBg(1)} />
  <AboutMissionVision sectionBg={rhythmBg(2)} />
  <AboutProductionCapacity sectionBg={rhythmBg(3)} />
  <AboutTeamGrid sectionBg={rhythmBg(4)} />
  <CertificateGallery items={certificates} sectionBg={rhythmBg(5)} />
  <TestimonialsSlider items={testimonialsAbout} variant="dark" />
</SiteLayout>
