---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteCtaSection from '../components/SiteCtaSection.astro';
import PageHero from '../components/PageHero.astro';
import AboutBrandStory from '../components/about/AboutBrandStory.astro';
import AboutTimeline from '../components/about/AboutTimeline.astro';
import AboutMissionVision from '../components/about/AboutMissionVision.astro';
import AboutProductionCapacity from '../components/about/AboutProductionCapacity.astro';
import AboutTeamGrid from '../components/about/AboutTeamGrid.astro';
import CertificateGallery from '../components/CertificateGallery.astro';
import TestimonialsSlider from '../components/TestimonialsSlider.astro';
import { gioiThieuSeo, testimonials, certificateImages } from '../data/gioi-thieu';
---

<BaseLayout title={gioiThieuSeo.title} description={gioiThieuSeo.description}>
  <SiteNav currentPath="/gioi-thieu" solid />

  <PageHero
    title="Giới thiệu"
    description="Hơn 23 năm kinh nghiệm trong ngành may mặc — từ thời trang cao cấp đến giải pháp đồng phục doanh nghiệp toàn diện."
    breadcrumb={[
      { label: 'Trang chủ', href: '/' },
      { label: 'Giới thiệu' },
    ]}
  />

  <AboutBrandStory />
  <AboutTimeline />
  <AboutMissionVision />
  <AboutProductionCapacity />
  <AboutTeamGrid />
  <CertificateGallery items={certificateImages} />
  <TestimonialsSlider items={testimonials} variant="dark" />

  <SiteCtaSection />
  <SiteFooter />
</BaseLayout>
