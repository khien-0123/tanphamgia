---
import SiteLayout from '../layouts/SiteLayout.astro';
import AboutBrandStory from '../components/about/AboutBrandStory.astro';
import AboutTimeline from '../components/about/AboutTimeline.astro';
import AboutMissionVision from '../components/about/AboutMissionVision.astro';
import AboutProductionCapacity from '../components/about/AboutProductionCapacity.astro';
import AboutTeamGrid from '../components/about/AboutTeamGrid.astro';
import CertificateGallery from '../components/CertificateGallery.astro';
import TestimonialsSlider from '../components/TestimonialsSlider.astro';
import { gioiThieuSeo, testimonials, certificateImages } from '../data/gioi-thieu';
import { pageHeroBg } from '../data/site';
import { routes } from '../lib/routes';
import { rhythmBg } from '../lib/section-rhythm';
import {
  pageHeroEyebrow,
  pageHeroImage,
  pageHeroInner,
  pageHeroScrim,
  pageHeroShell,
  pageHeroTitle,
} from '../lib/page-hero-shell';

const eyebrowClass = pageHeroEyebrow;
---

<SiteLayout
  title={gioiThieuSeo.title}
  description={gioiThieuSeo.description}
  currentPath={routes.gioiThieu}
>
  {/* Banner — 504px, ảnh nền + overlay, chữ đè, số ở chân */}
  <header data-page-hero class:list={[pageHeroShell, 'bg-[#0B1F35]']}>
    <img
      src={pageHeroBg.gioiThieu}
      alt=""
      class={pageHeroImage}
      loading="eager"
      decoding="async"
    />
    <div class={pageHeroScrim} aria-hidden="true"></div>

    <div class={pageHeroInner}>
      <p class:list={[eyebrowClass, 'text-white/65']}>Giới thiệu&nbsp;·&nbsp;Est. 2003</p>

      <div>
        <h1 class:list={[pageHeroTitle, 'mb-7']}>
          23 năm theo đuổi giá trị của một sản phẩm may mặc chất lượng
        </h1>

        <div class="flex flex-wrap items-baseline gap-x-11 gap-y-4">
          <div class="flex items-baseline gap-3.5">
            <b class="text-white text-[clamp(1.25rem,2vw,1.75rem)] font-extrabold tabular-nums">23</b>
            <span class:list={[eyebrowClass, 'text-white/55']}>Năm kinh nghiệm</span>
          </div>
          <div class="flex items-baseline gap-3.5">
            <b class="text-white text-[clamp(1.25rem,2vw,1.75rem)] font-extrabold tabular-nums">
              2.000m²
            </b>
            <span class:list={[eyebrowClass, 'text-white/55']}>Nhà xưởng</span>
          </div>
          <div class="flex items-baseline gap-3.5">
            <b class="text-white text-[clamp(1.25rem,2vw,1.75rem)] font-extrabold tabular-nums">
              30.000<span class="text-accent-gold">+</span>
            </b>
            <span class:list={[eyebrowClass, 'text-white/55']}>Sản phẩm / tháng</span>
          </div>
        </div>
      </div>
    </div>
  </header>

  <AboutBrandStory sectionBg={rhythmBg(0)} />
  <AboutTimeline sectionBg={rhythmBg(1)} />
  <AboutMissionVision sectionBg={rhythmBg(2)} />
  <AboutProductionCapacity sectionBg={rhythmBg(3)} />
  <AboutTeamGrid sectionBg={rhythmBg(4)} />
  <CertificateGallery items={certificateImages} sectionBg={rhythmBg(5)} />
  <TestimonialsSlider items={testimonials} variant="dark" />
</SiteLayout>
