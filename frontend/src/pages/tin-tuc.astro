---
import SiteLayout from '../layouts/SiteLayout.astro';
import PageHero from '../components/PageHero.astro';
import BlogListingSection from '../components/blog/BlogListingSection.astro';
import { pageSeo, blogPosts, BLOG_POSTS_PER_PAGE, pageHeroBg } from '../data/site';
import { paginate } from '../utils/pagination';
import { routes } from '../lib/routes';
import { rhythmBg } from '../lib/section-rhythm';

const { items, currentPage, totalPages } = paginate(blogPosts, 1, BLOG_POSTS_PER_PAGE);
---

<SiteLayout
  title={pageSeo.tinTuc.title}
  description={pageSeo.tinTuc.description}
  currentPath={routes.tinTuc}
>
  <PageHero
    title="Tin tức & Kiến thức chuyên ngành"
    bgImage={pageHeroBg.tinTuc}
    description="Chia sẻ kinh nghiệm quản lý đồng phục, lựa chọn chất liệu và xu hướng mới trong ngành."
    breadcrumb={[
      { label: 'Trang chủ', href: routes.home },
      { label: 'Tin tức' },
    ]}
  />

  <BlogListingSection items={items} currentPage={currentPage} totalPages={totalPages} sectionBg={rhythmBg(0)} />
</SiteLayout>
