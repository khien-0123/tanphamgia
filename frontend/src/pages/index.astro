---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteNav from '../components/SiteNav.astro';
import HomeHero from '../components/home/HomeHero.astro';
import HomeIntroSection from '../components/home/HomeIntroSection.astro';
import HomeWhyChooseSection from '../components/home/HomeWhyChooseSection.astro';
import HomeSolutionsGrid from '../components/home/HomeSolutionsGrid.astro';
import HomePartnersSection from '../components/home/HomePartnersSection.astro';
import HomeFeaturedCases from '../components/home/HomeFeaturedCases.astro';
import HomeDownloadTeaser from '../components/home/HomeDownloadTeaser.astro';
import CertificateGallery from '../components/CertificateGallery.astro';
import SiteCtaSection from '../components/SiteCtaSection.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { seo, navigation, certificates } from '../data/site';
---

<BaseLayout title={seo.title} description={seo.description}>
  <SiteNav items={navigation} currentPath="/" ctaHref="/tai-lieu" />

  <HomeHero />
  <HomeIntroSection />
  <HomeWhyChooseSection />
  <HomeSolutionsGrid />
  <HomePartnersSection />
  <HomeFeaturedCases />
  <HomeDownloadTeaser />
  <CertificateGallery items={certificates} centeredTitle />

  <SiteCtaSection />
  <SiteFooter />
</BaseLayout>
