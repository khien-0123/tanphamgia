---
/**
 * Deep-link trang N. Click số trang chỉ pushState (?trang=N) — không reload.
 * Route này để mở trực tiếp /chia sẻ URL dạng /khach-hang/trang/N.
 */
import SiteLayout from '../../../layouts/SiteLayout.astro';
import PageHero from '../../../components/PageHero.astro';
import ClientLogosSection from '../../../components/clients/ClientLogosSection.astro';
import ClientCaseStudyGrid from '../../../components/clients/ClientCaseStudyGrid.astro';
import ClientCaseStudyBlogSection from '../../../components/clients/ClientCaseStudyBlogSection.astro';
import TestimonialsSlider from '../../../components/TestimonialsSlider.astro';
import {
  pageSeo,
  clientCaseStudies,
  testimonialsClients,
  pageHeroBg,
  caseStudyBlogPosts,
  CASE_STUDY_POSTS_PER_PAGE,
} from '../../../data/site';
import { routes } from '../../../lib/routes';

export function getStaticPaths() {
  const totalPages = Math.ceil(caseStudyBlogPosts.length / CASE_STUDY_POSTS_PER_PAGE);
  return Array.from({ length: Math.max(0, totalPages - 1) }, (_, i) => ({
    params: { page: String(i + 2) },
  }));
}

const pageNum = Number(Astro.params.page) || 2;
---

<SiteLayout
  title={`${pageSeo.khachHang.title} — Trang ${pageNum}`}
  description={pageSeo.khachHang.description}
  currentPath={routes.khachHang}
>
  <PageHero
    title="Dự án & Khách hàng tiêu biểu"
    titleLines={['Dự án & Khách hàng', 'tiêu biểu']}
    bgImage={pageHeroBg.khachHang}
    description="Khám phá các dự án đồng phục thực tế và thương hiệu đã đồng hành cùng Tân Phạm Gia trong hơn 23 năm."
    breadcrumb={[
      { label: 'Trang chủ', href: routes.home },
      { label: 'Khách hàng', href: routes.khachHang },
      { label: `Trang ${pageNum}` },
    ]}
  />

  <ClientLogosSection sectionBg="bg-white" />
  <ClientCaseStudyGrid items={clientCaseStudies} sectionBg="bg-[#fbf8f1]" />
  <ClientCaseStudyBlogSection posts={caseStudyBlogPosts} currentPage={pageNum} />
  <TestimonialsSlider items={testimonialsClients} variant="dark" />
</SiteLayout>
